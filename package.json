{
  "name": "business-analytics-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/audit-learning-notes.mjs && node scripts/validate-ci.mjs && node scripts/verify-built-churn.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run && node scripts/scan-sensitive.mjs && node scripts/audit-churn-raster.mjs",
    "test:site": "node scripts/validate-ci.mjs",
    "security:scan": "node scripts/scan-sensitive.mjs",
    "audit:churn-raster": "node scripts/audit-churn-raster.mjs",
    "acceptance:churn": "node scripts/verify-built-churn.mjs",
    "quality": "npm run format && npm run check && npm run lint && npm run test && npm audit --audit-level=high && npm run build",
    "quality:check": "npm run format:check && npm run check && npm run lint && npm run test && npm audit --audit-level=high && npm run build",
    "deploy:meta": "node scripts/write-deploy-meta.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "audit:learning-notes": "node scripts/audit-learning-notes.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:i18n-sync": "node scripts/i18n-sync.mjs",
    "audit:i18n-sync:strict": "node scripts/i18n-sync.mjs --strict",
    "i18n:manifest": "node scripts/i18n-sync.mjs --write",
    "i18n:protected": "node scripts/i18n-protected.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "webr": "^0.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
