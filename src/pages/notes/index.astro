---
import { getCollection } from "astro:content";
import NotesExplorer from "../../components/NotesExplorer.astro";
import PageIntro from "../../components/PageIntro.astro";
import ProjectList from "../../components/ProjectList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPaginationPath,
  getTotalPages,
  NOTES_PAGE_SIZE,
} from "../../utils/pagination";

const includeDrafts = import.meta.env.DEV;
const notes = (await getCollection("notes"))
  .filter((entry) => entry.data.locale === "en" && (includeDrafts || !entry.data.draft))
  .sort((left, right) => left.data.title.localeCompare(right.data.title, "en"));
const relatedProjectKeys = new Set(
  notes.flatMap((entry) => entry.data.relatedProjects),
);
const relatedProjects = (await getCollection("projects")).filter(
  (entry) =>
    entry.data.locale === "en" && relatedProjectKeys.has(entry.data.translationKey),
);
const totalPages = getTotalPages(notes.length, NOTES_PAGE_SIZE);
---

<BaseLayout
  title="Learning Notes"
  locale="en"
  pagination={{
    next: totalPages > 1 ? getPaginationPath("/notes/", 2) : undefined,
  }}
>
  <PageIntro
    locale="en"
    title="Learning Notes"
    description="A bilingual, searchable knowledge base for analytics, optimisation and decision support."
  />
  <NotesExplorer
    entries={notes}
    locale="en"
    currentPage={1}
    pageSize={NOTES_PAGE_SIZE}
    basePath="/notes/"
  />
  {
    relatedProjects.length > 0 && (
      <section class="content-section" aria-labelledby="notes-projects-title">
        <h2 id="notes-projects-title">Related Projects</h2>
        <ProjectList entries={relatedProjects} locale="en" />
      </section>
    )
  }
</BaseLayout>
