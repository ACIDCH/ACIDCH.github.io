---
import { getCollection, type CollectionEntry } from "astro:content";
import NoteRenderer from "../../components/NoteRenderer.astro";
import { findTranslation, isPublicTranslation } from "../../i18n/content";
import { getLocalizedPath } from "../../utils/paths";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const entries = await getCollection("notes");
  return entries
    .filter(
      (entry) => entry.data.locale === "en" && (includeDrafts || !entry.data.draft),
    )
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, entries } }));
}

interface Props {
  entry: CollectionEntry<"notes">;
  entries: CollectionEntry<"notes">[];
}

const { entry, entries } = Astro.props;
const translation = findTranslation(entries, entry.data.translationKey, "zh");
const alternatePath =
  translation && isPublicTranslation(translation)
    ? getLocalizedPath(`/notes/${translation.data.slug}/`, "zh")
    : null;
---

<NoteRenderer entry={entry} alternatePath={alternatePath} />
