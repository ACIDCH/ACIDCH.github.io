---
import { getCollection, type CollectionEntry } from "astro:content";
import NotesExplorer from "../../../components/NotesExplorer.astro";
import PageIntro from "../../../components/PageIntro.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getGeneratedPageNumbers,
  getPaginationPath,
  getTotalPages,
  NOTES_PAGE_SIZE,
} from "../../../utils/pagination";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const notes = (await getCollection("notes"))
    .filter(
      (entry) => entry.data.locale === "en" && (includeDrafts || !entry.data.draft),
    )
    .sort((left, right) => left.data.title.localeCompare(right.data.title, "en"));

  return getGeneratedPageNumbers(notes.length, NOTES_PAGE_SIZE).map((page) => ({
    params: { page: String(page) },
    props: { notes, currentPage: page },
  }));
}

interface Props {
  notes: CollectionEntry<"notes">[];
  currentPage: number;
}

const { notes, currentPage } = Astro.props;
const totalPages = getTotalPages(notes.length, NOTES_PAGE_SIZE);
const canonicalPath = getPaginationPath("/notes/", currentPage);
const counterpartCount = (await getCollection("notes")).filter(
  (entry) =>
    entry.data.locale === "zh" && !entry.data.draft && !entry.data.isPlaceholder,
).length;
const alternatePath =
  currentPage <= getTotalPages(counterpartCount, NOTES_PAGE_SIZE)
    ? getPaginationPath("/zh/notes/", currentPage)
    : null;
---

<BaseLayout
  title={`Learning Notes — Page ${currentPage}`}
  locale="en"
  alternatePath={alternatePath}
  canonicalPath={canonicalPath}
  pagination={{
    previous: getPaginationPath("/notes/", currentPage - 1),
    next:
      currentPage < totalPages
        ? getPaginationPath("/notes/", currentPage + 1)
        : undefined,
  }}
>
  <PageIntro
    locale="en"
    title="Learning Notes"
    description={`Learning notes archive, page ${currentPage} of ${totalPages}.`}
  />
  <NotesExplorer
    entries={notes}
    locale="en"
    currentPage={currentPage}
    pageSize={NOTES_PAGE_SIZE}
    basePath="/notes/"
  />
</BaseLayout>
