---
import { getCollection, type CollectionEntry } from "astro:content";
import { findTranslation } from "../../../i18n/content";
import DataScienceNoteLayout from "../../../layouts/DataScienceNoteLayout.astro";
import DecisionModelNoteLayout from "../../../layouts/DecisionModelNoteLayout.astro";
import NoteLayout from "../../../layouts/NoteLayout.astro";
import RegressionNoteLayout from "../../../layouts/RegressionNoteLayout.astro";
import "../../../styles/sql-pagination.css";
import { getLocalizedPath } from "../../../utils/paths";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const entries = await getCollection("notes");
  return entries
    .filter(
      (entry) => entry.data.locale === "zh" && (includeDrafts || !entry.data.draft),
    )
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, entries } }));
}

interface Props {
  entry: CollectionEntry<"notes">;
  entries: CollectionEntry<"notes">[];
}

const { entry, entries } = Astro.props;
const translation = findTranslation(entries, entry.data.translationKey, "en");
const alternatePath = translation
  ? getLocalizedPath(`/notes/${translation.data.slug}/`, "en")
  : getLocalizedPath("/", "en");
const isDataScienceR = entry.data.seriesSlug === "data-science-r";
const isDecisionModel = entry.data.seriesSlug === "decision-models";
const isRegression = entry.data.seriesSlug === "regression";
---

{
  isDataScienceR ? (
    <DataScienceNoteLayout entry={entry} alternatePath={alternatePath} />
  ) : isDecisionModel ? (
    <DecisionModelNoteLayout entry={entry} alternatePath={alternatePath} />
  ) : isRegression ? (
    <RegressionNoteLayout entry={entry} alternatePath={alternatePath} />
  ) : (
    <NoteLayout entry={entry} alternatePath={alternatePath} />
  )
}
