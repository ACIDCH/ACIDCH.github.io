---
import { getCollection } from "astro:content";
import NotesExplorer from "../../../components/NotesExplorer.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ProjectList from "../../../components/ProjectList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes")).filter(
  (entry) => entry.data.locale === "zh",
);
const relatedProjectKeys = new Set(
  notes.flatMap((entry) => entry.data.relatedProjects),
);
const relatedProjects = (await getCollection("projects")).filter(
  (entry) =>
    entry.data.locale === "zh" && relatedProjectKeys.has(entry.data.translationKey),
);
---

<BaseLayout title="学习笔记" locale="zh">
  <PageIntro
    title="学习笔记"
    description="围绕分析、优化与决策支持建立的双语可搜索知识库；草稿不会公开受限制课程材料。"
  />
  <NotesExplorer entries={notes} locale="zh" />
  {
    relatedProjects.length > 0 && (
      <section class="content-section" aria-labelledby="notes-projects-title">
        <h2 id="notes-projects-title">相关项目</h2>
        <ProjectList entries={relatedProjects} locale="zh" />
      </section>
    )
  }
</BaseLayout>
