---
import { getCollection } from "astro:content";
import NotesExplorer from "../../../components/NotesExplorer.astro";
import LearningSeriesMap from "../../../components/learning/LearningSeriesMap.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ProjectList from "../../../components/ProjectList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getPaginationPath,
  getTotalPages,
  NOTES_PAGE_SIZE,
} from "../../../utils/pagination";

const includeDrafts = import.meta.env.DEV;
const notes = (await getCollection("notes"))
  .filter((entry) => entry.data.locale === "zh" && (includeDrafts || !entry.data.draft))
  .sort((left, right) => left.data.title.localeCompare(right.data.title, "zh-CN"));
const relatedProjectKeys = new Set(
  notes.flatMap((entry) => entry.data.relatedProjects),
);
const relatedProjects = (await getCollection("projects")).filter(
  (entry) =>
    entry.data.locale === "zh" && relatedProjectKeys.has(entry.data.translationKey),
);
const totalPages = getTotalPages(notes.length, NOTES_PAGE_SIZE);
---

<BaseLayout
  title="学习笔记"
  locale="zh"
  pagination={{
    next: totalPages > 1 ? getPaginationPath("/zh/notes/", 2) : undefined,
  }}
>
  <PageIntro
    locale="zh"
    title="学习笔记"
    description="先用标签快速定位知识点，再按主题进入完整知识库；全部笔记保留在下方并支持分页浏览。"
  />
  <NotesExplorer
    entries={notes}
    locale="zh"
    currentPage={1}
    pageSize={NOTES_PAGE_SIZE}
    basePath="/zh/notes/"
  >
    <LearningSeriesMap slot="knowledge-map" />
  </NotesExplorer>
  {
    relatedProjects.length > 0 && (
      <section class="content-section" aria-labelledby="notes-projects-title">
        <h2 id="notes-projects-title">相关项目</h2>
        <ProjectList entries={relatedProjects} locale="zh" />
      </section>
    )
  }
</BaseLayout>
