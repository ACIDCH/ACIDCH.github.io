---
import { getCollection, type CollectionEntry } from "astro:content";
import NotesExplorer from "../../../../components/NotesExplorer.astro";
import PageIntro from "../../../../components/PageIntro.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  getGeneratedPageNumbers,
  getPaginationPath,
  getTotalPages,
  NOTES_PAGE_SIZE,
} from "../../../../utils/pagination";

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const notes = (await getCollection("notes"))
    .filter(
      (entry) => entry.data.locale === "zh" && (includeDrafts || !entry.data.draft),
    )
    .sort((left, right) => left.data.title.localeCompare(right.data.title, "zh-CN"));

  return getGeneratedPageNumbers(notes.length, NOTES_PAGE_SIZE).map((page) => ({
    params: { page: String(page) },
    props: { notes, currentPage: page },
  }));
}

interface Props {
  notes: CollectionEntry<"notes">[];
  currentPage: number;
}

const { notes, currentPage } = Astro.props;
const totalPages = getTotalPages(notes.length, NOTES_PAGE_SIZE);
const canonicalPath = getPaginationPath("/zh/notes/", currentPage);
const counterpartCount = (await getCollection("notes")).filter(
  (entry) =>
    entry.data.locale === "en" && !entry.data.draft && !entry.data.isPlaceholder,
).length;
const alternatePath =
  currentPage <= getTotalPages(counterpartCount, NOTES_PAGE_SIZE)
    ? getPaginationPath("/notes/", currentPage)
    : null;
---

<BaseLayout
  title={`学习笔记 — 第 ${currentPage} 页`}
  locale="zh"
  alternatePath={alternatePath}
  canonicalPath={canonicalPath}
  pagination={{
    previous: getPaginationPath("/zh/notes/", currentPage - 1),
    next:
      currentPage < totalPages
        ? getPaginationPath("/zh/notes/", currentPage + 1)
        : undefined,
  }}
>
  <PageIntro
    locale="zh"
    title="学习笔记"
    description={`学习笔记归档，第 ${currentPage} 页，共 ${totalPages} 页。`}
  />
  <NotesExplorer
    entries={notes}
    locale="zh"
    currentPage={currentPage}
    pageSize={NOTES_PAGE_SIZE}
    basePath="/zh/notes/"
  />
</BaseLayout>
