---
import PageIntro from "../components/PageIntro.astro";
import { profileConfig } from "../config/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Resume" locale="en">
  <PageIntro
    title="Resume"
    description="The English resume has not been supplied."
    placeholder
  />
  {
    profileConfig.resume.en ? (
      <a href={profileConfig.resume.en}>Download resume</a>
    ) : (
      <p aria-live="polite">Resume download unavailable.</p>
    )
  }
</BaseLayout>
