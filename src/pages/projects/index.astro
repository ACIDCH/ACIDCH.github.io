---
import { getCollection } from "astro:content";
import PageIntro from "../../components/PageIntro.astro";
import Pagination from "../../components/Pagination.astro";
import ProjectList from "../../components/ProjectList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPaginationPath, paginate } from "../../utils/pagination";
import { sortProjects } from "../../utils/projects";

const projects = sortProjects(
  (await getCollection("projects")).filter((entry) => entry.data.locale === "en"),
  "en",
);
const page = paginate(projects, 1, 6);
---

<BaseLayout
  title="Projects"
  locale="en"
  pagination={{
    next: page.totalPages > 1 ? getPaginationPath("/projects/", 2) : undefined,
  }}
>
  <PageIntro
    locale="en"
    title="Projects"
    description="Projects are clearly marked by completion status; completed work presents traceable methods, results and modelling boundaries."
  />
  <ProjectList entries={page.items} locale="en" />
  <Pagination
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    basePath="/projects/"
    locale="en"
  />
</BaseLayout>
