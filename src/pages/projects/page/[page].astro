---
import { getCollection, type CollectionEntry } from "astro:content";
import Pagination from "../../../components/Pagination.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ProjectList from "../../../components/ProjectList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getGeneratedPageNumbers,
  getPaginationPath,
  paginate,
} from "../../../utils/pagination";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter((entry) => entry.data.locale === "en")
    .sort(
      (left, right) =>
        Number(right.data.featured) - Number(left.data.featured) ||
        left.data.title.localeCompare(right.data.title, "en"),
    );

  return getGeneratedPageNumbers(projects.length, 6).map((page) => ({
    params: { page: String(page) },
    props: { projects, currentPage: page },
  }));
}

interface Props {
  projects: CollectionEntry<"projects">[];
  currentPage: number;
}

const { projects, currentPage } = Astro.props;
const page = paginate(projects, currentPage, 6);
const canonicalPath = getPaginationPath("/projects/", currentPage);
---

<BaseLayout
  title={`Projects — Page ${currentPage}`}
  locale="en"
  canonicalPath={canonicalPath}
  pagination={{
    previous: getPaginationPath("/projects/", currentPage - 1),
    next:
      currentPage < page.totalPages
        ? getPaginationPath("/projects/", currentPage + 1)
        : undefined,
  }}
>
  <PageIntro
    title="Projects"
    description={`Project archive, page ${currentPage} of ${page.totalPages}.`}
  />
  <ProjectList entries={page.items} locale="en" />
  <Pagination
    currentPage={currentPage}
    totalPages={page.totalPages}
    basePath="/projects/"
    locale="en"
  />
</BaseLayout>
