---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MotionController from "../components/MotionController.astro";
import type { Locale } from "../config/site";
import { siteConfig } from "../config/site";
import { ui } from "../i18n/ui";
import "../styles/tokens.css";
import "../styles/global.css";
import { getCanonicalUrl } from "../utils/urls";
import { getGitHubProfileUrl } from "../utils/urls";
import { getLocalizedPath, withBase } from "../utils/paths";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  alternatePath?: string;
  canonicalPath?: string;
  noindex?: boolean;
  pageType?: "website" | "article" | "profile";
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = ui[Astro.props.locale].siteDescription,
  locale,
  alternatePath,
  canonicalPath,
  noindex = false,
  pageType = "website",
  structuredData,
} = Astro.props;
const resolvedCanonicalPath = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = getCanonicalUrl(resolvedCanonicalPath);
const fullTitle = `${title} | ${siteConfig.publicName}`;
const targetLocale: Locale = locale === "en" ? "zh" : "en";
const resolvedAlternatePath =
  alternatePath ?? getLocalizedPath(Astro.url.pathname, targetLocale);
const englishPath = locale === "en" ? resolvedCanonicalPath : resolvedAlternatePath;
const chinesePath = locale === "zh" ? resolvedCanonicalPath : resolvedAlternatePath;
const socialImageUrl = getCanonicalUrl(siteConfig.seo.defaultImage);
const ogLocale = locale === "en" ? "en_US" : "zh_CN";
const alternateOgLocale = locale === "en" ? "zh_CN" : "en_US";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteConfig.siteUrl}/#person`,
      name: siteConfig.publicName,
      url: siteConfig.siteUrl,
      description: ui[locale].siteDescription,
      sameAs: [getGitHubProfileUrl()],
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "University of Auckland",
      },
      knowsAbout: [
        "Business analytics",
        "Supply chain analytics",
        "Data analysis",
        "Optimisation",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteConfig.siteUrl}/#website`,
      name: `${siteConfig.publicName} Portfolio`,
      url: siteConfig.siteUrl,
      inLanguage: ["en", "zh-CN"],
      publisher: { "@id": `${siteConfig.siteUrl}/#person` },
    },
    ...(structuredData ? [structuredData] : []),
  ],
};
const serialisedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html
  lang={locale === "en" ? "en" : "zh-CN"}
  data-theme="light"
  data-theme-preference={siteConfig.design.defaultTheme}
  data-theme-storage-key={siteConfig.design.themeStorageKey}
>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const key = root.dataset.themeStorageKey ?? "theme";
        let stored = null;
        try {
          stored = localStorage.getItem(key);
        } catch {
          stored = null;
        }
        const preference = ["light", "dark", "system"].includes(stored ?? "")
          ? stored
          : "system";
        const resolved =
          preference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;

        root.dataset.themePreference = preference;
        root.dataset.theme = resolved;
        root.dataset.js = "true";
        root.style.colorScheme = resolved;
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteConfig.seo.themeColour} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={`${siteConfig.publicName} Portfolio`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content={`${siteConfig.publicName} business analytics portfolio`}
    />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase("/brand/favicon.svg")} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={getCanonicalUrl(englishPath)} />
    <link rel="alternate" hreflang="zh-CN" href={getCanonicalUrl(chinesePath)} />
    <link rel="alternate" hreflang="x-default" href={getCanonicalUrl(englishPath)} />
    <ClientRouter />
    <script is:inline type="application/ld+json" set:html={serialisedJsonLd} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <MotionController />
    <a class="skip-link" href="#main-content">
      {locale === "en" ? "Skip to content" : "跳到主要内容"}
    </a>
    <Header locale={locale} alternatePath={alternatePath} />
    <main id="main-content" class="page-shell">
      <div class="page-container">
        <slot />
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
