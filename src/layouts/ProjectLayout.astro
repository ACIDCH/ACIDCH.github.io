---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  alternatePath?: string;
}

const { entry, alternatePath } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale={entry.data.locale}
  alternatePath={alternatePath}
  noindex={entry.data.isPlaceholder}
>
  <article>
    {entry.data.isPlaceholder && <p class="status">Placeholder / 占位内容</p>}
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    <dl>
      <dt>{entry.data.locale === "en" ? "Status" : "状态"}</dt>
      <dd>{entry.data.status}</dd>
      <dt>{entry.data.locale === "en" ? "Tools" : "工具"}</dt>
      <dd>{entry.data.tools.join(", ") || "—"}</dd>
    </dl>
    <Content />
  </article>
</BaseLayout>
