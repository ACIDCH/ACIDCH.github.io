---
import { getCollection, render, type CollectionEntry } from "astro:content";
import RelatedNotes from "../components/RelatedNotes.astro";
import ProjectCover from "../components/ProjectCover.astro";
import SupplyChainNetwork from "../components/SupplyChainNetwork.astro";
import ContextBack from "../components/ContextBack.astro";
import { getCanonicalUrl } from "../utils/urls";
import { getGitHubRepoUrl } from "../utils/urls";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  alternatePath?: string | null;
}

const { entry, alternatePath } = Astro.props;
const { Content } = await render(entry);
const relatedNotes = (await getCollection("notes")).filter(
  (note) =>
    note.data.locale === entry.data.locale &&
    !note.data.draft &&
    note.data.relatedProjects.includes(entry.data.translationKey),
);
const statusLabels = {
  planned: { en: "Planned", zh: "计划中" },
  "in-development": { en: "In development", zh: "开发中" },
  completed: { en: "Completed", zh: "已完成" },
} as const;
const projectStructuredData = {
  "@type": "CreativeWork",
  "@id": `${getCanonicalUrl(Astro.url.pathname)}#project`,
  name: entry.data.title,
  description: entry.data.summary,
  url: getCanonicalUrl(Astro.url.pathname),
  inLanguage: entry.data.locale === "en" ? "en" : "zh-CN",
  keywords: [...entry.data.tools, ...entry.data.tags],
  isAccessibleForFree: true,
  dateModified: entry.data.updatedAt?.toISOString(),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale={entry.data.locale}
  alternatePath={alternatePath}
  noindex={entry.data.isPlaceholder || entry.data.noindex}
  pageType="article"
  structuredData={projectStructuredData}
>
  <article class="project-detail">
    <ContextBack
      locale={entry.data.locale}
      fallbackPath="/projects/"
      label={{ en: "Back to Projects", zh: "返回项目列表" }}
    />
    <ProjectCover entry={entry} />
    {
      entry.data.isPlaceholder && (
        <p class="status">
          {entry.data.locale === "en"
            ? "Demo / placeholder content"
            : "演示 / 占位内容"}
        </p>
      )
    }
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    {
      entry.data.isDemo && (
        <p class="demo-disclosure">
          {entry.data.locale === "en"
            ? "Demonstration data and interactions on this page are synthetic and do not represent a real project result."
            : "本页的演示数据与交互均为合成内容，不代表真实项目成果。"}
        </p>
      )
    }
    <dl>
      <dt>{entry.data.locale === "en" ? "Status" : "状态"}</dt>
      <dd>{statusLabels[entry.data.status][entry.data.locale]}</dd>
      <dt>{entry.data.locale === "en" ? "Tools" : "工具"}</dt>
      <dd>{entry.data.tools.join(", ") || "—"}</dd>
    </dl>
    {
      (entry.data.repoSlug || entry.data.reportUrl || entry.data.dashboardUrl) && (
        <div class="cluster">
          {entry.data.repoSlug && (
            <a class="button" href={getGitHubRepoUrl(entry.data.repoSlug)}>
              {entry.data.locale === "en" ? "Repository" : "代码仓库"}
            </a>
          )}
          {entry.data.reportUrl && (
            <a class="button button--secondary" href={entry.data.reportUrl}>
              {entry.data.locale === "en" ? "Report" : "报告"}
            </a>
          )}
          {entry.data.dashboardUrl && (
            <a class="button button--secondary" href={entry.data.dashboardUrl}>
              {entry.data.locale === "en" ? "Dashboard" : "仪表板"}
            </a>
          )}
        </div>
      )
    }
    <Content />
    {
      entry.data.topic === "transportation" &&
        entry.data.translationKey !== "geospatial-supply-chain-optimisation" && (
          <SupplyChainNetwork locale={entry.data.locale} />
        )
    }
    <RelatedNotes entries={relatedNotes} locale={entry.data.locale} />
    <ContextBack
      locale={entry.data.locale}
      fallbackPath="/projects/"
      label={{ en: "Back to Projects", zh: "返回项目列表" }}
    />
  </article>
</BaseLayout>
