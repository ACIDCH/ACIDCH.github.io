---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContextBack from "../components/ContextBack.astro";
import NoteList from "../components/NoteList.astro";
import ProjectList from "../components/ProjectList.astro";
import CorrelationLab from "../components/learning/CorrelationLab.astro";
import DescriptiveStatisticsLab from "../components/learning/DescriptiveStatisticsLab.astro";
import ForeignKeyLab from "../components/learning/ForeignKeyLab.astro";
import LearningNoteHero from "../components/learning/LearningNoteHero.astro";
import LearningNoteToc from "../components/learning/LearningNoteToc.astro";
import NormalDistributionLab from "../components/learning/NormalDistributionLab.astro";
import PrimaryKeyLab from "../components/learning/PrimaryKeyLab.astro";
import RegressionLab from "../components/learning/RegressionLab.astro";
import SqlPlayground from "../components/learning/SqlPlayground.astro";
import "../styles/learning-note-editorial.css";
import { getCanonicalUrl } from "../utils/urls";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"notes">;
  alternatePath?: string;
}

const { entry, alternatePath } = Astro.props;
const { Content } = await render(entry);
const isStatisticsHandbook = entry.data.slug === "descriptive-statistics";
const isSqlOverview = entry.data.slug === "sql-relational-data";
const isSqlPrimaryKey = entry.data.slug === "sql-primary-key";
const isSqlForeignKey = entry.data.slug === "sql-foreign-key";
const isSqlEditorial = isSqlOverview || isSqlPrimaryKey || isSqlForeignKey;
const isHandbook = isStatisticsHandbook || isSqlEditorial;

const statisticsToc = [
  {
    id: "描述性统计量",
    label: "描述性统计量",
    children: [
      { id: "数据的集中趋势", label: "数据的集中趋势" },
      { id: "数据的变异性离散性", label: "数据的变异性（离散性）" },
      { id: "计算描述性统计量", label: "计算描述性统计量" },
      { id: "形象化展示", label: "形象化展示" },
    ],
  },
  {
    id: "概率相关内容",
    label: "概率相关内容",
    children: [
      { id: "几个概念", label: "几个概念" },
      { id: "离散概率分布", label: "离散概率分布" },
      { id: "常见的离散概率分布", label: "常见的离散概率分布" },
      { id: "连续概率分布", label: "连续概率分布" },
    ],
  },
  { id: "估计", label: "估计" },
  {
    id: "相关性分析",
    label: "相关性分析",
    children: [
      { id: "正态分布评估", label: "正态分布评估" },
      { id: "相关性可视化展示", label: "相关性可视化" },
      { id: "pearson-相关性检验", label: "Pearson 相关性检验" },
    ],
  },
  {
    id: "单双样本均值分析",
    label: "单双样本均值分析",
    children: [
      { id: "假设检验一般步骤", label: "假设检验一般步骤" },
      { id: "单样本-t-test", label: "单样本 t-test" },
      { id: "单样本-wilcoxon-符号秩检验", label: "单样本 Wilcoxon" },
      { id: "独立双样本-t-test", label: "独立双样本 t-test" },
      { id: "独立双样本-wilcoxon-test", label: "独立 Wilcoxon" },
      { id: "非独立双样本-t-test", label: "配对 t-test" },
      { id: "非独立双样本-wilcoxon-test", label: "配对 Wilcoxon" },
    ],
  },
  {
    id: "多样本均值分析",
    label: "多样本均值分析",
    children: [
      { id: "one-way-anova", label: "one-way ANOVA" },
      { id: "two-way-anova", label: "two-way ANOVA" },
    ],
  },
  {
    id: "比例分析",
    label: "比例分析",
    children: [
      { id: "单比例检验", label: "单比例检验" },
      { id: "双比例检验", label: "双比例检验" },
      { id: "卡方分布", label: "卡方分布" },
    ],
  },
  {
    id: "常用高阶分析方法",
    label: "常用高阶分析方法",
    children: [
      { id: "回归分析", label: "回归分析" },
      { id: "聚类分析", label: "聚类分析" },
      { id: "k-means", label: "k-means" },
      { id: "hierarchical-clustering", label: "Hierarchical Clustering" },
      { id: "主成分分析", label: "主成分分析" },
    ],
  },
  { id: "一条完整的统计学习路径", label: "完整学习路径" },
];

const sqlOverviewToc = [
  { id: "关系数据库为什么不是一个大表", label: "关系数据库与业务实体" },
  { id: "一行到底代表什么", label: "记录粒度" },
  { id: "行列与字段分别在表达什么", label: "行与字段" },
  { id: "字段名称只是开始数据类型同样重要", label: "数据类型" },
  { id: "null-到底表示什么", label: "NULL" },
  { id: "表结构和表中的数据是两件事", label: "Schema 与 Data" },
  { id: "为什么同一个信息不应该到处重复", label: "减少重复信息" },
  { id: "多张表是如何组成一个业务模型的", label: "多表业务模型" },
  { id: "sql-查询为什么依赖正确的数据结构", label: "结构与查询" },
  { id: "建表前可以先问这几个问题", label: "建表检查" },
  { id: "关系模型接下来还缺什么", label: "进入主键" },
];

const sqlPrimaryKeyToc = [
  { id: "一张表为什么需要记录身份", label: "记录身份" },
  { id: "主键首先必须解决唯一性", label: "唯一性" },
  { id: "当前唯一并不等于适合作为主键", label: "唯一 ≠ 稳定" },
  { id: "业务字段与记录身份应该分开", label: "业务字段与身份" },
  { id: "主键为什么会影响表之间的关系", label: "主键与关系" },
  { id: "重复主键会发生什么", label: "约束错误实验" },
  { id: "自增整数最容易理解的主键方案", label: "自增整数" },
  { id: "uuid当记录需要在不同系统中独立生成", label: "UUID" },
  { id: "联合主键一条记录也可以由多个字段共同确定", label: "联合主键" },
  { id: "一个候选字段是否适合做主键可以这样检查", label: "主键检查框架" },
  { id: "在-business-analytics-中主键为什么同样重要", label: "分析中的影响" },
  { id: "常见错误", label: "常见错误" },
  { id: "本篇的核心判断", label: "核心判断" },
  { id: "下一步从身份进入关系", label: "下一步" },
];

const sqlForeignKeyToc = [
  { id: "主键解决是谁外键解决和谁有关", label: "主键与外键" },
  { id: "外键不是因为列名相同才成立", label: "关系来自约束" },
  { id: "父表与子表怎样理解", label: "父表与子表" },
  { id: "什么叫引用完整性", label: "引用完整性" },
  { id: "外键约束如何阻止无效订单", label: "无效引用实验" },
  { id: "为什么必须先有父表记录", label: "写入依赖" },
  { id: "外键列可以重复吗", label: "外键可重复" },
  { id: "外键可以为空吗", label: "NULL 与外键" },
  { id: "逻辑外键与数据库外键约束不是同一件事", label: "逻辑外键与约束" },
  { id: "删除外键约束不等于删除字段", label: "删除约束" },
  { id: "外键为什么会直接影响分析质量", label: "分析质量" },
  { id: "检查外键关系时可以问什么", label: "关系检查" },
  { id: "本篇的核心判断", label: "核心判断" },
  { id: "下一步关系到底是一对多还是多对多", label: "下一步" },
];

const learningToc = isSqlForeignKey
  ? sqlForeignKeyToc
  : isSqlPrimaryKey
    ? sqlPrimaryKeyToc
    : isSqlOverview
      ? sqlOverviewToc
      : statisticsToc;
const handbookTitle = isSqlPrimaryKey || isSqlForeignKey
  ? entry.data.title
  : isSqlOverview
    ? "SQL 与关系数据"
    : "统计学与 R";

const notes = await getCollection("notes");
const projects = await getCollection("projects");
const relatedNotes = notes.filter(
  (note) =>
    note.data.locale === entry.data.locale &&
    !note.data.draft &&
    entry.data.relatedNotes.includes(note.data.translationKey),
);
const relatedProjects = projects.filter(
  (project) =>
    project.data.locale === entry.data.locale &&
    entry.data.relatedProjects.includes(project.data.translationKey),
);
const noteStructuredData = {
  "@type": "Article",
  "@id": `${getCanonicalUrl(Astro.url.pathname)}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  url: getCanonicalUrl(Astro.url.pathname),
  inLanguage: entry.data.locale === "en" ? "en" : "zh-CN",
  keywords: entry.data.tags,
  isAccessibleForFree: true,
  datePublished: entry.data.publishedAt?.toISOString(),
  dateModified: entry.data.updatedAt?.toISOString(),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale={entry.data.locale}
  alternatePath={alternatePath}
  noindex={entry.data.draft || entry.data.isPlaceholder}
  pageType="article"
  structuredData={noteStructuredData}
  fullWidth={isHandbook}
>
  <article class:list={[isHandbook && "learning-note"]}>
    <ContextBack
      locale={entry.data.locale}
      fallbackPath="/notes/"
      label={{ en: "Back to Learning Notes", zh: "返回学习笔记" }}
    />
    {
      entry.data.isPlaceholder && (
        <p class="status">
          {entry.data.locale === "en" ? "Draft placeholder" : "草稿占位内容"}
        </p>
      )
    }
    {
      isHandbook ? (
        <>
          <LearningNoteHero title={handbookTitle} />
          <div class="learning-note__grid">
            <LearningNoteToc items={learningToc} />
            <div class="learning-note__body">
              <Content />
              {
                isStatisticsHandbook && (
                  <>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="statistics-lab"
                    >
                      <DescriptiveStatisticsLab />
                    </div>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="normal-distribution-lab"
                      data-learning-after-heading="连续概率分布"
                    >
                      <NormalDistributionLab />
                    </div>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="correlation-lab"
                      data-learning-after-heading="相关性可视化展示"
                    >
                      <CorrelationLab />
                    </div>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="regression-lab"
                      data-learning-after-heading="回归分析"
                    >
                      <RegressionLab />
                    </div>
                  </>
                )
              }
              {
                isSqlPrimaryKey && (
                  <>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="primary-key-lab"
                    >
                      <PrimaryKeyLab />
                    </div>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="sql-playground"
                    >
                      <SqlPlayground />
                    </div>
                  </>
                )
              }
              {
                isSqlForeignKey && (
                  <>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="foreign-key-lab"
                    >
                      <ForeignKeyLab />
                    </div>
                    <div
                      class="learning-note__inline-block"
                      data-learning-block="sql-playground"
                    >
                      <SqlPlayground />
                    </div>
                  </>
                )
              }
            </div>
          </div>
        </>
      ) : (
        <>
          <h1>{entry.data.title}</h1>
          <p>{entry.data.summary}</p>
          <div class="note-detail__metadata">
            {entry.data.series && <span class="tag">{entry.data.series}</span>}
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            {entry.data.topics.map((topic) => (
              <span class="tag">{topic}</span>
            ))}
            {entry.data.tools.map((tool) => (
              <span class="tag">{tool}</span>
            ))}
          </div>
          <Content />
        </>
      )
    }
    {
      relatedNotes.length > 0 && (
        <section class="related-notes" aria-labelledby="note-related-title">
          <h2 id="note-related-title">
            {entry.data.locale === "en" ? "Related Notes" : "相关笔记"}
          </h2>
          <NoteList entries={relatedNotes} locale={entry.data.locale} />
        </section>
      )
    }
    {
      relatedProjects.length > 0 && (
        <section class="related-notes" aria-labelledby="project-related-title">
          <h2 id="project-related-title">
            {entry.data.locale === "en" ? "Related Projects" : "相关项目"}
          </h2>
          <ProjectList entries={relatedProjects} locale={entry.data.locale} />
        </section>
      )
    }
    <ContextBack
      locale={entry.data.locale}
      fallbackPath="/notes/"
      label={{ en: "Back to Learning Notes", zh: "返回学习笔记" }}
    />
  </article>
</BaseLayout>

<script>
  function removeHandbookPreface() {
    const heading = document.getElementById("写在前面");
    if (!heading) return;
    let node = heading.nextElementSibling;
    while (node && node.tagName !== "H2") {
      const next = node.nextElementSibling;
      node.remove();
      node = next;
    }
    heading.remove();
  }

  function insertAfterSection(block: HTMLElement, headingId: string) {
    const heading = document.getElementById(headingId);
    if (!heading) return false;
    const level = Number(heading.tagName.slice(1));
    let boundary = heading.nextElementSibling;
    while (boundary) {
      if (/^H[1-6]$/.test(boundary.tagName)) {
        const boundaryLevel = Number(boundary.tagName.slice(1));
        if (boundaryLevel <= level) break;
      }
      boundary = boundary.nextElementSibling;
    }
    if (boundary) boundary.before(block);
    else heading.parentElement?.append(block);
    return true;
  }

  function placeLearningBlocks() {
    removeHandbookPreface();
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>("[data-learning-block]"),
    );
    const slots = Array.from(
      document.querySelectorAll<HTMLElement>("[data-learning-slot]"),
    );

    blocks.forEach((block) => {
      const name = block.dataset.learningBlock;
      const slot = slots.find((candidate) => candidate.dataset.learningSlot === name);
      if (name && slot) {
        slot.replaceWith(block);
        block.dataset.learningPlaced = "true";
        return;
      }

      const headingId = block.dataset.learningAfterHeading;
      if (headingId && insertAfterSection(block, headingId)) {
        block.dataset.learningPlaced = "true";
        return;
      }

      block.dataset.learningPlaced = "true";
    });
  }

  document.addEventListener("astro:page-load", placeLearningBlocks);
  placeLearningBlocks();
</script>
