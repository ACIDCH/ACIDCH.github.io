---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContextBack from "../components/ContextBack.astro";
import NoteList from "../components/NoteList.astro";
import DataScienceAdvancedSections from "../components/learning/DataScienceAdvancedSections.astro";
import PredictionThresholdLab from "../components/learning/PredictionThresholdLab.astro";
import ProjectList from "../components/ProjectList.astro";
import LearningNoteHero from "../components/learning/LearningNoteHero.astro";
import LearningNoteToc from "../components/learning/LearningNoteToc.astro";
import "../styles/learning-note-editorial.css";
import { getCanonicalUrl } from "../utils/urls";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"notes">;
  alternatePath?: string;
}

const { entry, alternatePath } = Astro.props;
const { Content, headings } = await render(entry);
const renderedToc = headings
  .filter((heading) => heading.depth === 2 && heading.slug !== "写在前面")
  .map((heading) => ({ id: heading.slug, label: heading.text }));
const advancedToc = entry.data.locale === "zh"
  ? [
      { id: "bayesian-hierarchical", label: "Bayesian 与层次模型补上了哪些信息" },
      { id: "association-treatment-effect", label: "关联、预测和处理效应要分开" },
      { id: "loss-bias-variance", label: "损失函数和偏差—方差决定模型在优化什么" },
      { id: "resampling-selection", label: "特征选择也必须发生在 resampling 里面" },
      { id: "calibration-decision-cost", label: "模型排序能力、概率校准和业务价值是三件事" },
      { id: "model-evidence-checklist", label: "最后检查的是证据链，不是算法数量" },
    ]
  : [];
const referenceIndex = renderedToc.findIndex((item) => item.id === "参考与许可");
const toc = referenceIndex >= 0
  ? [
      ...renderedToc.slice(0, referenceIndex),
      ...advancedToc,
      ...renderedToc.slice(referenceIndex),
    ]
  : [...renderedToc, ...advancedToc];

const notes = await getCollection("notes");
const projects = await getCollection("projects");
const relatedNotes = notes.filter(
  (note) =>
    note.data.locale === entry.data.locale &&
    !note.data.draft &&
    entry.data.relatedNotes.includes(note.data.translationKey),
);
const relatedProjects = projects.filter(
  (project) =>
    project.data.locale === entry.data.locale &&
    entry.data.relatedProjects.includes(project.data.translationKey),
);

const structuredData = {
  "@type": "Article",
  "@id": `${getCanonicalUrl(Astro.url.pathname)}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  url: getCanonicalUrl(Astro.url.pathname),
  inLanguage: entry.data.locale === "en" ? "en" : "zh-CN",
  keywords: entry.data.tags,
  isAccessibleForFree: true,
  datePublished: entry.data.publishedAt?.toISOString(),
  dateModified: entry.data.updatedAt?.toISOString(),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale={entry.data.locale}
  alternatePath={alternatePath}
  noindex={entry.data.draft || entry.data.isPlaceholder}
  pageType="article"
  structuredData={structuredData}
  fullWidth={true}
>
  <article class="learning-note data-science-note">
    <ContextBack
      locale={entry.data.locale}
      fallbackPath="/notes/"
      label={{ en: "Back to Learning Notes", zh: "返回学习笔记" }}
    />
    <LearningNoteHero title={entry.data.title} />
    <div class="learning-note__grid">
      <LearningNoteToc items={toc} />
      <div class="learning-note__body">
        <Content />
        <DataScienceAdvancedSections locale={entry.data.locale} />
        <div class="learning-note__inline-block" data-learning-block="prediction-threshold-lab">
          <PredictionThresholdLab />
        </div>
      </div>
    </div>

    {
      relatedNotes.length > 0 && (
        <section class="related-notes" aria-labelledby="data-science-related-notes-title">
          <h2 id="data-science-related-notes-title">
            {entry.data.locale === "en" ? "Related Notes" : "相关笔记"}
          </h2>
          <NoteList entries={relatedNotes} locale={entry.data.locale} />
        </section>
      )
    }
    {
      relatedProjects.length > 0 && (
        <section class="related-notes" aria-labelledby="data-science-related-projects-title">
          <h2 id="data-science-related-projects-title">
            {entry.data.locale === "en" ? "Related Projects" : "相关项目"}
          </h2>
          <ProjectList entries={relatedProjects} locale={entry.data.locale} />
        </section>
      )
    }
    <ContextBack
      locale={entry.data.locale}
      fallbackPath="/notes/"
      label={{ en: "Back to Learning Notes", zh: "返回学习笔记" }}
    />
  </article>
</BaseLayout>

<script>
  function placeDataScienceBlocks() {
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>(".data-science-note [data-learning-block]"),
    );
    const slots = Array.from(
      document.querySelectorAll<HTMLElement>(".data-science-note [data-learning-slot]"),
    );

    blocks.forEach((block) => {
      const name = block.dataset.learningBlock;
      const slot = slots.find((candidate) => candidate.dataset.learningSlot === name);
      if (name && slot) {
        slot.replaceWith(block);
        block.dataset.learningPlaced = "true";
      }
    });

    const advanced = document.querySelector<HTMLElement>(
      ".data-science-note [data-data-science-advanced]",
    );
    const referenceHeading = document.querySelector<HTMLElement>(
      '.data-science-note h2[id="参考与许可"]',
    );
    if (advanced && referenceHeading && advanced.nextElementSibling !== referenceHeading) {
      referenceHeading.before(advanced);
      advanced.dataset.learningPlaced = "true";
    }
  }

  document.addEventListener("astro:page-load", placeDataScienceBlocks);
  placeDataScienceBlocks();
</script>
