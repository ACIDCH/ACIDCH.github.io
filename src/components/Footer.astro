---
import type { Locale } from "../config/site";
import { navigationItems } from "../config/navigation";
import { sharedUi } from "../i18n/shared-ui";
import { getLocalizedPath } from "../utils/paths";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sharedUi[locale].footer;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <Logo size="sm" />
      <p class="site-footer__statement">{copy.statement}</p>
    </div>
    <nav aria-label={copy.navigation}>
      {
        navigationItems.map((item) => (
          <a href={getLocalizedPath(item.path, locale)}>{item.label[locale]}</a>
        ))
      }
    </nav>
    <p class="site-footer__meta">
      &copy; {new Date().getFullYear()}{" "}
      {copy.copyright}
    </p>
  </div>
</footer>
