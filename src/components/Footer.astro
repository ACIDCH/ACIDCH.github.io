---
import type { Locale } from "../config/site";
import { navigationItems } from "../config/navigation";
import { getLocalizedPath } from "../utils/paths";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <Logo size="sm" />
      <p class="site-footer__statement">
        {
          locale === "en"
            ? "Business analytics and supply chain analytics portfolio."
            : "商业分析与供应链分析作品集。"
        }
      </p>
    </div>
    <nav aria-label={locale === "en" ? "Footer navigation" : "页脚导航"}>
      {
        navigationItems.map((item) => (
          <a href={getLocalizedPath(item.path, locale)}>{item.label[locale]}</a>
        ))
      }
    </nav>
    <p class="site-footer__meta">
      &copy; {new Date().getFullYear()}{" "}
      {locale === "en" ? "Business Analytics Portfolio" : "商业分析作品集"}
    </p>
  </div>
</footer>
