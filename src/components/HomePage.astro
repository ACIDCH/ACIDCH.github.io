---
import { getCollection } from "astro:content";
import { skillGroups } from "../config/skills";
import { siteConfig, type Locale } from "../config/site";
import { sharedUi } from "../i18n/shared-ui";
import { getLocalizedPath } from "../utils/paths";
import { sortProjects } from "../utils/projects";
import Hero from "./hero/Hero.astro";
import NoteList from "./NoteList.astro";
import ProjectList from "./ProjectList.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = sortProjects(
  (await getCollection("projects")).filter(
    (entry) => entry.data.locale === locale && entry.data.featured,
  ),
  locale,
).slice(0, 4);
const notes = (await getCollection("notes"))
  .filter((entry) => entry.data.locale === locale && !entry.data.draft)
  .slice(0, 3);

const copy = sharedUi[locale].home;
---

<Hero locale={locale}>
  <p class="home-hero__discipline">{copy.discipline}</p>
  <h1 id="home-title">
    {siteConfig.siteTitleByLocale[locale]}
  </h1>
  <div class="cluster">
    <a class="button" href={getLocalizedPath("/projects/", locale)}>
      {copy.projectsAction}
    </a>
    <a class="button button--secondary" href={getLocalizedPath("/notes/", locale)}>
      {copy.notesAction}
    </a>
    <a class="button button--ghost-light" href={getLocalizedPath("/about/", locale)}>
      {copy.aboutAction}
    </a>
  </div>
  <a
    class="home-hero__featured-project"
    href={getLocalizedPath("/lab/geospatial-supply-chain/", locale)}
  >
    <span>{copy.interactiveProject}</span>
    <strong>{copy.geospatialProject}</strong>
    <small>{copy.geospatialProjectDescription}</small>
    <span class="home-hero__featured-arrow" aria-hidden="true">→</span>
  </a>
</Hero>

<div class="home-content" id="home-content">
  <section class="home-section" aria-labelledby="projects-title" data-reveal>
    <div class="section-heading section-heading--split">
      <div>
        <p class="status">01</p>
        <h2 id="projects-title">{copy.featured}</h2>
      </div>
    </div>
    <ProjectList entries={projects} locale={locale} />
  </section>

  <section class="home-section" aria-labelledby="notes-title" data-reveal>
    <div class="section-heading section-heading--split">
      <div>
        <p class="status">02</p>
        <h2 id="notes-title">{copy.notes}</h2>
      </div>
    </div>
    <NoteList entries={notes} locale={locale} />
  </section>

  <section class="home-section" aria-labelledby="themes-title" data-reveal>
    <div class="section-heading section-heading--split">
      <div>
        <p class="status">03</p>
        <h2 id="themes-title">{copy.themes}</h2>
      </div>
    </div>
    <ul class="theme-keywords">
      {skillGroups.map((group) => <li>{group.title[locale]}</li>)}
    </ul>
  </section>

  <section class="home-section home-cta" aria-labelledby="cta-title" data-reveal>
    <div>
      <p class="status">04</p>
      <h2 id="cta-title">{copy.cta}</h2>
    </div>
    <a class="button" href={getLocalizedPath("/about/", locale)}>
      {copy.aboutAction}
    </a>
  </section>
</div>

<style>
  .home-hero__featured-project {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.22rem 1rem;
    width: min(39rem, 100%);
    margin-top: var(--space-4);
    padding: 0.9rem 3rem 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 55%, white 25%);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 28%, transparent);
    color: white;
    text-decoration: none;
    backdrop-filter: blur(12px);
    box-shadow: 0 14px 38px rgb(0 0 0 / 0.12);
    transition:
      transform var(--motion-fast),
      border-color var(--motion-fast),
      background var(--motion-fast),
      box-shadow var(--motion-fast);
  }

  .home-hero__featured-project:hover,
  .home-hero__featured-project:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, white 58%, transparent);
    background: color-mix(in srgb, var(--color-surface) 38%, transparent);
    box-shadow: 0 18px 44px rgb(0 0 0 / 0.16);
  }

  .home-hero__featured-project > span:first-child {
    color: color-mix(in srgb, white 78%, transparent);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__featured-project strong,
  .home-hero__featured-project small {
    grid-column: 1;
  }

  .home-hero__featured-project strong {
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.3;
  }

  .home-hero__featured-project small {
    color: color-mix(in srgb, white 84%, transparent);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .home-hero__featured-arrow {
    position: absolute;
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
    font-size: 1.35rem;
  }

  :global(html[data-theme="light"]) .home-hero__featured-project {
    border-color: rgb(22 72 91 / 0.32);
    background: rgb(248 252 253 / 0.92);
    color: #0b3342;
    box-shadow: 0 14px 34px rgb(18 60 76 / 0.16);
  }

  :global(html[data-theme="light"]) .home-hero__featured-project:hover,
  :global(html[data-theme="light"]) .home-hero__featured-project:focus-visible {
    border-color: rgb(16 89 116 / 0.55);
    background: #ffffff;
    box-shadow: 0 18px 42px rgb(18 60 76 / 0.22);
  }

  :global(html[data-theme="light"])
    .home-hero__featured-project
    > span:first-child {
    color: #47707f;
  }

  :global(html[data-theme="light"]) .home-hero__featured-project small {
    color: #496a77;
  }

  :global(html[data-theme="light"]) .home-hero__featured-arrow {
    color: #0e698a;
  }

  @media (max-width: 48rem) {
    .home-hero__featured-project {
      padding-block: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__featured-project {
      transition: none;
    }
  }
</style>
