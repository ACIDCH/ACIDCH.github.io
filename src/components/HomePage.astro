---
import { getCollection } from "astro:content";
import { skillGroups } from "../config/skills";
import type { Locale } from "../config/site";
import { getLocalizedPath } from "../utils/paths";
import Hero from "./hero/Hero.astro";
import NoteList from "./NoteList.astro";
import ProjectList from "./ProjectList.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.locale === locale && entry.data.featured)
  .slice(0, 3);
const notes = (await getCollection("notes"))
  .filter((entry) => entry.data.locale === locale)
  .slice(0, 3);

const copy = {
  en: {
    discipline: "Business Analytics · Supply Chain",
    statement: "Data, models and decisions in context.",
    intro: "I turn analytical questions into clear, practical decision support.",
    projectsAction: "Explore Projects",
    notesAction: "View Learning Notes",
    aboutAction: "About Me",
    featured: "Featured Projects",
    featuredBody:
      "Selected work in progress, clearly labelled by status and evidence level.",
    notes: "Latest Learning Notes",
    notesBody:
      "Bilingual working notes on analytics, optimisation and decision support.",
    themes: "Core Themes",
    themesBody: "The recurring areas that shape this portfolio.",
    cta: "Build decisions on clearer evidence.",
    ctaBody:
      "Explore the work, follow the learning process, or learn more about my approach.",
  },
  zh: {
    discipline: "商业分析 · 供应链",
    statement: "让数据、模型与决策回到真实语境。",
    intro: "我将分析问题转化为清晰、实用的决策支持。",
    projectsAction: "浏览项目",
    notesAction: "查看学习笔记",
    aboutAction: "关于我",
    featured: "精选项目",
    featuredBody: "展示当前重点工作，并明确标注状态与证据程度。",
    notes: "最新学习笔记",
    notesBody: "围绕分析、优化与决策支持整理的中英双语学习记录。",
    themes: "核心方向",
    themesBody: "贯穿本作品集的主要能力与关注领域。",
    cta: "用更清晰的证据支持决策。",
    ctaBody: "浏览项目、了解学习过程，或进一步查看我的工作方式。",
  },
}[locale];
---

<Hero locale={locale}>
  <p class="home-hero__discipline">{copy.discipline}</p>
  <h1 id="home-title">
    {locale === "en" ? "Business Analytics Portfolio" : "商业分析作品集"}
  </h1>
  <p class="home-hero__statement">{copy.statement}</p>
  <p>{copy.intro}</p>
  <div class="cluster">
    <a class="button" href={getLocalizedPath("/projects/", locale)}>
      {copy.projectsAction}
    </a>
    <a class="button button--secondary" href={getLocalizedPath("/notes/", locale)}>
      {copy.notesAction}
    </a>
    <a class="button button--ghost-light" href={getLocalizedPath("/about/", locale)}>
      {copy.aboutAction}
    </a>
  </div>
</Hero>

<div class="home-content" id="home-content">
  <section class="home-section" aria-labelledby="projects-title" data-reveal>
    <div class="section-heading section-heading--split">
      <div>
        <p class="status">01</p>
        <h2 id="projects-title">{copy.featured}</h2>
      </div>
      <p>{copy.featuredBody}</p>
    </div>
    <ProjectList entries={projects} locale={locale} />
  </section>

  <section class="home-section" aria-labelledby="notes-title" data-reveal>
    <div class="section-heading section-heading--split">
      <div>
        <p class="status">02</p>
        <h2 id="notes-title">{copy.notes}</h2>
      </div>
      <p>{copy.notesBody}</p>
    </div>
    <NoteList entries={notes} locale={locale} />
  </section>

  <section class="home-section" aria-labelledby="themes-title" data-reveal>
    <div class="section-heading section-heading--split">
      <div>
        <p class="status">03</p>
        <h2 id="themes-title">{copy.themes}</h2>
      </div>
      <p>{copy.themesBody}</p>
    </div>
    <ul class="theme-keywords">
      {skillGroups.map((group) => <li>{group.title[locale]}</li>)}
    </ul>
  </section>

  <section class="home-section home-cta" aria-labelledby="cta-title" data-reveal>
    <div>
      <p class="status">04</p>
      <h2 id="cta-title">{copy.cta}</h2>
      <p>{copy.ctaBody}</p>
    </div>
    <a class="button" href={getLocalizedPath("/about/", locale)}>
      {copy.aboutAction}
    </a>
  </section>
</div>
