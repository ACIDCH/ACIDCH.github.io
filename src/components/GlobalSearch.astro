---
import { getCollection } from "astro:content";
import type { Locale } from "../config/site";
import { sharedUi } from "../i18n/shared-ui";
import type { SearchItem } from "../utils/search";
import { withBase } from "../utils/paths";
import { deepDives, projectBasePath } from "../data/r-machine-learning";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = (await getCollection("projects")).filter(
  (entry) =>
    entry.data.status === "completed" &&
    !entry.data.isPlaceholder &&
    !entry.data.noindex,
);
const notes = (await getCollection("notes")).filter(
  (entry) =>
    entry.data.status === "published" && !entry.data.draft && !entry.data.isPlaceholder,
);
const locales: Locale[] = ["en", "zh"];
const pages: SearchItem[] = locales.flatMap((pageLocale) =>
  sharedUi[pageLocale].search.pages.map((page) => ({
    ...page,
    locale: pageLocale,
    group: "page" as const,
  })),
);

const index: SearchItem[] = [
  ...pages,
  ...projects.map((entry) => ({
    title: entry.data.title,
    description: entry.data.summary,
    path: `${entry.data.locale === "zh" ? "/zh" : ""}/projects/${entry.data.slug}/`,
    locale: entry.data.locale,
    group: "project" as const,
    searchText: [
      entry.data.title,
      entry.data.summary,
      entry.data.topic,
      entry.data.status,
      ...entry.data.tools,
      ...entry.data.tags,
      "body" in entry ? String(entry.body ?? "") : "",
    ].join(" "),
  })),
  ...deepDives.map((deepDive) => ({
    title: deepDive.titleZh,
    description: deepDive.summary,
    path: `${projectBasePath}${deepDive.slug}/`,
    locale: "zh" as const,
    group: "project" as const,
    searchText: `${deepDive.titleZh} ${deepDive.title} ${deepDive.summary} ${sharedUi.zh.search.deepDiveKeywords}`,
  })),
  ...notes.map((entry) => ({
    title: entry.data.title,
    description: entry.data.summary,
    path: `${entry.data.locale === "zh" ? "/zh" : ""}/notes/${entry.data.slug}/`,
    locale: entry.data.locale,
    group: "note" as const,
    searchText: [
      entry.data.title,
      entry.data.summary,
      ...entry.data.tags,
      ...entry.data.topics,
      ...entry.data.tools,
      entry.data.series ?? "",
      "body" in entry ? String(entry.body ?? "") : "",
    ].join(" "),
  })),
]
  .filter((item) => item.locale === locale)
  .map((item) => ({ ...item, path: withBase(item.path) }));
const serialisedIndex = JSON.stringify(index).replace(/</g, "\\u003c");
const copy = sharedUi[locale].search;
---

<dialog class="global-search" data-global-search>
  <div class="global-search__panel">
    <header>
      <div>
        <p class="status">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
      </div>
      <button
        class="icon-button"
        type="button"
        aria-label={copy.close}
        title={copy.close}
        data-search-close
      >
        <Icon name="close" />
      </button>
    </header>
    <label class="global-search__field">
      <Icon name="search" />
      <span class="visually-hidden">{copy.title}</span>
      <input
        type="search"
        placeholder={copy.placeholder}
        autocomplete="off"
        data-search-input
      />
      <kbd>⌘/Ctrl K</kbd>
    </label>
    <p class="global-search__hint" data-search-status aria-live="polite">
      {copy.hint}
    </p>
    <div
      class="global-search__results"
      data-search-results
      data-empty={copy.empty}
      data-group-page={copy.groups.page}
      data-group-project={copy.groups.project}
      data-group-note={copy.groups.note}
      data-result-label={copy.result}
    >
    </div>
  </div>
  <script
    is:inline
    type="application/json"
    data-search-index
    set:html={serialisedIndex}
  />
</dialog>

<script>
  import { findSearchResults, splitHighlight, type SearchItem } from "../utils/search";

  let activeSearchCleanup: (() => void) | undefined;
  let lockedSearchScrollPosition: number | undefined;

  function lockSearchPage() {
    if (lockedSearchScrollPosition !== undefined) return;
    lockedSearchScrollPosition = window.scrollY;
    document.documentElement.dataset.searchLocked = "true";
    document.body.dataset.searchLocked = "true";
    document.body.style.setProperty(
      "--search-lock-offset",
      `-${lockedSearchScrollPosition}px`,
    );
  }

  function unlockSearchPage(restoreScroll = true) {
    const scrollPosition = lockedSearchScrollPosition;
    lockedSearchScrollPosition = undefined;
    document.documentElement.removeAttribute("data-search-locked");
    document.body.removeAttribute("data-search-locked");
    document.body.style.removeProperty("--search-lock-offset");
    if (restoreScroll && scrollPosition !== undefined) {
      const scrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = "auto";
      window.scrollTo(0, scrollPosition);
      document.documentElement.style.scrollBehavior = scrollBehavior;
    }
  }

  function appendHighlighted(target: HTMLElement, value: string, query: string) {
    splitHighlight(value, query).forEach((segment) => {
      const node = document.createElement(segment.match ? "mark" : "span");
      node.textContent = segment.text;
      target.append(node);
    });
  }

  function initGlobalSearch() {
    activeSearchCleanup?.();
    const dialog = document.querySelector<HTMLDialogElement>("[data-global-search]");
    const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
    const results = dialog?.querySelector<HTMLElement>("[data-search-results]");
    const status = dialog?.querySelector<HTMLElement>("[data-search-status]");
    const indexNode = dialog?.querySelector<HTMLScriptElement>("[data-search-index]");
    if (!dialog || !input || !results || !status || !indexNode) return;

    const controller = new AbortController();
    const { signal } = controller;
    const index = JSON.parse(indexNode.textContent ?? "[]") as SearchItem[];
    const initialStatus = status.textContent ?? "";
    let selected = -1;
    let links: HTMLAnchorElement[] = [];
    let opener: HTMLElement | null = null;

    const select = (next: number) => {
      selected = links.length ? (next + links.length) % links.length : -1;
      links.forEach((link, position) => {
        link.setAttribute("aria-selected", String(position === selected));
      });
      links[selected]?.scrollIntoView({ block: "nearest" });
    };

    const render = () => {
      const query = input.value.trim();
      const matches = findSearchResults(index, query);
      results.replaceChildren();
      selected = -1;
      links = [];
      status.textContent = query
        ? `${matches.length} ${results.dataset.resultLabel ?? ""}`
        : status.textContent;

      if (query && matches.length === 0) {
        const empty = document.createElement("p");
        empty.className = "empty-state";
        empty.textContent = results.dataset.empty ?? "";
        results.append(empty);
        return;
      }

      (["page", "project", "note"] as const).forEach((group) => {
        const groupItems = matches.filter((item) => item.group === group);
        if (!groupItems.length) return;
        const section = document.createElement("section");
        const heading = document.createElement("h3");
        heading.textContent =
          results.dataset[
            `group${group[0]!.toUpperCase()}${group.slice(1)}` as keyof DOMStringMap
          ] ?? group;
        section.append(heading);
        groupItems.forEach((item) => {
          const link = document.createElement("a");
          link.href = item.path;
          link.lang = item.locale === "zh" ? "zh-CN" : "en";
          link.setAttribute("role", "option");
          link.setAttribute("aria-selected", "false");
          const title = document.createElement("strong");
          appendHighlighted(title, item.title, query);
          const description = document.createElement("span");
          appendHighlighted(description, item.description, query);
          link.append(title, description);
          section.append(link);
          links.push(link);
        });
        results.append(section);
      });
    };

    const open = (trigger?: HTMLElement) => {
      opener = trigger ?? (document.activeElement as HTMLElement);
      if (!dialog.open) {
        lockSearchPage();
        dialog.showModal();
      }
      requestAnimationFrame(() => input.focus());
    };

    document.querySelectorAll<HTMLElement>("[data-search-open]").forEach((button) => {
      button.addEventListener("click", () => open(button), { signal });
    });
    dialog
      .querySelector<HTMLElement>("[data-search-close]")
      ?.addEventListener("click", () => dialog.close(), { signal });
    dialog.addEventListener(
      "close",
      () => {
        input.value = "";
        results.replaceChildren();
        status.textContent = initialStatus;
        unlockSearchPage();
        opener?.focus({ preventScroll: true });
      },
      { signal },
    );
    input.addEventListener("input", render, { signal });
    input.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          select(selected + (event.key === "ArrowDown" ? 1 : -1));
        } else if (event.key === "Home" && links.length) {
          event.preventDefault();
          select(0);
        } else if (event.key === "End" && links.length) {
          event.preventDefault();
          select(links.length - 1);
        } else if (event.key === "PageDown" || event.key === "PageUp") {
          event.preventDefault();
          results.scrollBy({
            top: results.clientHeight * (event.key === "PageDown" ? 0.82 : -0.82),
          });
        } else if (event.key === "Enter" && selected >= 0) {
          event.preventDefault();
          links[selected]?.click();
        } else if (event.key === "Escape") {
          event.preventDefault();
          dialog.close();
        }
      },
      { signal },
    );
    results.addEventListener(
      "click",
      (event) => {
        if ((event.target as HTMLElement).closest("a")) dialog.close();
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        const target = event.target as HTMLElement;
        const editable =
          target.matches("input, textarea, select") || target.isContentEditable;
        if (
          (!editable && event.key === "/") ||
          ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")
        ) {
          event.preventDefault();
          open();
        }
      },
      { signal },
    );

    activeSearchCleanup = () => {
      if (dialog.open) dialog.close();
      unlockSearchPage(false);
      controller.abort();
    };
  }

  document.addEventListener("astro:before-swap", () => activeSearchCleanup?.());
  document.addEventListener("astro:page-load", initGlobalSearch);
  initGlobalSearch();
</script>
