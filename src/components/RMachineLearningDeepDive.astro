---
import type { deepDives } from "../data/r-machine-learning";
import RDataValidationDeepDive from "./RDataValidationDeepDive.astro";
import RLogisticInterpretationDeepDive from "./RLogisticInterpretationDeepDive.astro";
import RModelBenchmarkDeepDive from "./RModelBenchmarkDeepDive.astro";
import RModelSelectionDeepDive from "./RModelSelectionDeepDive.astro";
import RNeuralNetworkDeepDive from "./RNeuralNetworkDeepDive.astro";

interface Props {
  deepDive: (typeof deepDives)[number];
}

const { deepDive } = Astro.props;
---

{
  deepDive.slug === "data-validation" ? (
    <RDataValidationDeepDive />
  ) : deepDive.slug === "model-comparison" ? (
    <RModelBenchmarkDeepDive />
  ) : deepDive.slug === "model-selection-error-analysis" ? (
    <RModelSelectionDeepDive />
  ) : deepDive.slug === "logistic-interpretation" ? (
    <RLogisticInterpretationDeepDive />
  ) : (
    <RNeuralNetworkDeepDive />
  )
}
