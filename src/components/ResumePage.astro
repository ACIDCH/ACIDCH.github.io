---
import { timelineEntries } from "../config/experience";
import { profileConfig } from "../config/profile";
import { skillGroups } from "../config/skills";
import type { Locale } from "../config/site";
import PageIntro from "./PageIntro.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  en: {
    title: "Resume",
    intro:
      "A public resume file has not been supplied. This page presents only confirmed, non-sensitive information.",
    education: "Education & experience",
    capabilities: "Capability areas",
    unavailable: "Resume download is unavailable until a verified file is supplied.",
    download: "Download resume",
  },
  zh: {
    title: "简历",
    intro: "尚未提供可公开的简历文件。本页仅展示已确认且不敏感的信息。",
    education: "教育与经历",
    capabilities: "能力领域",
    unavailable: "已核实的简历文件提供前，暂不开放下载。",
    download: "下载简历",
  },
}[locale];
---

<PageIntro title={copy.title} description={copy.intro} />
<section class="content-section" aria-labelledby="resume-background-title">
  <h2 id="resume-background-title">{copy.education}</h2>
  <ul class="resume-list">
    {
      timelineEntries.map((entry) => (
        <li>
          <strong>{entry.title[locale]}</strong>
          <span>{entry.organisation[locale]}</span>
          <span>{entry.period[locale]}</span>
        </li>
      ))
    }
  </ul>
</section>
<section class="content-section" aria-labelledby="resume-capabilities-title">
  <h2 id="resume-capabilities-title">{copy.capabilities}</h2>
  <ul class="tag-list">
    {skillGroups.map((group) => <li class="tag">{group.title[locale]}</li>)}
  </ul>
</section>
{
  profileConfig.resume[locale] ? (
    <a class="button" href={profileConfig.resume[locale]}>
      {copy.download}
    </a>
  ) : (
    <p class="status" aria-live="polite">
      {copy.unavailable}
    </p>
  )
}
