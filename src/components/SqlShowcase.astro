---
interface Props {
  title: string;
  code: string;
  open?: boolean;
}

const { title, code, open = false } = Astro.props;
const escapeHtml = (value: string) =>
  value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const highlighted = escapeHtml(code)
  .replace(/(--[^\n]*)/g, '<span class="sql-comment">$1</span>')
  .replace(/('[^']*')/g, '<span class="sql-string">$1</span>')
  .replace(
    /\b(WITH|AS|SELECT|FROM|JOIN|ON|CROSS|WHERE|GROUP BY|ORDER BY|CASE|WHEN|THEN|ELSE|END|SUM|CAST|DECIMAL|NULLIF|TOP|PERCENT|AND|OR|IN|DATEPART)\b/g,
    '<span class="sql-keyword">$1</span>',
  )
  .replace(
    /\b(FactSales|DimCustomer|DimProduct|DimTerritory|DimPromotion|DimDate)\b/g,
    '<span class="sql-table">$1</span>',
  );
---

<details class="sql-showcase" open={open}>
  <summary>
    <span>{title}</span>
    <span class="sql-showcase__hint">展开 SQL</span>
  </summary>
  <div class="sql-showcase__toolbar">
    <span>T-SQL</span>
    <button
      class="icon-button sql-copy"
      type="button"
      data-copy-sql
      aria-label={`复制${title}`}
    >
      复制
    </button>
  </div>
  <pre tabindex="0"><code set:html={highlighted} /></pre>
</details>

<script>
  const initialiseSqlCopy = () => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-sql]")
      .forEach((button) => {
        if (button.dataset.ready === "true") return;
        button.dataset.ready = "true";
        button.addEventListener("click", async () => {
          const code =
            button.closest(".sql-showcase")?.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = "已复制";
            window.setTimeout(() => (button.textContent = "复制"), 1400);
          } catch {
            button.textContent = "复制失败";
          }
        });
      });
  };

  initialiseSqlCopy();
  document.addEventListener("astro:page-load", initialiseSqlCopy);
</script>

<style>
  .sql-showcase {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: clip;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    background: var(--colour-surface);
  }

  summary,
  .sql-showcase__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  summary {
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
  }

  .sql-showcase__hint,
  .sql-showcase__toolbar {
    color: var(--colour-text-muted);
    font-size: var(--font-size-sm);
  }

  .sql-showcase__toolbar {
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--colour-border);
    border-bottom: 1px solid var(--colour-border);
    background: var(--colour-surface-raised);
  }

  .sql-copy {
    width: auto;
    min-width: 4.6rem;
    padding-inline: var(--space-3);
  }

  pre {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding: var(--space-5);
    overflow-x: auto;
    color: var(--colour-text);
    background: color-mix(
      in srgb,
      var(--colour-surface) 82%,
      var(--colour-navy-950) 18%
    );
    font-size: 0.86rem;
    line-height: 1.65;
    tab-size: 4;
  }

  pre:focus-visible {
    outline: 2px solid var(--colour-accent);
    outline-offset: -3px;
  }

  :global(.sql-keyword) {
    color: var(--colour-accent);
    font-weight: var(--font-weight-bold);
  }

  :global(.sql-string) {
    color: var(--colour-secondary);
  }

  :global(.sql-comment) {
    color: var(--colour-text-muted);
    font-style: italic;
  }

  :global(.sql-table) {
    color: var(--colour-primary);
    font-weight: var(--font-weight-semibold);
  }
</style>
