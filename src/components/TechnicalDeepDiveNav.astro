---
import { deepDives, projectBasePath } from "../data/r-machine-learning";
import { withBase } from "../utils/paths";
import ChurnMicroIcon from "./ChurnMicroIcon.astro";

interface Props {
  current?: string;
}

const { current } = Astro.props;
const iconBySlug = {
  "data-validation": "validation",
  "model-comparison": "compare",
  "model-selection-error-analysis": "error",
  "logistic-interpretation": "interpretation",
  "neural-network": "model",
} as const;
---

{
  !current && (
    <div class="deep-dive-nav__intro">
      <span>DEEP</span>
      <div>
        <p>TECHNICAL DEEP DIVES</p>
        <h2>继续深入分析</h2>
        <small>
          五个专题分别拆解数据验证、模型比较、错误结构、解释路径与关联实验。
        </small>
      </div>
    </div>
  )
}

<nav class="deep-dive-nav" aria-label="Technical Deep Dives">
  <ul>
    {
      deepDives.map((item) => (
        <li>
          <a
            href={withBase(`${projectBasePath}${item.slug}/`)}
            aria-current={current === item.slug ? "page" : undefined}
          >
            <span class="deep-dive-nav__number">
              {item.eyebrow.replace("Technical Deep Dive ", "")}
            </span>
            <span class="deep-dive-nav__icon" aria-hidden="true">
              <ChurnMicroIcon
                name={iconBySlug[item.slug as keyof typeof iconBySlug] ?? "deep-dive"}
              />
            </span>
            <strong>
              {item.titleZh}
              <em>{item.title}</em>
            </strong>
            <small>{item.summary}</small>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  :global(.chapter--deep-dives > .chapter-heading),
  :global(.chapter--deep-dives > .deep-dive-intro) {
    display: none;
  }

  .deep-dive-nav__intro {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin-bottom: clamp(1.4rem, 3vw, 2.4rem);
  }

  .deep-dive-nav__intro > span {
    color: var(--colour-primary-strong);
    font: 700 0.9rem/1 var(--font-mono);
  }

  .deep-dive-nav__intro p,
  .deep-dive-nav__intro h2,
  .deep-dive-nav__intro small {
    margin: 0;
  }

  .deep-dive-nav__intro p {
    color: var(--colour-accent);
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .deep-dive-nav__intro h2 {
    max-width: 18ch;
    margin-top: 0.55rem;
    font-size: clamp(2rem, 5vw, 4.15rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .deep-dive-nav__intro small {
    display: block;
    max-width: 46rem;
    margin-top: 0.75rem;
    color: var(--colour-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .deep-dive-nav ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--colour-border);
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 3rem 2.6rem minmax(12rem, 0.55fr) minmax(0, 1fr) auto;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    height: 100%;
    padding: var(--space-5) var(--space-2);
    border-bottom: 1px solid var(--colour-border);
    color: var(--colour-text);
    text-decoration: none;
    transition:
      padding-inline var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  a::after {
    content: "↗";
    color: var(--colour-accent);
    font-size: 1.1rem;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  a:hover,
  a[aria-current="page"] {
    padding-inline: var(--space-4);
    border-bottom-color: var(--colour-border-strong);
    background: color-mix(in srgb, var(--colour-primary) 6%, transparent);
  }

  a:hover::after {
    transform: translate(0.12rem, -0.12rem);
  }

  a[aria-current="page"] {
    box-shadow: inset 3px 0 0 var(--colour-primary);
  }

  .deep-dive-nav__number {
    color: var(--colour-primary-strong);
    font-family: var(--font-family-mono);
    font-weight: 700;
  }

  .deep-dive-nav__icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--colour-border);
    border-radius: 0.78rem;
    background: color-mix(in srgb, var(--colour-surface) 88%, transparent);
    color: var(--colour-primary-strong);
    transition:
      transform var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  a:hover .deep-dive-nav__icon,
  a[aria-current="page"] .deep-dive-nav__icon {
    border-color: color-mix(in srgb, var(--colour-primary) 42%, var(--colour-border));
    background: color-mix(in srgb, var(--colour-primary) 9%, var(--colour-surface));
    transform: translateY(-1px);
  }

  strong {
    display: grid;
    gap: var(--space-1);
  }

  strong em {
    color: var(--colour-text-muted);
    font: normal 0.72rem/1.3 var(--font-family-mono);
  }

  small {
    color: var(--colour-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 58rem) {
    a {
      grid-template-columns: 2.6rem 2.35rem minmax(0, 1fr) auto;
    }

    small {
      grid-column: 3 / -1;
    }
  }

  @media (max-width: 44rem) {
    .deep-dive-nav__intro {
      grid-template-columns: 2.8rem minmax(0, 1fr);
    }

    a {
      grid-template-columns: 2.1rem 2.2rem minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-4);
    }

    .deep-dive-nav__icon {
      width: 2rem;
      height: 2rem;
      border-radius: 0.68rem;
    }

    small {
      grid-column: 3 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    a::after,
    .deep-dive-nav__icon {
      transition: none;
      transform: none !important;
    }

    a:hover,
    a[aria-current="page"] {
      padding-inline: var(--space-2);
    }
  }
</style>
