---
import { deepDives, projectBasePath } from "../data/r-machine-learning";
import { withBase } from "../utils/paths";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<nav class="deep-dive-nav" aria-label="Technical Deep Dives">
  <ul>
    {
      deepDives.map((item) => (
        <li>
          <a
            href={withBase(`${projectBasePath}${item.slug}/`)}
            aria-current={current === item.slug ? "page" : undefined}
          >
            <span>{item.eyebrow.replace("Technical Deep Dive ", "")}</span>
            <strong>{item.title}</strong>
            <small>{item.summary}</small>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .deep-dive-nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-3);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    color: var(--colour-text);
    background: var(--colour-surface);
    text-decoration: none;
  }

  a:hover,
  a[aria-current="page"] {
    border-color: var(--colour-primary);
    background: color-mix(in srgb, var(--colour-primary) 7%, var(--colour-surface));
    transform: translateY(-2px);
  }

  a[aria-current="page"] {
    box-shadow: inset 3px 0 0 var(--colour-primary);
  }

  span {
    grid-row: 1 / 3;
    color: var(--colour-primary-strong);
    font-family: var(--font-family-mono);
    font-weight: 700;
  }

  small {
    color: var(--colour-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 44rem) {
    .deep-dive-nav ul {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a:hover,
    a[aria-current="page"] {
      transform: none;
    }
  }
</style>
