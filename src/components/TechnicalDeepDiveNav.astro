---
import { deepDives, projectBasePath } from "../data/r-machine-learning";
import { withBase } from "../utils/paths";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<nav class="deep-dive-nav" aria-label="Technical Deep Dives">
  <ul>
    {
      deepDives.map((item) => (
        <li>
          <a
            href={withBase(`${projectBasePath}${item.slug}/`)}
            aria-current={current === item.slug ? "page" : undefined}
          >
            <span>{item.eyebrow.replace("Technical Deep Dive ", "")}</span>
            <strong>{item.title}</strong>
            <small>{item.summary}</small>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .deep-dive-nav ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--colour-border);
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 3rem minmax(12rem, 0.55fr) minmax(0, 1fr) auto;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    height: 100%;
    padding: var(--space-5) var(--space-2);
    border-bottom: 1px solid var(--colour-border);
    color: var(--colour-text);
    text-decoration: none;
  }

  a::after {
    content: "↗";
    color: var(--colour-accent);
    font-size: 1.1rem;
  }

  a:hover,
  a[aria-current="page"] {
    padding-inline: var(--space-4);
    background: color-mix(in srgb, var(--colour-primary) 6%, transparent);
  }

  a[aria-current="page"] {
    box-shadow: inset 3px 0 0 var(--colour-primary);
  }

  span {
    color: var(--colour-primary-strong);
    font-family: var(--font-family-mono);
    font-weight: 700;
  }

  small {
    color: var(--colour-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 44rem) {
    .deep-dive-nav ul {
      display: grid;
    }

    a {
      grid-template-columns: 2.2rem minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
    }

    small {
      grid-column: 2 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a:hover,
    a[aria-current="page"] {
      padding-inline: var(--space-2);
    }
  }
</style>
