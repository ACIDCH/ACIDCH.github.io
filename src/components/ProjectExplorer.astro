---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import ProjectList from "./ProjectList.astro";

interface Props {
  entries: CollectionEntry<"projects">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const tools = [...new Set(entries.flatMap((entry) => entry.data.tools))].sort();
const copy = {
  en: {
    filters: "Filter projects",
    tool: "Tool",
    topic: "Topic",
    status: "Status",
    all: "All",
    inventory: "Inventory",
    transportation: "Transportation",
    analytics: "Analytics",
    planned: "Planned",
    development: "In development",
    completed: "Completed",
    reset: "Reset filters",
    count: "projects shown",
    empty: "No projects match these filters.",
  },
  zh: {
    filters: "筛选项目",
    tool: "工具",
    topic: "主题",
    status: "状态",
    all: "全部",
    inventory: "库存",
    transportation: "运输",
    analytics: "分析",
    planned: "计划中",
    development: "开发中",
    completed: "已完成",
    reset: "重置筛选",
    count: "个项目",
    empty: "没有符合当前筛选条件的项目。",
  },
}[locale];
---

<section class="project-explorer" data-project-explorer data-result-suffix={copy.count}>
  <form class="filter-bar" aria-label={copy.filters} data-project-filters>
    <label>
      <span>{copy.tool}</span>
      <select name="tool">
        <option value="">{copy.all}</option>
        {tools.map((tool) => <option value={tool}>{tool}</option>)}
      </select>
    </label>
    <label>
      <span>{copy.topic}</span>
      <select name="topic">
        <option value="">{copy.all}</option>
        <option value="inventory">{copy.inventory}</option>
        <option value="transportation">{copy.transportation}</option>
        <option value="analytics">{copy.analytics}</option>
      </select>
    </label>
    <label>
      <span>{copy.status}</span>
      <select name="status">
        <option value="">{copy.all}</option>
        <option value="planned">{copy.planned}</option>
        <option value="in-development">{copy.development}</option>
        <option value="completed">{copy.completed}</option>
      </select>
    </label>
    <button class="button button--secondary" type="reset">{copy.reset}</button>
  </form>
  <p class="filter-result" aria-live="polite" data-project-count></p>
  <ProjectList entries={entries} locale={locale} />
  <p class="empty-state" data-project-empty hidden>{copy.empty}</p>
</section>

<script>
  import { matchesProjectFilters } from "../utils/projects";

  function initProjectExplorer() {
    const explorer = document.querySelector<HTMLElement>("[data-project-explorer]");
    const form = explorer?.querySelector<HTMLFormElement>("[data-project-filters]");
    if (!explorer || !form || explorer.dataset.explorerReady === "true") return;
    explorer.dataset.explorerReady = "true";
    const cards = [...explorer.querySelectorAll<HTMLElement>("[data-project-card]")];
    const result = explorer.querySelector<HTMLElement>("[data-project-count]");
    const empty = explorer.querySelector<HTMLElement>("[data-project-empty]");
    const filterNames = ["tool", "topic", "status"] as const;

    function readFilters() {
      const data = new FormData(form!);
      return Object.fromEntries(
        filterNames
          .map((name) => [name, String(data.get(name) ?? "")])
          .filter(([, value]) => value),
      );
    }

    function applyFilters(updateUrl = true) {
      if (!result || !empty) return;
      const filters = readFilters();
      let visible = 0;

      cards.forEach((card) => {
        const matches = matchesProjectFilters(
          {
            tools: (card.dataset.projectTools ?? "").split("|").filter(Boolean),
            topic: card.dataset.projectTopic ?? "",
            status: card.dataset.projectStatus ?? "",
          },
          filters,
        );
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      result.textContent = `${visible} ${explorer!.dataset.resultSuffix ?? ""}`;
      empty.hidden = visible !== 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        filterNames.forEach((name) => {
          const value = filters[name];
          if (value) url.searchParams.set(name, value);
          else url.searchParams.delete(name);
        });
        window.history.replaceState({}, "", url);
      }
    }

    const parameters = new URLSearchParams(window.location.search);
    filterNames.forEach((name) => {
      const field = form.elements.namedItem(name);
      if (field instanceof HTMLSelectElement) {
        const requested = parameters.get(name) ?? "";
        field.value = [...field.options].some((option) => option.value === requested)
          ? requested
          : "";
      }
    });

    form.addEventListener("change", () => applyFilters());
    form.addEventListener("reset", () => {
      requestAnimationFrame(() => applyFilters());
    });
    applyFilters(false);
  }

  document.addEventListener("astro:page-load", initProjectExplorer);
  initProjectExplorer();
</script>
