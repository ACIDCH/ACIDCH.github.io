---
export type IconName =
  | "home"
  | "projects"
  | "notes"
  | "about"
  | "back"
  | "tag"
  | "topic"
  | "tool"
  | "calendar"
  | "search"
  | "menu"
  | "close"
  | "github"
  | "linkedin"
  | "email"
  | "wechat"
  | "resume"
  | "download"
  | "external"
  | "language"
  | "theme"
  | "sun"
  | "moon"
  | "system";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  class="ui-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "home" && <path d="m3 11 9-8 9 8v9H6v-9m4 9v-6h4v6" />}
  {name === "projects" && <path d="M4 7h16v13H4zM8 7V4h8v3" />}
  {name === "notes" && <path d="M5 3h11l3 3v15H5zm11 0v4h4M8 11h8M8 15h8" />}
  {
    name === "about" && (
      <>
        <circle cx="12" cy="8" r="3" />
        <path d="M5.5 21c.5-5 2.7-7.5 6.5-7.5s6 2.5 6.5 7.5" />
      </>
    )
  }
  {name === "back" && <path d="m15 18-6-6 6-6M9 12h11" />}
  {
    name === "tag" && (
      <>
        <path d="M3 12V4h8l10 10-7 7z" />
        <circle cx="8" cy="8" r="1" />
      </>
    )
  }
  {name === "topic" && <path d="M4 6h16M4 12h11M4 18h8" />}
  {name === "tool" && <path d="m14 6 4-3 3 3-3 4M4 20l9-9m-7-1-3-3 4-4 3 3" />}
  {
    name === "calendar" && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M8 3v4m8-4v4M3 10h18" />
      </>
    )
  }
  {name === "search" && <path d="m20 20-4.5-4.5m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="m5 5 14 14M19 5 5 19" />}
  {
    name === "github" && (
      <path d="M12 2.8a9.4 9.4 0 0 0-3 18.3c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.7-1.3-2.3-.3-4.7-1.1-4.7-5a4 4 0 0 1 1-2.7 3.7 3.7 0 0 1 .1-2.7s.9-.3 3 1a10.6 10.6 0 0 1 5.5 0c2.1-1.3 3-1 3-1 .6 1.5.2 2.5.1 2.7a4 4 0 0 1 1 2.7c0 3.9-2.4 4.7-4.7 5 .4.3.7 1 .7 1.9v2.8c0 .4.2.6.7.5A9.4 9.4 0 0 0 12 2.8Z" />
    )
  }
  {
    name === "linkedin" && (
      <>
        <path d="M6 9v11M6 5.5v.1M10.5 20V9m0 4.5c1-3 7.5-3.7 7.5 2V20" />
      </>
    )
  }
  {
    name === "email" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === "wechat" && (
      <>
        <path d="M13 15c-1.2.7-2.7 1-4.2 1l-3.3 2 .8-3.1C4.3 13.8 3 12 3 10c0-3.3 3.5-6 7.8-6s7.7 2.7 7.7 6v.8" />
        <path d="M21 15.3c0 2.6-2.8 4.7-6.3 4.7-.9 0-1.8-.2-2.6-.4L9.5 21l.7-2.4c-1.1-.9-1.8-2-1.8-3.3 0-2.6 2.8-4.7 6.3-4.7s6.3 2.1 6.3 4.7Z" />
      </>
    )
  }
  {name === "resume" && <path d="M6 3h9l3 3v15H6zm9 0v4h4M9 11h6M9 15h6" />}
  {name === "download" && <path d="M12 3v12m-4-4 4 4 4-4M5 20h14" />}
  {name === "external" && <path d="M14 4h6v6m0-6-9 9M19 14v6H4V5h6" />}
  {
    name === "language" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" />
      </>
    )
  }
  {name === "theme" && <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" />}
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="3.5" />
        <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {name === "moon" && <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" />}
  {
    name === "system" && (
      <>
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M8 21h8m-4-4v4" />
      </>
    )
  }
</svg>
