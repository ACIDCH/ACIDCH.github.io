---
import { withBase } from "../utils/paths";
---

<span class="whatsapp-control" data-whatsapp-control data-open="false">
  <button
    class="social-icon-button"
    type="button"
    aria-label="WhatsApp"
    aria-expanded="false"
    data-whatsapp-trigger
  >
    <svg
      class="ui-icon"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.3L4 20l1-3.7a8.4 8.4 0 1 1 15.4-4.6Z" />
      <path d="M9 8.2c.3-.7.6-.7 1-.7h.4c.2 0 .4.1.5.4l.8 2c.1.3.1.5-.1.7l-.6.8c-.2.2-.2.4 0 .7.5.9 1.3 1.7 2.2 2.2.3.2.5.2.7 0l.8-1c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.5 0 .4-.2 1.2-.6 1.7-.5.6-1.3.9-2.1.8-1.2-.2-2.8-.8-4.6-2.3-1.5-1.3-2.5-2.9-2.8-4-.3-.9.1-1.8.3-2.3Z" />
    </svg>
    <span>WhatsApp</span>
  </button>
  <span class="whatsapp-qr-popover" data-whatsapp-popover>
    <img
      src={withBase("/contact/whatsapp-qr.svg")}
      width="900"
      height="900"
      alt="WhatsApp QR code"
      loading="lazy"
      decoding="async"
    />
  </span>
</span>

<script>
  function closeWhatsappPopovers() {
    document
      .querySelectorAll<HTMLElement>('[data-whatsapp-control][data-open="true"]')
      .forEach((control) => {
        control.dataset.open = "false";
        control
          .querySelector<HTMLButtonElement>("[data-whatsapp-trigger]")
          ?.setAttribute("aria-expanded", "false");
      });
  }

  function initWhatsappPopover() {
    document
      .querySelectorAll<HTMLElement>("[data-whatsapp-control]")
      .forEach((control) => {
        const trigger = control.querySelector<HTMLButtonElement>(
          "[data-whatsapp-trigger]",
        );
        if (!trigger || control.dataset.ready === "true") return;

        control.dataset.ready = "true";
        trigger.addEventListener("click", (event) => {
          const coarsePointer = window.matchMedia(
            "(hover: none), (pointer: coarse)",
          ).matches;
          if (!coarsePointer) return;

          event.preventDefault();
          const nextOpen = control.dataset.open !== "true";
          closeWhatsappPopovers();
          control.dataset.open = nextOpen ? "true" : "false";
          trigger.setAttribute("aria-expanded", String(nextOpen));
        });
      });

    if (document.documentElement.dataset.whatsappPopoverBound === "true") return;
    document.documentElement.dataset.whatsappPopoverBound = "true";

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if ((target as Element).closest?.("[data-whatsapp-control]")) return;
      closeWhatsappPopovers();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeWhatsappPopovers();
    });
  }

  document.addEventListener("astro:page-load", initWhatsappPopover);
  initWhatsappPopover();
</script>

<style>
  .whatsapp-control {
    position: relative;
    display: inline-flex;
  }

  .whatsapp-qr-popover {
    position: absolute;
    z-index: 80;
    bottom: calc(100% + 0.75rem);
    left: 50%;
    width: min(19rem, calc(100vw - 2rem));
    padding: 0.3rem;
    border: 1px solid var(--colour-border);
    border-radius: 1rem;
    background: #fff;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 0.4rem) scale(0.98);
    transform-origin: bottom center;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      visibility var(--duration-fast) var(--ease-standard);
  }

  .whatsapp-qr-popover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.8rem;
    background: #fff;
  }

  @media (hover: hover) and (pointer: fine) {
    .whatsapp-control:hover .whatsapp-qr-popover,
    .whatsapp-control:focus-within .whatsapp-qr-popover {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0) scale(1);
    }
  }

  .whatsapp-control[data-open="true"] .whatsapp-qr-popover {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0) scale(1);
  }

  @media (hover: none), (pointer: coarse) {
    .whatsapp-qr-popover {
      position: fixed;
      top: 50%;
      right: auto;
      bottom: auto;
      left: 50%;
      width: min(21rem, calc(100vw - 2rem));
      transform: translate(-50%, calc(-50% + 0.4rem)) scale(0.98);
      transform-origin: center;
    }

    .whatsapp-control[data-open="true"] .whatsapp-qr-popover {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-qr-popover {
      transition: none;
    }
  }
</style>
