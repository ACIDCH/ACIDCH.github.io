---
import type { Locale } from "../../config/site";
import { learningLabUi } from "../../i18n/learning-ui";

interface Props {
  locale?: Locale;
}

const { locale = "zh" } = Astro.props;
const copy = learningLabUi[locale].normalDistribution;
---

<section
  class="learning-visual-lab"
  data-normal-lab
  data-copy={JSON.stringify(copy)}
  aria-labelledby="normal-lab-title"
>
  <div class="learning-visual-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="normal-lab-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="learning-visual-lab__controls" aria-label={copy.controlsLabel}>
    <label>
      <span>{copy.mean}{" "}<output data-normal-mean-output>20</output></span>
      <input data-normal-mean type="range" min="0" max="40" value="20" step="1" />
    </label>
    <label>
      <span>{copy.standardDeviation}{" "}<output data-normal-sd-output>6</output></span>
      <input data-normal-sd type="range" min="2" max="14" value="6" step="1" />
    </label>
    <label>
      <span>{copy.threshold}{" "}<output data-normal-threshold-output>25</output></span>
      <input data-normal-threshold type="range" min="0" max="60" value="25" step="1" />
    </label>
  </div>

  <div class="learning-visual-lab__metric" aria-live="polite">
    <span>P(X ≤ x)</span>
    <strong data-normal-probability>79.8%</strong>
    <small data-normal-reading>{copy.initialReading}</small>
  </div>

  <figure class="learning-visual-lab__figure">
    <svg viewBox="0 0 760 340" role="img" aria-label={copy.chartLabel} data-normal-svg
    ></svg>
    <figcaption>{copy.caption}</figcaption>
  </figure>
</section>

<style>
  .learning-visual-lab {
    margin: var(--space-12) 0;
    padding: var(--space-7) 0 var(--space-8);
    border-top: 1px solid var(--colour-border-strong);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .learning-visual-lab__intro {
    max-width: 58rem;
  }

  .learning-visual-lab__intro h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.35rem, 1.5vw, 1.8rem);
    line-height: 1.35;
  }

  .learning-visual-lab__intro p:last-child,
  .learning-visual-lab__figure figcaption,
  .learning-visual-lab__metric small {
    color: var(--colour-text-muted);
  }

  .learning-visual-lab__controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .learning-visual-lab__controls label {
    display: grid;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .learning-visual-lab__controls input[type="range"] {
    width: 100%;
  }

  .learning-visual-lab__metric {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-7) 0 var(--space-4);
  }

  .learning-visual-lab__metric span {
    color: var(--colour-text-muted);
    font-size: var(--font-size-sm);
  }

  .learning-visual-lab__metric strong {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-variant-numeric: tabular-nums;
  }

  .learning-visual-lab__metric small {
    line-height: 1.7;
  }

  .learning-visual-lab__figure {
    margin: 0;
  }

  .learning-visual-lab__figure svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--colour-text-muted);
  }

  .learning-visual-lab__figure figcaption {
    max-width: 58rem;
    margin-top: var(--space-3);
    font-size: var(--font-size-sm);
    line-height: 1.75;
  }

  @media (max-width: 52rem) {
    .learning-visual-lab__controls {
      grid-template-columns: 1fr;
    }

    .learning-visual-lab__metric {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

<script>
  let normalLabCleanup: (() => void) | undefined;

  function initNormalDistributionLab() {
    normalLabCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-normal-lab]");
    if (!root) return;
    const copy = JSON.parse(root.dataset.copy ?? "{}") as Record<string, string>;

    const meanInput = root.querySelector<HTMLInputElement>("[data-normal-mean]");
    const sdInput = root.querySelector<HTMLInputElement>("[data-normal-sd]");
    const thresholdInput = root.querySelector<HTMLInputElement>(
      "[data-normal-threshold]",
    );
    const meanOutput = root.querySelector<HTMLOutputElement>(
      "[data-normal-mean-output]",
    );
    const sdOutput = root.querySelector<HTMLOutputElement>("[data-normal-sd-output]");
    const thresholdOutput = root.querySelector<HTMLOutputElement>(
      "[data-normal-threshold-output]",
    );
    const probabilityOutput = root.querySelector<HTMLElement>(
      "[data-normal-probability]",
    );
    const reading = root.querySelector<HTMLElement>("[data-normal-reading]");
    const svg = root.querySelector<SVGSVGElement>("[data-normal-svg]");
    if (
      !meanInput ||
      !sdInput ||
      !thresholdInput ||
      !meanOutput ||
      !sdOutput ||
      !thresholdOutput ||
      !probabilityOutput ||
      !reading ||
      !svg
    )
      return;

    const controller = new AbortController();
    const ns = "http://www.w3.org/2000/svg";
    const make = (tag: string, attrs: Record<string, string | number>) => {
      const node = document.createElementNS(ns, tag);
      Object.entries(attrs).forEach(([key, value]) =>
        node.setAttribute(key, String(value)),
      );
      svg.append(node);
      return node;
    };
    const erf = (x: number) => {
      const sign = x < 0 ? -1 : 1;
      const value = Math.abs(x);
      const t = 1 / (1 + 0.3275911 * value);
      const y =
        1 -
        ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t +
          0.254829592) *
          t *
          Math.exp(-value * value);
      return sign * y;
    };
    const cdf = (x: number, mean: number, sd: number) =>
      0.5 * (1 + erf((x - mean) / (sd * Math.SQRT2)));
    const pdf = (x: number, mean: number, sd: number) =>
      Math.exp(-0.5 * ((x - mean) / sd) ** 2) / (sd * Math.sqrt(2 * Math.PI));

    const draw = () => {
      const mean = Number(meanInput.value);
      const sd = Number(sdInput.value);
      const threshold = Number(thresholdInput.value);
      const probability = cdf(threshold, mean, sd);
      meanOutput.value = String(mean);
      sdOutput.value = String(sd);
      thresholdOutput.value = String(threshold);
      probabilityOutput.textContent = `${(probability * 100).toFixed(1)}%`;
      reading.textContent =
        threshold === mean
          ? copy.equalReading
          : threshold > mean
            ? copy.aboveReading
            : copy.belowReading;

      svg.replaceChildren();
      const left = 54;
      const right = 728;
      const top = 24;
      const bottom = 286;
      const domainMin = Math.max(-10, mean - 4.5 * sd);
      const domainMax = Math.min(70, mean + 4.5 * sd);
      const maxDensity = pdf(mean, mean, sd);
      const xScale = (x: number) =>
        left + ((x - domainMin) / (domainMax - domainMin)) * (right - left);
      const yScale = (y: number) => bottom - (y / maxDensity) * (bottom - top - 18);

      make("line", {
        x1: left,
        y1: bottom,
        x2: right,
        y2: bottom,
        stroke: "var(--colour-border-strong)",
      });
      const points: string[] = [];
      const shade: string[] = [`${xScale(domainMin)},${bottom}`];
      for (let index = 0; index <= 180; index += 1) {
        const x = domainMin + (index / 180) * (domainMax - domainMin);
        const y = pdf(x, mean, sd);
        points.push(`${xScale(x)},${yScale(y)}`);
        if (x <= threshold) shade.push(`${xScale(x)},${yScale(y)}`);
      }
      shade.push(`${xScale(Math.min(threshold, domainMax))},${bottom}`);
      make("polygon", {
        points: shade.join(" "),
        fill: "var(--colour-primary)",
        opacity: 0.14,
      });
      make("polyline", {
        points: points.join(" "),
        fill: "none",
        stroke: "var(--colour-primary)",
        "stroke-width": 3,
      });
      make("line", {
        x1: xScale(mean),
        y1: top + 18,
        x2: xScale(mean),
        y2: bottom,
        stroke: "var(--colour-border-strong)",
        "stroke-dasharray": "6 6",
      });
      if (threshold >= domainMin && threshold <= domainMax) {
        make("line", {
          x1: xScale(threshold),
          y1: top + 18,
          x2: xScale(threshold),
          y2: bottom,
          stroke: "var(--colour-primary-strong)",
          "stroke-width": 2,
        });
      }
      [domainMin, mean - sd, mean, mean + sd, domainMax].forEach((tick) => {
        const text = make("text", {
          x: xScale(tick),
          y: 314,
          fill: "currentColor",
          "font-size": 12,
          "text-anchor": "middle",
        });
        text.textContent = Number.isInteger(tick) ? String(tick) : tick.toFixed(1);
      });
      const label = make("text", {
        x: 390,
        y: 334,
        fill: "currentColor",
        "font-size": 12,
        "text-anchor": "middle",
      });
      label.textContent = copy.xAxis;
    };

    [meanInput, sdInput, thresholdInput].forEach((input) =>
      input.addEventListener("input", draw, { signal: controller.signal }),
    );
    draw();
    normalLabCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => normalLabCleanup?.());
  document.addEventListener("astro:page-load", initNormalDistributionLab);
  initNormalDistributionLab();
</script>
