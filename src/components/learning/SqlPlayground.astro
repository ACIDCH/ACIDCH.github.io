<section class="sql-playground" data-sql-playground aria-labelledby="sql-playground-title">
  <div class="sql-playground__intro">
    <p class="learning-note-kicker">浏览器实验 · SQLite</p>
    <h3 id="sql-playground-title">直接修改 SQL，再运行同一组客户与订单数据</h3>
    <p>
      数据库只存在于当前浏览器内存中。点击运行后会按需加载 SQLite，不会在普通页面打开时提前启动运行环境。
    </p>
  </div>

  <div class="sql-playground__toolbar">
    <label for="sql-playground-preset">
      <span>示例</span>
      <select id="sql-playground-preset" data-sql-preset>
        <option value="join">连接客户与订单</option>
        <option value="customers">查看客户表</option>
        <option value="aggregate">按客户汇总订单</option>
        <option value="duplicate">测试重复主键</option>
        <option value="foreign-key">测试无效外键</option>
      </select>
    </label>
    <div class="sql-playground__actions">
      <button type="button" class="button" data-sql-run>运行 SQL</button>
      <button type="button" class="button button--secondary" data-sql-reset>重置数据库</button>
    </div>
  </div>

  <label class="sql-playground__editor" for="sql-playground-code">
    <span>SQL</span>
    <textarea id="sql-playground-code" data-sql-code rows="9" spellcheck="false"></textarea>
  </label>

  <div class="sql-playground__status" aria-live="polite" data-sql-status>
    运行环境尚未加载。
  </div>

  <div class="sql-playground__output" data-sql-output aria-live="polite">
    <p>运行查询后，结果表会显示在这里。</p>
  </div>
</section>

<style>
  .sql-playground {
    margin: var(--space-12) 0;
    padding: var(--space-7) 0 var(--space-8);
    border-top: 1px solid var(--colour-border-strong);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .sql-playground__intro {
    max-width: 58rem;
  }

  .sql-playground__intro h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.35rem, 1.5vw, 1.8rem);
    line-height: 1.35;
  }

  .sql-playground__intro p:last-child,
  .sql-playground__status,
  .sql-playground__output > p {
    color: var(--colour-text-muted);
  }

  .sql-playground__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-4);
  }

  .sql-playground__toolbar label {
    display: grid;
    gap: var(--space-2);
    min-width: min(100%, 19rem);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .sql-playground__toolbar select {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-md);
    background: var(--colour-surface);
    color: var(--colour-text);
    font: inherit;
  }

  .sql-playground__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sql-playground__editor {
    display: grid;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .sql-playground__editor textarea {
    width: 100%;
    resize: vertical;
    padding: var(--space-4);
    border: 1px solid var(--colour-border-strong);
    border-radius: var(--radius-md);
    background: var(--colour-code-bg, var(--colour-surface-subtle));
    color: var(--colour-text);
    font-family: var(--font-mono);
    font-size: 0.94rem;
    line-height: 1.65;
    tab-size: 2;
  }

  .sql-playground__status {
    margin: var(--space-3) 0;
    font-size: var(--font-size-sm);
  }

  .sql-playground__status[data-state="error"] {
    color: var(--colour-danger, #9a3f38);
  }

  .sql-playground__output {
    overflow-x: auto;
    border-top: 1px solid var(--colour-border);
    padding-top: var(--space-4);
  }

  .sql-playground__output table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .sql-playground__output th,
  .sql-playground__output td {
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--colour-border);
    text-align: left;
    white-space: nowrap;
  }

  .sql-playground__output th {
    color: var(--colour-text-muted);
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 48rem) {
    .sql-playground__toolbar,
    .sql-playground__actions {
      align-items: stretch;
    }

    .sql-playground__toolbar {
      display: grid;
    }

    .sql-playground__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type SqlResult = {
    columns: string[];
    values: Array<Array<string | number | null>>;
  };

  type SqlDatabase = {
    run: (sql: string) => void;
    exec: (sql: string) => SqlResult[];
    close: () => void;
  };

  type SqlModule = {
    Database: new () => SqlDatabase;
  };

  type InitSqlJs = (config: {
    locateFile: (filename: string) => string;
  }) => Promise<SqlModule>;

  let sqlPlaygroundCleanup: (() => void) | undefined;
  let sqlModulePromise: Promise<SqlModule> | undefined;

  const cdnBase = "https://cdn.jsdelivr.net/npm/sql.js@1.14.1/dist/";

  function getInitSqlJs(): Promise<InitSqlJs> {
    const existing = Reflect.get(window, "initSqlJs");
    if (typeof existing === "function") return Promise.resolve(existing as InitSqlJs);

    return new Promise((resolve, reject) => {
      const prior = document.querySelector<HTMLScriptElement>('script[data-sqljs-loader="true"]');
      if (prior) {
        prior.addEventListener("load", () => {
          const loaded = Reflect.get(window, "initSqlJs");
          if (typeof loaded === "function") resolve(loaded as InitSqlJs);
          else reject(new Error("SQLite loader did not expose initSqlJs."));
        }, { once: true });
        prior.addEventListener("error", () => reject(new Error("SQLite loader failed.")), { once: true });
        return;
      }

      const script = document.createElement("script");
      script.src = `${cdnBase}sql-wasm.js`;
      script.async = true;
      script.dataset.sqljsLoader = "true";
      script.addEventListener("load", () => {
        const loaded = Reflect.get(window, "initSqlJs");
        if (typeof loaded === "function") resolve(loaded as InitSqlJs);
        else reject(new Error("SQLite loader did not expose initSqlJs."));
      }, { once: true });
      script.addEventListener("error", () => reject(new Error("SQLite loader failed.")), { once: true });
      document.head.append(script);
    });
  }

  async function getSqlModule() {
    if (!sqlModulePromise) {
      sqlModulePromise = getInitSqlJs().then((initSqlJs) =>
        initSqlJs({ locateFile: (filename) => `${cdnBase}${filename}` }),
      );
    }
    return sqlModulePromise;
  }

  function initSqlPlayground() {
    sqlPlaygroundCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-sql-playground]");
    if (!root) return;

    const preset = root.querySelector<HTMLSelectElement>("[data-sql-preset]");
    const code = root.querySelector<HTMLTextAreaElement>("[data-sql-code]");
    const runButton = root.querySelector<HTMLButtonElement>("[data-sql-run]");
    const resetButton = root.querySelector<HTMLButtonElement>("[data-sql-reset]");
    const status = root.querySelector<HTMLElement>("[data-sql-status]");
    const output = root.querySelector<HTMLElement>("[data-sql-output]");
    if (!preset || !code || !runButton || !resetButton || !status || !output) return;

    const presetSelect = preset;
    const codeEditor = code;
    const runControl = runButton;
    const resetControl = resetButton;
    const statusOutput = status;
    const resultOutput = output;
    const controller = new AbortController();
    let db: SqlDatabase | undefined;

    const examples: Record<string, string> = {
      join: `SELECT\n  o.order_id,\n  c.customer_name,\n  o.order_date,\n  o.order_value\nFROM orders AS o\nJOIN customers AS c\n  ON o.customer_id = c.customer_id\nORDER BY o.order_id;`,
      customers: `SELECT *\nFROM customers\nORDER BY customer_id;`,
      aggregate: `SELECT\n  c.customer_name,\n  COUNT(o.order_id) AS order_count,\n  ROUND(SUM(o.order_value), 2) AS total_value\nFROM customers AS c\nLEFT JOIN orders AS o\n  ON c.customer_id = o.customer_id\nGROUP BY c.customer_id, c.customer_name\nORDER BY total_value DESC;`,
      duplicate: `INSERT INTO customers (customer_id, customer_name, email, segment)\nVALUES (1001, 'Duplicate Customer', 'duplicate@example.com', 'Retail');`,
      "foreign-key": `INSERT INTO orders (order_id, customer_id, order_date, order_value)\nVALUES (50999, 9999, '2026-08-10', 99.00);`,
    };

    const seedSql = `
PRAGMA foreign_keys = ON;
CREATE TABLE customers (
  customer_id INTEGER PRIMARY KEY,
  customer_name TEXT NOT NULL,
  email TEXT NOT NULL UNIQUE,
  segment TEXT NOT NULL
);
CREATE TABLE orders (
  order_id INTEGER PRIMARY KEY,
  customer_id INTEGER NOT NULL,
  order_date TEXT NOT NULL,
  order_value REAL NOT NULL,
  FOREIGN KEY (customer_id) REFERENCES customers (customer_id)
);
INSERT INTO customers VALUES
  (1001, 'North Retail', 'north@example.com', 'Retail'),
  (1002, 'Coast Foods', 'coast@example.com', 'Wholesale'),
  (1003, 'Alpine Labs', 'alpine@example.com', 'Enterprise');
INSERT INTO orders VALUES
  (50001, 1001, '2026-07-03', 420.00),
  (50002, 1001, '2026-07-05', 185.00),
  (50003, 1002, '2026-07-06', 760.00),
  (50004, 1003, '2026-07-09', 510.00);
`;

    function setStatus(message: string, state = "ready") {
      statusOutput.textContent = message;
      statusOutput.dataset.state = state;
    }

    function renderResults(results: SqlResult[]) {
      resultOutput.replaceChildren();
      if (results.length === 0) {
        const paragraph = document.createElement("p");
        paragraph.textContent = "SQL 执行成功，没有返回结果集。";
        resultOutput.append(paragraph);
        return;
      }

      results.forEach((result) => {
        const table = document.createElement("table");
        const thead = document.createElement("thead");
        const headRow = document.createElement("tr");
        result.columns.forEach((column) => {
          const th = document.createElement("th");
          th.textContent = column;
          headRow.append(th);
        });
        thead.append(headRow);
        table.append(thead);

        const tbody = document.createElement("tbody");
        result.values.forEach((row) => {
          const tr = document.createElement("tr");
          row.forEach((value) => {
            const td = document.createElement("td");
            td.textContent = value === null ? "NULL" : String(value);
            tr.append(td);
          });
          tbody.append(tr);
        });
        table.append(tbody);
        resultOutput.append(table);
      });
    }

    async function resetDatabase(showStatus = true) {
      if (showStatus) setStatus("正在加载 SQLite…", "loading");
      const SQL = await getSqlModule();
      db?.close();
      db = new SQL.Database();
      db.run(seedSql);
      if (showStatus) setStatus("SQLite 已就绪，示例数据库已重置。", "ready");
    }

    async function runQuery() {
      runControl.disabled = true;
      try {
        if (!db) await resetDatabase(false);
        setStatus("正在执行 SQL…", "running");
        const results = db?.exec(codeEditor.value) ?? [];
        renderResults(results);
        setStatus("SQL 执行完成。", "success");
      } catch (error) {
        const paragraph = document.createElement("p");
        paragraph.textContent = error instanceof Error ? error.message : String(error);
        resultOutput.replaceChildren(paragraph);
        setStatus("SQL 执行失败。查看下方错误信息。", "error");
      } finally {
        runControl.disabled = false;
      }
    }

    presetSelect.addEventListener(
      "change",
      () => {
        codeEditor.value = examples[presetSelect.value] ?? examples.join;
      },
      { signal: controller.signal },
    );

    runControl.addEventListener("click", runQuery, { signal: controller.signal });
    resetControl.addEventListener(
      "click",
      async () => {
        try {
          await resetDatabase();
          const paragraph = document.createElement("p");
          paragraph.textContent = "数据库已恢复到初始客户与订单数据。";
          resultOutput.replaceChildren(paragraph);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        }
      },
      { signal: controller.signal },
    );

    codeEditor.addEventListener(
      "keydown",
      (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
          event.preventDefault();
          void runQuery();
        }
      },
      { signal: controller.signal },
    );

    codeEditor.value = examples.join;
    sqlPlaygroundCleanup = () => {
      controller.abort();
      db?.close();
    };
  }

  document.addEventListener("astro:before-swap", () => sqlPlaygroundCleanup?.());
  document.addEventListener("astro:page-load", initSqlPlayground);
  initSqlPlayground();
</script>
