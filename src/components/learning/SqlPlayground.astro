---
import { sqlLearningSeedSql } from "../../data/sql-learning";
import type { Locale } from "../../config/site";
import { sqlUi } from "../../i18n/sql-ui";

type Preset =
  | "join"
  | "customers"
  | "orders"
  | "products"
  | "order-items"
  | "expression"
  | "aggregate"
  | "duplicate"
  | "foreign-key"
  | "where-gte"
  | "where-and"
  | "where-or"
  | "where-grouped"
  | "where-between"
  | "where-in"
  | "where-like"
  | "where-null"
  | "projection-columns"
  | "projection-reorder"
  | "projection-alias"
  | "projection-where"
  | "projection-expression";
type Focus = "keys" | "select" | "where" | "projection" | "all";

interface Props {
  defaultPreset?: Preset;
  focus?: Focus;
  locale?: Locale;
}

const pathname = Astro.url.pathname;
const inferredFocus: Focus = pathname.includes("/sql-projection/")
  ? "projection"
  : pathname.includes("/sql-where/")
    ? "where"
    : pathname.includes("/sql-select/")
      ? "select"
      : pathname.includes("/sql-primary-key/") || pathname.includes("/sql-foreign-key/")
        ? "keys"
        : "all";
const inferredPreset: Preset = pathname.includes("/sql-primary-key/")
  ? "duplicate"
  : pathname.includes("/sql-foreign-key/")
    ? "foreign-key"
    : pathname.includes("/sql-where/")
      ? "where-gte"
      : pathname.includes("/sql-projection/")
        ? "projection-columns"
        : "customers";
const {
  defaultPreset = inferredPreset,
  focus = inferredFocus,
  locale = "zh",
} = Astro.props;
const copy = sqlUi[locale].playground;
const label = (value: Preset) => copy.options[value];
const presetOptions = {
  keys: [
    { value: "customers", label: label("customers") },
    { value: "orders", label: label("orders") },
    { value: "duplicate", label: label("duplicate") },
    { value: "foreign-key", label: label("foreign-key") },
  ],
  select: [
    { value: "customers", label: label("customers") },
    { value: "orders", label: label("orders") },
    { value: "products", label: label("products") },
    { value: "order-items", label: label("order-items") },
    { value: "expression", label: label("expression") },
  ],
  where: [
    { value: "where-gte", label: label("where-gte") },
    { value: "where-and", label: label("where-and") },
    { value: "where-or", label: label("where-or") },
    { value: "where-grouped", label: label("where-grouped") },
    { value: "where-between", label: label("where-between") },
    { value: "where-in", label: label("where-in") },
    { value: "where-like", label: label("where-like") },
    { value: "where-null", label: label("where-null") },
  ],
  projection: [
    { value: "projection-columns", label: label("projection-columns") },
    { value: "projection-reorder", label: label("projection-reorder") },
    { value: "projection-alias", label: label("projection-alias") },
    { value: "projection-where", label: label("projection-where") },
    { value: "projection-expression", label: label("projection-expression") },
  ],
  all: [
    { value: "customers", label: label("customers") },
    { value: "orders", label: label("orders") },
    { value: "products", label: label("products") },
    { value: "order-items", label: label("order-items") },
    { value: "expression", label: label("expression") },
    { value: "where-gte", label: label("where-gte") },
    { value: "where-between", label: label("where-between") },
    { value: "projection-columns", label: label("projection-columns") },
    { value: "projection-alias", label: label("projection-alias") },
    { value: "join", label: label("join") },
    { value: "aggregate", label: label("aggregate") },
    { value: "duplicate", label: label("duplicate") },
    { value: "foreign-key", label: label("foreign-key") },
  ],
} as const;
const visiblePresets = presetOptions[focus];
const serializedSeed = JSON.stringify(sqlLearningSeedSql).replace(/</g, "\\u003c");
---

<section
  class="sql-playground"
  data-sql-playground
  data-default-preset={defaultPreset}
  data-sql-focus={focus}
  data-copy={JSON.stringify(copy)}
  aria-labelledby="sql-playground-title"
>
  <div class="sql-playground__intro">
    <p class="learning-note-kicker">{copy.kicker}</p><h3 id="sql-playground-title">
      {copy.title}
    </h3><p>{copy.intro}</p>
  </div>

  <div class="sql-playground__toolbar">
    <label for="sql-playground-preset">
      <span>{copy.presetLabel}</span>
      <select id="sql-playground-preset" data-sql-preset>
        {
          visiblePresets.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))
        }
      </select>
    </label>
    <div class="sql-playground__actions">
      <button type="button" class="button" data-sql-run>{copy.run}</button>
      <button type="button" class="button button--secondary" data-sql-reset
        >{copy.reset}</button
      >
    </div>
  </div>

  <label class="sql-playground__editor" for="sql-playground-code">
    <span>SQL</span>
    <textarea id="sql-playground-code" data-sql-code rows="9" spellcheck="false"
    ></textarea>
  </label>

  <div class="sql-playground__status" aria-live="polite" data-sql-status>
    {copy.loading}
  </div>

  <div
    class="sql-playground__result-summary"
    data-sql-result-summary
    aria-live="polite"
  >
    {copy.notRun}
  </div>

  <div class="sql-playground__output" data-sql-output aria-live="polite">
    <p>{copy.outputHint}</p>
  </div>

  <script is:inline type="application/json" data-sql-seed set:html={serializedSeed} />
</section>

<style>
  .sql-playground {
    margin: var(--space-12) 0;
    padding: var(--space-7) 0 var(--space-8);
    border-top: 1px solid var(--colour-border-strong);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .sql-playground__intro {
    max-width: 58rem;
  }

  .sql-playground__intro h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.35rem, 1.5vw, 1.8rem);
    line-height: 1.35;
  }

  .sql-playground__intro p:last-child,
  .sql-playground__status,
  .sql-playground__result-summary,
  .sql-playground__output > p {
    color: var(--colour-text-muted);
  }

  .sql-playground__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-6) 0 var(--space-4);
  }

  .sql-playground__toolbar label {
    display: grid;
    gap: var(--space-2);
    min-width: min(100%, 19rem);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .sql-playground__toolbar select {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-md);
    background: var(--colour-surface);
    color: var(--colour-text);
    font: inherit;
  }

  .sql-playground__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sql-playground__editor {
    display: grid;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .sql-playground__editor textarea {
    width: 100%;
    resize: vertical;
    padding: var(--space-4);
    border: 1px solid var(--colour-border-strong);
    border-radius: var(--radius-md);
    background: var(--colour-code-bg, var(--colour-surface-subtle));
    color: var(--colour-text);
    font-family: var(--font-mono);
    font-size: 0.94rem;
    line-height: 1.65;
    tab-size: 2;
  }

  .sql-playground__status {
    margin: var(--space-3) 0 var(--space-2);
    font-size: var(--font-size-sm);
  }

  .sql-playground__status[data-state="error"] {
    color: var(--colour-danger, #9a3f38);
  }

  .sql-playground__result-summary {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .sql-playground__output {
    overflow-x: auto;
    border-top: 1px solid var(--colour-border);
    padding-top: var(--space-4);
  }

  .sql-playground__output table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .sql-playground__output th,
  .sql-playground__output td {
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--colour-border);
    text-align: left;
    white-space: nowrap;
  }

  .sql-playground__output th {
    color: var(--colour-text-muted);
    font-weight: var(--font-weight-semibold);
  }

  @media (max-width: 48rem) {
    .sql-playground__toolbar,
    .sql-playground__actions {
      align-items: stretch;
    }

    .sql-playground__toolbar {
      display: grid;
    }

    .sql-playground__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type SqlResult = {
    columns: string[];
    values: Array<Array<string | number | null>>;
  };

  type SqlDatabase = {
    run: (sql: string) => void;
    exec: (sql: string) => SqlResult[];
    close: () => void;
  };

  type SqlModule = {
    Database: new () => SqlDatabase;
  };

  type InitSqlJs = (config: {
    locateFile: (filename: string) => string;
  }) => Promise<SqlModule>;

  let sqlPlaygroundCleanup: (() => void) | undefined;
  let sqlModulePromise: Promise<SqlModule> | undefined;

  const cdnBase = "https://cdn.jsdelivr.net/npm/sql.js@1.14.1/dist/";

  function getInitSqlJs(): Promise<InitSqlJs> {
    const existing = Reflect.get(window, "initSqlJs");
    if (typeof existing === "function") return Promise.resolve(existing as InitSqlJs);

    return new Promise((resolve, reject) => {
      const prior = document.querySelector<HTMLScriptElement>(
        'script[data-sqljs-loader="true"]',
      );
      if (prior) {
        prior.addEventListener(
          "load",
          () => {
            const loaded = Reflect.get(window, "initSqlJs");
            if (typeof loaded === "function") resolve(loaded as InitSqlJs);
            else reject(new Error("SQLite loader did not expose initSqlJs."));
          },
          { once: true },
        );
        prior.addEventListener(
          "error",
          () => reject(new Error("SQLite loader failed.")),
          { once: true },
        );
        return;
      }

      const script = document.createElement("script");
      script.src = `${cdnBase}sql-wasm.js`;
      script.async = true;
      script.dataset.sqljsLoader = "true";
      script.addEventListener(
        "load",
        () => {
          const loaded = Reflect.get(window, "initSqlJs");
          if (typeof loaded === "function") resolve(loaded as InitSqlJs);
          else reject(new Error("SQLite loader did not expose initSqlJs."));
        },
        { once: true },
      );
      script.addEventListener(
        "error",
        () => reject(new Error("SQLite loader failed.")),
        { once: true },
      );
      document.head.append(script);
    });
  }

  async function getSqlModule() {
    if (!sqlModulePromise) {
      sqlModulePromise = getInitSqlJs().then((initSqlJs) =>
        initSqlJs({ locateFile: (filename) => `${cdnBase}${filename}` }),
      );
    }
    return sqlModulePromise;
  }

  function initSqlPlayground() {
    sqlPlaygroundCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-sql-playground]");
    if (!root) return;
    const copy = JSON.parse(root.dataset.copy ?? "{}") as Record<string, string>;

    const preset = root.querySelector<HTMLSelectElement>("[data-sql-preset]");
    const code = root.querySelector<HTMLTextAreaElement>("[data-sql-code]");
    const runButton = root.querySelector<HTMLButtonElement>("[data-sql-run]");
    const resetButton = root.querySelector<HTMLButtonElement>("[data-sql-reset]");
    const status = root.querySelector<HTMLElement>("[data-sql-status]");
    const summary = root.querySelector<HTMLElement>("[data-sql-result-summary]");
    const output = root.querySelector<HTMLElement>("[data-sql-output]");
    const seedNode = root.querySelector<HTMLScriptElement>("[data-sql-seed]");
    if (
      !preset ||
      !code ||
      !runButton ||
      !resetButton ||
      !status ||
      !summary ||
      !output ||
      !seedNode
    )
      return;

    const playgroundRoot = root;
    const presetSelect = preset;
    const codeEditor = code;
    const runControl = runButton;
    const resetControl = resetButton;
    const statusOutput = status;
    const summaryOutput = summary;
    const resultOutput = output;
    const controller = new AbortController();
    const seedSql = JSON.parse(seedNode.textContent || '""') as string;
    let db: SqlDatabase | undefined;

    const examples: Record<string, string> = {
      join: `SELECT\n  o.order_id,\n  c.customer_name,\n  o.order_date,\n  o.order_value\nFROM orders AS o\nJOIN customers AS c\n  ON o.customer_id = c.customer_id\nORDER BY o.order_id;`,
      customers: `SELECT *\nFROM customers\nORDER BY customer_id;`,
      orders: `SELECT *\nFROM orders\nORDER BY order_id;`,
      products: `SELECT *\nFROM products\nORDER BY product_id;`,
      "order-items": `SELECT *\nFROM order_items\nORDER BY order_id, product_id;`,
      expression: `SELECT 1 AS execution_ok;`,
      aggregate: `SELECT\n  c.customer_name,\n  COUNT(o.order_id) AS order_count,\n  ROUND(SUM(o.order_value), 2) AS total_value\nFROM customers AS c\nLEFT JOIN orders AS o\n  ON c.customer_id = o.customer_id\nGROUP BY c.customer_id, c.customer_name\nORDER BY total_value DESC;`,
      duplicate: `INSERT INTO customers (customer_id, customer_name, email, phone, segment)\nVALUES (1001, 'Duplicate Customer', 'duplicate@example.com', '021-999-999', 'Retail');`,
      "foreign-key": `INSERT INTO orders (order_id, customer_id, order_date, order_value)\nVALUES (50999, 9999, '2026-08-10', 99.00);`,
      "where-gte": `SELECT *\nFROM orders\nWHERE order_value >= 500\nORDER BY order_id;`,
      "where-and": `SELECT *\nFROM orders\nWHERE order_value >= 400\n  AND customer_id <> 1002\nORDER BY order_id;`,
      "where-or": `SELECT *\nFROM orders\nWHERE customer_id = 1001\n   OR order_value >= 700\nORDER BY order_id;`,
      "where-grouped": `SELECT *\nFROM orders\nWHERE (customer_id = 1001 OR order_value >= 500)\n  AND customer_id = 1003\nORDER BY order_id;`,
      "where-between": `SELECT *\nFROM orders\nWHERE order_value BETWEEN 400 AND 600\nORDER BY order_id;`,
      "where-in": `SELECT *\nFROM customers\nWHERE segment IN ('Retail', 'Enterprise')\nORDER BY customer_id;`,
      "where-like": `SELECT *\nFROM customers\nWHERE customer_name LIKE 'Coast%'\nORDER BY customer_id;`,
      "where-null": `SELECT *\nFROM customers\nWHERE phone IS NULL\nORDER BY customer_id;`,
      "projection-columns": `SELECT\n  customer_id,\n  customer_name,\n  segment\nFROM customers;`,
      "projection-reorder": `SELECT\n  segment,\n  customer_name,\n  customer_id\nFROM customers;`,
      "projection-alias": `SELECT\n  customer_id AS customer_key,\n  customer_name AS customer,\n  segment AS customer_segment\nFROM customers;`,
      "projection-where": `SELECT\n  order_id,\n  customer_id,\n  order_value AS value\nFROM orders\nWHERE order_value >= 500;`,
      "projection-expression": `SELECT\n  order_id,\n  order_value,\n  ROUND(order_value * 1.10, 2) AS scenario_value\nFROM orders;`,
    };

    function setStatus(message: string, state = "ready") {
      statusOutput.textContent = message;
      statusOutput.dataset.state = state;
    }

    function setResultSummary(results: SqlResult[]) {
      if (results.length === 0) {
        summaryOutput.textContent = "0 result sets · statement completed";
        return;
      }
      if (results.length === 1) {
        const [result] = results;
        summaryOutput.textContent = `${result.values.length} rows × ${result.columns.length} columns`;
        return;
      }
      const rowCount = results.reduce(
        (total, result) => total + result.values.length,
        0,
      );
      summaryOutput.textContent = `${results.length} result sets · ${rowCount} returned rows`;
    }

    function renderResults(results: SqlResult[]) {
      resultOutput.replaceChildren();
      setResultSummary(results);
      if (results.length === 0) {
        const paragraph = document.createElement("p");
        paragraph.textContent = copy.noResults;
        resultOutput.append(paragraph);
        return;
      }

      results.forEach((queryResult) => {
        const table = document.createElement("table");
        const thead = document.createElement("thead");
        const headRow = document.createElement("tr");
        queryResult.columns.forEach((column) => {
          const th = document.createElement("th");
          th.textContent = column;
          headRow.append(th);
        });
        thead.append(headRow);
        table.append(thead);

        const tbody = document.createElement("tbody");
        queryResult.values.forEach((row) => {
          const tr = document.createElement("tr");
          row.forEach((value) => {
            const td = document.createElement("td");
            td.textContent = value === null ? "NULL" : String(value);
            tr.append(td);
          });
          tbody.append(tr);
        });
        table.append(tbody);
        resultOutput.append(table);
      });
    }

    async function resetDatabase(showStatus = true) {
      if (showStatus) setStatus(copy.loadingSqlite, "loading");
      const SQL = await getSqlModule();
      db?.close();
      db = new SQL.Database();
      db.run(seedSql);
      if (showStatus) setStatus(copy.ready, "ready");
    }

    async function runQuery() {
      runControl.disabled = true;
      try {
        if (!db) await resetDatabase(false);
        setStatus(copy.running, "running");
        const results = db?.exec(codeEditor.value) ?? [];
        renderResults(results);
        setStatus(copy.success, "success");
      } catch (error) {
        const paragraph = document.createElement("p");
        paragraph.textContent = error instanceof Error ? error.message : String(error);
        resultOutput.replaceChildren(paragraph);
        summaryOutput.textContent = "query failed";
        setStatus(copy.failure, "error");
      } finally {
        runControl.disabled = false;
      }
    }

    presetSelect.addEventListener(
      "change",
      () => {
        codeEditor.value = examples[presetSelect.value] ?? examples.customers;
      },
      { signal: controller.signal },
    );

    runControl.addEventListener("click", runQuery, { signal: controller.signal });
    resetControl.addEventListener(
      "click",
      async () => {
        try {
          await resetDatabase();
          const paragraph = document.createElement("p");
          paragraph.textContent = copy.resetMessage;
          resultOutput.replaceChildren(paragraph);
          summaryOutput.textContent = "database reset · no query result yet";
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error), "error");
        }
      },
      { signal: controller.signal },
    );

    codeEditor.addEventListener(
      "keydown",
      (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
          event.preventDefault();
          void runQuery();
        }
      },
      { signal: controller.signal },
    );

    const requestedPreset = playgroundRoot.dataset.defaultPreset || "customers";
    const availablePresets = Array.from(presetSelect.options).map(
      (option) => option.value,
    );
    const initialPreset =
      requestedPreset in examples && availablePresets.includes(requestedPreset)
        ? requestedPreset
        : availablePresets[0] || "customers";
    presetSelect.value = initialPreset;
    codeEditor.value = examples[initialPreset] ?? examples.customers;
    sqlPlaygroundCleanup = () => {
      controller.abort();
      db?.close();
    };
  }

  document.addEventListener("astro:before-swap", () => sqlPlaygroundCleanup?.());
  document.addEventListener("astro:page-load", initSqlPlayground);
  initSqlPlayground();
</script>
