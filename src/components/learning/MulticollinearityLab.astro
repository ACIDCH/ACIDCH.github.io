---
import type { Locale } from "../../config/site";
import { learningLabUi } from "../../i18n/learning-ui";

interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const copy = learningLabUi[locale].multicollinearity;
---

<section
  class="multicollinearity-lab"
  data-multicollinearity
  data-copy={JSON.stringify(copy)}
  aria-labelledby="multicollinearity-title"
>
  <div class="multicollinearity-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="multicollinearity-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>
  <label class="multicollinearity-lab__slider">
    <span>{copy.predictorCorrelation}<output data-vif-correlation>0.40</output></span>
    <input data-vif-slider type="range" min="0" max="95" step="5" value="40" />
  </label>
  <div class="multicollinearity-lab__metrics" aria-live="polite">
    <dl><dt>R² of X₁ ~ X₂</dt><dd data-vif-r2>0.16</dd></dl>
    <dl><dt>VIF</dt><dd data-vif-value>1.19</dd></dl>
    <dl><dt>{copy.interpretation}</dt><dd data-vif-signal>{copy.initialSignal}</dd></dl>
  </div>
  <div class="multicollinearity-lab__bar" aria-hidden="true">
    <span data-vif-bar></span>
  </div>
  <p class="multicollinearity-lab__note" data-vif-note>{copy.initialNote}</p>
</section>

<style>
  .multicollinearity-lab {
    margin: var(--space-10) 0;
    padding: var(--space-6) 0;
    border-block: 1px solid var(--colour-border-strong);
  }
  .multicollinearity-lab__intro {
    max-width: 58rem;
  }
  .multicollinearity-lab h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.35rem, 1.6vw, 1.85rem);
  }
  .multicollinearity-lab__intro p:last-child,
  .multicollinearity-lab__note {
    color: var(--colour-text-muted);
  }
  .multicollinearity-lab__slider {
    display: grid;
    gap: var(--space-2);
    max-width: 48rem;
    margin: var(--space-5) 0;
    font-weight: var(--font-weight-medium);
  }
  .multicollinearity-lab__slider input {
    width: 100%;
  }
  .multicollinearity-lab__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .multicollinearity-lab__metrics dl {
    margin: 0;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--colour-border);
  }
  .multicollinearity-lab__metrics dt {
    font-size: var(--font-size-xs);
    color: var(--colour-text-muted);
  }
  .multicollinearity-lab__metrics dd {
    margin: var(--space-1) 0 0;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  .multicollinearity-lab__bar {
    height: 0.6rem;
    margin-top: var(--space-5);
    overflow: hidden;
    border-radius: 999px;
    background: var(--colour-surface-muted);
  }
  .multicollinearity-lab__bar span {
    display: block;
    height: 100%;
    width: 12%;
    border-radius: inherit;
    background: var(--colour-primary);
    transition: width 160ms ease;
  }
  .multicollinearity-lab__note {
    margin-top: var(--space-3);
    max-width: 54rem;
  }
  @media (max-width: 48rem) {
    .multicollinearity-lab__metrics {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  let vifCleanup: (() => void) | undefined;
  function initVifLab() {
    vifCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-multicollinearity]");
    if (!root) return;
    const copy = JSON.parse(root.dataset.copy ?? "{}") as Record<string, string>;
    const slider = root.querySelector<HTMLInputElement>("[data-vif-slider]");
    const corr = root.querySelector<HTMLOutputElement>("[data-vif-correlation]");
    const r2 = root.querySelector<HTMLElement>("[data-vif-r2]");
    const vif = root.querySelector<HTMLElement>("[data-vif-value]");
    const signal = root.querySelector<HTMLElement>("[data-vif-signal]");
    const bar = root.querySelector<HTMLElement>("[data-vif-bar]");
    const note = root.querySelector<HTMLElement>("[data-vif-note]");
    if (!slider || !corr || !r2 || !vif || !signal || !bar || !note) return;
    const controller = new AbortController();
    const render = () => {
      const rho = Number(slider.value) / 100;
      const modelR2 = rho * rho;
      const value = 1 / (1 - modelR2);
      corr.value = rho.toFixed(2);
      r2.textContent = modelR2.toFixed(2);
      vif.textContent = value.toFixed(2);
      bar.style.width = `${Math.min(100, (value / 10) * 100)}%`;
      if (value < 2) {
        signal.textContent = copy.lowSignal;
        note.textContent = copy.lowNote;
      } else if (value < 5) {
        signal.textContent = copy.mediumSignal;
        note.textContent = copy.mediumNote;
      } else {
        signal.textContent = copy.highSignal;
        note.textContent = copy.highNote;
      }
    };
    slider.addEventListener("input", render, { signal: controller.signal });
    render();
    vifCleanup = () => controller.abort();
  }
  document.addEventListener("astro:before-swap", () => vifCleanup?.());
  document.addEventListener("astro:page-load", initVifLab);
  initVifLab();
</script>
