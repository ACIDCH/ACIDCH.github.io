---
interface Fact {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  facts: Fact[];
  path: string[];
  jumpHref?: string;
  jumpLabel?: string;
}

const {
  facts,
  path,
  jumpHref,
  jumpLabel = "进入互动观察台",
} = Astro.props;
---

<aside class="learning-note-rail" aria-label="本页快览">
  <section class="learning-note-rail__section">
    <p class="learning-note-rail__label">核心读数</p>
    <dl class="learning-note-rail__facts">
      {
        facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
            {fact.note && <small>{fact.note}</small>}
          </div>
        ))
      }
    </dl>
  </section>

  <section class="learning-note-rail__section">
    <p class="learning-note-rail__label">阅读路径</p>
    <ol class="learning-note-rail__path">
      {path.map((item) => <li>{item}</li>)}
    </ol>
    {
      jumpHref && (
        <a class="learning-note-rail__jump" href={jumpHref}>
          {jumpLabel}<span aria-hidden="true">→</span>
        </a>
      )
    }
  </section>
</aside>
