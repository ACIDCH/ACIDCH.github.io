---
import { sqlLearningSeedSql, sqlOrders } from "../../data/sql-learning";
import type { Locale } from "../../config/site";
import { sqlUi } from "../../i18n/sql-ui";
interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const copy = sqlUi[locale].order;

const payload = JSON.stringify({
  orders: sqlOrders,
  seedSql: sqlLearningSeedSql,
}).replace(/</g, "\\u003c");
---

<section
  class="order-lab"
  data-order-by-lab
  data-copy={JSON.stringify(copy)}
  aria-labelledby="order-lab-title"
>
  <div class="order-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="order-lab-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="order-lab__controls" role="group" aria-label={copy.controlsLabel}>
    <button type="button" data-order-rule="observed" aria-pressed="false"
      >{copy.buttons.observed}</button
    >
    <button type="button" data-order-rule="asc" aria-pressed="false"
      >{copy.buttons.asc}</button
    >
    <button type="button" data-order-rule="desc" aria-pressed="true"
      >{copy.buttons.desc}</button
    >
    <button type="button" data-order-rule="multi" aria-pressed="false"
      >{copy.buttons.multi}</button
    >
    <button type="button" data-order-rule="stable" aria-pressed="false"
      >{copy.buttons.stable}</button
    >
    <button type="button" data-order-rule="where" aria-pressed="false"
      >WHERE + ORDER BY</button
    >
  </div>

  <div class="order-lab__statement">
    <span>ORDER</span>
    <code data-order-statement>BY order_value DESC</code>
  </div>

  <div class="order-lab__metrics" aria-live="polite">
    <div><span>Rows</span><strong data-order-rows>4</strong></div>
    <div><span>Sort keys</span><strong data-order-keys>1</strong></div>
    <div><span>Contract</span><strong data-order-contract>ties unresolved</strong></div>
  </div>

  <div class="order-lab__table-wrap">
    <table>
      <thead>
        <tr>
          <th>rank</th>
          <th>order_id</th>
          <th>customer_id</th>
          <th>order_date</th>
          <th>order_value</th>
        </tr>
      </thead>
      <tbody data-order-body></tbody>
    </table>
  </div>

  <div class="order-lab__cards" data-order-cards aria-label="ORDER BY mobile records">
  </div>

  <p class="order-lab__reading" data-order-reading aria-live="polite">
    {copy.initialReading}
  </p>

  <div class="order-lab__runner" aria-labelledby="order-runner-title">
    <div class="order-lab__runner-intro">
      <p class="learning-note-kicker">{copy.runnerKicker}</p>
      <h4 id="order-runner-title">{copy.runnerTitle}</h4>
    </div>

    <div class="order-lab__runner-toolbar">
      <label for="order-sql-preset">
        <span>{copy.presetLabel}</span>
        <select id="order-sql-preset" data-order-sql-preset>
          <option value="value-desc">{copy.presetLabels.desc}</option>
          <option value="value-asc">{copy.presetLabels.asc}</option>
          <option value="multi">{copy.presetLabels.multi}</option>
          <option value="stable">{copy.presetLabels.stable}</option>
          <option value="where">WHERE + ORDER BY</option>
          <option value="alias">{copy.presetLabels.alias}</option>
        </select>
      </label>
      <button type="button" class="button" data-order-sql-run>{copy.run}</button>
    </div>

    <label class="order-lab__editor" for="order-sql-code">
      <span>SQL</span>
      <textarea id="order-sql-code" data-order-sql-code rows="8" spellcheck="false"
      ></textarea>
    </label>

    <div class="order-lab__status" data-order-sql-status aria-live="polite">
      {copy.loading}
    </div>
    <div class="order-lab__summary" data-order-sql-summary aria-live="polite">
      {copy.notRun}
    </div>
    <div class="order-lab__output" data-order-sql-output aria-live="polite">
      <p>{copy.outputHint}</p>
    </div>
  </div>

  <script is:inline type="application/json" data-order-source set:html={payload} />
</section>

<style>
  .order-lab {
    margin: var(--space-12) 0;
    padding: var(--space-7) 0 var(--space-8);
    border-top: 1px solid var(--colour-border-strong);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .order-lab__intro,
  .order-lab__reading,
  .order-lab__runner-intro {
    max-width: 58rem;
  }

  .order-lab__intro h3,
  .order-lab__runner-intro h4 {
    margin: var(--space-2) 0 var(--space-3);
    line-height: 1.35;
  }

  .order-lab__intro h3 {
    font-size: clamp(1.35rem, 1.5vw, 1.8rem);
  }

  .order-lab__runner-intro h4 {
    font-size: clamp(1.15rem, 1.3vw, 1.45rem);
  }

  .order-lab__intro p:last-child,
  .order-lab__metrics span,
  .order-lab__reading,
  .order-lab__status,
  .order-lab__summary,
  .order-lab__output > p {
    color: var(--colour-text-muted);
  }

  .order-lab__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 var(--space-4);
  }

  .order-lab__controls button {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    background: var(--colour-surface);
    color: var(--colour-text);
    font: inherit;
    cursor: pointer;
  }

  .order-lab__controls button[aria-pressed="true"] {
    border-color: var(--colour-primary);
    background: var(--colour-surface-subtle);
    color: var(--colour-primary-strong);
  }

  .order-lab__statement {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4);
    border: 1px solid var(--colour-border-strong);
    border-radius: var(--radius-md);
    background: var(--colour-surface-subtle);
  }

  .order-lab__statement span {
    color: var(--colour-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
  }

  .order-lab__statement code {
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .order-lab__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .order-lab__metrics > div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--colour-border);
  }

  .order-lab__metrics span {
    font-size: var(--font-size-xs);
  }

  .order-lab__metrics strong {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .order-lab__table-wrap {
    overflow-x: auto;
  }

  .order-lab table,
  .order-lab__output table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .order-lab th,
  .order-lab td,
  .order-lab__output th,
  .order-lab__output td {
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--colour-border);
    text-align: left;
    white-space: nowrap;
  }

  .order-lab th,
  .order-lab__output th {
    color: var(--colour-text-muted);
    font-weight: var(--font-weight-semibold);
  }

  .order-lab__cards {
    display: none;
  }

  .order-lab__reading {
    margin: var(--space-4) 0 0;
    line-height: 1.75;
  }

  .order-lab__runner {
    margin-top: var(--space-9, 4rem);
    padding-top: var(--space-7);
    border-top: 1px solid var(--colour-border-strong);
  }

  .order-lab__runner-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-5) 0 var(--space-4);
  }

  .order-lab__runner-toolbar label,
  .order-lab__editor {
    display: grid;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .order-lab__runner-toolbar label {
    min-width: min(100%, 20rem);
  }

  .order-lab__runner-toolbar select,
  .order-lab__editor textarea {
    width: 100%;
    border: 1px solid var(--colour-border-strong);
    border-radius: var(--radius-md);
    background: var(--colour-surface);
    color: var(--colour-text);
    font: inherit;
  }

  .order-lab__runner-toolbar select {
    padding: 0.7rem 0.8rem;
  }

  .order-lab__editor textarea {
    resize: vertical;
    padding: var(--space-4);
    background: var(--colour-code-bg, var(--colour-surface-subtle));
    font-family: var(--font-mono);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .order-lab__status {
    margin: var(--space-3) 0 var(--space-2);
    font-size: var(--font-size-sm);
  }

  .order-lab__status[data-state="error"] {
    color: var(--colour-danger, #9a3f38);
  }

  .order-lab__summary {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .order-lab__output {
    overflow-x: auto;
    border-top: 1px solid var(--colour-border);
    padding-top: var(--space-4);
  }

  @media (max-width: 42rem) {
    .order-lab__statement {
      grid-template-columns: 1fr;
    }

    .order-lab__metrics {
      gap: var(--space-2);
    }

    .order-lab__table-wrap {
      display: none;
    }

    .order-lab__cards {
      display: grid;
      gap: var(--space-3);
    }

    .order-lab__cards :global(article) {
      padding: var(--space-4);
      border: 1px solid var(--colour-border);
      border-radius: var(--radius-md);
      background: var(--colour-surface);
    }

    .order-lab__cards :global(dl) {
      display: grid;
      grid-template-columns: minmax(6.4rem, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-2) var(--space-3);
      margin: 0;
      font-size: var(--font-size-sm);
    }

    .order-lab__cards :global(dt) {
      color: var(--colour-text-muted);
      overflow-wrap: anywhere;
    }

    .order-lab__cards :global(dd) {
      margin: 0;
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .order-lab__runner-toolbar {
      display: grid;
      align-items: stretch;
    }

    .order-lab__runner-toolbar .button {
      width: 100%;
    }

    .order-lab__output th,
    .order-lab__output td {
      padding-inline: 0.5rem;
      font-size: 0.78rem;
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>

<script>
  type Order = {
    order_id: number;
    customer_id: number;
    order_date: string;
    order_value: number;
  };
  type Source = { orders: Order[]; seedSql: string };
  type Rule = "observed" | "asc" | "desc" | "multi" | "stable" | "where";
  type SqlResult = { columns: string[]; values: Array<Array<string | number | null>> };
  type SqlDatabase = {
    run: (sql: string) => void;
    exec: (sql: string) => SqlResult[];
    close: () => void;
  };
  type SqlModule = { Database: new () => SqlDatabase };
  type InitSqlJs = (config: {
    locateFile: (filename: string) => string;
  }) => Promise<SqlModule>;

  let orderLabCleanup: (() => void) | undefined;
  const cdnBase = "https://cdn.jsdelivr.net/npm/sql.js@1.14.1/dist/";
  let sqlModulePromise: Promise<SqlModule> | undefined;

  function getInitSqlJs(): Promise<InitSqlJs> {
    const existing = Reflect.get(window, "initSqlJs");
    if (typeof existing === "function") return Promise.resolve(existing as InitSqlJs);

    return new Promise((resolve, reject) => {
      const prior = document.querySelector<HTMLScriptElement>(
        'script[data-sqljs-loader="true"]',
      );
      if (prior) {
        prior.addEventListener(
          "load",
          () => {
            const loaded = Reflect.get(window, "initSqlJs");
            if (typeof loaded === "function") resolve(loaded as InitSqlJs);
            else reject(new Error("SQLite loader did not expose initSqlJs."));
          },
          { once: true },
        );
        prior.addEventListener(
          "error",
          () => reject(new Error("SQLite loader failed.")),
          {
            once: true,
          },
        );
        return;
      }

      const script = document.createElement("script");
      script.src = `${cdnBase}sql-wasm.js`;
      script.async = true;
      script.dataset.sqljsLoader = "true";
      script.addEventListener(
        "load",
        () => {
          const loaded = Reflect.get(window, "initSqlJs");
          if (typeof loaded === "function") resolve(loaded as InitSqlJs);
          else reject(new Error("SQLite loader did not expose initSqlJs."));
        },
        { once: true },
      );
      script.addEventListener(
        "error",
        () => reject(new Error("SQLite loader failed.")),
        {
          once: true,
        },
      );
      document.head.append(script);
    });
  }

  async function getSqlModule() {
    if (!sqlModulePromise) {
      sqlModulePromise = getInitSqlJs().then((initSqlJs) =>
        initSqlJs({ locateFile: (filename) => `${cdnBase}${filename}` }),
      );
    }
    return sqlModulePromise;
  }

  function initOrderLab() {
    orderLabCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-order-by-lab]");
    if (!root) return;

    const sourceNode = root.querySelector<HTMLScriptElement>("[data-order-source]");
    const statement = root.querySelector<HTMLElement>("[data-order-statement]");
    const rowsOutput = root.querySelector<HTMLElement>("[data-order-rows]");
    const keysOutput = root.querySelector<HTMLElement>("[data-order-keys]");
    const contractOutput = root.querySelector<HTMLElement>("[data-order-contract]");
    const body = root.querySelector<HTMLTableSectionElement>("[data-order-body]");
    const cards = root.querySelector<HTMLElement>("[data-order-cards]");
    const reading = root.querySelector<HTMLElement>("[data-order-reading]");
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-order-rule]"),
    );
    const preset = root.querySelector<HTMLSelectElement>("[data-order-sql-preset]");
    const code = root.querySelector<HTMLTextAreaElement>("[data-order-sql-code]");
    const runButton = root.querySelector<HTMLButtonElement>("[data-order-sql-run]");
    const status = root.querySelector<HTMLElement>("[data-order-sql-status]");
    const summary = root.querySelector<HTMLElement>("[data-order-sql-summary]");
    const output = root.querySelector<HTMLElement>("[data-order-sql-output]");
    if (
      !sourceNode ||
      !statement ||
      !rowsOutput ||
      !keysOutput ||
      !contractOutput ||
      !body ||
      !cards ||
      !reading ||
      !preset ||
      !code ||
      !runButton ||
      !status ||
      !summary ||
      !output
    )
      return;

    const statementOutput = statement;
    const rowCountOutput = rowsOutput;
    const keyCountOutput = keysOutput;
    const contractStatusOutput = contractOutput;
    const tableBody = body;
    const cardOutput = cards;
    const readingOutput = reading;
    const presetSelect = preset;
    const codeEditor = code;
    const runControl = runButton;
    const statusOutput = status;
    const summaryOutput = summary;
    const sqlOutput = output;
    const source = JSON.parse(sourceNode.textContent || "{}") as Source;
    const copy = JSON.parse(root.dataset.copy ?? "{}") as {
      rules: Record<Rule, string>;
      noResults: string;
      running: string;
      success: string;
      failure: string;
    };
    const controller = new AbortController();
    let db: SqlDatabase | undefined;

    const rules: Record<
      Rule,
      {
        statement: string;
        keys: string;
        contract: string;
        reading: string;
        rows: Order[];
      }
    > = {
      observed: {
        statement: "not declared",
        keys: "0",
        contract: "not guaranteed",
        reading: copy.rules.observed,
        rows: [...source.orders],
      },
      asc: {
        statement: "BY order_value ASC",
        keys: "1",
        contract: "ties unresolved",
        reading: copy.rules.asc,
        rows: [...source.orders].sort((a, b) => a.order_value - b.order_value),
      },
      desc: {
        statement: "BY order_value DESC",
        keys: "1",
        contract: "ties unresolved",
        reading: copy.rules.desc,
        rows: [...source.orders].sort((a, b) => b.order_value - a.order_value),
      },
      multi: {
        statement: "BY customer_id ASC, order_date DESC",
        keys: "2",
        contract: "secondary key",
        reading: copy.rules.multi,
        rows: [...source.orders].sort(
          (a, b) =>
            a.customer_id - b.customer_id || b.order_date.localeCompare(a.order_date),
        ),
      },
      stable: {
        statement: "BY customer_id ASC, order_date DESC, order_id ASC",
        keys: "3",
        contract: "unique tie-breaker",
        reading: copy.rules.stable,
        rows: [...source.orders].sort(
          (a, b) =>
            a.customer_id - b.customer_id ||
            b.order_date.localeCompare(a.order_date) ||
            a.order_id - b.order_id,
        ),
      },
      where: {
        statement: "BY order_value DESC, order_id ASC · after WHERE order_value >= 400",
        keys: "2",
        contract: "filtered + ordered",
        reading: copy.rules.where,
        rows: source.orders
          .filter((row) => row.order_value >= 400)
          .sort((a, b) => b.order_value - a.order_value || a.order_id - b.order_id),
      },
    };

    function renderRule(rule: Rule) {
      const view = rules[rule];
      statementOutput.textContent = view.statement;
      rowCountOutput.textContent = String(view.rows.length);
      keyCountOutput.textContent = view.keys;
      contractStatusOutput.textContent = view.contract;
      readingOutput.textContent = view.reading;

      tableBody.replaceChildren();
      cardOutput.replaceChildren();
      view.rows.forEach((row, index) => {
        const values = [
          index + 1,
          row.order_id,
          row.customer_id,
          row.order_date,
          row.order_value,
        ];
        const tr = document.createElement("tr");
        values.forEach((value) => {
          const td = document.createElement("td");
          td.textContent = String(value);
          tr.append(td);
        });
        tableBody.append(tr);

        const article = document.createElement("article");
        const list = document.createElement("dl");
        ["rank", "order_id", "customer_id", "order_date", "order_value"].forEach(
          (label, valueIndex) => {
            const dt = document.createElement("dt");
            dt.textContent = label;
            const dd = document.createElement("dd");
            dd.textContent = String(values[valueIndex]);
            list.append(dt, dd);
          },
        );
        article.append(list);
        cardOutput.append(article);
      });

      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.orderRule === rule));
      });
    }

    const examples: Record<string, string> = {
      "value-desc": `SELECT\n  order_id,\n  customer_id,\n  order_value\nFROM orders\nORDER BY order_value DESC, order_id ASC;`,
      "value-asc": `SELECT\n  order_id,\n  customer_id,\n  order_value\nFROM orders\nORDER BY order_value ASC, order_id ASC;`,
      multi: `SELECT\n  order_id,\n  customer_id,\n  order_date\nFROM orders\nORDER BY customer_id ASC, order_date DESC;`,
      stable: `SELECT\n  order_id,\n  customer_id,\n  order_date\nFROM orders\nORDER BY customer_id ASC, order_date DESC, order_id ASC;`,
      where: `SELECT\n  order_id,\n  customer_id,\n  order_value\nFROM orders\nWHERE order_value >= 400\nORDER BY order_value DESC, order_id ASC;`,
      alias: `SELECT\n  order_id,\n  ROUND(order_value * 1.10, 2) AS scenario_value\nFROM orders\nORDER BY scenario_value DESC, order_id ASC;`,
    };

    function setStatus(message: string, state = "ready") {
      statusOutput.textContent = message;
      statusOutput.dataset.state = state;
    }

    function renderSqlResults(results: SqlResult[]) {
      sqlOutput.replaceChildren();
      if (results.length === 0) {
        summaryOutput.textContent = "0 result sets · statement completed";
        const paragraph = document.createElement("p");
        paragraph.textContent = copy.noResults;
        sqlOutput.append(paragraph);
        return;
      }

      const result = results[0];
      summaryOutput.textContent = `${result.values.length} rows × ${result.columns.length} columns`;
      const table = document.createElement("table");
      const thead = document.createElement("thead");
      const headRow = document.createElement("tr");
      result.columns.forEach((column) => {
        const th = document.createElement("th");
        th.textContent = column;
        headRow.append(th);
      });
      thead.append(headRow);
      table.append(thead);

      const tbody = document.createElement("tbody");
      result.values.forEach((row) => {
        const tr = document.createElement("tr");
        row.forEach((value) => {
          const td = document.createElement("td");
          td.textContent = value === null ? "NULL" : String(value);
          tr.append(td);
        });
        tbody.append(tr);
      });
      table.append(tbody);
      sqlOutput.append(table);
    }

    async function resetDatabase() {
      const SQL = await getSqlModule();
      db?.close();
      db = new SQL.Database();
      db.run(source.seedSql);
    }

    async function runSql() {
      runControl.disabled = true;
      try {
        setStatus(copy.running, "running");
        if (!db) await resetDatabase();
        const results = db?.exec(codeEditor.value) ?? [];
        renderSqlResults(results);
        setStatus(copy.success, "success");
      } catch (error) {
        const paragraph = document.createElement("p");
        paragraph.textContent = error instanceof Error ? error.message : String(error);
        sqlOutput.replaceChildren(paragraph);
        summaryOutput.textContent = "query failed";
        setStatus(copy.failure, "error");
      } finally {
        runControl.disabled = false;
      }
    }

    buttons.forEach((button) => {
      button.addEventListener(
        "click",
        () => renderRule((button.dataset.orderRule || "desc") as Rule),
        { signal: controller.signal },
      );
    });

    presetSelect.addEventListener(
      "change",
      () => {
        codeEditor.value = examples[presetSelect.value] ?? examples["value-desc"];
      },
      { signal: controller.signal },
    );
    runControl.addEventListener("click", () => void runSql(), {
      signal: controller.signal,
    });
    codeEditor.addEventListener(
      "keydown",
      (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
          event.preventDefault();
          void runSql();
        }
      },
      { signal: controller.signal },
    );

    presetSelect.value = "value-desc";
    codeEditor.value = examples["value-desc"];
    renderRule("desc");
    orderLabCleanup = () => {
      controller.abort();
      db?.close();
    };
  }

  document.addEventListener("astro:before-swap", () => orderLabCleanup?.());
  document.addEventListener("astro:page-load", initOrderLab);
  initOrderLab();
</script>
