---
interface LearningFact {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  title: string;
  summary: string;
  series?: string;
  tags: string[];
  tools: string[];
  updatedAt?: Date;
  facts?: LearningFact[];
}

const { title, summary, series, tags, tools, updatedAt, facts = [] } = Astro.props;
const readingMinutes = 12;
---

<header class="learning-note-hero" data-learning-note-hero>
  <div class="learning-note-hero__intro">
    <div class="learning-note-hero__main">
      <p class="learning-note-hero__eyebrow">Learning Note</p>
      {series && <p class="learning-note-hero__series">{series}</p>}
      <h1>{title}</h1>
    </div>

    <div class="learning-note-hero__aside">
      <p class="learning-note-hero__summary">{summary}</p>
      <dl class="learning-note-hero__meta">
        <div>
          <dt>阅读</dt>
          <dd>约 {readingMinutes} 分钟</dd>
        </div>
        {
          updatedAt && (
            <div>
              <dt>更新</dt>
              <dd>{updatedAt.toLocaleDateString("zh-CN")}</dd>
            </div>
          )
        }
        <div>
          <dt>工具</dt>
          <dd>{tools.join(" · ")}</dd>
        </div>
      </dl>
      <div class="learning-note-hero__tags" aria-label="主题标签">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </div>

  {
    facts.length > 0 && (
      <dl class="learning-note-hero__facts" aria-label="本页核心读数">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
            {fact.note && <small>{fact.note}</small>}
          </div>
        ))}
      </dl>
    )
  }
</header>
