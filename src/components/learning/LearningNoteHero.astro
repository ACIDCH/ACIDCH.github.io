---
interface Props {
  title: string;
  summary?: string;
}

const { title, summary } = Astro.props;
---

<header class="learning-note-titlebar" data-learning-note-hero>
  <h1>{title}</h1>
  {summary && <p class="learning-note-titlebar__lead">{summary}</p>}
</header>

<style>
  .learning-note-titlebar {
    width: 100%;
    margin: 0 0 var(--space-10);
    padding: 0 0 var(--space-5);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .learning-note-titlebar h1 {
    max-width: none;
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 3.45rem);
    line-height: 1.15;
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
  }

  .learning-note-titlebar__lead {
    max-width: 52rem;
    margin: var(--space-4) 0 0;
    color: var(--colour-text-muted);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.8;
  }

  @media (max-width: 48rem) {
    .learning-note-titlebar {
      margin-bottom: var(--space-7);
    }

    .learning-note-titlebar h1 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }
  }
</style>
