---
import { getEditorialNoteCopy } from "../../data/note-editorial-copy";

interface Props {
  title: string;
  summary?: string;
}

const { title, summary = "" } = Astro.props;
const segments = Astro.url.pathname.split("/").filter(Boolean);
const notesIndex = segments.indexOf("notes");
const slug = notesIndex >= 0 ? (segments[notesIndex + 1] ?? "") : "";
const locale = Astro.url.pathname.startsWith("/zh/") ? "zh" : "en";
const editorial = getEditorialNoteCopy({ slug, locale, title, summary });
const displaySummary = editorial.summary || summary;
---

<header class="learning-note-titlebar" data-learning-note-hero>
  <h1>{editorial.title}</h1>
  {displaySummary && <p class="learning-note-titlebar__lead">{displaySummary}</p>}
</header>

<style>
  .learning-note-titlebar {
    width: 100%;
    margin: 0 0 var(--space-10);
    padding: 0 0 var(--space-5);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .learning-note-titlebar h1 {
    max-width: none;
    margin: 0;
    font-size: clamp(2.2rem, 3vw, 3.45rem);
    line-height: 1.15;
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
  }

  .learning-note-titlebar__lead {
    max-width: 52rem;
    margin: var(--space-4) 0 0;
    color: var(--colour-text-muted);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.8;
  }

  @media (max-width: 48rem) {
    .learning-note-titlebar { margin-bottom: var(--space-7); }
    .learning-note-titlebar h1 { font-size: clamp(2rem, 10vw, 2.8rem); }
  }
</style>
