---
import { dataScienceUi } from "../../i18n/data-science-ui";
interface Props {
  locale: "en" | "zh";
}

const { locale } = Astro.props;
const copy = dataScienceUi[locale].advanced;
---

<section class="data-science-advanced" data-data-science-advanced>
  <section id="bayesian-hierarchical" class="data-science-advanced__section">
    <p class="data-science-advanced__eyebrow">Inference · Beyond one estimate</p>
    <h2>{copy.bayesian.title}</h2>
    <p>{copy.bayesian.p1}</p>

    <div class="data-science-advanced__equation" aria-label="Bayes model update">
      <span>prior</span><strong>×</strong><span>likelihood</span><strong>→</strong><span
        >posterior</span
      >
    </div>

    <p>{copy.bayesian.p2}</p>

    <h3>{copy.bayesian.subtitle}</h3>
    <p>{copy.bayesian.p3}</p>

    <div class="data-science-advanced__comparison">
      {
        copy.bayesian.comparisons.map((item) => (
          <article>
            <>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section id="association-treatment-effect" class="data-science-advanced__section">
    <p class="data-science-advanced__eyebrow">Linear models · Evidence</p>
    <h2>{copy.evidence.title}</h2>
    <p>{copy.evidence.p1}</p>

    <table class="data-science-advanced__table">
      <thead><tr>{copy.evidence.headers.map((header) => <th>{header}</th>)}</tr></thead>
      <tbody>
        {
          copy.evidence.rows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>{copy.evidence.p2}</p>
  </section>

  <section id="loss-bias-variance" class="data-science-advanced__section">
    <p class="data-science-advanced__eyebrow">Prediction · Generalisation</p>
    <h2>{copy.loss.title}</h2>
    <p>{copy.loss.p1}</p>

    <div class="data-science-advanced__loss-grid">
      {
        copy.loss.cards.map((item) => (
          <article>
            <>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </>
          </article>
        ))
      }
    </div>

    <h3>{copy.loss.subtitle}</h3>
    <p>{copy.loss.p2}</p>

    <div
      class="data-science-advanced__tradeoff"
      role="img"
      aria-label={copy.loss.chartLabel}
    >
      <div class="data-science-advanced__tradeoff-axis">
        <span>{copy.loss.simple}</span><strong>{copy.loss.complexity}</strong><span
          >{copy.loss.complex}</span
        >
      </div>
      <div class="data-science-advanced__tradeoff-row">
        <span>{copy.loss.training}</span><i class="line line--train"></i>
      </div>
      <div class="data-science-advanced__tradeoff-row">
        <span>{copy.loss.validation}</span><i class="line line--validation"></i>
      </div>
      <p>{copy.loss.caption}</p>
    </div>
  </section>

  <section id="resampling-selection" class="data-science-advanced__section">
    <p class="data-science-advanced__eyebrow">High-dimensional data · Resampling</p>
    <h2>{copy.resampling.title}</h2>
    <p>{copy.resampling.p1}</p>

    <div class="data-science-advanced__pipeline">
      {
        copy.resampling.pipeline.map((item, index) => (
          <>
            {index > 0 && <b>→</b>}
            <span>{item}</span>
          </>
        ))
      }
    </div>

    <p>{copy.resampling.p2}</p>
  </section>

  <section id="calibration-decision-cost" class="data-science-advanced__section">
    <p class="data-science-advanced__eyebrow">Assessment · Decision quality</p>
    <h2>{copy.calibration.title}</h2>
    <p>{copy.calibration.p1}</p>

    <div class="data-science-advanced__three-levels">
      <article>
        <span>01</span><strong>Discrimination</strong><p>AUC · ROC · PR</p>
      </article>
      <article>
        <span>02</span><strong>Calibration</strong><p>
          Brier score · calibration curve
        </p>
      </article>
      <article>
        <span>03</span><strong>Decision</strong><p>{copy.calibration.decision}</p>
      </article>
    </div>

    <p>{copy.calibration.p2}</p>
  </section>

  <section id="model-evidence-checklist" class="data-science-advanced__section">
    <p class="data-science-advanced__eyebrow">Review · Evidence chain</p>
    <h2>{copy.checklist.title}</h2>
    <ol class="data-science-advanced__checklist">
      {copy.checklist.items.map((item) => <li>{item}</li>)}
    </ol>
  </section>
</section>

<style>
  .data-science-advanced {
    display: grid;
    gap: 2.4rem;
    margin: 2.6rem 0;
  }

  .data-science-advanced__section {
    min-width: 0;
    scroll-margin-top: 7rem;
  }

  .data-science-advanced__eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .data-science-advanced__section h2 {
    margin-top: 0;
  }

  .data-science-advanced__equation,
  .data-science-advanced__pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 1.2rem 0;
    padding: 1rem;
    border: 1px solid var(--border-color, rgba(127, 127, 127, 0.28));
    border-radius: 1rem;
  }

  .data-science-advanced__equation span,
  .data-science-advanced__pipeline span {
    padding: 0.45rem 0.7rem;
    border-radius: 0.65rem;
    background: var(--surface-soft, rgba(127, 127, 127, 0.08));
  }

  .data-science-advanced__comparison,
  .data-science-advanced__loss-grid,
  .data-science-advanced__three-levels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 1.2rem 0;
  }

  .data-science-advanced__loss-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .data-science-advanced__comparison article,
  .data-science-advanced__loss-grid article,
  .data-science-advanced__three-levels article {
    padding: 1rem;
    border: 1px solid var(--border-color, rgba(127, 127, 127, 0.28));
    border-radius: 0.9rem;
  }

  .data-science-advanced__comparison p,
  .data-science-advanced__loss-grid p,
  .data-science-advanced__three-levels p {
    margin-bottom: 0;
  }

  .data-science-advanced__three-levels span {
    display: block;
    margin-bottom: 0.45rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.58;
  }

  .data-science-advanced__table {
    width: 100%;
    margin: 1.2rem 0;
    border-collapse: collapse;
  }

  .data-science-advanced__table th,
  .data-science-advanced__table td {
    padding: 0.72rem;
    border-bottom: 1px solid var(--border-color, rgba(127, 127, 127, 0.28));
    text-align: left;
    vertical-align: top;
  }

  .data-science-advanced__tradeoff {
    margin: 1.2rem 0;
    padding: 1rem;
    border: 1px solid var(--border-color, rgba(127, 127, 127, 0.28));
    border-radius: 1rem;
  }

  .data-science-advanced__tradeoff-axis,
  .data-science-advanced__tradeoff-row {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) 1fr minmax(3rem, auto);
    gap: 0.8rem;
    align-items: center;
    margin: 0.65rem 0;
  }

  .data-science-advanced__tradeoff-axis strong {
    text-align: center;
  }

  .data-science-advanced__tradeoff-row {
    grid-template-columns: minmax(5.5rem, auto) 1fr;
  }

  .line {
    position: relative;
    display: block;
    height: 2.7rem;
    overflow: hidden;
  }

  .line::after {
    content: "";
    position: absolute;
    inset: 0.2rem 0.15rem;
    border-bottom: 2px solid currentColor;
    transform-origin: center;
  }

  .line--train::after {
    transform: skewY(-8deg) translateY(-0.15rem);
  }

  .line--validation::after {
    border: 0;
    border-top: 2px solid currentColor;
    border-radius: 50%;
    transform: translateY(0.9rem) scaleY(1.8);
  }

  .data-science-advanced__checklist {
    padding-left: 1.35rem;
  }

  .data-science-advanced__checklist li + li {
    margin-top: 0.55rem;
  }

  @media (max-width: 760px) {
    .data-science-advanced__comparison,
    .data-science-advanced__loss-grid,
    .data-science-advanced__three-levels {
      grid-template-columns: 1fr;
    }

    .data-science-advanced__table {
      display: block;
      overflow-x: auto;
    }
  }
</style>
