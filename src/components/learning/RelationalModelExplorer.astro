    }

    .relational-model-explorer__node,
    .relational-model-explorer__table {
      width: 100%;
    }
  }
</style>

<script>
  let relationalModelCleanup: (() => void) | undefined;

  function initRelationalModelExplorer() {
    relationalModelCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-relational-model-explorer]");
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-model-choice]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-model-panel]"));
    if (buttons.length === 0 || panels.length === 0) return;

    const controller = new AbortController();

    function selectModel(selected: string) {
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.modelChoice === selected));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.modelPanel !== selected;
      });
    }

    buttons.forEach((button) => {
      button.addEventListener(
        "click",
        () => selectModel(button.dataset.modelChoice || "relational"),
        { signal: controller.signal },
      );
    });

    selectModel("relational");
    relationalModelCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => relationalModelCleanup?.());
  document.addEventListener("astro:page-load", initRelationalModelExplorer);
  initRelationalModelExplorer();
</script>
