  }

  @media (max-width: 48rem) {
    .relational-model-explorer__network-main,
    .relational-model-explorer__schema-row {
      display: grid;
      grid-template-columns: 1fr;
      justify-items: stretch;
    }

    .relational-model-explorer__network-main > span {
      text-align: center;
    }

    .relational-model-explorer__schema-row > .relational-model-explorer__relation {
      font-size: 0;
    }

    .relational-model-explorer__schema-row > .relational-model-explorer__relation::after {
      content: attr(data-mobile-label);
