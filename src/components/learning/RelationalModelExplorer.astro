<section class="relational-model-explorer" data-relational-model-explorer aria-labelledby="relational-model-explorer-title">
  <div class="relational-model-explorer__intro">
    <p class="learning-note-kicker">互动图解 · 数据模型</p>
    <h3 id="relational-model-explorer-title">同一批业务信息，可以怎样组织？</h3>
    <p>
      在层次模型、网状模型和关系模型之间切换。重点不是记图形名称，而是观察“数据之间的连接”由什么结构表达，以及为什么二维关系表更容易用统一查询语言处理。
    </p>
  </div>

  <div class="relational-model-explorer__controls" role="group" aria-label="选择数据模型">
    <button type="button" data-model-choice="hierarchical" aria-pressed="false">层次模型</button>
    <button type="button" data-model-choice="network" aria-pressed="false">网状模型</button>
    <button type="button" data-model-choice="relational" aria-pressed="true">关系模型</button>
  </div>

  <div class="relational-model-explorer__panels" aria-live="polite">
    <section data-model-panel="hierarchical" hidden>
      <div class="relational-model-explorer__diagram relational-model-explorer__tree" aria-label="层次模型树状示意">
        <div class="relational-model-explorer__node">Business</div>
        <div class="relational-model-explorer__edge">↓</div>
        <div class="relational-model-explorer__row">
          <div class="relational-model-explorer__node">Customers</div>
          <div class="relational-model-explorer__node">Products</div>
        </div>
        <div class="relational-model-explorer__edge">↓</div>
        <div class="relational-model-explorer__row">
          <div class="relational-model-explorer__node">Orders</div>
          <div class="relational-model-explorer__node">Categories</div>
        </div>
      </div>
      <p class="relational-model-explorer__reading">
        层次模型把数据组织成树。父子路径很清楚，但一个节点天然处在一条层级路径中，跨层级或多重关系会变得不灵活。
      </p>
    </section>

    <section data-model-panel="network" hidden>
      <div class="relational-model-explorer__diagram relational-model-explorer__network" aria-label="网状模型多连接示意">
        <div class="relational-model-explorer__node">Customers</div>
        <span>↔</span>
        <div class="relational-model-explorer__node">Orders</div>
        <span>↔</span>
        <div class="relational-model-explorer__node">Products</div>
        <span>↕</span>
        <div class="relational-model-explorer__node">Shipments</div>
        <span>↔</span>
        <div class="relational-model-explorer__node">Warehouses</div>
      </div>
      <p class="relational-model-explorer__reading">
        网状模型允许节点之间建立多条路径，表达能力更强，但应用通常需要理解和沿着具体连接结构访问数据。
      </p>
    </section>

    <section data-model-panel="relational">
      <div class="relational-model-explorer__diagram relational-model-explorer__relations" aria-label="关系模型多表示意">
        <div class="relational-model-explorer__table">
          <strong>customers</strong>
          <span>customer_id · PK</span>
          <span>customer_name</span>
          <span>segment</span>
        </div>
        <div class="relational-model-explorer__relation">1 → N</div>
        <div class="relational-model-explorer__table">
          <strong>orders</strong>
          <span>order_id · PK</span>
          <span>customer_id · FK</span>
          <span>order_value</span>
        </div>
      </div>
      <p class="relational-model-explorer__reading">
        关系模型把实体放进结构一致的二维表，再通过键表达表之间的关系。SQL 可以在这个统一结构上执行查询、修改和约束操作。
      </p>
    </section>
  </div>
</section>

<style>
  .relational-model-explorer {
    margin: var(--space-12) 0;
    padding: var(--space-7) 0 var(--space-8);
    border-top: 1px solid var(--colour-border-strong);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .relational-model-explorer__intro,
  .relational-model-explorer__reading {
    max-width: 58rem;
  }

  .relational-model-explorer__intro h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.35rem, 1.5vw, 1.8rem);
    line-height: 1.35;
  }

  .relational-model-explorer__intro p:last-child,
  .relational-model-explorer__reading {
    color: var(--colour-text-muted);
  }

  .relational-model-explorer__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 var(--space-5);
  }

  .relational-model-explorer__controls button {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    background: var(--colour-surface);
    color: var(--colour-text);
    font: inherit;
    cursor: pointer;
  }

  .relational-model-explorer__controls button[aria-pressed="true"] {
    border-color: var(--colour-primary);
    background: var(--colour-surface-subtle);
    color: var(--colour-primary-strong);
  }

  .relational-model-explorer__diagram {
    min-height: 12rem;
    padding: var(--space-5);
    border: 1px solid var(--colour-border-strong);
    border-radius: var(--radius-md);
    background: var(--colour-surface-subtle);
  }

  .relational-model-explorer__tree {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .relational-model-explorer__row,
  .relational-model-explorer__relations {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .relational-model-explorer__node,
  .relational-model-explorer__table {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--colour-border-strong);
    border-radius: var(--radius-sm);
    background: var(--colour-surface);
  }

  .relational-model-explorer__node {
    min-width: 8rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .relational-model-explorer__network {
    display: grid;
    grid-template-columns: repeat(5, auto);
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .relational-model-explorer__network span,
  .relational-model-explorer__edge,
  .relational-model-explorer__relation {
    color: var(--colour-text-muted);
    font-family: var(--font-mono);
    text-align: center;
  }

  .relational-model-explorer__table {
    display: grid;
    gap: var(--space-2);
    min-width: min(100%, 16rem);
  }

  .relational-model-explorer__table strong,
  .relational-model-explorer__table span {
    font-family: var(--font-mono);
  }

  .relational-model-explorer__table span {
    padding-top: var(--space-2);
    border-top: 1px solid var(--colour-border);
    color: var(--colour-text-muted);
    font-size: var(--font-size-sm);
  }

  .relational-model-explorer__reading {
    margin: var(--space-4) 0 0;
    line-height: 1.75;
  }

  @media (max-width: 48rem) {
    .relational-model-explorer__network {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }

    .relational-model-explorer__network span {
      transform: rotate(90deg);
    }

    .relational-model-explorer__relations {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<script>
  let relationalModelCleanup: (() => void) | undefined;

  function initRelationalModelExplorer() {
    relationalModelCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-relational-model-explorer]");
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-model-choice]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-model-panel]"));
    if (buttons.length === 0 || panels.length === 0) return;

    const controller = new AbortController();

    function selectModel(selected: string) {
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.modelChoice === selected));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.modelPanel !== selected;
      });
    }

    buttons.forEach((button) => {
      button.addEventListener(
        "click",
        () => selectModel(button.dataset.modelChoice || "relational"),
        { signal: controller.signal },
      );
    });

    selectModel("relational");
    relationalModelCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => relationalModelCleanup?.());
  document.addEventListener("astro:page-load", initRelationalModelExplorer);
  initRelationalModelExplorer();
</script>
