---
import { optimisationUniverse } from "../../data/supply-chain-optimisation";
import type { Locale } from "../../config/site";
import { decisionUi } from "../../i18n/decision-ui";
interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const copy = decisionUi[locale].milp;
const hubs = optimisationUniverse.candidateHubs;
const payload = JSON.stringify(hubs).replace(/</g, "\\u003c");
---

<section
  class="dm-lab"
  data-milp-lab
  data-copy={JSON.stringify(copy)}
  aria-labelledby="milp-title"
>
  <div class="dm-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="milp-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="dm-lab__cards">
    {
      hubs.map((hub, index) => (
        <article data-hub-card={hub.id} data-active={index === 0 ? "true" : "false"}>
          <h4>{hub.name}</h4>
          <dl>
            <>
              <dt>Capacity</dt>
              <dd>{hub.capacity}</dd>
            </>
            <>
              <dt>Fixed cost</dt>
              <dd>{hub.fixedCost}</dd>
            </>
            <>
              <dt>Binary y</dt>
              <dd data-hub-y={hub.id}>{index === 0 ? "1" : "0"}</dd>
            </>
          </dl>
          <button
            type="button"
            data-hub-toggle={hub.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {index === 0 ? copy.close : copy.open}
          </button>
        </article>
      ))
    }
  </div>

  <div class="dm-lab__metrics" aria-live="polite">
    <div class="dm-lab__metric">
      <span>Open hubs</span><strong data-open-count>1</strong>
    </div>
    <div class="dm-lab__metric">
      <span>Available capacity</span><strong data-open-capacity
        >{hubs[0].capacity}</strong>
    </div>
    <div class="dm-lab__metric">
      <span>Fixed cost</span><strong data-fixed-cost>{hubs[0].fixedCost}</strong>
    </div>
    <div class="dm-lab__metric"><span>Network demand</span><strong>860</strong></div>
  </div>

  <div class="dm-lab__equation" data-linking-equation>
    Σ flow[central, region] ≤ 620 × y[central]
  </div>
  <div class="dm-lab__callout">
    <strong>{copy.logic}</strong><span data-milp-reading>{copy.initialReading}</span>
  </div>
  <script is:inline type="application/json" data-hub-source set:html={payload} />
</section>

<script>
  type Hub = { id: string; name: string; capacity: number; fixedCost: number };
  let milpCleanup: (() => void) | undefined;
  function initMilpLab() {
    milpCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-milp-lab]")!;
    const source = root?.querySelector<HTMLScriptElement>("[data-hub-source]");
    if (!root || !source) return;
    const copy = JSON.parse(root.dataset.copy ?? "{}") as Record<string, string>;
    const format = (template: string, values: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
    const hubs = JSON.parse(source.textContent || "[]") as Hub[];
    const state = new Map(hubs.map((hub, index) => [hub.id, index === 0]));
    const controller = new AbortController();
    const openCount = root.querySelector<HTMLElement>("[data-open-count]");
    const capacity = root.querySelector<HTMLElement>("[data-open-capacity]");
    const fixedCost = root.querySelector<HTMLElement>("[data-fixed-cost]");
    const equation = root.querySelector<HTMLElement>("[data-linking-equation]");
    const reading = root.querySelector<HTMLElement>("[data-milp-reading]");

    function render() {
      const open = hubs.filter((hub) => state.get(hub.id));
      if (openCount) openCount.textContent = String(open.length);
      if (capacity)
        capacity.textContent = String(open.reduce((sum, hub) => sum + hub.capacity, 0));
      if (fixedCost)
        fixedCost.textContent = String(
          open.reduce((sum, hub) => sum + hub.fixedCost, 0),
        );
      hubs.forEach((hub) => {
        const isOpen = Boolean(state.get(hub.id));
        root
          .querySelector<HTMLElement>(`[data-hub-card="${hub.id}"]`)
          ?.setAttribute("data-active", String(isOpen));
        root.querySelector<HTMLElement>(`[data-hub-y="${hub.id}"]`)!.textContent =
          isOpen ? "1" : "0";
        const button = root.querySelector<HTMLButtonElement>(
          `[data-hub-toggle="${hub.id}"]`,
        );
        if (button) {
          button.setAttribute("aria-pressed", String(isOpen));
          button.textContent = isOpen ? copy.close : copy.open;
        }
      });
      const focus = hubs[0];
      const y = state.get(focus.id) ? 1 : 0;
      if (equation)
        equation.textContent = `Σ flow[${focus.id}, region] ≤ ${focus.capacity} × ${y} = ${focus.capacity * y}`;
      if (reading) {
        const total = open.reduce((sum, hub) => sum + hub.capacity, 0);
        reading.textContent =
          open.length === 0
            ? copy.noneOpen
            : total < 860
              ? format(copy.insufficient, { total: String(total) })
              : format(copy.sufficient, { total: String(total) });
      }
    }

    root.querySelectorAll<HTMLButtonElement>("[data-hub-toggle]").forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const id = button.dataset.hubToggle;
          if (!id) return;
          state.set(id, !state.get(id));
          render();
        },
        { signal: controller.signal },
      );
    });
    render();
    milpCleanup = () => controller.abort();
  }
  document.addEventListener("astro:before-swap", () => milpCleanup?.());
  document.addEventListener("astro:page-load", initMilpLab);
  initMilpLab();
</script>
