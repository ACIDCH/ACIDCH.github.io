---
import { sqlCustomers } from "../../data/sql-learning";
import type { Locale } from "../../config/site";
import { sqlUi } from "../../i18n/sql-ui";
interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const copy = sqlUi[locale].primaryKey;

const serializedRows = JSON.stringify(sqlCustomers).replace(/</g, "\\u003c");
---

<section
  class="primary-key-lab"
  data-primary-key-lab
  data-copy={JSON.stringify(copy)}
  aria-labelledby="primary-key-lab-title"
>
  <div class="primary-key-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="primary-key-lab-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="primary-key-lab__controls" role="group" aria-label={copy.controlsLabel}>
    <button type="button" data-key-choice="customer_id" aria-pressed="true"
      >customer_id</button
    >
    <button type="button" data-key-choice="email" aria-pressed="false">email</button>
    <button type="button" data-key-choice="phone" aria-pressed="false">phone</button>
  </div>

  <div class="primary-key-lab__stage">
    <div class="primary-key-lab__table-wrap" aria-label={copy.desktopLabel}>
      <table>
        <thead>
          <tr>
            <th data-field="customer_id">customer_id</th>
            <th>customer_name</th>
            <th data-field="email">email</th>
            <th data-field="phone">phone</th>
          </tr>
        </thead>
        <tbody data-key-table-body></tbody>
      </table>
    </div>

    <div class="primary-key-lab__cards" data-key-cards aria-label={copy.mobileLabel}>
    </div>

    <aside class="primary-key-lab__reading" aria-live="polite">
      <span>{copy.currentCandidate}</span>
      <strong data-key-current>customer_id</strong>
      <p data-key-reading>{copy.messages.customer_id}</p>
      <div class="primary-key-lab__checks" data-key-checks></div>
      <button type="button" class="button button--secondary" data-key-change>
        {copy.simulate}
      </button>
      <button type="button" class="button button--ghost" data-key-reset>
        {copy.reset}
      </button>
    </aside>
  </div>

  <script is:inline type="application/json" data-key-source set:html={serializedRows} />
</section>

<style>
  .primary-key-lab {
    margin: var(--space-12) 0;
    padding: var(--space-7) 0 var(--space-8);
    border-top: 1px solid var(--colour-border-strong);
    border-bottom: 1px solid var(--colour-border-strong);
  }

  .primary-key-lab__intro {
    max-width: 58rem;
  }

  .primary-key-lab__intro h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.35rem, 1.5vw, 1.8rem);
    line-height: 1.35;
  }

  .primary-key-lab__intro p:last-child,
  .primary-key-lab__reading p,
  .primary-key-lab__reading span,
  .primary-key-lab__checks {
    color: var(--colour-text-muted);
  }

  .primary-key-lab__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 var(--space-5);
  }

  .primary-key-lab__controls button {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    background: var(--colour-surface);
    color: var(--colour-text);
    font: inherit;
    cursor: pointer;
  }

  .primary-key-lab__controls button[aria-pressed="true"] {
    border-color: var(--colour-primary);
    background: var(--colour-surface-subtle);
    color: var(--colour-primary-strong);
  }

  .primary-key-lab__stage {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .primary-key-lab__table-wrap {
    overflow-x: auto;
  }

  .primary-key-lab table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
  }

  .primary-key-lab th,
  .primary-key-lab td {
    padding: 0.68rem 0.62rem;
    border-bottom: 1px solid var(--colour-border);
    text-align: left;
    white-space: nowrap;
  }

  .primary-key-lab th[data-active-key="true"],
  .primary-key-lab td[data-active-key="true"] {
    background: var(--colour-surface-subtle);
  }

  .primary-key-lab td[data-changed="true"] {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.25em;
  }

  .primary-key-lab__cards {
    display: none;
  }

  .primary-key-lab__reading {
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-strong);
  }

  .primary-key-lab__reading span {
    display: block;
    font-size: var(--font-size-xs);
  }

  .primary-key-lab__reading strong {
    display: block;
    margin-top: var(--space-1);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-family: var(--font-mono);
  }

  .primary-key-lab__reading p {
    max-width: 58rem;
    margin: var(--space-3) 0;
    line-height: 1.75;
  }

  .primary-key-lab__checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--colour-border);
    border-bottom: 1px solid var(--colour-border);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .primary-key-lab__reading .button + .button {
    margin-left: var(--space-2);
  }

  @media (max-width: 42rem) {
    .primary-key-lab__table-wrap {
      display: none;
    }

    .primary-key-lab__cards {
      display: grid;
      gap: var(--space-3);
    }

    .primary-key-lab__card {
      margin: 0;
      padding: var(--space-3);
      border: 1px solid var(--colour-border);
      border-radius: var(--radius-sm);
      background: var(--colour-surface);
    }

    .primary-key-lab__card-row {
      display: grid;
      grid-template-columns: 7.4rem minmax(0, 1fr);
      gap: var(--space-3);
      padding: 0.48rem 0;
      border-bottom: 1px solid var(--colour-border);
    }

    .primary-key-lab__card-row:last-child {
      border-bottom: 0;
    }

    .primary-key-lab__card-row[data-active-key="true"] {
      margin-inline: calc(var(--space-2) * -1);
      padding-inline: var(--space-2);
      border-radius: var(--radius-sm);
      background: var(--colour-surface-subtle);
    }

    .primary-key-lab__card dt,
    .primary-key-lab__card dd {
      margin: 0;
      min-width: 0;
    }

    .primary-key-lab__card dt {
      color: var(--colour-text-muted);
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
    }

    .primary-key-lab__card dd {
      overflow-wrap: anywhere;
      font-size: var(--font-size-sm);
    }

    .primary-key-lab__card-row[data-changed="true"] dd {
      text-decoration: underline;
      text-decoration-style: dotted;
      text-underline-offset: 0.25em;
    }

    .primary-key-lab__checks {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .primary-key-lab__reading .button {
      width: 100%;
    }

    .primary-key-lab__reading .button + .button {
      margin-top: var(--space-2);
      margin-left: 0;
    }
  }
</style>

<script>
  type CustomerRow = {
    customer_id: number;
    customer_name: string;
    email: string;
    phone: string;
    segment: string;
  };
  type KeyChoice = "customer_id" | "email" | "phone";
  type VisibleField = "customer_id" | "customer_name" | "email" | "phone";

  let primaryKeyCleanup: (() => void) | undefined;

  function initPrimaryKeyLab() {
    primaryKeyCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-primary-key-lab]");
    if (!root) return;

    const body = root.querySelector<HTMLTableSectionElement>("[data-key-table-body]");
    const cards = root.querySelector<HTMLElement>("[data-key-cards]");
    const current = root.querySelector<HTMLElement>("[data-key-current]");
    const reading = root.querySelector<HTMLElement>("[data-key-reading]");
    const checks = root.querySelector<HTMLElement>("[data-key-checks]");
    const changeButton = root.querySelector<HTMLButtonElement>("[data-key-change]");
    const resetButton = root.querySelector<HTMLButtonElement>("[data-key-reset]");
    const sourceNode = root.querySelector<HTMLScriptElement>("[data-key-source]");
    const choiceButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-key-choice]"),
    );
    if (
      !body ||
      !cards ||
      !current ||
      !reading ||
      !checks ||
      !changeButton ||
      !resetButton ||
      !sourceNode ||
      choiceButtons.length === 0
    )
      return;

    const labRoot = root;
    const copy = JSON.parse(root.dataset.copy ?? "{}") as {
      messages: Record<KeyChoice, string>;
      simulate: string;
      changed: string;
    };
    const tableBody = body;
    const cardList = cards;
    const currentOutput = current;
    const readingOutput = reading;
    const checksOutput = checks;
    const changeControl = changeButton;
    const resetControl = resetButton;
    const controller = new AbortController();
    const originalRows = JSON.parse(sourceNode.textContent || "[]") as CustomerRow[];
    let selected: KeyChoice = "customer_id";
    let changed = false;

    const fields: VisibleField[] = ["customer_id", "customer_name", "email", "phone"];

    function rows() {
      return originalRows.map((row) => {
        if (!changed || row.customer_id !== 1002) return { ...row };
        return {
          ...row,
          email: "accounts@coast.example",
          phone: "021-555-902",
        };
      });
    }

    function isChangedField(row: CustomerRow, field: VisibleField) {
      return (
        changed && row.customer_id === 1002 && (field === "email" || field === "phone")
      );
    }

    function renderChecks(currentRows: CustomerRow[]) {
      const values = currentRows.map((row) => String(row[selected]));
      const unique = new Set(values).size === values.length;
      const nonNull = values.every((value) => value.length > 0);
      const stable = selected === "customer_id";
      checksOutput.replaceChildren();
      [
        `unique    ${unique ? "✓" : "✗"}`,
        `non-null  ${nonNull ? "✓" : "✗"}`,
        `stable    ${stable ? "✓" : "△ business field"}`,
      ].forEach((label) => {
        const line = document.createElement("div");
        line.textContent = label;
        checksOutput.append(line);
      });
    }

    function renderDesktopTable(currentRows: CustomerRow[]) {
      tableBody.replaceChildren();
      currentRows.forEach((row) => {
        const tr = document.createElement("tr");
        fields.forEach((field) => {
          const td = document.createElement("td");
          td.textContent = String(row[field]);
          if (field === selected) td.dataset.activeKey = "true";
          if (isChangedField(row, field)) td.dataset.changed = "true";
          tr.append(td);
        });
        tableBody.append(tr);
      });
    }

    function renderMobileCards(currentRows: CustomerRow[]) {
      cardList.replaceChildren();
      currentRows.forEach((row) => {
        const card = document.createElement("dl");
        card.className = "primary-key-lab__card";
        fields.forEach((field) => {
          const wrapper = document.createElement("div");
          wrapper.className = "primary-key-lab__card-row";
          wrapper.dataset.activeKey = String(field === selected);
          if (isChangedField(row, field)) wrapper.dataset.changed = "true";

          const term = document.createElement("dt");
          term.textContent = field;
          const value = document.createElement("dd");
          value.textContent = String(row[field]);
          wrapper.append(term, value);
          card.append(wrapper);
        });
        cardList.append(card);
      });
    }

    function render() {
      const currentRows = rows();
      renderDesktopTable(currentRows);
      renderMobileCards(currentRows);

      labRoot.querySelectorAll<HTMLElement>("th[data-field]").forEach((cell) => {
        cell.dataset.activeKey = String(cell.dataset.field === selected);
      });
      choiceButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.keyChoice === selected),
        );
      });
      currentOutput.textContent = selected;
      readingOutput.textContent = copy.messages[selected];
      renderChecks(currentRows);
      changeControl.textContent = changed ? copy.changed : copy.simulate;
      changeControl.disabled = changed;
    }

    choiceButtons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const next = button.dataset.keyChoice;
          if (next === "customer_id" || next === "email" || next === "phone") {
            selected = next;
          }
          render();
        },
        { signal: controller.signal },
      );
    });

    changeControl.addEventListener(
      "click",
      () => {
        changed = true;
        render();
      },
      { signal: controller.signal },
    );

    resetControl.addEventListener(
      "click",
      () => {
        selected = "customer_id";
        changed = false;
        render();
      },
      { signal: controller.signal },
    );

    render();
    primaryKeyCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => primaryKeyCleanup?.());
  document.addEventListener("astro:page-load", initPrimaryKeyLab);
  initPrimaryKeyLab();
</script>
