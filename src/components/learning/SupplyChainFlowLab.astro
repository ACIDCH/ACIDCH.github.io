---
import { optimisationUniverse } from "../../data/supply-chain-optimisation";
import type { Locale } from "../../config/site";
import { decisionUi } from "../../i18n/decision-ui";

interface Props {
  defaultMode?: "carrier" | "period";
  locale?: Locale;
}

const { defaultMode = "carrier", locale = "zh" } = Astro.props;
const copy = decisionUi[locale].flow;
const payload = JSON.stringify({
  carriers: optimisationUniverse.carriers,
  periods: optimisationUniverse.periods,
}).replace(/</g, "\\u003c");
---

<section
  class="dm-lab"
  data-flow-lab
  data-default-mode={defaultMode}
  data-copy={JSON.stringify(copy)}
  aria-labelledby="flow-title"
>
  <div class="dm-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="flow-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="dm-lab__chips">
    <button
      type="button"
      data-flow-mode="carrier"
      aria-pressed={defaultMode === "carrier" ? "true" : "false"}
      >Carrier allocation</button
    >
    <button
      type="button"
      data-flow-mode="period"
      aria-pressed={defaultMode === "period" ? "true" : "false"}
      >Multi-period flow</button
    >
  </div>

  <div data-flow-panel="carrier" hidden={defaultMode !== "carrier"}>
    <div class="dm-lab__equation">
      min Σ unitCost[s] · volume[s] s.t. Σ volume[s] = 860 min[s] ≤ volume[s] ≤ max[s]
    </div>
    <div class="dm-lab__controls">
      <label
        >Carrier A volume<input
          data-carrier-input="a"
          type="range"
          min="180"
          max="420"
          step="10"
          value="300"
        /></label
      >
      <label
        >Carrier B volume<input
          data-carrier-input="b"
          type="range"
          min="120"
          max="360"
          step="10"
          value="300"
        /></label
      >
      <label
        >Carrier C volume<input
          data-carrier-input="c"
          type="range"
          min="0"
          max="300"
          step="10"
          value="260"
        /></label
      >
    </div>
    <div class="dm-lab__metrics" aria-live="polite">
      <div class="dm-lab__metric">
        <span>Allocated</span><strong data-carrier-total>860</strong>
      </div>
      <div class="dm-lab__metric"><span>Demand</span><strong>860</strong></div>
      <div class="dm-lab__metric">
        <span>Transport cost</span><strong data-carrier-cost>6198</strong>
      </div>
      <div class="dm-lab__metric">
        <span>Status</span><strong data-carrier-status>Feasible</strong>
      </div>
    </div>
    <div class="dm-lab__bar-list" data-carrier-bars></div>
    <div class="dm-lab__callout">
      <strong>Flow interpretation</strong><span data-carrier-reading
        >{copy.initialCarrierReading}</span
      >
    </div>
  </div>

  <div data-flow-panel="period" hidden={defaultMode !== "period"}>
    <div class="dm-lab__actions">
      <button type="button" data-production-plan="match" aria-pressed="true"
        >Demand match</button
      >
      <button type="button" data-production-plan="smooth" aria-pressed="false"
        >Smooth 225</button
      >
      <button type="button" data-production-plan="batch" aria-pressed="false"
        >Two batches</button
      >
    </div>
    <div class="dm-lab__equation">
      endingInventory[t] = beginningInventory[t] + production[t] - demand[t]
      beginningInventory[t+1] = endingInventory[t]
    </div>
    <div class="dm-lab__metrics" aria-live="polite">
      <div class="dm-lab__metric">
        <span>Total production</span><strong data-period-production>900</strong>
      </div>
      <div class="dm-lab__metric">
        <span>Setups</span><strong data-period-setups>4</strong>
      </div>
      <div class="dm-lab__metric">
        <span>Holding units</span><strong data-period-holding>0</strong>
      </div>
      <div class="dm-lab__metric">
        <span>Total cost</span><strong data-period-cost>12480</strong>
      </div>
    </div>
    <div class="dm-lab__table-wrap">
      <table>
        <thead
          ><tr
            ><th>Period</th><th>Demand</th><th>Production</th><th>Ending inventory</th
            ></tr
          ></thead
        >
        <tbody data-period-body></tbody>
      </table>
    </div>
    <div class="dm-lab__callout">
      <strong>Planning interpretation</strong><span data-period-reading
        >{copy.initialPeriodReading}</span
      >
    </div>
  </div>

  <script is:inline type="application/json" data-flow-source set:html={payload} />
</section>

<script>
  type Carrier = {
    id: string;
    name: string;
    minVolume: number;
    maxVolume: number;
    unitCost: number;
  };
  type Period = {
    period: number;
    demand: number;
    productionCost: number;
    holdingCost: number;
    setupCost: number;
  };
  let flowCleanup: (() => void) | undefined;

  function initFlowLab() {
    flowCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-flow-lab]")!;
    const source = root?.querySelector<HTMLScriptElement>("[data-flow-source]");
    if (!root || !source) return;
    const data = JSON.parse(source.textContent || "{}") as {
      carriers: Carrier[];
      periods: Period[];
    };
    const copy = JSON.parse(root.dataset.copy ?? "{}") as {
      carrierBalanced: string;
      carrierMismatch: string;
      carrierBounds: string;
      planReadings: Record<string, string>;
    };
    const format = (template: string, values: Record<string, string>) =>
      template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
    const controller = new AbortController();
    const field = (selector: string) => root.querySelector<HTMLElement>(selector);

    function renderCarriers() {
      const volumes = new Map<string, number>();
      data.carriers.forEach((carrier) => {
        const input = root.querySelector<HTMLInputElement>(
          `[data-carrier-input="${carrier.id}"]`,
        );
        volumes.set(carrier.id, Number(input?.value || 0));
      });
      const total = data.carriers.reduce(
        (sum, carrier) => sum + (volumes.get(carrier.id) || 0),
        0,
      );
      const cost = data.carriers.reduce(
        (sum, carrier) => sum + (volumes.get(carrier.id) || 0) * carrier.unitCost,
        0,
      );
      const boundsOk = data.carriers.every((carrier) => {
        const volume = volumes.get(carrier.id) || 0;
        return volume >= carrier.minVolume && volume <= carrier.maxVolume;
      });
      const feasible = boundsOk && total === 860;
      field("[data-carrier-total]")!.textContent = String(total);
      field("[data-carrier-cost]")!.textContent = cost.toFixed(0);
      field("[data-carrier-status]")!.textContent = feasible
        ? "Feasible"
        : "Check flow";
      const bars = field("[data-carrier-bars]");
      if (bars) {
        bars.replaceChildren();
        data.carriers.forEach((carrier) => {
          const volume = volumes.get(carrier.id) || 0;
          const row = document.createElement("div");
          row.className = "dm-lab__bar-row";
          const label = document.createElement("span");
          label.textContent = `${carrier.name} · ${volume}`;
          const track = document.createElement("div");
          track.className = "dm-lab__bar-track";
          const fill = document.createElement("div");
          fill.className = "dm-lab__bar-fill";
          fill.style.setProperty(
            "--bar-width",
            `${(volume / carrier.maxVolume) * 100}%`,
          );
          const bound = document.createElement("strong");
          bound.textContent = `${carrier.minVolume}–${carrier.maxVolume}`;
          track.append(fill);
          row.append(label, track, bound);
          bars.append(row);
        });
      }
      field("[data-carrier-reading]")!.textContent = feasible
        ? copy.carrierBalanced
        : total !== 860
          ? format(copy.carrierMismatch, {
              total: String(total),
              difference: String(Math.abs(860 - total)),
            })
          : copy.carrierBounds;
    }

    const plans: Record<string, number[]> = {
      match: data.periods.map((period) => period.demand),
      smooth: [225, 225, 225, 225],
      batch: [440, 0, 460, 0],
    };
    function renderPeriod(planId: string) {
      const production = plans[planId];
      let inventory = 0;
      let holdingUnits = 0;
      let setups = 0;
      let productionCost = 0;
      let setupCost = 0;
      const body = root.querySelector<HTMLTableSectionElement>("[data-period-body]");
      body?.replaceChildren();
      data.periods.forEach((period, index) => {
        const qty = production[index] || 0;
        inventory += qty - period.demand;
        holdingUnits += Math.max(0, inventory);
        if (qty > 0) {
          setups += 1;
          setupCost += period.setupCost;
        }
        productionCost += qty * period.productionCost;
        const tr = document.createElement("tr");
        [period.period, period.demand, qty, inventory].forEach((value) => {
          const td = document.createElement("td");
          td.textContent = String(value);
          tr.append(td);
        });
        body?.append(tr);
      });
      const holdingCost = holdingUnits * data.periods[0].holdingCost;
      const totalCost = productionCost + setupCost + holdingCost;
      field("[data-period-production]")!.textContent = String(
        production.reduce((sum, value) => sum + value, 0),
      );
      field("[data-period-setups]")!.textContent = String(setups);
      field("[data-period-holding]")!.textContent = String(holdingUnits);
      field("[data-period-cost]")!.textContent = totalCost.toFixed(0);
      field("[data-period-reading]")!.textContent = copy.planReadings[planId];
      root
        .querySelectorAll<HTMLButtonElement>("[data-production-plan]")
        .forEach((button) =>
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.productionPlan === planId),
          ),
        );
    }

    function setMode(mode: string) {
      root
        .querySelectorAll<HTMLButtonElement>("[data-flow-mode]")
        .forEach((button) =>
          button.setAttribute("aria-pressed", String(button.dataset.flowMode === mode)),
        );
      root.querySelectorAll<HTMLElement>("[data-flow-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.flowPanel !== mode;
      });
    }

    root.querySelectorAll<HTMLButtonElement>("[data-flow-mode]").forEach((button) => {
      button.addEventListener(
        "click",
        () => setMode(button.dataset.flowMode || "carrier"),
        { signal: controller.signal },
      );
    });
    root
      .querySelectorAll<HTMLInputElement>("[data-carrier-input]")
      .forEach((input) =>
        input.addEventListener("input", renderCarriers, { signal: controller.signal }),
      );
    root
      .querySelectorAll<HTMLButtonElement>("[data-production-plan]")
      .forEach((button) =>
        button.addEventListener(
          "click",
          () => renderPeriod(button.dataset.productionPlan || "match"),
          { signal: controller.signal },
        ),
      );

    renderCarriers();
    renderPeriod("match");
    setMode(root.dataset.defaultMode || "carrier");
    flowCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => flowCleanup?.());
  document.addEventListener("astro:page-load", initFlowLab);
  initFlowLab();
</script>
