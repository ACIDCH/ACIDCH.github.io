---
import { optimisationUniverse } from "../../data/supply-chain-optimisation";
import type { Locale } from "../../config/site";
import { decisionUi } from "../../i18n/decision-ui";
interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const copy = decisionUi[locale].horizon;
const cases = optimisationUniverse.planningCases.map((item) => ({
  id: item.horizon,
  ...copy.cases[item.horizon],
}));
const payload = JSON.stringify(cases).replace(/</g, "\\u003c");
---

<section class="dm-lab" data-horizon-lab aria-labelledby="horizon-title">
  <div class="dm-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="horizon-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="dm-lab__chips" aria-label={copy.controlsLabel}>
    {
      cases.map((item, index) => (
        <button
          type="button"
          data-horizon-choice={item.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {item.horizon}
        </button>
      ))
    }
  </div>

  <div class="dm-lab__cards" aria-live="polite">
    <article data-horizon-card="decision" data-active="true">
      <h4>Decision</h4><p data-horizon-decision>{cases[0].decision}</p>
    </article>
    <article data-horizon-card="example">
      <h4>Business example</h4><p data-horizon-example>{cases[0].example}</p>
    </article>
    <article data-horizon-card="reversibility">
      <h4>Reversibility</h4><p data-horizon-reversibility>{cases[0].reversibility}</p>
    </article>
  </div>

  <div class="dm-lab__equation" data-horizon-model>
    Strategic → network footprint → binary/opening decisions + long-lived capacity
  </div>
  <div class="dm-lab__callout">
    <strong>Model design implication</strong><span data-horizon-reading
      >{copy.initialReading}</span
    >
  </div>
  <script is:inline type="application/json" data-horizon-source set:html={payload} />
</section>

<script>
  type HorizonCase = {
    id: string;
    horizon: string;
    decision: string;
    example: string;
    reversibility: string;
    model: string;
    reading: string;
  };
  let horizonCleanup: (() => void) | undefined;
  function initHorizonLab() {
    horizonCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-horizon-lab]");
    const source = root?.querySelector<HTMLScriptElement>("[data-horizon-source]");
    if (!root || !source) return;
    const cases = JSON.parse(source.textContent || "[]") as HorizonCase[];
    const controller = new AbortController();
    const decision = root.querySelector<HTMLElement>("[data-horizon-decision]");
    const example = root.querySelector<HTMLElement>("[data-horizon-example]");
    const reversibility = root.querySelector<HTMLElement>(
      "[data-horizon-reversibility]",
    );
    const model = root.querySelector<HTMLElement>("[data-horizon-model]");
    const reading = root.querySelector<HTMLElement>("[data-horizon-reading]");
    root
      .querySelectorAll<HTMLButtonElement>("[data-horizon-choice]")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const selected = cases.find(
              (item) => item.id === button.dataset.horizonChoice,
            );
            if (!selected) return;
            root
              .querySelectorAll<HTMLButtonElement>("[data-horizon-choice]")
              .forEach((candidate) =>
                candidate.setAttribute("aria-pressed", String(candidate === button)),
              );
            if (decision) decision.textContent = selected.decision;
            if (example) example.textContent = selected.example;
            if (reversibility) reversibility.textContent = selected.reversibility;
            if (model) model.textContent = selected.model;
            if (reading) reading.textContent = selected.reading;
          },
          { signal: controller.signal },
        );
      });
    horizonCleanup = () => controller.abort();
  }
  document.addEventListener("astro:before-swap", () => horizonCleanup?.());
  document.addEventListener("astro:page-load", initHorizonLab);
  initHorizonLab();
</script>
