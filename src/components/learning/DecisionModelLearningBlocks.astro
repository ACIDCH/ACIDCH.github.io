---
import FeasibleRegionSensitivityLab from "./FeasibleRegionSensitivityLab.astro";
import FixedChargeMilpLab from "./FixedChargeMilpLab.astro";
import ModelScaleLab from "./ModelScaleLab.astro";
import OptimisationAnatomyLab from "./OptimisationAnatomyLab.astro";
import PlanningHorizonLab from "./PlanningHorizonLab.astro";
import PulpModelAnatomyLab from "./PulpModelAnatomyLab.astro";
import SupplyChainFlowLab from "./SupplyChainFlowLab.astro";
import UnconstrainedTradeoffLab from "./UnconstrainedTradeoffLab.astro";
import type { Locale } from "../../config/site";

interface Props {
  slug: string;
  locale?: Locale;
}

const { slug, locale = "zh" } = Astro.props;
---

{
  slug === "optimisation-model-anatomy" && (
    <div class="learning-note__inline-block" data-learning-block="optimisation-anatomy">
      <OptimisationAnatomyLab locale={locale} />
    </div>
  )
}
{
  slug === "unconstrained-optimisation" && (
    <div
      class="learning-note__inline-block"
      data-learning-block="unconstrained-tradeoff"
    >
      <UnconstrainedTradeoffLab locale={locale} />
    </div>
  )
}
{
  (slug === "constrained-optimisation" ||
    slug === "optimisation-sensitivity-analysis") && (
    <div
      class="learning-note__inline-block"
      data-learning-block="feasible-region-sensitivity"
    >
      <FeasibleRegionSensitivityLab locale={locale} />
    </div>
  )
}
{
  slug === "binary-milp-decisions" && (
    <div class="learning-note__inline-block" data-learning-block="fixed-charge-milp">
      <FixedChargeMilpLab locale={locale} />
    </div>
  )
}
{
  (slug === "sets-indices-model-scale" || slug === "multidimensional-optimisation") && (
    <div class="learning-note__inline-block" data-learning-block="model-scale">
      <ModelScaleLab locale={locale} />
    </div>
  )
}
{
  slug === "pulp-model-architecture" && (
    <div class="learning-note__inline-block" data-learning-block="pulp-model-anatomy">
      <PulpModelAnatomyLab locale={locale} />
    </div>
  )
}
{
  slug === "transportation-models" && (
    <>
      <div class="learning-note__inline-block" data-learning-block="planning-horizon">
        <PlanningHorizonLab locale={locale} />
      </div>
      <div class="learning-note__inline-block" data-learning-block="supply-chain-flow">
        <SupplyChainFlowLab defaultMode="carrier" locale={locale} />
      </div>
    </>
  )
}
{
  slug === "multi-period-production-inventory" && (
    <div class="learning-note__inline-block" data-learning-block="supply-chain-flow">
      <SupplyChainFlowLab defaultMode="period" locale={locale} />
    </div>
  )
}
