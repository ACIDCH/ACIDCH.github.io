---
import type { Locale } from "../../config/site";
import { decisionUi } from "../../i18n/decision-ui";

interface Props {
  locale?: Locale;
}

const { locale = "zh" } = Astro.props;
const copy = decisionUi[locale].anatomy;
const scenarios = copy.scenarios;
const payload = JSON.stringify(scenarios).replace(/</g, "\\u003c");
---

<section
  class="dm-lab"
  data-optimisation-anatomy
  aria-labelledby="optimisation-anatomy-title"
>
  <div class="dm-lab__intro">
    <p class="learning-note-kicker">{copy.kicker}</p>
    <h3 id="optimisation-anatomy-title">{copy.title}</h3>
    <p>{copy.intro}</p>
  </div>

  <div class="dm-lab__chips" aria-label={copy.controlsLabel}>
    {
      scenarios.map((scenario, index) => (
        <button
          type="button"
          data-anatomy-choice={scenario.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {scenario.label}
        </button>
      ))
    }
  </div>

  <div class="dm-lab__callout">
    <strong>{copy.questionLabel}</strong>
    <span data-anatomy-question>{scenarios[0].question}</span>
  </div>

  <div class="dm-lab__grid" aria-live="polite">
    <article class="dm-lab__panel">
      <h4>{copy.objectiveLabel}</h4>
      <p data-anatomy-objective>{scenarios[0].objective}</p>
    </article>
    <article class="dm-lab__panel">
      <h4>{copy.parametersLabel}</h4>
      <p data-anatomy-parameters>{scenarios[0].parameters}</p>
    </article>
    <article class="dm-lab__panel">
      <h4>{copy.decisionsLabel}</h4>
      <p data-anatomy-decisions>{scenarios[0].decisions}</p>
    </article>
    <article class="dm-lab__panel">
      <h4>{copy.constraintsLabel}</h4>
      <p data-anatomy-constraints>{scenarios[0].constraints}</p>
    </article>
  </div>

  <div class="dm-lab__equation" data-anatomy-equation>
    Business question → decisions → objective → constraints → solve → interpret
  </div>

  <script is:inline type="application/json" data-anatomy-source set:html={payload} />
</section>

<script>
  type Scenario = {
    id: string;
    label: string;
    objective: string;
    parameters: string;
    decisions: string;
    constraints: string;
    question: string;
  };

  let anatomyCleanup: (() => void) | undefined;

  function initOptimisationAnatomy() {
    anatomyCleanup?.();
    const root = document.querySelector<HTMLElement>("[data-optimisation-anatomy]");
    if (!root) return;
    const source = root.querySelector<HTMLScriptElement>("[data-anatomy-source]");
    if (!source) return;
    const scenarios = JSON.parse(source.textContent || "[]") as Scenario[];
    const controller = new AbortController();
    const fields = {
      question: root.querySelector<HTMLElement>("[data-anatomy-question]"),
      objective: root.querySelector<HTMLElement>("[data-anatomy-objective]"),
      parameters: root.querySelector<HTMLElement>("[data-anatomy-parameters]"),
      decisions: root.querySelector<HTMLElement>("[data-anatomy-decisions]"),
      constraints: root.querySelector<HTMLElement>("[data-anatomy-constraints]"),
    };

    root
      .querySelectorAll<HTMLButtonElement>("[data-anatomy-choice]")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const selected = scenarios.find(
              (item) => item.id === button.dataset.anatomyChoice,
            );
            if (!selected) return;
            root
              .querySelectorAll<HTMLButtonElement>("[data-anatomy-choice]")
              .forEach((candidate) =>
                candidate.setAttribute("aria-pressed", String(candidate === button)),
              );
            Object.entries(fields).forEach(([key, element]) => {
              if (element) element.textContent = selected[key as keyof Scenario];
            });
          },
          { signal: controller.signal },
        );
      });

    anatomyCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => anatomyCleanup?.());
  document.addEventListener("astro:page-load", initOptimisationAnatomy);
  initOptimisationAnatomy();
</script>
