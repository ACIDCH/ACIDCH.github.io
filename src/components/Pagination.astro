---
import type { Locale } from "../config/site";
import { formatSharedUi, sharedUi } from "../i18n/shared-ui";
import { getPaginationPath, withQuery } from "../utils/pagination";
import { withBase } from "../utils/paths";

interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  locale: Locale;
  query?: Record<string, string | undefined>;
}

const { currentPage, totalPages, basePath, locale, query = {} } = Astro.props;
const copy = sharedUi[locale].pagination;
const status = formatSharedUi(copy.status, {
  current: currentPage,
  total: totalPages,
});
const hrefFor = (page: number) =>
  withBase(withQuery(getPaginationPath(basePath, page), query));
---

{
  totalPages > 1 && (
    <nav
      class="pagination"
      aria-label={copy.label}
      data-pagination
      data-pagination-base={basePath}
      data-pagination-current={currentPage}
      data-pagination-total={totalPages}
    >
      <p class="pagination__status" data-pagination-status aria-live="polite">
        {status}
      </p>
      <div class="pagination__controls">
        {currentPage > 1 ? (
          <a rel="prev" href={hrefFor(currentPage - 1)} data-pagination-previous>
            {copy.previous}
          </a>
        ) : (
          <span aria-disabled="true">{copy.previous}</span>
        )}
        <ol>
          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              <a
                href={hrefFor(page)}
                aria-current={page === currentPage ? "page" : undefined}
                data-pagination-page={page}
              >
                {page}
              </a>
            </li>
          ))}
        </ol>
        {currentPage < totalPages ? (
          <a rel="next" href={hrefFor(currentPage + 1)} data-pagination-next>
            {copy.next}
          </a>
        ) : (
          <span aria-disabled="true">{copy.next}</span>
        )}
      </div>
    </nav>
  )
}
