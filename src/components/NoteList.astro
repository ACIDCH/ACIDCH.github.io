---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import { getCanonicalNoteTags } from "../data/note-tag-taxonomy";
import { getSharedUi } from "../i18n/shared-ui";
import { getLocalizedPath } from "../utils/paths";

interface Props {
  entries: CollectionEntry<"notes">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const copy = getSharedUi(locale).noteList;
---

{
  entries.length === 0 ? (
    <p>{copy.empty}</p>
  ) : (
    <ul class="content-list">
      {entries.map((entry) => {
        const displayTitle =
          entry.data.locale === "zh"
            ? (copy.handbookTitles[entry.data.slug] ?? entry.data.title)
            : entry.data.title;
        const isCompactHandbook =
          entry.data.locale === "zh" && Boolean(copy.handbookTitles[entry.data.slug]);
        const displaySeries =
          entry.data.locale === "zh" && entry.data.seriesSlug === "decision-models"
            ? copy.decisionSeries
            : entry.data.series;
        const canonicalTags = getCanonicalNoteTags(entry);

        return (
          <li
            data-reveal
            data-note-card
            data-search={`${entry.data.title} ${displayTitle} ${entry.data.summary} ${entry.data.tags.join(" ")} ${entry.data.topics.join(" ")} ${entry.data.tools.join(" ")} ${canonicalTags.join(" ")} ${displaySeries ?? ""}`.toLocaleLowerCase()}
            data-tags={canonicalTags.join("|").toLocaleLowerCase()}
            data-topics={entry.data.topics.join("|").toLocaleLowerCase()}
            data-tools={entry.data.tools.join("|").toLocaleLowerCase()}
            data-series={(displaySeries ?? "").toLocaleLowerCase()}
          >
            <article
              class:list={["note-card", isCompactHandbook && "note-card--handbook"]}
            >
              {isCompactHandbook ? (
                <h2>
                  <a href={getLocalizedPath(`/notes/${entry.data.slug}/`, locale)}>
                    {displayTitle}
                  </a>
                </h2>
              ) : (
                <>
                  <p class="status">{entry.data.draft ? copy.draft : copy.published}</p>
                  <h2>
                    <a href={getLocalizedPath(`/notes/${entry.data.slug}/`, locale)}>
                      {displayTitle}
                    </a>
                  </h2>
                  <p>{entry.data.summary}</p>
                  {(displaySeries || canonicalTags.length > 0) && (
                    <div class="note-card__metadata">
                      {displaySeries && <span class="tag">{displaySeries}</span>}
                      {canonicalTags.map((tag) => (
                        <a
                          class="tag"
                          href={getLocalizedPath(
                            `/notes/?tag=${encodeURIComponent(tag)}`,
                            locale,
                          )}
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  )}
                  {entry.data.isPlaceholder && (
                    <span class="tag">{copy.placeholder}</span>
                  )}
                </>
              )}
            </article>
          </li>
        );
      })}
    </ul>
  )
}
