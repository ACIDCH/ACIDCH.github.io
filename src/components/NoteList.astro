---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import { getEditorialNoteCopy } from "../data/note-editorial-copy";
import { getCanonicalNoteTags } from "../data/note-tag-taxonomy";
import { getLocalizedPath } from "../utils/paths";

interface Props {
  entries: CollectionEntry<"notes">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const compactHandbooks = new Set(["descriptive-statistics", "sql-relational-data"]);
---

{
  entries.length === 0 ? (
    <p>{locale === "en" ? "No notes are available yet." : "暂时没有可展示的笔记。"}</p>
  ) : (
    <ul class="content-list">
      {entries.map((entry) => {
        const editorial = getEditorialNoteCopy({
          slug: entry.data.slug,
          locale: entry.data.locale,
          title: entry.data.title,
          summary: entry.data.summary,
        });
        const isCompactHandbook = entry.data.locale === "zh" && compactHandbooks.has(entry.data.slug);
        const displaySeries =
          entry.data.locale === "zh" && entry.data.seriesSlug === "decision-models"
            ? "供应链与优化"
            : entry.data.series;
        const canonicalTags = getCanonicalNoteTags(entry);

        return (
          <li
            data-reveal
            data-note-card
            data-search={`${entry.data.title} ${editorial.title} ${entry.data.summary} ${editorial.summary} ${entry.data.tags.join(" ")} ${entry.data.topics.join(" ")} ${entry.data.tools.join(" ")} ${canonicalTags.join(" ")} ${displaySeries ?? ""}`.toLocaleLowerCase()}
            data-tags={canonicalTags.join("|").toLocaleLowerCase()}
            data-topics={entry.data.topics.join("|").toLocaleLowerCase()}
            data-tools={entry.data.tools.join("|").toLocaleLowerCase()}
            data-series={(displaySeries ?? "").toLocaleLowerCase()}
          >
            <article class:list={["note-card", isCompactHandbook && "note-card--handbook"]}>
              {isCompactHandbook ? (
                <h2><a href={getLocalizedPath(`/notes/${entry.data.slug}/`, locale)}>{editorial.title}</a></h2>
              ) : (
                <>
                  <p class="status">{entry.data.draft ? (locale === "en" ? "Draft" : "草稿") : locale === "en" ? "Published" : "已发布"}</p>
                  <h2><a href={getLocalizedPath(`/notes/${entry.data.slug}/`, locale)}>{editorial.title}</a></h2>
                  <p>{editorial.summary}</p>
                  {(displaySeries || canonicalTags.length > 0) && (
                    <div class="note-card__metadata">
                      {displaySeries && <span class="tag">{displaySeries}</span>}
                      {canonicalTags.map((tag) => (
                        <a class="tag" href={getLocalizedPath(`/notes/?tag=${encodeURIComponent(tag)}`, locale)}>{tag}</a>
                      ))}
                    </div>
                  )}
                  {entry.data.isPlaceholder && <span class="tag">{locale === "en" ? "Placeholder" : "占位内容"}</span>}
                </>
              )}
            </article>
          </li>
        );
      })}
    </ul>
  )
}
