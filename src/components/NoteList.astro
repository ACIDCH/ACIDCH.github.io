---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import { getLocalizedPath } from "../utils/paths";

interface Props {
  entries: CollectionEntry<"notes">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const handbookTitles: Record<string, string> = {
  "descriptive-statistics": "统计学与 R",
  "sql-relational-data": "SQL 与关系数据",
};
---

{
  entries.length === 0 ? (
    <p>{locale === "en" ? "No notes are available yet." : "暂时没有可展示的笔记。"}</p>
  ) : (
    <ul class="content-list">
      {entries.map((entry) => {
        const displayTitle =
          entry.data.locale === "zh"
            ? (handbookTitles[entry.data.slug] ?? entry.data.title)
            : entry.data.title;
        const isCompactHandbook =
          entry.data.locale === "zh" && Boolean(handbookTitles[entry.data.slug]);
        const displaySeries =
          entry.data.locale === "zh" && entry.data.seriesSlug === "decision-models"
            ? "供应链与优化"
            : entry.data.series;

        return (
          <li
            data-reveal
            data-note-card
            data-search={`${entry.data.title} ${displayTitle} ${entry.data.summary} ${entry.data.tags.join(" ")} ${entry.data.topics.join(" ")} ${entry.data.tools.join(" ")} ${displaySeries ?? ""}`.toLocaleLowerCase()}
            data-tags={entry.data.tags.join("|").toLocaleLowerCase()}
            data-topics={entry.data.topics.join("|").toLocaleLowerCase()}
            data-tools={entry.data.tools.join("|").toLocaleLowerCase()}
            data-series={(displaySeries ?? "").toLocaleLowerCase()}
          >
            <article class:list={["note-card", isCompactHandbook && "note-card--handbook"]}>
              {isCompactHandbook ? (
                <h2>
                  <a href={getLocalizedPath(`/notes/${entry.data.slug}/`, locale)}>
                    {displayTitle}
                  </a>
                </h2>
              ) : (
                <>
                  <p class="status">
                    {entry.data.draft
                      ? locale === "en"
                        ? "Draft"
                        : "草稿"
                      : locale === "en"
                        ? "Published"
                        : "已发布"}
                  </p>
                  <h2>
                    <a href={getLocalizedPath(`/notes/${entry.data.slug}/`, locale)}>
                      {displayTitle}
                    </a>
                  </h2>
                  <p>{entry.data.summary}</p>
                  {(displaySeries ||
                    entry.data.tags.length ||
                    entry.data.topics.length ||
                    entry.data.tools.length) && (
                    <div class="note-card__metadata">
                      {displaySeries && <span class="tag">{displaySeries}</span>}
                      {entry.data.tags.map((tag) => (
                        <a
                          class="tag"
                          href={getLocalizedPath(
                            `/notes/?tag=${encodeURIComponent(tag)}`,
                            locale,
                          )}
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  )}
                  {entry.data.isPlaceholder && (
                    <span class="tag">{locale === "en" ? "Placeholder" : "占位内容"}</span>
                  )}
                </>
              )}
            </article>
          </li>
        );
      })}
    </ul>
  )
}
