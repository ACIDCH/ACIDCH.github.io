---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  entries: CollectionEntry<"projects">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

{
  entries.length === 0 ? (
    <p>
      {locale === "en" ? "No projects are available yet." : "暂时没有可展示的项目。"}
    </p>
  ) : (
    <ul class="content-list">
      {entries.map((entry) => (
        <li
          data-project-card
          data-project-tools={entry.data.tools.join("|")}
          data-project-topic={entry.data.topic}
          data-project-status={entry.data.status}
        >
          <ProjectCard entry={entry} locale={locale} />
        </li>
      ))}
    </ul>
  )
}
