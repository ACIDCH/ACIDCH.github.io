---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import { getLocalizedPath } from "../utils/paths";

interface Props {
  entries: CollectionEntry<"projects">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const statusLabels = {
  planned: { en: "Planned", zh: "计划中" },
  "in-development": { en: "In development", zh: "开发中" },
  completed: { en: "Completed", zh: "已完成" },
} as const;
---

{
  entries.length === 0 ? (
    <p>
      {locale === "en" ? "No projects are available yet." : "暂时没有可展示的项目。"}
    </p>
  ) : (
    <ul class="content-list">
      {entries.map((entry) => (
        <li>
          <article>
            <div class="cluster cluster--compact">
              <p class="status">{statusLabels[entry.data.status][locale]}</p>
              {entry.data.isPlaceholder && (
                <span class="tag">
                  {locale === "en" ? "Demo / placeholder" : "演示 / 占位"}
                </span>
              )}
            </div>
            <h2>
              <a href={getLocalizedPath(`/projects/${entry.data.slug}/`, locale)}>
                {entry.data.title}
              </a>
            </h2>
            <p>{entry.data.summary}</p>
            <ul class="tag-list" aria-label={locale === "en" ? "Tools" : "工具"}>
              {entry.data.tools.map((tool) => (
                <li class="tag">{tool}</li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ul>
  )
}
