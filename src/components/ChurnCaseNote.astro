---
import ChurnMicroIcon from "./ChurnMicroIcon.astro";

interface Props {
  label?: string;
}

const { label = "Note." } = Astro.props;
---

<aside class="churn-case-note" aria-label={label}>
  <span class="churn-case-note__icon" aria-hidden="true">
    <ChurnMicroIcon name="note" decorative />
  </span>
  <div class="churn-case-note__body">
    <strong>{label}</strong>
    <slot />
  </div>
</aside>

<style>
  .churn-case-note {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    max-width: 78ch;
    margin: 1.45rem 0 0;
    padding: 0.95rem 1rem 1rem;
    border: 1px solid color-mix(in srgb, var(--colour-border) 88%, transparent);
    border-left: 3px solid var(--colour-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--colour-accent) 7%, var(--colour-surface)),
      color-mix(in srgb, var(--colour-surface) 96%, transparent) 46%
    );
    color: var(--colour-text-muted);
    font-size: 0.88rem;
    line-height: 1.68;
    box-shadow: 0 0.45rem 1.25rem rgb(8 28 39 / 4%);
  }

  .churn-case-note__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid color-mix(in srgb, var(--colour-accent) 28%, var(--colour-border));
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--colour-accent) 8%, var(--colour-surface));
    color: var(--colour-accent);
  }

  .churn-case-note__body {
    min-width: 0;
  }

  .churn-case-note :global(p) {
    margin: 0;
  }

  .churn-case-note strong {
    display: inline-block;
    margin: 0 0.45rem 0.28rem 0;
    color: var(--colour-text);
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 520px) {
    .churn-case-note {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 0.9rem;
    }

    .churn-case-note__icon {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
</style>
