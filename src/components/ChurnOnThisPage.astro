---
interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: readonly Section[];
  label?: string;
}

const { sections, label = "本页导航" } = Astro.props;
const instanceId = `churn-toc-${Math.random().toString(36).slice(2, 8)}`;
---

<nav class="churn-on-page" aria-label={label} data-churn-toc={instanceId}>
  <details class="churn-on-page__mobile">
    <summary>
      <span>{label}</span>
      <span data-churn-toc-current>{sections[0]?.label}</span>
    </summary>
    <div class="churn-on-page__links">
      {
        sections.map((section) => (
          <a href={`#${section.id}`} data-churn-toc-link={section.id}>
            {section.label}
          </a>
        ))
      }
    </div>
  </details>

  <div class="churn-on-page__desktop">
    <div class="churn-on-page__heading">
      <p>{label}</p>
      <span aria-hidden="true"><i data-churn-toc-progress></i></span>
    </div>
    <ol>
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`} data-churn-toc-link={section.id}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{section.label}</strong>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<script is:inline define:vars={{ instanceId }}>
  const initialize = () => {
    const nav = document.querySelector(`[data-churn-toc="${instanceId}"]`);
    if (!(nav instanceof HTMLElement) || nav.dataset.ready === "true") return;
    nav.dataset.ready = "true";

    const links = [...nav.querySelectorAll("[data-churn-toc-link]")];
    const current = nav.querySelector("[data-churn-toc-current]");
    const progress = nav.querySelector("[data-churn-toc-progress]");
    const details = nav.querySelector("details");
    const sections = links
      .map((link) =>
        document.getElementById(link.getAttribute("data-churn-toc-link") || ""),
      )
      .filter(Boolean);

    const activate = (id) => {
      const activeIndex = Math.max(
        0,
        links.findIndex((link) => link.getAttribute("data-churn-toc-link") === id),
      );

      links.forEach((link) => {
        const active = link.getAttribute("data-churn-toc-link") === id;
        link.toggleAttribute("aria-current", active);
      });

      const activeLink = links[activeIndex];
      if (current && activeLink)
        current.textContent = activeLink.textContent?.replace(/^\d+/, "").trim() || "";

      if (progress instanceof HTMLElement && links.length > 0) {
        progress.style.width = `${((activeIndex + 1) / links.length) * 100}%`;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target instanceof HTMLElement) activate(visible.target.id);
      },
      { rootMargin: "-20% 0px -68% 0px", threshold: [0.05, 0.2, 0.5] },
    );

    sections.forEach((section) => observer.observe(section));
    links.forEach((link) =>
      link.addEventListener("click", () => {
        if (details) details.removeAttribute("open");
      }),
    );
    activate(sections[0]?.id || "");
  };

  document.addEventListener("astro:page-load", initialize);
  initialize();
</script>

<style>
  .churn-on-page {
    color: var(--colour-text-muted);
  }

  .churn-on-page__mobile {
    display: none;
  }

  .churn-on-page__desktop {
    width: 100%;
    min-width: 0;
  }

  .churn-on-page__heading {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }

  .churn-on-page__heading p {
    margin: 0;
    color: var(--colour-text);
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .churn-on-page__heading > span {
    display: block;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--colour-border);
  }

  .churn-on-page__heading i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--colour-primary), var(--colour-accent));
    transition: width 320ms var(--ease-standard);
  }

  .churn-on-page ol {
    display: grid;
    gap: 0.08rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .churn-on-page a {
    color: inherit;
    text-decoration: none;
  }

  .churn-on-page__desktop a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.45rem;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.48rem 0.55rem 0.48rem 0.15rem;
    border-radius: 0.7rem;
    font-size: 0.8rem;
    line-height: 1.35;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .churn-on-page__desktop a > span {
    color: var(--colour-accent);
    font: 700 0.67rem/1.5 var(--font-mono);
  }

  .churn-on-page__desktop a strong {
    min-width: 0;
    font-weight: 650;
  }

  .churn-on-page__desktop a:hover {
    color: var(--colour-text);
    background: var(--colour-surface-subtle);
    transform: translateX(0.12rem);
  }

  .churn-on-page__desktop a[aria-current] {
    color: var(--colour-primary-strong);
    background: color-mix(in srgb, var(--colour-primary) 9%, var(--colour-surface));
    box-shadow: inset 2px 0 0 var(--colour-primary);
  }

  @media (min-width: 1200px) {
    .churn-on-page__desktop {
      padding: 1rem 0 1rem 1rem;
      border-left: 1px solid var(--colour-border);
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .churn-on-page__desktop {
      padding: 0.8rem 1rem;
      border: 1px solid var(--colour-border);
      border-radius: 1.25rem;
      background: color-mix(in srgb, var(--colour-surface) 94%, transparent);
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(0.8rem);
    }

    .churn-on-page__heading {
      grid-template-columns: auto minmax(5rem, 1fr);
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.55rem;
    }

    .churn-on-page ol {
      display: flex;
      gap: 0.3rem;
      overflow-x: auto;
      padding-bottom: 0.1rem;
      scrollbar-width: thin;
    }

    .churn-on-page__desktop a {
      display: inline-flex;
      min-height: 2.35rem;
      padding: 0.45rem 0.65rem;
      white-space: nowrap;
    }

    .churn-on-page__desktop a > span {
      display: none;
    }

    .churn-on-page__desktop a:hover {
      transform: translateY(-1px);
    }

    .churn-on-page__desktop a[aria-current] {
      box-shadow: inset 0 -2px 0 var(--colour-primary);
    }
  }

  @media (max-width: 767px) {
    .churn-on-page__desktop {
      display: none;
    }

    .churn-on-page__mobile {
      display: block;
      border: 1px solid var(--colour-border);
      border-radius: 1rem;
      background: color-mix(in srgb, var(--colour-surface) 96%, transparent);
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(0.8rem);
    }

    .churn-on-page summary {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      min-height: 3rem;
      padding: 0.85rem 1rem;
      color: var(--colour-text);
      cursor: pointer;
      list-style: none;
      font-size: 0.84rem;
      font-weight: 650;
    }

    .churn-on-page summary::-webkit-details-marker {
      display: none;
    }

    .churn-on-page summary span:last-child {
      overflow: hidden;
      color: var(--colour-primary-strong);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .churn-on-page__links {
      display: grid;
      max-height: min(55dvh, 24rem);
      overflow-y: auto;
      border-top: 1px solid var(--colour-border);
    }

    .churn-on-page__links a {
      padding: 0.78rem 1rem;
      border-bottom: 1px solid var(--colour-border);
      color: var(--colour-text-muted);
      font-size: 0.84rem;
    }

    .churn-on-page__links a:last-child {
      border-bottom: 0;
    }

    .churn-on-page__links a[aria-current] {
      color: var(--colour-primary-strong);
      background: var(--colour-surface-subtle);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .churn-on-page__heading i,
    .churn-on-page__desktop a {
      transition: none;
      transform: none;
    }
  }
</style>
