---
import { correlations } from "../data/r-machine-learning";

const detailByPair: Record<string, string> = {
  "weeks_since_signup::weeks_since_last_charge":
    "两个周数变量承载高度重叠的时间信息；距上次充电更直接描述当前不活跃状态。",
  "app_version_lag_weeks::app_crashes_30d":
    "版本滞后在探索阶段保留，最终由更直接的应用异常信号承接。",
  "avg_wait_minutes::charger_fault_rate":
    "排队体验与设施可靠性相关但含义不同，因此没有按单一阈值机械删除。",
  "avg_wait_minutes::peak_share":
    "该关系用于理解拥挤情境；peak_share 没有进入最终七变量。",
};
const detailFor = (left: string, right: string) =>
  detailByPair[`${left}::${right}`] ?? "该配对保留为变量审阅背景。";
---

<figure class="correlation-explorer" data-correlation-explorer>
  <figcaption>
    <span>EDA / 03</span>
    <div>
      <h3>相关性用于判断信息重叠，而不是替代业务判断</h3>
      <p>四个经核实的关键配对按相关系数排序。选择一个配对，查看它如何影响最终变量去向。</p>
    </div>
  </figcaption>

  <div class="correlation-explorer__scale" aria-hidden="true">
    <span>较弱</span><b>|r|</b><span>较强</span>
  </div>

  <div class="correlation-explorer__grid" role="list" aria-label="关键变量相关性">
    {
      correlations.map((item, index) => (
        <button
          type="button"
          role="listitem"
          class:list={[index === 0 && "is-active"]}
          data-correlation-option={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span>{item.left}</span>
          <i style={`--correlation:${Math.abs(item.value) * 100}%`}>
            <u aria-hidden="true" />
            <b>r {item.value.toFixed(2)}</b>
          </i>
          <span>{item.right}</span>
        </button>
      ))
    }
  </div>

  <div class="correlation-explorer__detail" aria-live="polite">
    <div>
      <small>当前配对</small>
      <p data-correlation-pair>{correlations[0].left} × {correlations[0].right}</p>
    </div>
    <strong data-correlation-value>r = {correlations[0].value.toFixed(2)}</strong>
    <span data-correlation-decision>{correlations[0].decision}</span>
    <p data-correlation-detail>
      {detailFor(correlations[0].left, correlations[0].right)}
    </p>
  </div>

  <p class="figure-reading">
    0.88 是明确的冗余信号；0.41、0.39 与 0.37 主要用于理解变量之间的共同变化。相关性本身不证明某个服务或行为变量造成流失。
  </p>
  <p class="correlation-explorer__note">
    <strong>Note.</strong> 所有系数只用于变量审阅与信息重叠判断；最终保留与删除仍结合变量含义和解释目标。
  </p>
</figure>

<script is:inline define:vars={{ correlations, detailByPair }}>
  const initialize = () => {
    document.querySelectorAll("[data-correlation-explorer]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;
      root.dataset.ready = "true";

      const buttons = [...root.querySelectorAll("[data-correlation-option]")];
      const fields = {
        pair: root.querySelector("[data-correlation-pair]"),
        value: root.querySelector("[data-correlation-value]"),
        decision: root.querySelector("[data-correlation-decision]"),
        detail: root.querySelector("[data-correlation-detail]"),
      };

      const activate = (index, focus = false) => {
        const item = correlations[index];
        if (!item) return;
        buttons.forEach((option, optionIndex) => {
          const selected = optionIndex === index;
          option.classList.toggle("is-active", selected);
          option.setAttribute("aria-pressed", String(selected));
          option.tabIndex = selected ? 0 : -1;
        });
        fields.pair.textContent = `${item.left} × ${item.right}`;
        fields.value.textContent = `r = ${item.value.toFixed(2)}`;
        fields.decision.textContent = item.decision;
        fields.detail.textContent =
          detailByPair[`${item.left}::${item.right}`] ?? "该配对保留为变量审阅背景。";
        if (focus) buttons[index]?.focus();
      };

      buttons.forEach((button, index) => {
        button.tabIndex = index === 0 ? 0 : -1;
        button.addEventListener("click", () => activate(index));
        button.addEventListener("keydown", (event) => {
          if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
          event.preventDefault();
          const next =
            event.key === "Home"
              ? 0
              : event.key === "End"
                ? buttons.length - 1
                : (index + (event.key === "ArrowDown" ? 1 : -1) + buttons.length) %
                  buttons.length;
          activate(next, true);
        });
      });

      activate(0);
    });
  };

  document.addEventListener("astro:page-load", initialize);
  initialize();
</script>

<style>
  .correlation-explorer {
    margin: 0;
  }

  .correlation-explorer figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .correlation-explorer figcaption > span {
    width: max-content;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    color: var(--colour-primary-strong);
    font: 700 0.7rem/1 var(--font-mono);
  }

  .correlation-explorer h3,
  .correlation-explorer p {
    margin: 0;
  }

  .correlation-explorer h3 {
    max-width: 27ch;
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    line-height: 1.15;
  }

  .correlation-explorer figcaption p,
  .correlation-explorer__reading,
  .correlation-explorer__note {
    max-width: 72ch;
    margin-top: 0.6rem;
    color: var(--colour-text-muted);
    line-height: 1.72;
  }

  .correlation-explorer__scale {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: center;
    width: min(11rem, 100%);
    margin: 0 0 0.7rem auto;
    color: var(--colour-text-muted);
    font-size: 0.66rem;
  }

  .correlation-explorer__scale span:last-child {
    text-align: right;
  }

  .correlation-explorer__scale b {
    color: var(--colour-primary-strong);
    font: 700 0.66rem/1 var(--font-mono);
  }

  .correlation-explorer__grid {
    display: grid;
    border: 1px solid var(--colour-border);
    background: var(--colour-border);
  }

  .correlation-explorer button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1rem;
    border: 0;
    border-bottom: 1px solid var(--colour-border);
    background: var(--colour-surface);
    color: var(--colour-text);
    text-align: left;
    cursor: pointer;
  }

  .correlation-explorer button:last-child {
    border-bottom: 0;
  }

  .correlation-explorer button:hover,
  .correlation-explorer button.is-active {
    background: color-mix(in srgb, var(--colour-primary) 9%, var(--colour-surface));
  }

  .correlation-explorer button > span {
    overflow-wrap: anywhere;
    font: 600 0.76rem/1.4 var(--font-mono);
  }

  .correlation-explorer button i {
    position: relative;
    display: grid;
    place-items: center;
    height: 0.65rem;
    overflow: visible;
    border-radius: 999px;
    background: var(--colour-surface-raised);
    font-style: normal;
  }

  .correlation-explorer button i u {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--correlation);
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--colour-primary) 44%, transparent),
      var(--colour-primary)
    );
    text-decoration: none;
  }

  .correlation-explorer button i b {
    z-index: 1;
    transform: translateY(-1.25rem);
    font: 700 0.7rem/1 var(--font-mono);
    white-space: nowrap;
  }

  .correlation-explorer__detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem 1.25rem;
    margin-top: 1rem;
    padding: 1.1rem;
    border-left: 3px solid var(--colour-accent);
    background: var(--colour-surface);
  }

  .correlation-explorer__detail > div {
    display: grid;
    gap: 0.28rem;
  }

  .correlation-explorer__detail small {
    color: var(--colour-accent);
    font: 700 0.64rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .correlation-explorer__detail > p:last-child {
    grid-column: 1 / -1;
    color: var(--colour-text-muted);
    line-height: 1.65;
  }

  .correlation-explorer__detail strong {
    align-self: center;
    font: 750 1.4rem/1 var(--font-display);
  }

  .correlation-explorer__detail > span {
    grid-column: 1 / -1;
    color: var(--colour-primary-strong);
    font-size: 0.86rem;
  }

  .correlation-explorer__reading {
    padding-left: 1rem;
    border-left: 3px solid var(--colour-accent);
  }

  .correlation-explorer__note {
    padding: 0.78rem 0 0.78rem 1rem;
    border-left: 2px solid var(--colour-border-strong);
    font-size: 0.84rem;
  }

  .correlation-explorer__note strong {
    color: var(--colour-text);
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.06em;
  }

  @media (max-width: 560px) {
    .correlation-explorer figcaption {
      grid-template-columns: 1fr;
    }

    .correlation-explorer__scale {
      margin-left: 0;
    }

    .correlation-explorer button {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .correlation-explorer button i {
      width: 100%;
    }

    .correlation-explorer__detail {
      grid-template-columns: 1fr;
    }

    .correlation-explorer__detail strong {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .correlation-explorer button {
      transition: none;
      transform: none !important;
    }
  }
</style>
