---
import type { Locale } from "../../config/site";
import { portfolioConfig } from "../../config/portfolio";
import { sharedUi } from "../../i18n/shared-ui";
import { withBase } from "../../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sharedUi[locale].hero;
const { homeHero } = portfolioConfig.media;
const background = homeHero.available ? homeHero.desktop : homeHero.fallback;
const mobileBackground = homeHero.available ? homeHero.mobile : homeHero.fallback;
---

<section
  class="home-hero"
  aria-labelledby="home-title"
  style={`--hero-overlay: ${homeHero.overlay}; --hero-position-desktop: ${homeHero.position.desktop}; --hero-position-mobile: ${homeHero.position.mobile};`}
  data-home-hero
>
  <picture class="home-hero__media" aria-hidden="true">
    <source media="(max-width: 48rem)" srcset={withBase(mobileBackground)} />
    <img
      src={withBase(background)}
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <span class="home-hero__overlay" aria-hidden="true"></span>
  <div class="home-hero__content">
    <slot />
  </div>
  <a class="home-hero__scroll-cue" href="#home-content">
    <span>{copy.scroll}</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let activeHeroCleanup: (() => void) | undefined;

  function initHomeHero() {
    activeHeroCleanup?.();
    const hero = document.querySelector<HTMLElement>("[data-home-hero]");
    if (!hero) return;
    const controller = new AbortController();

    const update = () => {
      if (reducedMotion.matches) {
        hero.style.removeProperty("--hero-scroll");
        return;
      }

      const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
      hero.style.setProperty("--hero-scroll", progress.toFixed(3));
    };

    window.addEventListener("scroll", update, {
      passive: true,
      signal: controller.signal,
    });
    reducedMotion.addEventListener("change", update, { signal: controller.signal });
    activeHeroCleanup = () => controller.abort();
    update();
  }

  document.addEventListener("astro:before-swap", () => activeHeroCleanup?.());
  document.addEventListener("astro:page-load", initHomeHero);
  initHomeHero();
</script>
