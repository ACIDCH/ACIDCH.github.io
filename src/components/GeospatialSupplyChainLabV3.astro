  .geo3__cost { margin-top: .42rem; padding: .62rem; border: 1px solid rgba(216,255,107,.22); background: rgba(70,90,33,.14); }
  .geo3__cost strong { display: block; margin-top: .4rem; color: var(--acid); font: 700 1rem monospace; }
  .geo3__status { margin: .65rem 0 0; color: #7796a2; font-size: .65rem; line-height: 1.45; }
  .geo3__open-list { display: grid; gap: .34rem; margin-top: .65rem; }
