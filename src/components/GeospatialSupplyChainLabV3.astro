          simDone: "Monte Carlo 稳健性模拟完成。",
          routeLoading: "正在加载当前分配对应的真实道路几何…",
          routeDone: "道路路径已加载。",
          routePartial: "部分道路路径不可用，已保留直线分配。",
          remove: "删除",
          auto: "自动",
          must: "必须开启",
          exclude: "排除",
          mapOn: "地图添加：开启",
          mapOff: "地图添加：关闭",
          abMissing: "需要先分别保存 A 和 B。",
          abReady: "A / B 对比已生成。",
          savedA: "已保存情景 A。",
          savedB: "已保存情景 B。",
          facility: "设施",
          demand: "需求",
          warehouse: "仓库",
          factory: "工厂",
        }
      : {
          graphReady: "Course OD baseline is ready.",
          graphLoading: "Loading and building the OSM drivable road graph…",
          graphLoaded: "OSM edge-level road graph loaded.",
          graphFail: "OSM road graph failed; course OD mode remains available.",
          geocoding: "Resolving the location and updating the road matrix…",
          addFailed: "Location add failed. Check the address or network service.",
          noSolution: "No feasible solution under the current facility, coverage, capacity or fleet constraints.",
          solved: "Scenario re-optimised.",
          simRunning: "Running robustness simulation…",
          simDone: "Monte Carlo robustness simulation complete.",
          routeLoading: "Loading real road geometry for the current allocation…",
          routeDone: "Road routes loaded.",
          routePartial: "Some routes were unavailable; straight allocations remain.",
          remove: "Remove",
          auto: "Auto",
          must: "Must open",
          exclude: "Exclude",
          mapOn: "Map add: on",
          mapOff: "Map add: off",
          abMissing: "Save both A and B first.",
          abReady: "A / B comparison generated.",
          savedA: "Scenario A saved.",
          savedB: "Scenario B saved.",
          facility: "Facility",
          demand: "Demand",
          warehouse: "Warehouse",
          factory: "Factory",
        };

    const baseHubNames = [
      "328 Ponsonby Road",
      "322 Great North Road",
      "214 Green Lane West",
      "151 Beach Road",
      "76 Coates Avenue",
      "151 Neilson Street",
    ];
    const baseHubQueries = [
      "328 Ponsonby Road, Ponsonby, Auckland, New Zealand",
      "322 Great North Road, Grey Lynn, Auckland, New Zealand",
      "214 Green Lane West, Epsom, Auckland, New Zealand",
      "151 Beach Road, Auckland CBD, Auckland, New Zealand",
      "76 Coates Avenue, Orakei, Auckland, New Zealand",
      "151 Neilson Street, Onehunga, Auckland, New Zealand",
    ];
    const baseDemandNames = [
      "Auckland CBD",
      "Epsom",
      "Grey Lynn",
      "Mount Eden",
      "Newmarket",
      "Onehunga",
      "Orakei",
      "Ponsonby",
      "Remuera",
      "Three Kings",
    ];
    const baseDemandQueries = baseDemandNames.map(
      (name) => `${name}, Auckland, New Zealand`,
    );
    const baseDemands = [4000, 600, 700, 800, 500, 600, 400, 700, 900, 400];
    const baseDistances = [
      [2.07, 5.8, 2.04, 4.66, 4.12, 10.66, 7.5, 0.31, 7.7, 7.89],
      [4.2, 5.62, 1.29, 4.26, 4.94, 10.03, 9.5, 3.22, 8.51, 6.91],
      [6.45, 1.92, 6.76, 2.79, 3.44, 4.19, 7.26, 7.27, 4.42, 3.23],
      [1.45, 4.95, 4.85, 4.11, 2.47, 9.25, 4.48, 3.52, 4.89, 7.33],
      [5.56, 6.79, 8.98, 7.29, 5.05, 9.13, 0, 7.63, 2.87, 9.6],
      [10.7, 6.17, 10.99, 7.03, 7.69, 1.04, 9.48, 11.52, 6.62, 4.27],
    ];

    let hubNames = [...baseHubNames];
    let hubQueries = [...baseHubQueries];
    let hubTypes = baseHubNames.map(() => "warehouse");
    let demandNames = [...baseDemandNames];
    let demandQueries = [...baseDemandQueries];
    let demands = [...baseDemands];
    let matrix = baseDistances.map((row) => [...row]);
    let hubCoords = [];
    let demandCoords = [];
    let custom = [];
    let policies = baseHubNames.map(() => "auto");
    let maxOpen = 4;
    let fleet = 20;
    let newRoads = 4;
    let solution = null;
    let activeMatrix = matrix.map((row) => [...row]);
    let roadGraph = null;
    let lastMonteCarlo = null;
    let mapAddMode = false;
    const slots = { A: null, B: null };

    const $ = (id) => document.getElementById(id);
    const map = window.L.map("geo3-map", { zoomControl: true }).setView(
      [-36.873, 174.766],
      12,
    );
    window.L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
      {
        maxZoom: 20,
        subdomains: "abcd",
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; CARTO',
      },
    ).addTo(map);
    const facilityLayer = window.L.layerGroup().addTo(map);
    const demandLayer = window.L.layerGroup().addTo(map);
    const allocationLayer = window.L.layerGroup().addTo(map);
    const coverageLayer = window.L.layerGroup().addTo(map);
    const routeLayer = window.L.layerGroup().addTo(map);

    const sleep = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
    const money = (value) =>
      Number.isFinite(value)
        ? `NZ$${Number(value).toLocaleString(undefined, { maximumFractionDigits: 0 })}`
        : "—";
    const percentage = (value) =>
      Number.isFinite(value) ? `${(value * 100).toFixed(1)}%` : "—";

    const geocodeOne = async (query) => {
      const url = new URL("https://nominatim.openstreetmap.org/search");
      url.searchParams.set("q", query);
      url.searchParams.set("format", "jsonv2");
      url.searchParams.set("limit", "1");
      url.searchParams.set("countrycodes", "nz");
      const response = await fetch(url.toString(), {
        headers: { "Accept-Language": zh ? "zh,en;q=0.8" : "en" },
      });
      if (!response.ok) throw new Error(`Nominatim ${response.status}`);
      const data = await response.json();
      if (!data.length) throw new Error("No geocode result");
      return {
        lat: Number(data[0].lat),
        lon: Number(data[0].lon),
        label: data[0].display_name || query,
      };
    };

    const reverseGeocode = async (point) => {
      const url = new URL("https://nominatim.openstreetmap.org/reverse");
      url.searchParams.set("lat", String(point.lat));
      url.searchParams.set("lon", String(point.lon));
      url.searchParams.set("format", "jsonv2");
      const response = await fetch(url.toString(), {
        headers: { "Accept-Language": zh ? "zh,en;q=0.8" : "en" },
      });
      if (!response.ok) return `${point.lat.toFixed(5)}, ${point.lon.toFixed(5)}`;
      const data = await response.json();
      return data.display_name || `${point.lat.toFixed(5)}, ${point.lon.toFixed(5)}`;
    };

    const ensureBaseCoords = async () => {
      const key = "acidch-geo-v3-base-coords";
      try {
        const cached = JSON.parse(localStorage.getItem(key) || "null");
        if (
          cached?.hubs?.length === baseHubNames.length &&
          cached?.demands?.length === baseDemandNames.length
        ) {
          hubCoords = [...cached.hubs, ...hubCoords.slice(baseHubNames.length)];
          demandCoords = [
            ...cached.demands,
            ...demandCoords.slice(baseDemandNames.length),
          ];
          return;
        }
      } catch {
        // Refresh invalid cache.
      }
      const hubs = [];
      const demandPoints = [];
      for (const query of baseHubQueries) {
        hubs.push(await geocodeOne(query));
        await sleep(1050);
      }
      for (const query of baseDemandQueries) {
        demandPoints.push(await geocodeOne(query));
        await sleep(1050);
      }
      hubCoords = [...hubs, ...hubCoords.slice(baseHubNames.length)];
      demandCoords = [
        ...demandPoints,
        ...demandCoords.slice(baseDemandNames.length),
      ];
      localStorage.setItem(key, JSON.stringify({ hubs, demands: demandPoints }));
    };

    const osrmTable = async (sources, destinations) => {
      const points = [...sources, ...destinations];
      const coords = points.map((p) => `${p.lon},${p.lat}`).join(";");
      const sourceIds = sources.map((_, i) => i).join(";");
      const destinationIds = destinations
        .map((_, i) => i + sources.length)
        .join(";");
      const url =
        `https://router.project-osrm.org/table/v1/driving/${coords}` +
        `?sources=${sourceIds}&destinations=${destinationIds}&annotations=distance,duration`;
      const response = await fetch(url);
      if (!response.ok) throw new Error(`OSRM table ${response.status}`);
      const data = await response.json();
      if (!Array.isArray(data.distances)) throw new Error("No OSRM table");
      return {
        distances: data.distances.map((row) =>
          row.map((value) => (Number.isFinite(value) ? value / 1000 : Infinity)),
        ),
        durations: data.durations.map((row) =>
          row.map((value) => (Number.isFinite(value) ? value / 60 : Infinity)),
        ),
      };
    };

    const scenarioParams = (seedOffset = 0) => ({
      mode: $("geo3-road-mode").value,
      congestionSeverity: Number($("geo3-congestion").value) / 100,
      congestionShare: Number($("geo3-congestion-share").value) / 100,
      closureShare: Number($("geo3-closure").value) / 100,
      improvement: 0.25,
      improvementShare: 0.3,
      newRoadLinks: newRoads,
      maxNewRoadKm: 0.65,
      newRoadSpeedKph: 50,
      seed: Number($("geo3-seed").value) + seedOffset,
    });

    const solverParams = (scenarioMatrix) => {
      const totalDemand = demands.reduce((a, b) => a + b, 0);
      const multiplier = Number($("geo3-demand-multiplier").value);
      const fleetCapacity =
        fleet *
        Number($("geo3-vehicle-capacity").value) *
        Number($("geo3-trips").value);
      return {
        matrix: scenarioMatrix,
        demands,
        policies,
        maxOpen,
        redundancy: Number($("geo3-redundancy").value),
        threshold: Number($("geo3-threshold").value),
        facilityCapacity: Number($("geo3-facility-capacity").value),
        fixedCost: Number($("geo3-fixed-cost").value),
        transportCost: Number($("geo3-transport-cost").value),
        objective: $("geo3-objective").value,
        demandMultiplier: multiplier,
        fleetCapacity,
        enforceFleet: $("geo3-enforce-fleet").checked,
        totalDemand: totalDemand * multiplier,
      };
    };

    const inventoryInputs = () => ({
      mean: Number($("geo3-inv-mean").value),
      sd: Number($("geo3-inv-sd").value),
      leadTime: Number($("geo3-lead-time").value),
      z: Number($("geo3-service").value),
    });

    const updateLabels = () => {
      $("geo3-congestion-out").textContent = `${$("geo3-congestion").value}%`;
      $("geo3-congestion-share-out").textContent = `${$("geo3-congestion-share").value}%`;
      $("geo3-closure-out").textContent = `${$("geo3-closure").value}%`;
      $("geo3-new-roads-out").textContent = String(newRoads);
      $("geo3-demand-multiplier-out").textContent = `${Number($("geo3-demand-multiplier").value).toFixed(2)}×`;
      $("geo3-max-open-out").textContent = String(maxOpen);
      $("geo3-fleet-out").textContent = String(fleet);
      const osm = $("geo3-engine").value === "osm";
      const threshold = $("geo3-threshold");
      if (osm) {
        threshold.min = "5";
        threshold.max = "60";
        threshold.step = "1";
        if (Number(threshold.value) < 5) threshold.value = "30";
        $("geo3-threshold-out").textContent = `${Number(threshold.value).toFixed(0)} min`;
      } else {
        threshold.min = "3";
        threshold.max = "15";
        threshold.step = "0.5";
        if (Number(threshold.value) > 15) threshold.value = "6";
        $("geo3-threshold-out").textContent = `${Number(threshold.value).toFixed(1)} km`;
      }
    };

    const renderPolicies = () => {
      $("geo3-facility-count").textContent = String(hubNames.length);
      $("geo3-policy-list").innerHTML = hubNames
        .map(
          (name, index) => `
            <div class="geo3__policy-row">
              <div><strong>${name}</strong><small>${hubTypes[index] === "factory" ? t.factory : t.warehouse}</small></div>
              <select data-policy="${index}">
                <option value="auto" ${policies[index] === "auto" ? "selected" : ""}>${t.auto}</option>
                <option value="must" ${policies[index] === "must" ? "selected" : ""}>${t.must}</option>
                <option value="exclude" ${policies[index] === "exclude" ? "selected" : ""}>${t.exclude}</option>
              </select>
            </div>`,
        )
        .join("");
      document.querySelectorAll("[data-policy]").forEach((select) => {
        select.addEventListener("change", () => {
          policies[Number(select.dataset.policy)] = select.value;
        });
      });
    };

    const renderCustom = () => {
      $("geo3-custom-count").textContent = String(custom.length);
      $("geo3-custom-list").innerHTML = custom.length
        ? custom
            .map(
              (item) => `
                <div class="geo3__custom-row">
                  <div><strong>${item.name}</strong><small>${item.type} · ${item.lat.toFixed(5)}, ${item.lon.toFixed(5)}</small></div>
                  <button type="button" data-remove-custom="${item.id}">${t.remove}</button>
                </div>`,
            )
            .join("")
        : `<p>—</p>`;
      document.querySelectorAll("[data-remove-custom]").forEach((button) => {
        button.addEventListener("click", () => removeCustom(button.dataset.removeCustom));
      });
    };

    const currentInventory = () => inventoryPolicy(inventoryInputs());

    const renderMap = () => {
      facilityLayer.clearLayers();
      demandLayer.clearLayers();
      allocationLayer.clearLayers();
      coverageLayer.clearLayers();
      const layer = $("geo3-layer").value;
      const inv = currentInventory();
      const stability = new Map(
        (lastMonteCarlo?.facilityStability || []).map((x) => [x.index, x.probability]),
      );
      const utilisation = new Map();
      if (solution?.selected && solution?.utilisation) {
        solution.selected.forEach((hub, local) => utilisation.set(hub, solution.utilisation[local]));
      }

      hubCoords.forEach((point, index) => {
        if (!point) return;
        const active = solution?.selected?.includes(index);
        let radius = active ? 9 : 6;
        if (layer === "utilisation" && active) radius = 6 + 10 * (utilisation.get(index) || 0);
        if (layer === "risk") radius = 5 + 12 * (stability.get(index) || 0);
        const baseColor = hubTypes[index] === "factory" ? "#ffcc66" : "#62ecff";
        const color = active ? "#d8ff6b" : baseColor;
        let detail = hubTypes[index];
        if (layer === "utilisation" && active) detail += `<br>Utilisation: ${percentage(utilisation.get(index))}`;
        if (layer === "inventory" && active) detail += `<br>SS: ${inv.safetyStock.toFixed(0)} · ROP: ${inv.reorderPoint.toFixed(0)}`;
        if (layer === "risk") detail += `<br>Selection: ${percentage(stability.get(index) || 0)}`;
        window.L.circleMarker([point.lat, point.lon], {
          radius,
          weight: active ? 3 : 1.4,
          color,
          fillColor: color,
          fillOpacity: active ? 0.92 : 0.5,
        })
          .bindTooltip(`<strong>${hubNames[index]}</strong><br>${detail}`)
          .addTo(facilityLayer);
      });

      demandCoords.forEach((point, index) => {
        if (!point) return;
        window.L.circleMarker([point.lat, point.lon], {
          radius: Math.max(4, Math.min(10, 4 + (demands[index] || 0) / 900)),
          color: "#ff759a",
          weight: 1.2,
          fillColor: "#ff3d78",
          fillOpacity: 0.62,
        })
          .bindTooltip(`<strong>${demandNames[index]}</strong><br>Demand: ${(demands[index] || 0).toLocaleString()}`)
          .addTo(demandLayer);
      });

      if (solution?.assignments && hubCoords.length && demandCoords.length) {
        const maxFlow = Math.max(1, ...solution.assignments.map((x) => x.flow));
        solution.assignments.forEach((item) => {
          const a = hubCoords[item.hub];
          const b = demandCoords[item.demand];
          if (!a || !b) return;
          const weight = layer === "flow" ? 1.2 + (item.flow / maxFlow) * 6 : 1.5;
          const opacity = layer === "network" ? 0.42 : 0.7;
          const label =
            layer === "cost"
              ? `${money(item.flow * item.networkCost * Number($("geo3-transport-cost").value))}`
              : `Flow: ${item.flow.toFixed(0)}`;
          window.L.polyline(
            [
              [a.lat, a.lon],
              [b.lat, b.lon],
            ],
            {
              color: layer === "cost" ? "#ffcc66" : "#62ecff",
              weight,
              opacity,
              dashArray: layer === "network" ? "4 8" : undefined,
            },
          )
            .bindTooltip(label)
            .addTo(allocationLayer);
        });
      }

      if (layer === "coverage" && solution && $("geo3-engine").value === "od") {
        const radiusMeters = Number($("geo3-threshold").value) * 1000;
        solution.selected.forEach((index) => {
          const p = hubCoords[index];
          if (!p) return;
          window.L.circle([p.lat, p.lon], {
            radius: radiusMeters,
            color: "#d8ff6b",
            weight: 1,
            fillOpacity: 0.035,
            opacity: 0.45,
          }).addTo(coverageLayer);
        });
      }
    };

    const renderResults = () => {
      const inv = currentInventory();
      const totalDemand =
        demands.reduce((a, b) => a + b, 0) * Number($("geo3-demand-multiplier").value);
      const fleetCapacity =
        fleet * Number($("geo3-vehicle-capacity").value) * Number($("geo3-trips").value);
      $("geo3-kpi-fleet").textContent = `${Math.min(999, (fleetCapacity / Math.max(1, totalDemand)) * 100).toFixed(0)}%`;
      $("geo3-kpi-ss").textContent = inv.safetyStock.toFixed(0);
      $("geo3-kpi-rop").textContent = inv.reorderPoint.toFixed(0);
      if (!solution) {
        $("geo3-kpi-hubs").textContent = "—";
        $("geo3-kpi-coverage").textContent = "0%";
        $("geo3-kpi-network").textContent = "—";
        $("geo3-kpi-cost").textContent = "—";
        $("geo3-open-list").innerHTML = "";
        $("geo3-status").textContent = t.noSolution;
        return;
      }
      const holding =
        inv.safetyStock *
        Number($("geo3-holding-cost").value) *
        solution.selected.length;
      solution.totalScenarioCost = solution.score + holding;
      $("geo3-kpi-hubs").textContent = String(solution.selected.length);
      $("geo3-kpi-coverage").textContent = "100%";
      $("geo3-kpi-network").textContent = `${solution.averageNetworkCost.toFixed(2)} ${$("geo3-engine").value === "osm" ? "min" : "km"}`;
      $("geo3-kpi-cost").textContent = money(solution.totalScenarioCost);
      $("geo3-open-list").innerHTML = solution.selected
        .map(
          (index, local) => `
            <div><span>${String(index + 1).padStart(2, "0")}</span><div><strong>${hubNames[index]}</strong><small>Utilisation ${percentage(solution.utilisation[local])}</small></div></div>`,
        )
        .join("");
      $("geo3-status").textContent = t.solved;
    };

    const buildActiveMatrix = async (seedOffset = 0) => {
      if ($("geo3-engine").value === "osm") {
        if (!roadGraph) throw new Error("OSM graph not loaded");
        await ensureBaseCoords();
        return graphOdMatrix({
          graph: roadGraph,
          sources: hubCoords,
          destinations: demandCoords,
          scenarioParams: scenarioParams(seedOffset),
          metric: "time",
        }).matrix;
      }
      return applyOdScenario(matrix, scenarioParams(seedOffset));
    };

    const runScenario = async () => {
      $("geo3-status").textContent = zh ? "正在计算当前情景…" : "Calculating scenario…";
      routeLayer.clearLayers();
      try {
        activeMatrix = await buildActiveMatrix();
        solution = solveFacilityNetwork(solverParams(activeMatrix));
      } catch (error) {
        console.warn("[Geo V3] scenario failed", error);
        solution = null;
      }
      renderResults();
      renderMap();
      $("geo3-routes").disabled = !solution;
    };

    const renderRobustness = (result) => {
      lastMonteCarlo = result;
      $("geo3-robust").hidden = false;
      $("geo3-mc-expected").textContent = money(result.expectedCost);
      $("geo3-mc-p95").textContent = money(result.p95Cost);
      $("geo3-mc-failure").textContent = percentage(result.failureRate);
      $("geo3-mc-travel").textContent = Number.isFinite(result.averageNetworkCost)
        ? `${result.averageNetworkCost.toFixed(2)} ${$("geo3-engine").value === "osm" ? "min" : "km"}`
        : "—";
      $("geo3-mc-stockout").textContent = percentage(result.stockoutProbability);
      $("geo3-stability").innerHTML = result.facilityStability
        .slice(0, 8)
        .map(
          (item) => `<div><span>${item.name}</span><strong>${percentage(item.probability)}</strong><i style="--p:${Math.min(1, item.probability)}"></i></div>`,
        )
        .join("");
      renderMap();
    };

    const runEdgeMonteCarlo = async (runs) => {
      const n = Math.min(25, runs);
      const costs = [];
      const travel = [];
      const counts = Array(hubNames.length).fill(0);
      let failures = 0;
      for (let i = 0; i < n; i += 1) {
        const scenarioMatrix = await buildActiveMatrix(i * 7919);
        const candidate = solveFacilityNetwork(solverParams(scenarioMatrix));
        if (!candidate) failures += 1;
        else {
          costs.push(candidate.score);
          travel.push(candidate.averageNetworkCost);
          candidate.selected.forEach((index) => {
            counts[index] += 1;
          });
        }
        if (i % 3 === 0) await sleep(0);
      }
      const sorted = [...costs].sort((a, b) => a - b);
      const inv = simulateInventoryStockout({
        ...inventoryInputs(),
        runs: Math.max(200, n * 10),
        seed: Number($("geo3-seed").value) + 104729,
      });
      return {
        runs: n,
        successfulRuns: n - failures,
        expectedCost: costs.length ? costs.reduce((a, b) => a + b, 0) / costs.length : null,
        p95Cost: sorted.length ? sorted[Math.min(sorted.length - 1, Math.ceil(sorted.length * 0.95) - 1)] : null,
        failureRate: failures / n,
        averageNetworkCost: travel.length ? travel.reduce((a, b) => a + b, 0) / travel.length : null,
        stockoutProbability: inv.stockoutProbability,
        facilityStability: counts
          .map((count, index) => ({ index, name: hubNames[index], probability: count / n }))
          .sort((a, b) => b.probability - a.probability),
      };
    };

    const runSimulation = async () => {
      $("geo3-status").textContent = t.simRunning;
      $("geo3-simulate").disabled = true;
      try {
        const runs = Number($("geo3-runs").value);
        let result;
        if ($("geo3-engine").value === "osm") {
          if (!roadGraph) throw new Error("OSM graph not loaded");
          result = await runEdgeMonteCarlo(runs);
        } else {
          result = runMonteCarlo({
            baseMatrix: matrix,
            solverParams: solverParams(matrix),
            scenarioParams: scenarioParams(),
            runs,
            seed: Number($("geo3-seed").value),
            facilityNames: hubNames,
            inventory: inventoryInputs(),
          });
        }
        renderRobustness(result);
        $("geo3-status").textContent = t.simDone;
      } catch (error) {
        console.warn("[Geo V3] Monte Carlo failed", error);
        $("geo3-status").textContent = t.noSolution;
      } finally {
        $("geo3-simulate").disabled = false;
      }
    };

    const updateMatrixForNewPoint = async (point, type) => {
      await ensureBaseCoords();
      if (type === "demand") {
        const table = await osrmTable(hubCoords, [point]);
        matrix.forEach((row, index) => row.push(table.distances[index][0]));
        demandCoords.push(point);
      } else {
        const table = await osrmTable([point], demandCoords);
        matrix.push(table.distances[0]);
        hubCoords.push(point);
      }
    };

    const addPoint = async ({ point, name, type, demandQty }) => {
      await updateMatrixForNewPoint(point, type);
      const id = `custom-${Date.now()}-${Math.random().toString(16).slice(2)}`;
      if (type === "demand") {
        demandNames.push(name);
        demandQueries.push(name);
        demands.push(Math.max(0, Number(demandQty) || 0));
      } else {
        hubNames.push(name);
        hubQueries.push(name);
        hubTypes.push(type);
        policies.push("auto");
        maxOpen = Math.min(Math.max(1, maxOpen), hubNames.length);
      }
      custom.push({ id, name, type, lat: point.lat, lon: point.lon });
      roadGraph = null;
      $("geo3-engine").value = "od";
      $("geo3-graph-status").textContent = t.graphReady;
      renderCustom();
      renderPolicies();
      updateLabels();
      await runScenario();
    };

    const removeCustom = async (id) => {
      const item = custom.find((x) => x.id === id);
      if (!item) return;
      if (item.type === "demand") {
        const index = demandNames.indexOf(item.name);
        if (index >= baseDemandNames.length) {
          demandNames.splice(index, 1);
          demandQueries.splice(index, 1);
          demands.splice(index, 1);
          demandCoords.splice(index, 1);
          matrix.forEach((row) => row.splice(index, 1));
        }
      } else {
        const index = hubNames.indexOf(item.name);
        if (index >= baseHubNames.length) {
          hubNames.splice(index, 1);
          hubQueries.splice(index, 1);
          hubTypes.splice(index, 1);
          hubCoords.splice(index, 1);
          policies.splice(index, 1);
          matrix.splice(index, 1);
          maxOpen = Math.min(maxOpen, hubNames.length);
        }
      }
      custom = custom.filter((x) => x.id !== id);
      roadGraph = null;
      $("geo3-engine").value = "od";
      renderCustom();
      renderPolicies();
      updateLabels();
      await runScenario();
    };

    const bboxForPoints = (points) => {
      const lats = points.map((p) => p.lat);
      const lons = points.map((p) => p.lon);
      const pad = 0.008;
      return [
        Math.min(...lats) - pad,
        Math.min(...lons) - pad,
        Math.max(...lats) + pad,
        Math.max(...lons) + pad,
      ];
    };

    const loadRoadGraph = async () => {
      $("geo3-graph-status").textContent = t.graphLoading;
      $("geo3-load-graph").disabled = true;
      try {
        await ensureBaseCoords();
        const points = [...hubCoords, ...demandCoords];
        const [south, west, north, east] = bboxForPoints(points);
        const query = `[out:json][timeout:35];way["highway"]["highway"!~"footway|path|cycleway|steps|pedestrian|track"](${south},${west},${north},${east});(._;>;);out body;`;
        const endpoints = [
          "https://overpass-api.de/api/interpreter",
          "https://overpass.kumi.systems/api/interpreter",
        ];
        let data = null;
        for (const endpoint of endpoints) {
          try {
            const response = await fetch(endpoint, {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
              body: `data=${encodeURIComponent(query)}`,
            });
            if (!response.ok) throw new Error(`Overpass ${response.status}`);
            data = await response.json();
            break;
          } catch (error) {
            console.warn("[Geo V3] Overpass endpoint failed", endpoint, error);
          }
        }
        if (!data?.elements?.length) throw new Error("No Overpass graph");
        roadGraph = parseOverpassGraph(data.elements);
        if (roadGraph.edges.length < 100) throw new Error("Road graph too small");
        $("geo3-engine").value = "osm";
        $("geo3-graph-status").textContent = `${t.graphLoaded} ${roadGraph.nodeList.length.toLocaleString()} nodes / ${roadGraph.edges.length.toLocaleString()} directed edges.`;
        updateLabels();
        await runScenario();
      } catch (error) {
        console.warn("[Geo V3] OSM graph load failed", error);
        roadGraph = null;
        $("geo3-engine").value = "od";
        $("geo3-graph-status").textContent = t.graphFail;
        updateLabels();
      } finally {
        $("geo3-load-graph").disabled = false;
      }
    };

    const snapshot = () => ({
      result: solution ? JSON.parse(JSON.stringify(solution)) : null,
      settings: {
        engine: $("geo3-engine").value,
        roadMode: $("geo3-road-mode").value,
        threshold: Number($("geo3-threshold").value),
        redundancy: Number($("geo3-redundancy").value),
        fleet,
        maxOpen,
        demandMultiplier: Number($("geo3-demand-multiplier").value),
      },
    });

    const compareSlots = () => {
      if (!slots.A?.result || !slots.B?.result) {
        $("geo3-ab").textContent = t.abMissing;
        return;
      }
      const delta = compareScenarioResults(slots.A.result, slots.B.result);
      $("geo3-ab").innerHTML = `
        <div><span>Δ Facilities</span><strong>${delta.hubs > 0 ? "+" : ""}${delta.hubs ?? "—"}</strong></div>
        <div><span>Δ Cost</span><strong>${delta.cost == null ? "—" : `${delta.cost >= 0 ? "+" : "−"}${money(Math.abs(delta.cost))}`}</strong></div>
        <div><span>Δ Network</span><strong>${delta.averageNetworkCost == null ? "—" : `${delta.averageNetworkCost >= 0 ? "+" : ""}${delta.averageNetworkCost.toFixed(2)}`}</strong></div>`;
      $("geo3-status").textContent = t.abReady;
    };

    const loadRoutes = async () => {
      if (!solution) return;
      $("geo3-status").textContent = t.routeLoading;
      $("geo3-routes").disabled = true;
      routeLayer.clearLayers();
      try {
        await ensureBaseCoords();
        let failures = 0;
        for (const item of solution.assignments) {
          const a = hubCoords[item.hub];
          const b = demandCoords[item.demand];
          if (!a || !b) {
            failures += 1;
            continue;
          }
          const url =
            `https://router.project-osrm.org/route/v1/driving/${a.lon},${a.lat};${b.lon},${b.lat}` +
            "?overview=simplified&geometries=geojson&steps=false";
          try {
            const response = await fetch(url);
            const data = await response.json();
            const coords = data.routes?.[0]?.geometry?.coordinates;
            if (!coords?.length) throw new Error("No geometry");
            window.L.polyline(
              coords.map(([lon, lat]) => [lat, lon]),
              { color: "#d8ff6b", weight: 2.6, opacity: 0.82 },
            )
              .bindTooltip(`Flow: ${item.flow.toFixed(0)}`)
              .addTo(routeLayer);
          } catch {
            failures += 1;
          }
          await sleep(90);
        }
        $("geo3-status").textContent = failures ? t.routePartial : t.routeDone;
      } finally {
        $("geo3-routes").disabled = false;
      }
    };

    const reset = async () => {
      hubNames = [...baseHubNames];
      hubQueries = [...baseHubQueries];
      hubTypes = baseHubNames.map(() => "warehouse");
      demandNames = [...baseDemandNames];
      demandQueries = [...baseDemandQueries];
      demands = [...baseDemands];
      matrix = baseDistances.map((row) => [...row]);
      hubCoords = hubCoords.slice(0, baseHubNames.length);
      demandCoords = demandCoords.slice(0, baseDemandNames.length);
      custom = [];
      policies = baseHubNames.map(() => "auto");
      maxOpen = 4;
      fleet = 20;
      newRoads = 4;
      solution = null;
      roadGraph = null;
      lastMonteCarlo = null;
      mapAddMode = false;
      slots.A = null;
      slots.B = null;
      $("geo3-engine").value = "od";
      $("geo3-road-mode").value = "baseline";
      $("geo3-objective").value = "minHubs";
      $("geo3-threshold").value = "6";
      $("geo3-redundancy").value = "1";
      $("geo3-congestion").value = "35";
      $("geo3-congestion-share").value = "35";
      $("geo3-closure").value = "1";
      $("geo3-seed").value = "708709";
      $("geo3-demand-multiplier").value = "1";
      $("geo3-facility-capacity").value = "6000";
      $("geo3-fixed-cost").value = "350000";
      $("geo3-enforce-fleet").checked = true;
      $("geo3-vehicle-capacity").value = "120";
      $("geo3-trips").value = "5";
      $("geo3-transport-cost").value = "0.72";
      $("geo3-layer").value = "network";
      $("geo3-robust").hidden = true;
      $("geo3-ab").innerHTML = "";
      $("geo3-map-add").textContent = t.mapOff;
      $("geo3-graph-status").textContent = t.graphReady;
      routeLayer.clearLayers();
      renderCustom();
      renderPolicies();
      updateLabels();
      await runScenario();
      map.setView([-36.873, 174.766], 12);
    };

    [
      "geo3-congestion",
      "geo3-congestion-share",
      "geo3-closure",
      "geo3-threshold",
      "geo3-demand-multiplier",
    ].forEach((id) => $(id).addEventListener("input", updateLabels));

    document.querySelectorAll("[data-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const delta = Number(button.dataset.delta || 0);
        if (button.dataset.step === "maxOpen") {
          maxOpen = Math.max(1, Math.min(hubNames.length, maxOpen + delta));
        } else if (button.dataset.step === "fleet") {
          fleet = Math.max(0, fleet + delta);
        } else if (button.dataset.step === "newRoads") {
          newRoads = Math.max(0, Math.min(40, newRoads + delta));
        }
        updateLabels();
      });
    });

    $("geo3-engine").addEventListener("change", () => {
      if ($("geo3-engine").value === "osm" && !roadGraph) {
        $("geo3-engine").value = "od";
        $("geo3-graph-status").textContent = t.graphFail;
      }
      updateLabels();
    });
    $("geo3-layer").addEventListener("change", renderMap);
    $("geo3-load-graph").addEventListener("click", loadRoadGraph);
    $("geo3-run").addEventListener("click", runScenario);
    $("geo3-simulate").addEventListener("click", runSimulation);
    $("geo3-routes").addEventListener("click", loadRoutes);
    $("geo3-reset").addEventListener("click", reset);
    $("geo3-save-a").addEventListener("click", () => {
      slots.A = snapshot();
      $("geo3-status").textContent = t.savedA;
    });
    $("geo3-save-b").addEventListener("click", () => {
      slots.B = snapshot();
      $("geo3-status").textContent = t.savedB;
    });
    $("geo3-compare").addEventListener("click", compareSlots);

    $("geo3-add-address").addEventListener("click", async () => {
      const query = $("geo3-address").value.trim();
      if (!query) return;
      $("geo3-status").textContent = t.geocoding;
      $("geo3-add-address").disabled = true;
      try {
        const point = await geocodeOne(
          query.toLowerCase().includes("new zealand")
            ? query
            : `${query}, Auckland, New Zealand`,
        );
        await addPoint({
          point,
          name: query,
          type: $("geo3-role").value,
          demandQty: Number($("geo3-demand-qty").value),
        });
        $("geo3-address").value = "";
      } catch (error) {
        console.warn("[Geo V3] address add failed", error);
        $("geo3-status").textContent = t.addFailed;
      } finally {
        $("geo3-add-address").disabled = false;
      }
    });

    $("geo3-map-add").addEventListener("click", () => {
      mapAddMode = !mapAddMode;
      $("geo3-map-add").textContent = mapAddMode ? t.mapOn : t.mapOff;
      $("geo3-map-add").classList.toggle("is-active", mapAddMode);
    });

    map.on("click", async (event) => {
      if (!mapAddMode) return;
      const point = { lat: event.latlng.lat, lon: event.latlng.lng };
      $("geo3-status").textContent = t.geocoding;
      try {
        const name = await reverseGeocode(point);
        await addPoint({
          point,
          name,
          type: $("geo3-role").value,
          demandQty: Number($("geo3-demand-qty").value),
        });
      } catch (error) {
        console.warn("[Geo V3] map add failed", error);
        $("geo3-status").textContent = t.addFailed;
      }
    });

    try {
      const cached = JSON.parse(localStorage.getItem("acidch-geo-v3-base-coords") || "null");
      if (
        cached?.hubs?.length === baseHubNames.length &&
        cached?.demands?.length === baseDemandNames.length
      ) {
        hubCoords = cached.hubs;
        demandCoords = cached.demands;
      }
    } catch {
      // Ignore invalid cache.
    }

    renderCustom();
    renderPolicies();
    updateLabels();
    runScenario();
  }
</script>

