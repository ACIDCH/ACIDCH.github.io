---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<section id="geo-v3" class="geo3" data-locale={locale}>
  <div class="geo3__map-shell">
    <div id="geo3-map" aria-label="Auckland geospatial supply chain decision map"></div>

    <div class="geo3__identity">
      <span>{c.subtitle}</span>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
    </div>

    <div class="geo3__legend">
      <span><i class="facility"></i> Facility</span>
      <span><i class="demand"></i> Demand</span>
      <span><i class="allocation"></i> Allocation</span>
      <span><i class="route"></i> Road route</span>
    </div>

    <aside class="geo3__console" aria-label="Scenario console">
      <div class="geo3__scroll">
        <section class="geo3__block">
          <div class="geo3__block-title"><span>01</span><strong>{c.scenario}</strong></div>
          <label class="geo3__field"><span>Objective</span><select id="geo3-objective"><option value="minHubs">{c.minHubs}</option><option value="minCost">{c.minCost}</option></select></label>
          <label class="geo3__field"><span>Network engine</span><select id="geo3-engine"><option value="od">{c.graphCourse}</option><option value="osm">{c.graphOsm}</option></select></label>
          <button id="geo3-load-graph" type="button" class="geo3__secondary">{c.loadGraph}</button>
          <p id="geo3-graph-status" class="geo3__micro">{c.graphReady}</p>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>02</span><strong>{c.road}</strong></div>
          <label class="geo3__field"><span>Scenario</span><select id="geo3-road-mode"><option value="baseline">{c.baseline}</option><option value="congestion">{c.congestion}</option><option value="closure">{c.closure}</option><option value="newroad">{c.newRoad}</option><option value="mixed">{c.mixed}</option></select></label>
          <label class="geo3__range"><span>{c.congestion}</span><output id="geo3-congestion-out">35%</output><input id="geo3-congestion" type="range" min="0" max="100" step="5" value="35" /></label>
          <label class="geo3__range"><span>Congested edges</span><output id="geo3-congestion-share-out">35%</output><input id="geo3-congestion-share" type="range" min="0" max="100" step="5" value="35" /></label>
          <label class="geo3__range"><span>{c.closure}</span><output id="geo3-closure-out">1%</output><input id="geo3-closure" type="range" min="0" max="15" step="0.5" value="1" /></label>
          <div class="geo3__stepper-row"><span>Hypothetical new links</span><div class="geo3__stepper"><button type="button" data-step="newRoads" data-delta="-1">−</button><output id="geo3-new-roads-out">4</output><button type="button" data-step="newRoads" data-delta="1">+</button></div></div>
          <label class="geo3__field geo3__field--inline"><span>Random seed</span><input id="geo3-seed" type="number" value="708709" /></label>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>03</span><strong>{c.facilities}</strong></div>
          <label class="geo3__range"><span>{c.threshold}</span><output id="geo3-threshold-out">6.0 km</output><input id="geo3-threshold" type="range" min="3" max="15" step="0.5" value="6" /></label>
          <label class="geo3__field"><span>{c.redundancy}</span><select id="geo3-redundancy"><option value="1">1×</option><option value="2">2×</option></select></label>
          <div class="geo3__stepper-row"><span>{c.maxOpen}</span><div class="geo3__stepper"><button type="button" data-step="maxOpen" data-delta="-1">−</button><output id="geo3-max-open-out">4</output><button type="button" data-step="maxOpen" data-delta="1">+</button></div></div>
          <label class="geo3__field geo3__field--inline"><span>{c.facilityCapacity}</span><input id="geo3-facility-capacity" type="number" min="100" step="100" value="6000" /></label>
          <label class="geo3__field geo3__field--inline"><span>{c.fixedCost}</span><input id="geo3-fixed-cost" type="number" min="0" step="10000" value="350000" /></label>
          <label class="geo3__check"><input id="geo3-enforce-fleet" type="checkbox" checked /><span>{c.enforceFleet}</span></label>
          <div class="geo3__subhead"><span>{c.policy}</span><strong id="geo3-facility-count">6</strong></div>
          <div id="geo3-policy-list" class="geo3__policy-list"></div>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>04</span><strong>{c.fleet}</strong></div>
          <div class="geo3__stepper-row"><span>{c.fleetSize}</span><div class="geo3__stepper"><button type="button" data-step="fleet" data-delta="-1">−</button><output id="geo3-fleet-out">20</output><button type="button" data-step="fleet" data-delta="1">+</button></div></div>
          <label class="geo3__field geo3__field--inline"><span>{c.vehicleCapacity}</span><input id="geo3-vehicle-capacity" type="number" min="1" value="120" /></label>
          <label class="geo3__field geo3__field--inline"><span>{c.trips}</span><input id="geo3-trips" type="number" min="1" value="5" /></label>
          <label class="geo3__field geo3__field--inline"><span>{c.transportCost}</span><input id="geo3-transport-cost" type="number" min="0" step="0.01" value="0.72" /></label>
          <label class="geo3__range"><span>{c.demandMultiplier}</span><output id="geo3-demand-multiplier-out">1.00×</output><input id="geo3-demand-multiplier" type="range" min="0.5" max="1.8" step="0.05" value="1" /></label>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>05</span><strong>{c.inventory}</strong></div>
          <label class="geo3__field geo3__field--inline"><span>{c.meanDemand}</span><input id="geo3-inv-mean" type="number" min="0" value="120" /></label>
          <label class="geo3__field geo3__field--inline"><span>{c.demandSd}</span><input id="geo3-inv-sd" type="number" min="0" value="25" /></label>
          <label class="geo3__field geo3__field--inline"><span>{c.leadTime}</span><input id="geo3-lead-time" type="number" min="0.1" step="0.1" value="2" /></label>
          <label class="geo3__field"><span>{c.serviceLevel}</span><select id="geo3-service"><option value="1.282">90%</option><option value="1.645" selected>95%</option><option value="1.960">97.5%</option><option value="2.326">99%</option></select></label>
          <label class="geo3__field geo3__field--inline"><span>{c.holdingCost}</span><input id="geo3-holding-cost" type="number" min="0" step="0.1" value="1" /></label>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>06</span><strong>{c.edit}</strong></div>
          <label class="geo3__field"><span>{c.role}</span><select id="geo3-role"><option value="warehouse">{c.warehouse}</option><option value="factory">{c.factory}</option><option value="demand">{c.demand}</option></select></label>
          <label class="geo3__field"><span>{c.address}</span><input id="geo3-address" type="text" placeholder="20 Symonds Street, Auckland" /></label>
          <label class="geo3__field geo3__field--inline"><span>{c.demandQty}</span><input id="geo3-demand-qty" type="number" min="0" value="500" /></label>
          <div class="geo3__button-pair"><button id="geo3-add-address" type="button" class="geo3__secondary">{c.addAddress}</button><button id="geo3-map-add" type="button" class="geo3__ghost">{c.mapAddOff}</button></div>
          <div class="geo3__subhead"><span>{c.custom}</span><strong id="geo3-custom-count">0</strong></div>
          <div id="geo3-custom-list" class="geo3__custom-list"></div>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>07</span><strong>{c.simulation}</strong></div>
          <label class="geo3__field"><span>{c.runs}</span><select id="geo3-runs"><option value="50">50</option><option value="100" selected>100</option><option value="250">250</option><option value="500">500</option><option value="1000">1000</option></select></label>
          <button id="geo3-simulate" type="button" class="geo3__secondary">{c.runSimulation}</button>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>08</span><strong>{c.compare}</strong></div>
          <div class="geo3__button-trio"><button id="geo3-save-a" type="button" class="geo3__ghost">{c.saveA}</button><button id="geo3-save-b" type="button" class="geo3__ghost">{c.saveB}</button><button id="geo3-compare" type="button" class="geo3__secondary">{c.compareAB}</button></div>
          <div id="geo3-ab" class="geo3__ab"></div>
        </section>

        <section class="geo3__block">
          <div class="geo3__block-title"><span>09</span><strong>{c.layers}</strong></div>
          <label class="geo3__field"><span>Layer</span><select id="geo3-layer"><option value="network">{c.network}</option><option value="flow">{c.flow}</option><option value="coverage">{c.coverage}</option><option value="utilisation">{c.utilisation}</option><option value="cost">{c.cost}</option><option value="inventory">{c.inventoryLayer}</option><option value="risk">{c.risk}</option></select></label>
          <p class="geo3__micro">{c.note}</p>
        </section>
      </div>

      <div class="geo3__actions">
        <button id="geo3-run" type="button">{c.run}</button>
        <button id="geo3-routes" type="button" disabled>{c.routes}</button>
        <button id="geo3-reset" type="button" class="geo3__ghost">{c.reset}</button>
      </div>
    </aside>

    <aside class="geo3__results">
      <div class="geo3__results-head"><span>RESULT</span><strong>{c.results}</strong></div>
      <div class="geo3__kpis">
        <div><span>{c.hubs}</span><strong id="geo3-kpi-hubs">—</strong></div>
        <div><span>{c.coverageRate}</span><strong id="geo3-kpi-coverage">—</strong></div>
        <div><span>{c.avgNetwork}</span><strong id="geo3-kpi-network">—</strong></div>
        <div><span>{c.fleetCoverage}</span><strong id="geo3-kpi-fleet">—</strong></div>
        <div><span>{c.safetyStock}</span><strong id="geo3-kpi-ss">—</strong></div>
        <div><span>{c.rop}</span><strong id="geo3-kpi-rop">—</strong></div>
      </div>
      <div class="geo3__cost"><span>{c.totalCost}</span><strong id="geo3-kpi-cost">—</strong></div>
      <p id="geo3-status" class="geo3__status">{c.graphReady}</p>
      <div id="geo3-open-list" class="geo3__open-list"></div>

      <div id="geo3-robust" class="geo3__robust" hidden>
        <div class="geo3__results-head"><span>MONTE CARLO</span><strong>{c.robust}</strong></div>
        <div class="geo3__robust-grid">
          <div><span>{c.expectedCost}</span><strong id="geo3-mc-expected">—</strong></div>
          <div><span>{c.p95Cost}</span><strong id="geo3-mc-p95">—</strong></div>
          <div><span>{c.failureRate}</span><strong id="geo3-mc-failure">—</strong></div>
          <div><span>{c.avgTravel}</span><strong id="geo3-mc-travel">—</strong></div>
          <div><span>{c.stockout}</span><strong id="geo3-mc-stockout">—</strong></div>
        </div>
        <div class="geo3__subhead"><span>{c.stability}</span></div>
        <div id="geo3-stability" class="geo3__stability"></div>
      </div>
    </aside>
  </div>
</section>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
  import {
    applyOdScenario,
    compareScenarioResults,
