    solveFacilityNetwork,
  } from "../lib/geospatial/decisionEngine.js";

  const root = document.getElementById("geo-v3");
  if (root && window.L) {
    const locale = root.dataset.locale || "zh";
    const zh = locale === "zh";
    const t = zh
      ? {
          graphReady: "课程 OD 基线已就绪。",
          graphLoading: "正在加载并构建 OSM 可驾驶道路图…",
          graphLoaded: "OSM edge-level 路网已加载。",
          graphFail: "OSM 道路图加载失败，已保留课程 OD 模式。",
          geocoding: "正在解析地点并更新道路矩阵…",
          addFailed: "地点添加失败，请检查地址或网络服务。",
          noSolution: "当前设施、覆盖、容量或车队约束下没有可行方案。",
