---
import { confusionMatrix, projectImages } from "../data/r-machine-learning";
import { withBase } from "../utils/paths";
import ChurnRocExplorer from "./ChurnRocExplorer.astro";

interface Props {
  showRoc?: boolean;
}

const { showRoc = true } = Astro.props;

const cells = [
  {
    id: "tp",
    short: "TP",
    label: "正确识别流失客户",
    value: confusionMatrix.tp,
    rateLabel: "占实际 churned",
    rate: confusionMatrix.sensitivity * 100,
    detail:
      "实际为 churned，模型也预测为 churned。这一格与 FN 共同构成 Sensitivity 的分母。",
  },
  {
    id: "tn",
    short: "TN",
    label: "正确识别留存客户",
    value: confusionMatrix.tn,
    rateLabel: "占实际 retained",
    rate: confusionMatrix.specificity * 100,
    detail:
      "实际为 retained，模型也预测为 retained。这一格与 FP 共同构成 Specificity 的分母。",
  },
  {
    id: "fp",
    short: "FP",
    label: "把留存客户标为流失",
    value: confusionMatrix.fp,
    rateLabel: "False positive rate",
    rate: confusionMatrix.falsePositiveRate * 100,
    detail:
      "实际为 retained，但模型预测为 churned。它降低 Specificity，并扩大需要复核的客户范围。",
  },
  {
    id: "fn",
    short: "FN",
    label: "漏掉真实流失客户",
    value: confusionMatrix.fn,
    rateLabel: "False negative rate",
    rate: confusionMatrix.falseNegativeRate * 100,
    detail:
      "实际为 churned，但模型预测为 retained。它直接降低 Sensitivity，是流失筛查中需要单独关注的错误。",
  },
];
const data = JSON.stringify(cells).replace(/</g, "\\u003c");
---

<div class="evaluation-story" data-model-evaluation>
  <section class="holdout-summary" aria-labelledby="holdout-title">
    <div>
      <p class="evaluation-eyebrow">ONE-TIME HOLD-OUT</p>
      <h3 id="holdout-title">
        39,200 条记录只回答一个问题：已选模型面对新客户怎样表现？
      </h3>
      <p>
        这批记录没有参与变量判断、模型比较或选择。Logistic Regression
        在完整训练部分重拟合后，才由
        <code>last_fit()</code> 对这批数据进行一次性预测。
      </p>
    </div>
    <dl>
      <div><dt>Accuracy</dt><dd>{confusionMatrix.accuracy.toFixed(4)}</dd></div>
      <div><dt>AUC-ROC</dt><dd>{confusionMatrix.auc.toFixed(4)}</dd></div>
      <div><dt>Sensitivity</dt><dd>{confusionMatrix.sensitivity.toFixed(4)}</dd></div>
      <div><dt>Specificity</dt><dd>{confusionMatrix.specificity.toFixed(4)}</dd></div>
    </dl>
  </section>

  <figure class="confusion-figure">
    <figcaption>
      <span>FIG 09</span>
      <div>
        <h3>四个格子把“正确率”拆成两种正确和两种错误</h3>
        <p>点击任意格子，查看它对应的客户状态、指标位置和错误含义。</p>
      </div>
    </figcaption>
    <div class="confusion-layout">
      <div class="confusion-matrix">
        <span class="matrix-axis matrix-axis--actual">实际状态</span>
        <span class="matrix-axis matrix-axis--predicted">预测状态</span>
        <span class="matrix-label matrix-label--actual-retained">retained</span>
        <span class="matrix-label matrix-label--actual-churned">churned</span>
        <span class="matrix-label matrix-label--predicted-churned">churned</span>
        <span class="matrix-label matrix-label--predicted-retained">retained</span>
        {
          cells.map((cell) => (
            <button
              type="button"
              class={`matrix-cell matrix-cell--${cell.id}`}
              data-matrix-cell={cell.id}
              aria-pressed={cell.id === "fn" ? "true" : "false"}
            >
              <small>{cell.short}</small>
              <strong>{cell.value.toLocaleString("en-NZ")}</strong>
              <span>{cell.label}</span>
            </button>
          ))
        }
      </div>
      <aside class="matrix-reading" aria-live="polite">
        <p class="matrix-reading__label" data-matrix-short>FN · False Negative</p>
        <h4 data-matrix-label>漏掉真实流失客户</h4>
        <p data-matrix-detail>{cells[3]?.detail}</p>
        <div class="matrix-reading__ratio">
          <span data-matrix-rate-label>False negative rate</span>
          <strong data-matrix-rate
            >{
              confusionMatrix.falseNegativeRate.toLocaleString("zh-CN", {
                style: "percent",
                minimumFractionDigits: 2,
              })
            }</strong
          >
        </div>
      </aside>
    </div>
    <p class="figure-reading">
      应该看哪里：2,022 个 FN 与 10,092 个 TP 共同描述模型对真实流失客户的识别；5,261 个
      FP 与 21,825 个 TN 则描述模型对留存客户的区分。Accuracy
      把四格合并后看不见这种方向差异。
    </p>
  </figure>

  {
    showRoc && (
      <figure class="roc-figure">
        <figcaption>
          <span>FIG 10</span>
          <div>
            <h3>ROC 展示的是阈值变化下的整体区分能力</h3>
            <p>曲线由留出预测概率计算，虚线代表没有区分能力的随机基准。</p>
          </div>
        </figcaption>
        <ChurnRocExplorer />
        <div class="roc-layout" hidden>
          <div class="roc-image">
            <img
              src={withBase(projectImages.holdoutRoc)}
              alt="Logistic Regression 在 39,200 条留出记录上的 ROC 曲线，AUC 为 0.9053"
              loading="lazy"
              decoding="async"
            />
          </div>
          <aside class="roc-reading">
            <div>
              <>
                <span>Hold-out AUC</span>
                <strong>0.9053</strong>
              </>
            </div>
            <p>
              曲线在较低 false positive rate
              区域快速上升，并长期位于随机基准上方。0.9053
              衡量的是模型在各种阈值下把随机一位 churned 客户排在 retained
              客户之前的总体能力，而不是某一个阈值的 Accuracy。
            </p>
            <p>
              完整 ROC 曲线与 AUC
              可以描述整体排序能力；逐阈值计数还需要每位客户的预测概率序列。
              现有结果没有保留这组概率，因此分类错误分析以可复核的混淆矩阵为边界，不延伸到无法精确重算的阈值推演。
            </p>
          </aside>
        </div>
      </figure>
    )
  }

  <script is:inline type="application/json" data-matrix-data set:html={data} />
</div>

<script>
  type MatrixCell = {
    id: string;
    short: string;
    label: string;
    value: number;
    rateLabel: string;
    rate: number;
    detail: string;
  };

  const setupEvaluation = () => {
    document
      .querySelectorAll<HTMLElement>("[data-model-evaluation]")
      .forEach((root) => {
        if (root.dataset.ready === "true") return;
        root.dataset.ready = "true";
        const cells = JSON.parse(
          root.querySelector<HTMLScriptElement>("[data-matrix-data]")?.textContent ??
            "[]",
        ) as MatrixCell[];
        const buttons = Array.from(
          root.querySelectorAll<HTMLButtonElement>("[data-matrix-cell]"),
        );
        const selectCell = (id: string) => {
          const cell = cells.find((entry) => entry.id === id);
          if (!cell) return;
          buttons.forEach((button) =>
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.matrixCell === id),
            ),
          );
          const values: Array<[string, string]> = [
            [
              "[data-matrix-short]",
              `${cell.short} · ${cell.id === "tp" ? "True Positive" : cell.id === "tn" ? "True Negative" : cell.id === "fp" ? "False Positive" : "False Negative"}`,
            ],
            ["[data-matrix-label]", cell.label],
            ["[data-matrix-detail]", cell.detail],
            ["[data-matrix-rate-label]", cell.rateLabel],
            ["[data-matrix-rate]", `${cell.rate.toFixed(2)}%`],
          ];
          values.forEach(([selector, value]) => {
            const node = root.querySelector<HTMLElement>(selector);
            if (node) node.textContent = value;
          });
        };
        buttons.forEach((button) =>
          button.addEventListener("click", () =>
            selectCell(button.dataset.matrixCell ?? ""),
          ),
        );
        selectCell("fn");
      });
  };
  document.addEventListener("astro:page-load", setupEvaluation);
  setupEvaluation();
</script>

<style>
  .evaluation-story {
    display: grid;
    gap: clamp(3.5rem, 8vw, 7rem);
    min-width: 0;
  }
  .holdout-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.65fr);
    gap: 3rem;
    align-items: end;
    padding-block: 1.5rem;
    border-block: 1px solid var(--colour-border-strong);
  }
  h3,
  h4,
  p,
  dl,
  dt,
  dd,
  figure {
    margin: 0;
  }
  .evaluation-eyebrow {
    color: var(--colour-accent);
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.09em;
  }
  .holdout-summary h3,
  figcaption h3 {
    max-width: 28ch;
    margin-top: 0.55rem;
    font-size: clamp(1.55rem, 3.2vw, 2.5rem);
    line-height: 1.14;
  }
  .holdout-summary p:last-child,
  figcaption p,
  .figure-reading,
  .roc-reading p {
    max-width: 72ch;
    margin-top: 0.7rem;
    color: var(--colour-text-muted);
    line-height: 1.72;
  }
  .holdout-summary dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .holdout-summary dl div {
    padding: 1rem;
    border: 1px solid var(--colour-border);
  }
  .holdout-summary dt {
    color: var(--colour-text-muted);
    font-size: 0.75rem;
  }
  .holdout-summary dd {
    margin-top: 0.35rem;
    font: 750 clamp(1.4rem, 3vw, 2rem)/1 var(--font-display);
  }
  figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  figcaption > span {
    height: max-content;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--colour-border);
    border-radius: 999px;
    color: var(--colour-primary-strong);
    font: 700 0.7rem/1 var(--font-mono);
  }
  .confusion-layout,
  .roc-layout {
    display: grid;
    grid-template-columns: minmax(20rem, 1.25fr) minmax(17rem, 0.75fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .confusion-matrix {
    display: grid;
    grid-template-columns: 4rem 4rem repeat(2, minmax(8rem, 1fr));
    grid-template-rows: 2rem 2.2rem repeat(2, minmax(8rem, 1fr));
  }
  .matrix-axis,
  .matrix-label {
    display: grid;
    place-items: center;
    color: var(--colour-text-muted);
    font-size: 0.75rem;
  }
  .matrix-axis--actual {
    grid-column: 3 / 5;
    grid-row: 1;
  }
  .matrix-axis--predicted {
    grid-column: 1;
    grid-row: 3 / 5;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .matrix-label--actual-retained {
    grid-column: 3;
    grid-row: 2;
  }
  .matrix-label--actual-churned {
    grid-column: 4;
    grid-row: 2;
  }
  .matrix-label--predicted-churned {
    grid-column: 2;
    grid-row: 3;
  }
  .matrix-label--predicted-retained {
    grid-column: 2;
    grid-row: 4;
  }
  .matrix-cell {
    display: grid;
    align-content: center;
    gap: 0.35rem;
    min-width: 0;
    padding: 1rem;
    border: 2px solid var(--colour-page);
    color: var(--colour-text);
    text-align: left;
    cursor: pointer;
  }
  .matrix-cell--fp {
    grid-column: 3;
    grid-row: 3;
    background: color-mix(in srgb, var(--colour-primary) 20%, var(--colour-surface));
  }
  .matrix-cell--tp {
    grid-column: 4;
    grid-row: 3;
    background: var(--colour-primary);
    color: var(--colour-primary-contrast);
  }
  .matrix-cell--tn {
    grid-column: 3;
    grid-row: 4;
    background: color-mix(in srgb, var(--colour-secondary) 18%, var(--colour-surface));
  }
  .matrix-cell--fn {
    grid-column: 4;
    grid-row: 4;
    background: color-mix(in srgb, var(--colour-accent) 58%, var(--colour-surface));
  }
  .matrix-cell[aria-pressed="true"] {
    box-shadow: inset 0 0 0 3px var(--colour-focus);
  }
  .matrix-cell small {
    font: 700 0.72rem/1 var(--font-mono);
  }
  .matrix-cell strong {
    font: 750 clamp(1.35rem, 3vw, 2rem)/1 var(--font-display);
  }
  .matrix-cell span {
    font-size: 0.75rem;
  }
  .matrix-reading {
    padding-left: 1.5rem;
    border-left: 1px solid var(--colour-border-strong);
  }
  .matrix-reading__label {
    color: var(--colour-accent);
    font: 700 0.7rem/1 var(--font-mono);
  }
  .matrix-reading h4 {
    margin-top: 0.55rem;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
  }
  .matrix-reading > p:not(.matrix-reading__label) {
    margin-top: 0.8rem;
    color: var(--colour-text-muted);
    line-height: 1.7;
  }
  .matrix-reading__ratio {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--colour-border);
  }
  .matrix-reading__ratio span {
    color: var(--colour-text-muted);
    font-size: 0.8rem;
  }
  .matrix-reading__ratio strong {
    font: 750 1.5rem/1 var(--font-display);
  }
  .figure-reading {
    padding-left: 1rem;
    border-left: 3px solid var(--colour-accent);
  }
  .roc-image {
    overflow: hidden;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    background: #fff;
  }
  .roc-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .roc-reading {
    display: grid;
    gap: 1.25rem;
  }
  .roc-reading div {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--colour-border);
  }
  .roc-reading span {
    color: var(--colour-text-muted);
    font-size: 0.78rem;
  }
  .roc-reading strong {
    color: var(--colour-primary-strong);
    font: 750 clamp(2.8rem, 7vw, 4.5rem)/0.95 var(--font-display);
  }
  @media (max-width: 850px) {
    .holdout-summary,
    .confusion-layout,
    .roc-layout {
      grid-template-columns: 1fr;
    }
    .matrix-reading {
      padding: 1.25rem 0 0;
      border-top: 1px solid var(--colour-border);
      border-left: 0;
    }
  }
  @media (max-width: 580px) {
    figcaption {
      grid-template-columns: 1fr;
    }
    figcaption > span {
      width: max-content;
    }
    .confusion-matrix {
      grid-template-columns: 2.2rem 2.6rem repeat(2, minmax(0, 1fr));
      grid-template-rows: 1.5rem 2rem repeat(2, minmax(7rem, 1fr));
    }
    .matrix-cell {
      padding: 0.65rem;
    }
    .matrix-cell span {
      font-size: 0.64rem;
    }
  }
</style>
