<script>
  const initialiseQueryViewer = () => {
    document.querySelectorAll<HTMLElement>("[data-query-viewer]").forEach((viewer) => {
      if (viewer.dataset.ready === "true") return;
      viewer.dataset.ready = "true";
      const tabs = [...viewer.querySelectorAll<HTMLButtonElement>("[data-query-tab]")];
      const panels = [...viewer.querySelectorAll<HTMLElement>("[data-query-panel]")];

      const selectQuery = (id: string, focus = false) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.queryTab === id;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && focus) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.queryPanel !== id;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectQuery(tab.dataset.queryTab ?? ""));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = index;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft")
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = tabs.length - 1;
          else return;
          event.preventDefault();
          selectQuery(tabs[nextIndex]?.dataset.queryTab ?? "", true);
        });
      });

      selectQuery(tabs[0]?.dataset.queryTab ?? "");
    });
  };

  initialiseQueryViewer();
  document.addEventListener("astro:page-load", initialiseQueryViewer);
</script>

