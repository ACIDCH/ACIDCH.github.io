---
import type { Locale } from "../config/site";
import { getLocalizedPath } from "../utils/paths";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  fallbackPath: string;
  label: Record<Locale, string>;
}

const { locale, fallbackPath, label } = Astro.props;
const resolvedLabel =
  fallbackPath === "/notes/"
    ? locale === "en"
      ? "Back to Notes"
      : "返回笔记"
    : label[locale];
---

<a class="context-back" href={getLocalizedPath(fallbackPath, locale)}>
  <Icon name="back" />
  <span>{resolvedLabel}</span>
</a>
