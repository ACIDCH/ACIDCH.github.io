---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<section id="geo-v4" class="geo4" data-locale={locale}>
  <div class="geo4__shell">
    <div id="geo4-map" aria-label="Auckland geospatial supply chain decision map"></div>

    <header class="geo4__identity">
      <span>{c.subtitle}</span>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
    </header>

    <div class="geo4__legend" aria-hidden="true">
      <span><i class="facility"></i> Facility</span>
      <span><i class="demand"></i> Demand</span>
      <span><i class="allocation"></i> Allocation</span>
      <span><i class="route"></i> Optimal path</span>
    </div>

    <aside class="geo4__console" aria-label="Scenario console">
      <div class="geo4__scroll">
        <section class="geo4__block">
          <div class="geo4__block-title"><span>01</span><strong>{c.scenario}</strong></div>
          <label class="geo4__field"><span>Objective</span><select id="geo4-objective"><option value="minHubs">{c.minHubs}</option><option value="minCost">{c.minCost}</option></select></label>
          <label class="geo4__field"><span>Network engine</span><select id="geo4-engine"><option value="od">{c.graphCourse}</option><option value="osm">{c.graphOsm}</option></select></label>
          <div class="geo4__buttons"><button id="geo4-init" type="button" class="secondary">{c.initialise}</button><button id="geo4-load-graph" type="button" class="secondary">{c.loadGraph}</button></div>
          <p id="geo4-graph-status" class="geo4__micro">—</p>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>02</span><strong>{c.road}</strong></div>
          <label class="geo4__field"><span>Scenario</span><select id="geo4-road-mode"><option value="baseline">{c.baseline}</option><option value="congestion">{c.congestion}</option><option value="closure">{c.closure}</option><option value="newroad">{c.newRoad}</option><option value="mixed">{c.mixed}</option></select></label>
          <label class="geo4__range"><span>{c.congestion}</span><output id="geo4-congestion-out">35%</output><input id="geo4-congestion" type="range" min="0" max="100" step="5" value="35" /></label>
          <label class="geo4__range"><span>Congested edges / OD pairs</span><output id="geo4-congestion-share-out">35%</output><input id="geo4-congestion-share" type="range" min="0" max="100" step="5" value="35" /></label>
          <label class="geo4__range"><span>{c.closure}</span><output id="geo4-closure-out">1%</output><input id="geo4-closure" type="range" min="0" max="15" step="0.5" value="1" /></label>
          <div class="geo4__step-row"><span>Hypothetical new links</span><div class="geo4__stepper"><button type="button" data-step="newRoads" data-delta="-1">−</button><output id="geo4-new-roads-out">4</output><button type="button" data-step="newRoads" data-delta="1">+</button></div></div>
          <label class="geo4__field inline"><span>Random seed</span><input id="geo4-seed" type="number" value="708709" /></label>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>03</span><strong>{c.facility}</strong></div>
          <label class="geo4__range"><span>{c.threshold}</span><output id="geo4-threshold-out">6.0 km</output><input id="geo4-threshold" type="range" min="3" max="15" step="0.5" value="6" /></label>
          <label class="geo4__field"><span>{c.redundancy}</span><select id="geo4-redundancy"><option value="1">1×</option><option value="2">2×</option></select></label>
          <div class="geo4__step-row"><span>{c.maxOpen}</span><div class="geo4__stepper"><button type="button" data-step="maxOpen" data-delta="-1">−</button><output id="geo4-max-open-out">4</output><button type="button" data-step="maxOpen" data-delta="1">+</button></div></div>
          <label class="geo4__field inline"><span>{c.capacity}</span><input id="geo4-facility-capacity" type="number" min="100" step="100" value="6000" /></label>
          <label class="geo4__field inline"><span>{c.fixedCost}</span><input id="geo4-fixed-cost" type="number" min="0" step="10000" value="350000" /></label>
          <label class="geo4__check"><input id="geo4-enforce-fleet" type="checkbox" checked /><span>{c.enforceFleet}</span></label>
          <div class="geo4__subhead"><span>{c.policy}</span><strong id="geo4-facility-count">6</strong></div>
          <div id="geo4-policy-list" class="geo4__list"></div>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>04</span><strong>{c.fleet}</strong></div>
          <div class="geo4__step-row"><span>{c.fleetSize}</span><div class="geo4__stepper"><button type="button" data-step="fleet" data-delta="-1">−</button><output id="geo4-fleet-out">20</output><button type="button" data-step="fleet" data-delta="1">+</button></div></div>
          <label class="geo4__field inline"><span>{c.vehicleCapacity}</span><input id="geo4-vehicle-capacity" type="number" min="1" value="120" /></label>
          <label class="geo4__field inline"><span>{c.trips}</span><input id="geo4-trips" type="number" min="1" value="5" /></label>
          <label class="geo4__field inline"><span>{c.transportCost}</span><input id="geo4-transport-cost" type="number" min="0" step="0.01" value="0.72" /></label>
          <label class="geo4__range"><span>{c.demandMultiplier}</span><output id="geo4-demand-multiplier-out">1.00×</output><input id="geo4-demand-multiplier" type="range" min="0.5" max="1.8" step="0.05" value="1" /></label>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>05</span><strong>{c.inventory}</strong></div>
          <label class="geo4__field inline"><span>{c.meanDemand}</span><input id="geo4-inv-mean" type="number" min="0" value="120" /></label>
          <label class="geo4__field inline"><span>{c.demandSd}</span><input id="geo4-inv-sd" type="number" min="0" value="25" /></label>
          <label class="geo4__field inline"><span>{c.leadTime}</span><input id="geo4-lead-time" type="number" min="0.1" step="0.1" value="2" /></label>
          <label class="geo4__field"><span>{c.service}</span><select id="geo4-service"><option value="1.282">90%</option><option value="1.645" selected>95%</option><option value="1.960">97.5%</option><option value="2.326">99%</option></select></label>
          <label class="geo4__field inline"><span>{c.holdingCost}</span><input id="geo4-holding-cost" type="number" min="0" step="0.1" value="1" /></label>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>06</span><strong>{c.editor}</strong></div>
          <label class="geo4__field"><span>{c.role}</span><select id="geo4-role"><option value="warehouse">{c.warehouse}</option><option value="factory">{c.factory}</option><option value="demand">{c.demand}</option></select></label>
          <label class="geo4__field"><span>{c.address}</span><input id="geo4-address" type="text" placeholder="20 Symonds Street, Auckland" /></label>
          <label class="geo4__field inline"><span>{c.demandQty}</span><input id="geo4-demand-qty" type="number" min="0" value="500" /></label>
          <div class="geo4__buttons"><button id="geo4-add-address" type="button" class="secondary">{c.addAddress}</button><button id="geo4-map-add" type="button" class="ghost">{c.mapAdd}</button></div>
          <p class="geo4__micro">{c.facilityRoleNote}</p>
          <div class="geo4__subhead"><span>{c.custom}</span><strong id="geo4-custom-count">0</strong></div>
          <div id="geo4-custom-list" class="geo4__list"></div>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>07</span><strong>{c.simulation}</strong></div>
          <label class="geo4__field"><span>{c.runs}</span><select id="geo4-runs"></select></label>
          <button id="geo4-simulate" type="button" class="secondary full">{c.runSimulation}</button>
          <p class="geo4__micro">{c.simulationNote}</p>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>08</span><strong>{c.compare}</strong></div>
          <div class="geo4__buttons three"><button id="geo4-save-a" type="button" class="ghost">{c.saveA}</button><button id="geo4-save-b" type="button" class="ghost">{c.saveB}</button><button id="geo4-compare" type="button" class="secondary">{c.compareAB}</button></div>
          <div id="geo4-ab" class="geo4__ab"></div>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>09</span><strong>{c.layers}</strong></div>
          <label class="geo4__field"><span>Layer</span><select id="geo4-layer"><option value="network">{c.network}</option><option value="flow">{c.flow}</option><option value="coverage">{c.coverage}</option><option value="utilisation">{c.utilisation}</option><option value="cost">{c.cost}</option><option value="inventory">{c.inventoryLayer}</option><option value="risk">{c.risk}</option></select></label>
        </section>
      </div>

      <div class="geo4__actions">
        <button id="geo4-run" type="button">{c.run}</button>
        <button id="geo4-routes" type="button" disabled>{c.routes}</button>
        <button id="geo4-reset" type="button" class="ghost">{c.reset}</button>
      </div>
    </aside>

    <aside class="geo4__results">
      <div class="geo4__results-head"><span>RESULT</span><strong>{c.results}</strong></div>
      <div class="geo4__kpis">
        <div><span>{c.hubs}</span><strong id="geo4-kpi-hubs">—</strong></div>
        <div><span>{c.coverageRate}</span><strong id="geo4-kpi-coverage">—</strong></div>
        <div><span>{c.avgNetwork}</span><strong id="geo4-kpi-network">—</strong></div>
        <div><span>{c.fleetCoverage}</span><strong id="geo4-kpi-fleet">—</strong></div>
        <div><span>{c.safetyStock}</span><strong id="geo4-kpi-ss">—</strong></div>
        <div><span>{c.rop}</span><strong id="geo4-kpi-rop">—</strong></div>
      </div>
      <div class="geo4__cost"><span>{c.totalCost}</span><strong id="geo4-kpi-cost">—</strong></div>
      <p id="geo4-status" class="geo4__status">—</p>
      <div id="geo4-open-list" class="geo4__open-list"></div>

      <div id="geo4-robust" class="geo4__robust" hidden>
        <div class="geo4__results-head"><span>MONTE CARLO</span><strong>{c.robust}</strong></div>
        <div class="geo4__kpis compact">
          <div><span>{c.actualRuns}</span><strong id="geo4-mc-runs">—</strong></div>
          <div><span>{c.expectedCost}</span><strong id="geo4-mc-expected">—</strong></div>
          <div><span>{c.p95Cost}</span><strong id="geo4-mc-p95">—</strong></div>
          <div><span>{c.failureRate}</span><strong id="geo4-mc-failure">—</strong></div>
          <div><span>{c.avgNetwork}</span><strong id="geo4-mc-network">—</strong></div>
          <div><span>{c.stockout}</span><strong id="geo4-mc-stockout">—</strong></div>
        </div>
        <div class="geo4__subhead"><span>{c.stability}</span></div>
        <div id="geo4-stability" class="geo4__stability"></div>
      </div>
    </aside>
  </div>
</section>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
  import "../scripts/geospatial-v4.js";
</script>

<style>
  .geo4{--bg:#06131d;--panel:rgba(7,24,34,.95);--line:rgba(116,190,213,.2);--cyan:#62ecff;--acid:#d8ff6b;--pink:#ff759a;--amber:#ffcc66;--muted:#83a3b0;width:min(1720px,calc(100vw - 1rem));margin:0 auto 3rem;color:#eafaff}.geo4__shell{position:relative;min-height:900px;overflow:hidden;border:1px solid rgba(95,174,201,.28);background:var(--bg);box-shadow:0 30px 100px rgba(0,0,0,.24)}#geo4-map{position:absolute;inset:0;background:var(--bg)}.geo4__identity{position:absolute;z-index:600;top:1rem;left:1rem;width:min(470px,calc(100% - 780px));padding:1rem 1.1rem;border-left:2px solid var(--cyan);background:linear-gradient(90deg,rgba(3,16,24,.92),rgba(3,16,24,.58),transparent);pointer-events:none}.geo4__identity span,.geo4__results-head span{color:var(--cyan);font:700 .68rem/1.2 monospace;letter-spacing:.12em}.geo4__identity h1{margin:.35rem 0;color:#f2fdff;font-size:clamp(1.6rem,3vw,3rem);letter-spacing:-.035em}.geo4__identity p{margin:0;color:#8aa6b1;font-size:.78rem;line-height:1.55}.geo4__legend{position:absolute;z-index:620;left:1rem;bottom:1rem;display:flex;flex-wrap:wrap;gap:.7rem;padding:.55rem .7rem;border:1px solid var(--line);background:rgba(4,18,27,.88);color:#91acb7;font-size:.66rem;backdrop-filter:blur(12px)}.geo4__legend span{display:inline-flex;gap:.35rem;align-items:center}.geo4__legend i{width:12px;height:4px;border-radius:999px;display:inline-block}.geo4__legend .facility{height:8px;background:var(--acid)}.geo4__legend .demand{height:8px;background:var(--pink)}.geo4__legend .allocation{border-top:1px dashed var(--cyan)}.geo4__legend .route{background:var(--acid)}.geo4__console{position:absolute;z-index:700;top:.7rem;right:.7rem;width:390px;height:calc(100% - 1.4rem);display:grid;grid-template-rows:minmax(0,1fr) auto;border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(14px);box-shadow:0 20px 70px rgba(0,0,0,.25)}.geo4__scroll{overflow-y:auto;scrollbar-width:thin;scrollbar-color:#2d6676 transparent}.geo4__block{padding:.85rem .9rem;border-bottom:1px solid var(--line)}.geo4__block-title{display:flex;gap:.55rem;align-items:center;margin-bottom:.65rem}.geo4__block-title span{color:var(--acid);font:700 .66rem monospace}.geo4__block-title strong{font-size:.76rem;letter-spacing:.04em}.geo4__field,.geo4__range{display:grid;gap:.35rem;margin:.58rem 0;color:var(--muted);font-size:.7rem}.geo4__field.inline{grid-template-columns:minmax(0,1fr) 120px;align-items:center}.geo4__field input,.geo4__field select{width:100%;box-sizing:border-box;border:1px solid var(--line);background:#0b202c;color:#eefcff;padding:.43rem .48rem}.geo4__range{grid-template-columns:minmax(0,1fr) auto}.geo4__range input{grid-column:1/-1;width:100%;accent-color:var(--cyan)}.geo4__range output{color:#eefcff;font-family:monospace}.geo4__check{display:flex;gap:.5rem;align-items:center;margin:.65rem 0;color:var(--muted);font-size:.7rem}.geo4__check input{accent-color:var(--cyan)}.geo4__step-row{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:.58rem 0;color:var(--muted);font-size:.7rem}.geo4__stepper{display:flex;align-items:center;border:1px solid var(--line)}.geo4__stepper button{width:30px;height:30px;border:0;background:#0b2633;color:var(--cyan);cursor:pointer}.geo4__stepper output{min-width:38px;text-align:center;color:#fff;font:.72rem monospace}.geo4 button{border:1px solid var(--line);background:rgba(15,48,62,.8);color:#e8f9fc;padding:.55rem .62rem;cursor:pointer}.geo4 button:hover:not(:disabled){border-color:rgba(98,236,255,.6)}.geo4 button.ghost{background:transparent;color:#8ba8b3}.geo4 button.is-active{border-color:var(--acid);color:var(--acid)}.geo4 button:disabled{opacity:.4;cursor:not-allowed}.geo4__buttons{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.geo4__buttons.three{grid-template-columns:1fr 1fr 1fr}.geo4__buttons .full,.geo4 button.full{width:100%}.geo4__micro{margin:.5rem 0 0;color:#6f8e9a;font-size:.64rem;line-height:1.45}.geo4__subhead{display:flex;justify-content:space-between;