---
interface Props {
  locale?: "en" | "zh";
}

const { locale = "zh" } = Astro.props;
const zh = locale === "zh";
const pageTitle = zh
  ? "基于地理空间的供应链优化"
  : "Geospatial Supply Chain Optimisation";
const c = zh
  ? {
      scenario: "情景与计算引擎",
      road: "路网不确定性",
      facility: "设施与覆盖",
      fleet: "车队与运输",
      inventory: "库存策略",
      editor: "网络实体编辑",
      simulation: "Monte Carlo 稳健性",
      compare: "情景 A / B",
      layers: "地图功能层",
      results: "优化结果",
      initialise: "初始化真实 GIS 点位",
      loadGraph: "加载 OSM 道路图",
      run: "运行优化",
      routes: "加载当前最优路径",
      reset: "恢复基线",
      graphFast: "快速 OD 网络",
      graphOsm: "OSM 实时路网",
      baseline: "基线",
      congestion: "交通拥堵",
      closure: "临时封路",
      newRoad: "新增道路 / 通行改善",
      mixed: "混合不确定性",
      minHubs: "最少设施",
      minCost: "最低固定 + 运输成本",
      threshold: "最大服务阈值",
      redundancy: "最低覆盖次数",
      maxOpen: "最多开启设施",
      capacity: "单设施容量",
      fixedCost: "单设施固定成本",
      policy: "设施决策状态",
      auto: "自动",
      must: "必须开启",
      exclude: "排除",
      enforceFleet: "将车队运力作为硬约束",
      fleetSize: "车队数量",
      vehicleCapacity: "单车容量",
      trips: "每车每日趟数",
      transportCost: "运输成本 / 网络单位",
      demandMultiplier: "需求倍率",
      meanDemand: "日均库存需求",
      demandSd: "需求标准差",
      leadTime: "提前期（天）",
      service: "服务水平",
      holdingCost: "安全库存持有成本 / 单位",
      role: "地点类型",
      warehouse: "仓库候选点",
      factory: "工厂候选点",
      demand: "需求点",
      demandQty: "需求量",
      address: "自然语言地址",
      addAddress: "解析地址并加入",
      mapAdd: "地图点击添加",
      custom: "自定义实体",
      runs: "模拟次数",
      runSimulation: "运行 Monte Carlo",
      saveA: "保存为 A",
      saveB: "保存为 B",
      compareAB: "比较 A / B",
      network: "网络",
      flow: "货物流",
      coverage: "覆盖",
      utilisation: "利用率",
      cost: "成本",
      inventoryLayer: "库存",
      risk: "风险",
      hubs: "开启设施",
      coverageRate: "覆盖率",
      avgDistance: "平均配送距离",
      avgTime: "平均行程时间",
      transportCostKpi: "运输成本",
      baselineDelta: "较基线",
      fleetCoverage: "车队运力",
      safetyStock: "安全库存",
      rop: "再订货点",
      totalCost: "情景总成本",
      robust: "稳健性结果",
      actualRuns: "实际模拟次数",
      expectedCost: "期望成本",
      p95Cost: "P95 成本",
      failureRate: "不可行概率",
      stockout: "缺货概率",
      stability: "设施选择稳定性",
      facilityRoleNote:
        "设施分配与两级转运分别求解：主模型负责 Facility → Demand，Transshipment 模块负责 Factory → Warehouse → Demand，并共享当前道路情景。",
      simulationNote:
        "快速 OD 模式支持 50–1000 次模拟；OSM 路网模式使用较小运行批次以保持浏览器交互流畅。",
    }
  : {
      scenario: "Scenario & engine",
      road: "Road uncertainty",
      facility: "Facilities & coverage",
      fleet: "Fleet & transport",
      inventory: "Inventory policy",
      editor: "Network entity editor",
      simulation: "Monte Carlo robustness",
      compare: "Scenario A / B",
      layers: "Map functional layer",
      results: "Optimisation results",
      initialise: "Initialise real GIS points",
      loadGraph: "Load OSM road graph",
      run: "Run optimisation",
      routes: "Load current optimal paths",
      reset: "Reset baseline",
      graphFast: "Fast OD Network",
      graphOsm: "OSM Road Network",
      baseline: "Baseline",
      congestion: "Traffic congestion",
      closure: "Temporary closure",
      newRoad: "New road / access improvement",
      mixed: "Mixed uncertainty",
      minHubs: "Minimum facilities",
      minCost: "Minimum fixed + transport cost",
      threshold: "Maximum service threshold",
      redundancy: "Minimum coverage count",
      maxOpen: "Maximum open facilities",
      capacity: "Capacity per facility",
      fixedCost: "Fixed cost per facility",
      policy: "Facility decision policy",
      auto: "Auto",
      must: "Must open",
      exclude: "Exclude",
      enforceFleet: "Enforce fleet capacity",
      fleetSize: "Fleet size",
      vehicleCapacity: "Vehicle capacity",
      trips: "Trips per vehicle / day",
      transportCost: "Transport cost / network unit",
      demandMultiplier: "Demand multiplier",
      meanDemand: "Mean daily inventory demand",
      demandSd: "Demand standard deviation",
      leadTime: "Lead time (days)",
      service: "Service level",
      holdingCost: "Safety-stock holding cost / unit",
      role: "Location type",
      warehouse: "Warehouse candidate",
      factory: "Factory candidate",
      demand: "Demand node",
      demandQty: "Demand quantity",
      address: "Natural-language address",
      addAddress: "Geocode and add",
      mapAdd: "Map-click add",
      custom: "Custom entities",
      runs: "Simulation runs",
      runSimulation: "Run Monte Carlo",
      saveA: "Save as A",
      saveB: "Save as B",
      compareAB: "Compare A / B",
      network: "Network",
      flow: "Flow",
      coverage: "Coverage",
      utilisation: "Utilisation",
      cost: "Cost",
      inventoryLayer: "Inventory",
      risk: "Risk",
      hubs: "Open facilities",
      coverageRate: "Coverage",
      avgDistance: "Average delivery distance",
      avgTime: "Average travel time",
      transportCostKpi: "Transport cost",
      baselineDelta: "vs baseline",
      fleetCoverage: "Fleet capacity",
      safetyStock: "Safety stock",
      rop: "Reorder point",
      totalCost: "Scenario total cost",
      robust: "Robustness results",
      actualRuns: "Actual simulation runs",
      expectedCost: "Expected cost",
      p95Cost: "P95 cost",
      failureRate: "Infeasibility rate",
      stockout: "Stockout probability",
      stability: "Facility selection stability",
      facilityRoleNote:
        "Facility allocation and two-echelon transshipment are solved separately: the main model handles Facility → Demand, while the Transshipment module handles Factory → Warehouse → Demand under the same road scenario.",
      simulationNote:
        "Fast OD mode supports 50–1000 runs; OSM Road Network mode uses smaller batches to keep browser interaction responsive.",
    };
---

<section id="geo-v4" class="geo4" data-locale={locale}>
  <h1 class="geo4__sr-only">{pageTitle}</h1>
  <div class="geo4__shell">
    <div id="geo4-map" aria-label="Auckland geospatial supply chain decision map"></div>

    <div class="geo4__legend" aria-hidden="true">
      <span><i class="facility"></i> Facility</span>
      <span><i class="demand"></i> Demand</span>
      <span><i class="allocation"></i> Allocation</span>
      <span><i class="route"></i> Optimal path</span>
      <span class="coverage-only"><i class="covered"></i> Covered</span>
      <span class="coverage-only"><i class="redundant"></i> 2×+ coverage</span>
    </div>

    <aside class="geo4__console" aria-label="Scenario console">
      <div class="geo4__scroll">
        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>01</span><strong>{c.scenario}</strong>
          </div>
          <label class="geo4__field"
            ><span>Objective</span><select id="geo4-objective"
              ><option value="minHubs">{c.minHubs}</option><option value="minCost"
                >{c.minCost}</option
              ></select
            ></label
          >
          <label class="geo4__field"
            ><span>Network engine</span><select id="geo4-engine"
              ><option value="od">{c.graphFast}</option><option value="osm"
                >{c.graphOsm}</option
              ></select
            ></label
          >
          <div class="geo4__buttons">
            <button id="geo4-init" type="button" class="secondary"
              >{c.initialise}</button
            ><button id="geo4-load-graph" type="button" class="secondary"
              >{c.loadGraph}</button
            >
          </div>
          <p id="geo4-graph-status" class="geo4__micro">—</p>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>02</span><strong>{c.road}</strong></div>
          <label class="geo4__field"
            ><span>Scenario</span><select id="geo4-road-mode"
              ><option value="baseline">{c.baseline}</option><option value="congestion"
                >{c.congestion}</option
              ><option value="closure">{c.closure}</option><option value="newroad"
                >{c.newRoad}</option
              ><option value="mixed">{c.mixed}</option></select
            ></label
          >
          <label class="geo4__range"
            ><span>{c.congestion}</span><output id="geo4-congestion-out">35%</output
            ><input
              id="geo4-congestion"
              type="range"
              min="0"
              max="100"
              step="5"
              value="35"
            /></label
          >
          <label class="geo4__range"
            ><span>Congested edges / OD pairs</span><output
              id="geo4-congestion-share-out">35%</output
            ><input
              id="geo4-congestion-share"
              type="range"
              min="0"
              max="100"
              step="5"
              value="35"
            /></label
          >
          <label class="geo4__range"
            ><span>{c.closure}</span><output id="geo4-closure-out">1%</output><input
              id="geo4-closure"
              type="range"
              min="0"
              max="15"
              step="0.5"
              value="1"
            /></label
          >
          <div class="geo4__step-row">
            <span>Hypothetical new links</span><div class="geo4__stepper">
              <button type="button" data-step="newRoads" data-delta="-1">−</button
              ><output id="geo4-new-roads-out">4</output><button
                type="button"
                data-step="newRoads"
                data-delta="1">+</button
              >
            </div>
          </div>
          <label class="geo4__field inline"
            ><span>Random seed</span><input
              id="geo4-seed"
              type="number"
              value="708709"
            /></label
          >
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>03</span><strong>{c.facility}</strong>
          </div>
          <label class="geo4__range"
            ><span>{c.threshold}</span><output id="geo4-threshold-out">6.0 km</output
            ><input
              id="geo4-threshold"
              type="range"
              min="3"
              max="15"
              step="0.5"
              value="6"
            /></label
          >
          <label class="geo4__field"
            ><span>{c.redundancy}</span><select id="geo4-redundancy"
              ><option value="1">1×</option><option value="2">2×</option></select
            ></label
          >
          <div class="geo4__step-row">
            <span>{c.maxOpen}</span><div class="geo4__stepper">
              <button type="button" data-step="maxOpen" data-delta="-1">−</button
              ><output id="geo4-max-open-out">4</output><button
                type="button"
                data-step="maxOpen"
                data-delta="1">+</button
              >
            </div>
          </div>
          <label class="geo4__field inline"
            ><span>{c.capacity}</span><input
              id="geo4-facility-capacity"
              type="number"
              min="100"
              step="100"
              value="6000"
            /></label
          >
          <label class="geo4__field inline"
            ><span>{c.fixedCost}</span><input
              id="geo4-fixed-cost"
              type="number"
              min="0"
              step="10000"
              value="350000"
            /></label
          >
          <label class="geo4__check"
            ><input id="geo4-enforce-fleet" type="checkbox" checked /><span
              >{c.enforceFleet}</span
            ></label
          >
          <div class="geo4__subhead">
            <span>{c.policy}</span><strong id="geo4-facility-count">6</strong>
          </div>
          <div id="geo4-policy-list" class="geo4__list"></div>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title"><span>04</span><strong>{c.fleet}</strong></div>
          <div class="geo4__step-row">
            <span>{c.fleetSize}</span><div class="geo4__stepper">
              <button type="button" data-step="fleet" data-delta="-1">−</button><output
                id="geo4-fleet-out">20</output
              ><button type="button" data-step="fleet" data-delta="1">+</button>
            </div>
          </div>
          <label class="geo4__field inline"
            ><span>{c.vehicleCapacity}</span><input
              id="geo4-vehicle-capacity"
              type="number"
              min="1"
              value="120"
            /></label
          >
          <label class="geo4__field inline"
            ><span>{c.trips}</span><input
              id="geo4-trips"
              type="number"
              min="1"
              value="5"
            /></label
          >
          <label class="geo4__field inline"
            ><span>{c.transportCost}</span><input
              id="geo4-transport-cost"
              type="number"
              min="0"
              step="0.01"
              value="0.72"
            /></label
          >
          <label class="geo4__range"
            ><span>{c.demandMultiplier}</span><output id="geo4-demand-multiplier-out"
              >1.00×</output
            ><input
              id="geo4-demand-multiplier"
              type="range"
              min="0.5"
              max="1.8"
              step="0.05"
              value="1"
            /></label
          >
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>05</span><strong>{c.inventory}</strong>
          </div>
          <label class="geo4__field inline"
            ><span>{c.meanDemand}</span><input
              id="geo4-inv-mean"
              type="number"
              min="0"
              value="120"
            /></label
          >
          <label class="geo4__field inline"
            ><span>{c.demandSd}</span><input
              id="geo4-inv-sd"
              type="number"
              min="0"
              value="25"
            /></label
          >
          <label class="geo4__field inline"
            ><span>{c.leadTime}</span><input
              id="geo4-lead-time"
              type="number"
              min="0.1"
              step="0.1"
              value="2"
            /></label
          >
          <label class="geo4__field"
            ><span>{c.service}</span><select id="geo4-service"
              ><option value="1.282">90%</option><option value="1.645" selected
                >95%</option
              ><option value="1.960">97.5%</option><option value="2.326">99%</option
              ></select
            ></label
          >
          <label class="geo4__field inline"
            ><span>{c.holdingCost}</span><input
              id="geo4-holding-cost"
              type="number"
              min="0"
              step="0.1"
              value="1"
            /></label
          >
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>06</span><strong>{c.editor}</strong>
          </div>
          <label class="geo4__field"
            ><span>{c.role}</span><select id="geo4-role"
              ><option value="warehouse">{c.warehouse}</option><option value="factory"
                >{c.factory}</option
              ><option value="demand">{c.demand}</option></select
            ></label
          >
          <label class="geo4__field"
            ><span>{c.address}</span><input
              id="geo4-address"
              type="text"
              placeholder="20 Symonds Street, Auckland"
            /></label
          >
          <label class="geo4__field inline"
            ><span>{c.demandQty}</span><input
              id="geo4-demand-qty"
              type="number"
              min="0"
              value="500"
            /></label
          >
          <div class="geo4__buttons">
            <button id="geo4-add-address" type="button" class="secondary"
              >{c.addAddress}</button
            ><button id="geo4-map-add" type="button" class="ghost">{c.mapAdd}</button>
          </div>
          <p class="geo4__micro">{c.facilityRoleNote}</p>
          <div class="geo4__subhead">
            <span>{c.custom}</span><strong id="geo4-custom-count">0</strong>
          </div>
          <div id="geo4-custom-list" class="geo4__list"></div>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>07</span><strong>{c.simulation}</strong>
          </div>
          <label class="geo4__field"
            ><span>{c.runs}</span><select id="geo4-runs"></select></label
          >
          <button id="geo4-simulate" type="button" class="secondary full"
            >{c.runSimulation}</button
          >
          <p class="geo4__micro">{c.simulationNote}</p>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>08</span><strong>{c.compare}</strong>
          </div>
          <div class="geo4__buttons three">
            <button id="geo4-save-a" type="button" class="ghost">{c.saveA}</button
            ><button id="geo4-save-b" type="button" class="ghost">{c.saveB}</button
            ><button id="geo4-compare" type="button" class="secondary"
              >{c.compareAB}</button
            >
          </div>
          <div id="geo4-ab" class="geo4__ab"></div>
        </section>

        <section class="geo4__block">
          <div class="geo4__block-title">
            <span>09</span><strong>{c.layers}</strong>
          </div>
          <label class="geo4__field"
            ><span>Layer</span><select id="geo4-layer"
              ><option value="network">{c.network}</option><option value="flow"
                >{c.flow}</option
              ><option value="coverage">{c.coverage}</option><option value="utilisation"
                >{c.utilisation}</option
              ><option value="cost">{c.cost}</option><option value="inventory"
                >{c.inventoryLayer}</option
              ><option value="risk">{c.risk}</option></select
            ></label
          >
        </section>
      </div>

      <div class="geo4__actions">
        <button id="geo4-run" type="button">{c.run}</button>
        <button id="geo4-routes" type="button" disabled>{c.routes}</button>
        <button id="geo4-reset" type="button" class="ghost">{c.reset}</button>
      </div>
    </aside>

    <aside class="geo4__results">
      <div class="geo4__results-head">
        <span>RESULT</span><strong>{c.results}</strong>
      </div>
      <div class="geo4__kpis">
        <div><span>{c.hubs}</span><strong id="geo4-kpi-hubs">—</strong></div>
        <div>
          <span>{c.coverageRate}</span><strong id="geo4-kpi-coverage">—</strong>
        </div>
        <div>
          <span id="geo4-kpi-network-label">{c.avgDistance}</span><strong
            id="geo4-kpi-network">—</strong
          >
        </div>
        <div><span>{c.fleetCoverage}</span><strong id="geo4-kpi-fleet">—</strong></div>
        <div><span>{c.safetyStock}</span><strong id="geo4-kpi-ss">—</strong></div>
        <div><span>{c.rop}</span><strong id="geo4-kpi-rop">—</strong></div>
        <div>
          <span>{c.transportCostKpi}</span><strong id="geo4-kpi-transport">—</strong>
        </div>
      </div>
      <div class="geo4__cost">
        <span>{c.totalCost}</span><strong id="geo4-kpi-cost">—</strong><small
          id="geo4-kpi-delta">{c.baselineDelta} —</small
        >
      </div>
      <p id="geo4-status" class="geo4__status">—</p>
      <div id="geo4-open-list" class="geo4__open-list"></div>

      <div id="geo4-robust" class="geo4__robust" hidden>
        <div class="geo4__results-head">
          <span>MONTE CARLO</span><strong>{c.robust}</strong>
        </div>
        <div class="geo4__kpis compact">
          <div><span>{c.actualRuns}</span><strong id="geo4-mc-runs">—</strong></div>
          <div>
            <span>{c.expectedCost}</span><strong id="geo4-mc-expected">—</strong>
          </div>
          <div><span>{c.p95Cost}</span><strong id="geo4-mc-p95">—</strong></div>
          <div><span>{c.failureRate}</span><strong id="geo4-mc-failure">—</strong></div>
          <div>
            <span id="geo4-mc-network-label">{c.avgDistance}</span><strong
              id="geo4-mc-network">—</strong
            >
          </div>
          <div><span>{c.stockout}</span><strong id="geo4-mc-stockout">—</strong></div>
        </div>
        <div class="geo4__subhead"><span>{c.stability}</span></div>
        <div id="geo4-stability" class="geo4__stability"></div>
      </div>
    </aside>
  </div>
</section>

<script>
  import "../scripts/geospatial-leaflet-loader.js";
  import "../scripts/geospatial-v4.js";
</script>

<style>
  .geo4 {
    --bg: #06131d;
    --panel: rgba(7, 24, 34, 0.95);
    --line: rgba(116, 190, 213, 0.2);
    --cyan: #62ecff;
    --acid: #d8ff6b;
    --pink: #ff759a;
    --amber: #ffcc66;
    --muted: #83a3b0;
    width: min(1720px, calc(100vw - 1rem));
    margin: 0 auto 3rem;
    color: #eafaff;
  }
  .geo4__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .geo4__shell {
    position: relative;
    min-height: 900px;
    overflow: hidden;
    border: 1px solid rgba(95, 174, 201, 0.28);
    background: var(--bg);
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.24);
  }
  #geo4-map {
    position: absolute;
    inset: 0;
    background: var(--bg);
  }
  .geo4__results-head span {
    color: var(--cyan);
    font: 700 0.68rem/1.2 monospace;
    letter-spacing: 0.12em;
  }
  .geo4__legend {
    position: absolute;
    z-index: 620;
    left: 1rem;
    bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    background: rgba(4, 18, 27, 0.88);
    color: #91acb7;
    font-size: 0.66rem;
    backdrop-filter: blur(12px);
  }
  .geo4__legend span {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
  .geo4__legend i {
    width: 12px;
    height: 4px;
    border-radius: 999px;
    display: inline-block;
  }
  .geo4__legend .facility {
    height: 8px;
    background: var(--acid);
  }
  .geo4__legend .demand {
    height: 8px;
    background: var(--pink);
  }
  .geo4__legend .allocation {
    border-top: 1px dashed var(--cyan);
  }
  .geo4__legend .route {
    background: var(--acid);
  }
