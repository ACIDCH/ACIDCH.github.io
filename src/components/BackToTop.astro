---
import type { Locale } from "../config/site";
import { sharedUi } from "../i18n/shared-ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = sharedUi[locale].backToTop;
---

<button
  class="back-to-top"
  type="button"
  aria-label={label}
  title={label}
  data-back-to-top
  data-visible="false"
  style="--scroll-progress: 0"
>
  <span class="back-to-top__surface" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="m7 11 5-5 5 5"></path>
      <path d="M12 6v12"></path>
    </svg>
  </span>
</button>

<script>
  let backToTopCleanup: (() => void) | undefined;

  function initializeBackToTop() {
    backToTopCleanup?.();

    const button = document.querySelector<HTMLElement>("[data-back-to-top]");
    if (!(button instanceof HTMLButtonElement)) return;

    const controller = new AbortController();
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    const update = () => {
      frame = 0;
      const scrollable = Math.max(
        1,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      const progress = Math.min(1, Math.max(0, window.scrollY / scrollable));
      button.style.setProperty("--scroll-progress", progress.toFixed(4));
      button.dataset.visible = String(
        window.scrollY > Math.min(720, window.innerHeight),
      );
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    button.addEventListener(
      "click",
      () => {
        window.scrollTo({
          top: 0,
          behavior: reduceMotion.matches ? "auto" : "smooth",
        });
      },
      { signal: controller.signal },
    );
    window.addEventListener("scroll", scheduleUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", scheduleUpdate, {
      passive: true,
      signal: controller.signal,
    });

    update();

    backToTopCleanup = () => {
      controller.abort();
      if (frame) window.cancelAnimationFrame(frame);
    };
  }

  document.addEventListener("astro:before-swap", () => backToTopCleanup?.());
  document.addEventListener("astro:page-load", initializeBackToTop);
  initializeBackToTop();
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2.2rem);
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 18;
    display: grid;
    place-items: center;
    width: 3.15rem;
    height: 3.15rem;
    padding: 2px;
    border: 0;
    border-radius: 50%;
    background: conic-gradient(
      from -90deg,
      var(--colour-primary) calc(var(--scroll-progress) * 1turn),
      color-mix(in srgb, var(--colour-border-strong) 68%, transparent) 0
    );
    color: var(--colour-text);
    box-shadow: 0 0.7rem 2rem rgb(7 25 35 / 14%);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.65rem) scale(0.94);
    transition:
      opacity 180ms var(--ease-standard),
      transform 220ms var(--ease-standard),
      box-shadow 220ms var(--ease-standard);
  }

  .back-to-top[data-visible="true"] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .back-to-top:hover {
    box-shadow: 0 0.9rem 2.4rem rgb(7 25 35 / 20%);
    transform: translateY(-0.12rem) scale(1.02);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--colour-primary);
    outline-offset: 4px;
  }

  .back-to-top__surface {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid color-mix(in srgb, var(--colour-border) 82%, transparent);
    border-radius: inherit;
    background: color-mix(in srgb, var(--colour-surface) 94%, transparent);
    backdrop-filter: blur(0.8rem);
  }

  svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 42rem) {
    .back-to-top {
      right: 0.85rem;
      width: 2.9rem;
      height: 2.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 120ms linear;
      transform: none !important;
    }
  }
</style>
