---
import type { Locale } from "../config/site";
import { siteConfig } from "../config/site";
import { ui } from "../i18n/ui";
import { getLocalizedPath } from "../utils/paths";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const targetLocale: Locale = locale === "en" ? "zh" : "en";
const targetPath = alternatePath ?? getLocalizedPath(Astro.url.pathname, targetLocale);
---

<a
  class="language-link"
  href={targetPath}
  lang={targetLocale === "en" ? "en" : "zh-CN"}
  hreflang={targetLocale === "en" ? "en" : "zh-CN"}
  aria-label={locale === "en" ? "切换到简体中文" : "Switch to English"}
  data-language-switch
  data-target-locale={targetLocale}
  data-language-storage-key={siteConfig.language.storageKey}
  title={locale === "en" ? "简体中文" : "English"}
>
  <Icon name="language" />
  <span class="visually-hidden">{ui[locale].languageSwitch}</span>
</a>

<script>
  function initLanguageSwitch() {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-language-switch]")
      .forEach((link) => {
        if (link.dataset.languageReady === "true") return;
        link.dataset.languageReady = "true";
        link.addEventListener("click", () => {
          const locale = link.dataset.targetLocale;
          const key = link.dataset.languageStorageKey;
          if (!locale || !key) return;

          try {
            localStorage.setItem(key, locale);
          } catch {
            // Navigation remains functional when storage is unavailable.
          }
        });
      });
  }

  document.addEventListener("astro:page-load", initLanguageSwitch);
  initLanguageSwitch();
</script>
