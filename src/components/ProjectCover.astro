---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
  compact?: boolean;
  showCode?: boolean;
  code?: string;
  badges?: string[];
}

const {
  entry,
  compact = false,
  showCode = true,
  code,
  badges = [],
} = Astro.props;
const transitionName = `project-cover-${entry.data.translationKey}-${entry.data.locale}`;
const coverLabel = code ?? entry.data.topic.slice(0, 3).toUpperCase();
const coverBadges = badges.filter(Boolean).slice(0, 3);
---

<div
  class:list={["project-cover", compact && "project-cover--compact"]}
  data-topic={entry.data.topic}
  aria-hidden="true"
  transition:name={transitionName}
>
  <span class="project-cover__grid"></span>
  <span class="project-cover__orb project-cover__orb--one"></span>
  <span class="project-cover__orb project-cover__orb--two"></span>
  {
    showCode && (
      <div class="project-cover__visual">
        <span class="project-cover__label">{coverLabel}</span>
        {
          coverBadges.length > 0 && (
            <span class="project-cover__badges">
              {coverBadges.map((badge) => (
                <span class="project-cover__badge">{badge}</span>
              ))}
            </span>
          )
        }
      </div>
    )
  }
</div>
