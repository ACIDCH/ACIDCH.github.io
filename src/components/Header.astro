---
import { navigationItems } from "../config/navigation";
import type { Locale } from "../config/site";
import { getLocalizedPath } from "../utils/paths";
import LanguageSwitch from "./LanguageSwitch.astro";
import Icon, { type IconName } from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
  locale: Locale;
  alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const currentPath = Astro.url.pathname;
const navigationIcons: Record<string, IconName> = {
  "/": "home",
  "/projects/": "projects",
  "/notes/": "notes",
  "/about/": "about",
};

function isCurrentRoute(path: string): boolean {
  const localizedPath = getLocalizedPath(path, locale);

  if (path === "/") {
    return currentPath === localizedPath;
  }

  return currentPath.startsWith(localizedPath);
}
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a
      class="site-brand"
      href={getLocalizedPath("/", locale)}
      transition:name="site-logo"
      aria-label={locale === "en" ? "Portfolio home" : "作品集首页"}
    >
      <Logo size="sm" />
    </a>

    <div class="header-mobile-tools">
      <button
        class="icon-button search-trigger search-trigger--mobile"
        type="button"
        aria-label={locale === "en" ? "Search" : "搜索"}
        title={locale === "en"
          ? "Search (Ctrl/Command + K)"
          : "搜索（Ctrl/Command + K）"}
        data-search-open
      >
        <Icon name="search" />
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        data-menu-toggle
      >
        <span class="menu-toggle__open-icon"><Icon name="menu" /></span>
        <span class="menu-toggle__close-icon"><Icon name="close" /></span>
        <span>{locale === "en" ? "Menu" : "菜单"}</span>
      </button>
    </div>

    <button
      class="menu-scrim"
      type="button"
      tabindex="-1"
      aria-label={locale === "en" ? "Close menu" : "关闭菜单"}
      data-menu-scrim></button>

    <div class="header-panel" id="primary-navigation" data-header-panel>
      <nav
        class="primary-nav"
        aria-label={locale === "en" ? "Primary navigation" : "主导航"}
      >
        <ul>
          {
            navigationItems.map((item) => (
              <li>
                <a
                  href={getLocalizedPath(item.path, locale)}
                  aria-current={isCurrentRoute(item.path) ? "page" : undefined}
                >
                  <Icon name={navigationIcons[item.path] ?? "home"} />
                  {item.label[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-tools">
        <button
          class="icon-button search-trigger search-trigger--desktop"
          type="button"
          aria-label={locale === "en" ? "Search" : "搜索"}
          title={locale === "en"
            ? "Search (Ctrl/Command + K)"
            : "搜索（Ctrl/Command + K）"}
          data-search-open
        >
          <Icon name="search" />
        </button>
        <LanguageSwitch locale={locale} alternatePath={alternatePath} />
        <ThemeSwitch locale={locale} />
      </div>
    </div>
  </div>
</header>

<script>
  const desktop = window.matchMedia("(min-width: 70rem)");
  let activeHeaderCleanup: (() => void) | undefined;
  let lockedScrollPosition: number | undefined;

  function setBackgroundInert(inert: boolean) {
    document
      .querySelectorAll<HTMLElement>("body > .skip-link, body > main, body > footer")
      .forEach((element) => {
        element.inert = inert;
      });
  }

  function lockPage() {
    if (lockedScrollPosition !== undefined) return;

    lockedScrollPosition = window.scrollY;
    document.documentElement.dataset.menuLocked = "true";
    document.body.dataset.menuLocked = "true";
    document.body.style.setProperty("--menu-lock-offset", `-${lockedScrollPosition}px`);
    setBackgroundInert(true);
  }

  function unlockPage({ restoreScroll = true } = {}) {
    if (lockedScrollPosition === undefined) {
      document.documentElement.removeAttribute("data-menu-locked");
      document.body.removeAttribute("data-menu-locked");
      document.body.style.removeProperty("--menu-lock-offset");
      setBackgroundInert(false);
      return;
    }

    const scrollPosition = lockedScrollPosition;
    lockedScrollPosition = undefined;
    document.documentElement.removeAttribute("data-menu-locked");
    document.body.removeAttribute("data-menu-locked");
    document.body.style.removeProperty("--menu-lock-offset");
    setBackgroundInert(false);

    if (restoreScroll) {
      window.scrollTo(0, scrollPosition);
    }
  }

  function initHeader() {
    activeHeaderCleanup?.();

    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = header?.querySelector<HTMLElement>("[data-header-panel]");
    const scrim = header?.querySelector<HTMLButtonElement>("[data-menu-scrim]");
    if (!header || !toggle || !panel || !scrim) return;

    const controller = new AbortController();
    const { signal } = controller;

    function setMenu(open: boolean) {
      const wasOpen = toggle!.getAttribute("aria-expanded") === "true";
      header!.dataset.menuOpen = String(open);
      toggle!.setAttribute("aria-expanded", String(open));

      if (open && !wasOpen && !desktop.matches) {
        lockPage();
      } else if (!open && wasOpen) {
        unlockPage();
      }
    }

    function closeAndRestoreFocus() {
      setMenu(false);
      toggle!.focus();
    }

    toggle.addEventListener(
      "click",
      () => {
        setMenu(toggle.getAttribute("aria-expanded") !== "true");
      },
      { signal },
    );

    scrim.addEventListener("click", closeAndRestoreFocus, { signal });

    panel.addEventListener(
      "click",
      (event) => {
        if ((event.target as HTMLElement).closest("a")) {
          setMenu(false);
        }
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          closeAndRestoreFocus();
        }
      },
      { signal },
    );

    desktop.addEventListener("change", () => setMenu(false), { signal });

    activeHeaderCleanup = () => {
      controller.abort();
      header.dataset.menuOpen = "false";
      toggle.setAttribute("aria-expanded", "false");
      unlockPage();
    };
  }

  document.addEventListener("astro:before-swap", () => activeHeaderCleanup?.());
  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
