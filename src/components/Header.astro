---
import { navigationItems } from "../config/navigation";
import type { Locale } from "../config/site";
import { getLocalizedPath } from "../utils/paths";
import LanguageSwitch from "./LanguageSwitch.astro";
import Icon, { type IconName } from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeSwitch from "./ThemeSwitch.astro";

interface Props {
  locale: Locale;
  alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const currentPath = Astro.url.pathname;
const navigationIcons: Record<string, IconName> = {
  "/": "home",
  "/projects/": "projects",
  "/notes/": "notes",
  "/productivity/": "tool",
  "/about/": "about",
};

function isCurrentRoute(path: string): boolean {
  const localizedPath = getLocalizedPath(path, locale);
  return path === "/"
    ? currentPath === localizedPath
    : currentPath.startsWith(localizedPath);
}
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a
      class="site-brand"
      href={getLocalizedPath("/", locale)}
      transition:name="site-logo"
      aria-label={locale === "en" ? "Portfolio home" : "作品集首页"}
    >
      <Logo size="sm" />
    </a>

    <div class="header-mobile-tools">
      <button
        class="icon-button search-trigger search-trigger--mobile"
        type="button"
        aria-label={locale === "en" ? "Search" : "搜索"}
        title={locale === "en"
          ? "Search (Ctrl/Command + K)"
          : "搜索（Ctrl/Command + K）"}
        data-search-open
      >
        <Icon name="search" />
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
      >
        <span><Icon name="menu" /></span>
        <span>{locale === "en" ? "Menu" : "菜单"}</span>
      </button>
    </div>

    <div class="header-panel" data-header-panel>
      <nav
        class="primary-nav"
        aria-label={locale === "en" ? "Primary navigation" : "主导航"}
      >
        <ul>
          {
            navigationItems.map((item) => (
              <li>
                <a
                  href={getLocalizedPath(item.path, locale)}
                  aria-current={isCurrentRoute(item.path) ? "page" : undefined}
                >
                  <Icon name={navigationIcons[item.path] ?? "home"} />
                  {item.label[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-tools">
        <button
          class="icon-button search-trigger search-trigger--desktop"
          type="button"
          aria-label={locale === "en" ? "Search" : "搜索"}
          title={locale === "en"
            ? "Search (Ctrl/Command + K)"
            : "搜索（Ctrl/Command + K）"}
          data-search-open
        >
          <Icon name="search" />
        </button>
        <LanguageSwitch locale={locale} alternatePath={alternatePath} />
        <ThemeSwitch locale={locale} />
      </div>
    </div>
  </div>
</header>

<dialog
  class="mobile-menu"
  id="mobile-navigation"
  aria-label={locale === "en" ? "Mobile navigation" : "移动端导航"}
  data-mobile-menu
>
  <div class="mobile-menu__sheet">
    <header class="mobile-menu__header">
      <Logo size="sm" />
      <button
        class="menu-toggle"
        type="button"
        aria-label={locale === "en" ? "Close menu" : "关闭菜单"}
        data-menu-close
      >
        <Icon name="close" />
        <span>{locale === "en" ? "Close" : "关闭"}</span>
      </button>
    </header>
    <nav
      class="mobile-menu__nav primary-nav"
      aria-label={locale === "en" ? "Mobile navigation" : "移动端导航"}
    >
      <ul>
        {
          navigationItems.map((item) => (
            <li>
              <a
                href={getLocalizedPath(item.path, locale)}
                aria-current={isCurrentRoute(item.path) ? "page" : undefined}
                data-menu-link
              >
                <Icon name={navigationIcons[item.path] ?? "home"} />
                {item.label[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__tools">
      <LanguageSwitch locale={locale} alternatePath={alternatePath} />
      <ThemeSwitch locale={locale} />
    </div>
  </div>
</dialog>

<script>
  const desktop = window.matchMedia("(min-width: 70rem)");
  let activeHeaderCleanup: (() => void) | undefined;
  let lockedScrollPosition: number | undefined;

  function lockMenuPage() {
    if (lockedScrollPosition !== undefined) return;
    lockedScrollPosition = window.scrollY;
    document.documentElement.dataset.menuLocked = "true";
    document.body.dataset.menuLocked = "true";
    document.body.style.setProperty("--menu-lock-offset", `-${lockedScrollPosition}px`);
  }

  function unlockMenuPage(restoreScroll = true) {
    const scrollPosition = lockedScrollPosition;
    lockedScrollPosition = undefined;
    document.documentElement.removeAttribute("data-menu-locked");
    document.body.removeAttribute("data-menu-locked");
    document.body.style.removeProperty("--menu-lock-offset");
    if (restoreScroll && scrollPosition !== undefined) {
      const scrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = "auto";
      window.scrollTo(0, scrollPosition);
      document.documentElement.style.scrollBehavior = scrollBehavior;
    }
  }

  function initHeader() {
    activeHeaderCleanup?.();

    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const dialog = document.querySelector<HTMLDialogElement>("[data-mobile-menu]");
    const close = dialog?.querySelector<HTMLButtonElement>("[data-menu-close]");
    const firstLink = dialog?.querySelector<HTMLAnchorElement>("[data-menu-link]");
    if (!header || !toggle || !dialog || !close || !firstLink) return;

    const controller = new AbortController();
    const { signal } = controller;
    let returnFocus = false;
    let restoreScrollOnClose = true;

    function finishClose(restoreScroll: boolean, restoreFocus: boolean) {
      header!.dataset.menuOpen = "false";
      toggle!.setAttribute("aria-expanded", "false");
      unlockMenuPage(restoreScroll);
      if (restoreFocus) {
        requestAnimationFrame(() => toggle!.focus({ preventScroll: true }));
      }
    }

    function closeMenu({
      restoreScroll = true,
      restoreFocus = true,
    }: {
      restoreScroll?: boolean;
      restoreFocus?: boolean;
    } = {}) {
      returnFocus = restoreFocus;
      restoreScrollOnClose = restoreScroll;
      if (dialog!.open) {
        dialog!.close();
      } else {
        finishClose(restoreScroll, restoreFocus);
      }
    }

    function openMenu() {
      if (desktop.matches || dialog!.open) return;
      lockMenuPage();
      header!.dataset.menuOpen = "true";
      toggle!.setAttribute("aria-expanded", "true");
      returnFocus = true;
      restoreScrollOnClose = true;
      dialog!.showModal();
      requestAnimationFrame(() => firstLink!.focus());
    }

    toggle.addEventListener(
      "click",
      () => {
        if (dialog.open) closeMenu();
        else openMenu();
      },
      { signal },
    );
    close.addEventListener("click", () => closeMenu(), { signal });
    dialog.addEventListener(
      "click",
      (event) => {
        if (event.target === dialog) closeMenu();
      },
      { signal },
    );
    dialog.addEventListener(
      "cancel",
      (event) => {
        event.preventDefault();
        closeMenu();
      },
      { signal },
    );
    dialog.addEventListener(
      "close",
      () => finishClose(restoreScrollOnClose, returnFocus),
      { signal },
    );
    dialog.addEventListener(
      "click",
      (event) => {
        if ((event.target as HTMLElement).closest("[data-menu-link]")) {
          closeMenu({ restoreFocus: false });
        }
      },
      { signal },
    );
    desktop.addEventListener("change", () => closeMenu({ restoreFocus: false }), {
      signal,
    });

    const updateHeaderSurface = () => {
      header.dataset.scrolled = String(window.scrollY > 16);
    };
    window.addEventListener("scroll", updateHeaderSurface, {
      passive: true,
      signal,
    });
    updateHeaderSurface();

    activeHeaderCleanup = () => {
      returnFocus = false;
      restoreScrollOnClose = false;
      if (dialog.open) dialog.close();
      controller.abort();
      finishClose(false, false);
    };
  }

  document.addEventListener("astro:before-swap", () => activeHeaderCleanup?.());
  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
