---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedPath } from "../utils/paths";
import ContextBack from "./ContextBack.astro";
import AnalysisPipeline from "./AnalysisPipeline.astro";
import CaseSectionMarker from "./CaseSectionMarker.astro";
import ChurnDataStory from "./ChurnDataStory.astro";
import FeatureSelectionStory from "./FeatureSelectionStory.astro";
import ModelComparisonLab from "./ModelComparisonLab.astro";
import ModelEvaluation from "./ModelEvaluation.astro";
import RCodeShowcase from "./RCodeShowcase.astro";
import TechnicalDeepDiveNav from "./TechnicalDeepDiveNav.astro";
import { codeSnippets } from "../data/r-machine-learning";

interface Props {
  entry: CollectionEntry<"projects">;
  alternatePath: string;
}

const { entry, alternatePath } = Astro.props;
const relatedProjects = (await getCollection("projects"))
  .filter(
    (project) =>
      project.data.locale === "zh" &&
      project.data.status === "completed" &&
      project.data.translationKey !== entry.data.translationKey,
  )
  .slice(0, 3);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale="zh"
  alternatePath={alternatePath}
  canonicalPath={getLocalizedPath(`/projects/${entry.data.slug}/`, "zh")}
>
  <main id="main-content" class="churn-case">
    <article>
      <header class="case-hero">
        <div class="case-shell">
          <ContextBack
            locale="zh"
            fallbackPath="/projects/"
            label={{ en: "Back to projects", zh: "返回项目列表" }}
          />

          <div class="case-hero__grid" data-reveal>
            <div class="case-hero__copy">
              <p class="case-kicker">R / CUSTOMER CHURN / CLASSIFICATION</p>
              <h1>{entry.data.title}</h1>
              <p class="case-hero__summary">
                以 20
                万条合成电动车充电客户记录为起点，比较五种分类模型如何识别流失客户，并在区分能力、漏判控制和变量解释之间完成模型选择。
              </p>
              <ul class="case-tags" aria-label="工具与方法">
                {entry.data.tools.slice(0, 5).map((tool) => <li>{tool}</li>)}
              </ul>
            </div>

            <div class="case-hero__signal" aria-label="项目数据链">
              <div class="signal-route" aria-hidden="true">
                <svg viewBox="0 0 640 260">
                  <path
                    class="signal-route__base"
                    d="M28 210 C126 210 120 152 210 152 S302 86 390 86 S504 42 612 42"
                  ></path>
                  <path
                    class="signal-route__active"
                    d="M28 210 C126 210 120 152 210 152 S302 86 390 86 S504 42 612 42"
                  ></path>
                  <circle cx="28" cy="210" r="8"></circle>
                  <circle cx="210" cy="152" r="8"></circle>
                  <circle cx="390" cy="86" r="8"></circle>
                  <circle cx="612" cy="42" r="8"></circle>
                </svg>
              </div>
              <ol>
                <li><span>01</span><strong>200,000</strong><small>原始记录</small></li>
                <li><span>02</span><strong>7</strong><small>最终输入</small></li>
                <li><span>03</span><strong>5</strong><small>比较模型</small></li>
                <li><span>04</span><strong>0.9053</strong><small>留出集 AUC</small></li>
              </ol>
            </div>
          </div>

          <div class="case-hero__decision" data-reveal>
            <span>最终判断</span>
            <strong>Logistic Regression</strong>
            <p>
              AUC 在五折比较中排名第一，Sensitivity 接近最高值，同时保留 odds ratio
              解释。
            </p>
          </div>
        </div>
      </header>

      <nav class="case-toc" aria-label="项目阅读目录">
        <div class="case-shell">
          <a href="#question">问题</a>
          <a href="#data-flow">数据流转</a>
          <a href="#feature-selection">变量判断</a>
          <a href="#pipeline">建模流程</a>
          <a href="#comparison">模型比较</a>
          <a href="#evaluation">预测评估</a>
          <a href="#code">R 代码</a>
          <a href="#deep-dives">Deep Dives</a>
        </div>
      </nav>

      <div class="case-shell case-body">
        <section id="question" class="case-section case-section--opening" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="question" label="Problem" />
            <p class="section-number">01</p>
            <h2>真正要回答的，不是“谁会流失”这一句话</h2>
            <p class="section-lead">
              分类模型可以给出流失概率，但选择哪一个模型，取决于它如何平衡三件事：能否把流失客户排在更前面、会漏掉多少真实流失客户，以及结果能否解释到具体变量。
            </p>
          </div>

          <div class="question-grid">
            <article>
              <span>Q1</span>
              <h3>数据能否直接进入模型？</h3>
              <p>
                单位、百分比、二元字段和目标水平需要先统一；Fleet 还代表另一种合同结构。
              </p>
            </article>
            <article>
              <span>Q2</span>
              <h3>哪些信号值得保留？</h3>
              <p>字段选择由 EDA、业务边界和相关性共同决定，不按模型方便程度倒推。</p>
            </article>
            <article>
              <span>Q3</span>
              <h3>模型差异落在哪里？</h3>
              <p>Accuracy、AUC、Sensitivity 和 Specificity 分别给出不同排名。</p>
            </article>
            <article>
              <span>Q4</span>
              <h3>最后的判断如何解释？</h3>
              <p>留出集回答泛化表现，混淆矩阵回答错误结构，odds ratio 回答变量方向。</p>
            </article>
          </div>

          <p class="bridge-copy">
            第一个判断发生在建模之前：先看 20
            万条记录如何被限定、拆分和抽样，才能判断后面的指标是否可信。
          </p>
        </section>

        <section id="data-flow" class="case-section case-section--wide" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="data" label="Data" />
            <p class="section-number">02</p>
            <h2>200,000 条记录如何进入分析？</h2>
            <p class="section-lead">
              样本流转决定了模型比较与最终评价的边界。探索结果则回答另一件事：哪些差异值得进入后续筛选。
            </p>
          </div>
          <ChurnDataStory />
          <p class="bridge-copy">
            活跃度、等待时间、设备故障和支付退款信号都出现差异，但“出现差异”还不等于“全部放入模型”。下一步需要解释
            25 个字段如何缩减到 7 个输入。
          </p>
        </section>

        <section
          id="feature-selection"
          class="case-section case-section--wide"
          data-reveal
        >
          <div class="section-intro">
            <CaseSectionMarker kind="filter" label="Feature" />
            <p class="section-number">03</p>
            <h2>25 个字段为什么最后只留下 7 个？</h2>
            <p class="section-lead">
              最终输入覆盖服务质量、商业摩擦、活跃度和会员结构。高缺失调查字段、可能代理服务质量的地区字段，以及与近期活跃度高度相关的注册时长没有进入模型。
            </p>
          </div>
          <FeatureSelectionStory />
          <div class="code-evidence code-evidence--single">
            <div>
              <span>R / SELECT</span>
              <h3>字段判断如何对应到建模数据</h3>
              <p>
                代码只保留七个输入和 churn 目标；这一列表随后由两套 recipe 共同使用。
              </p>
              <dl><div><dt>输出</dt><dd>196,000 行 × 8 列</dd></div></dl>
            </div>
            <RCodeShowcase {...codeSnippets.variableSelection} />
          </div>
          <p class="bridge-copy">
            输入确定之后，新的风险来自流程本身：如果上采样或编码越过数据边界，模型比较会变得乐观。因此需要把拆分、交叉验证与预处理顺序放在同一条
            Pipeline 中检查。
          </p>
        </section>

        <section id="pipeline" class="case-section case-section--wide" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="pipeline" label="Pipeline" />
            <p class="section-number">04</p>
            <h2>如何比较模型，同时不让测试集提前泄露答案？</h2>
            <p class="section-lead">
              80/20 分层拆分先于抽样和预处理。五折比较只使用训练部分中的 30,000
              条记录；上采样写进 recipe，因此只作用于每一折的训练数据。
            </p>
          </div>
          <AnalysisPipeline />
          <div class="recipe-contrast">
            <article>
              <span>RECIPE A</span>
              <h3>Dummy 编码</h3>
              <p>
                Logistic Regression 与 XGBoost 使用数值矩阵；分类字段展开为指示变量。
              </p>
              <small>glm / xgboost</small>
            </article>
            <article>
              <span>RECIPE B</span>
              <h3>保留因子变量</h3>
              <p>Random Forest、LightGBM 与 Naive Bayes 直接接收分类字段。</p>
              <small>ranger / lightgbm / klaR</small>
            </article>
            <div class="recipe-shared">
              <strong>共同步骤</strong>
              <p>未知水平处理 → 零方差移除 → 训练折内 1:1 上采样</p>
            </div>
          </div>
          <div class="code-evidence">
            <div>
              <span>R / SPLIT</span>
              <h3>先锁定留出集</h3>
              <p>seed 404713359 与 churn 分层保证流程可以复查。</p>
              <dl>
                <div><dt>训练</dt><dd>156,800</dd></div><div>
                  <dt>测试</dt><dd>39,200</dd>
                </div>
              </dl>
            </div>
            <RCodeShowcase {...codeSnippets.split} />
            <div>
              <span>R / RECIPE</span>
              <h3>再把上采样限制在训练折</h3>
              <p>验证折和测试集维持原类别比例，指标因此仍对应自然分布。</p>
              <dl>
                <div><dt>CV</dt><dd>5 folds</dd></div><div>
                  <dt>样本</dt><dd>30,000</dd>
                </div>
              </dl>
            </div>
            <RCodeShowcase {...codeSnippets.recipes} />
          </div>
          <p class="bridge-copy">
            当五个模型使用同一份交叉验证设计后，比较才有意义。真正困难的部分不是找出每列最高值，而是理解四项指标为什么给出不同答案。
          </p>
        </section>

        <section id="comparison" class="case-section case-section--wide" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="compare" label="Compare" />
            <p class="section-number">05</p>
            <h2>五个模型到底差在哪里？</h2>
            <p class="section-lead">
              LightGBM 的 Accuracy 最高，Naive Bayes 的 Sensitivity 最高，XGBoost 的
              Specificity 最高，而 Logistic Regression 的 AUC
              最高。没有一个模型包揽四项指标。
            </p>
          </div>
          <ModelComparisonLab />
          <div class="decision-quote">
            <span aria-hidden="true">↳</span>
            <p>
              <strong>为什么不是 Accuracy 最高的 LightGBM？</strong> 0.8199 与 Logistic Regression
              的 0.8136 相差 0.0063；与此同时，Logistic Regression 的 AUC 高 0.0069，Sensitivity
              高 0.0287，并能继续解释变量方向。
            </p>
          </div>
          <p class="bridge-copy">
            交叉验证决定候选模型，留出集决定这个选择能否站住。下一步不再看均值排名，而是直接查看
            39,200 条未见记录中的正确分类与两类错误。
          </p>
        </section>

        <section id="evaluation" class="case-section case-section--wide" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="evaluate" label="Evaluate" />
            <p class="section-number">06</p>
            <h2>最终模型识别了多少流失客户，又漏掉了多少？</h2>
            <p class="section-lead">
              Logistic Regression 在留出集上取得 0.9053
              AUC。混淆矩阵说明错误落在哪里，ROC 说明跨阈值排序能力，odds ratio
              则把模型结果还原为变量方向。
            </p>
          </div>
          <ModelEvaluation />
          <p class="bridge-copy">
            图表回答了“结果是什么”，代码还要回答“结果从哪里产生”。主页面只保留与样本边界、模型选择和最终评价直接相关的五段
            R 代码。
          </p>
        </section>

        <section id="code" class="case-section case-section--wide" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="code" label="R Code" />
            <p class="section-number">07</p>
            <h2>每段 R 代码都对应一个可见结果</h2>
            <p class="section-lead">
              代码不按文件顺序堆叠，而是对应前文的判断：如何定义指标方向、如何选择模型，以及如何生成混淆矩阵和
              ROC。
            </p>
          </div>
          <div class="code-narrative">
            <article>
              <div>
                <span>01</span><h3>定义正类与评价指标</h3><p>
                  <code>churned</code> 是第二水平，Sensitivity 与 Specificity 都按这一方向计算。
                </p><strong>对应输出：五折四指标比较</strong>
              </div>
              <RCodeShowcase {...codeSnippets.metricSet} />
            </article>
            <article>
              <div>
                <span>02</span><h3>按 AUC 选择候选模型</h3><p>
                  比较完成后才把获选 workflow 拟合到完整训练部分。
                </p><strong>对应输出：Logistic Regression</strong>
              </div>
              <RCodeShowcase {...codeSnippets.finalFit} />
            </article>
            <article>
              <div>
                <span>03</span><h3>生成误判结构与 ROC</h3><p>
                  同一组留出集预测同时进入混淆矩阵与 AUC 计算。
                </p><strong>对应输出：39,200 条矩阵与 AUC 0.9053</strong>
              </div>
              <RCodeShowcase {...codeSnippets.confusion} />
            </article>
            <article>
              <div>
                <span>04</span><h3>重新拟合解释模型</h3><p>
                  解释用 Logistic Regression 保持自然类别比例，避免上采样改变截距与 OR
                  量级。
                </p><strong>对应输出：八项 odds ratio</strong>
              </div>
              <RCodeShowcase {...codeSnippets.oddsRatio} />
            </article>
          </div>
        </section>

        <section id="deep-dives" class="case-section case-section--deep" data-reveal>
          <div class="section-intro">
            <CaseSectionMarker kind="detail" label="Deep Dive" />
            <p class="section-number">08</p>
            <h2>主页面给出判断链，技术页展开实现细节</h2>
            <p class="section-lead">
              四个专题分别处理流程、模型比较、预测评价，以及与客户流失分析分开的神经网络实验。
            </p>
          </div>
          <TechnicalDeepDiveNav />
        </section>

        <section class="case-section case-section--boundary" data-reveal>
          <div class="boundary-copy">
            <p class="case-kicker">ANALYSIS BOUNDARY</p>
            <h2>这些结果能说明什么，不能说明什么？</h2>
          </div>
          <div class="boundary-notes">
            <p>
              <strong>数据边界</strong
              >客户记录是合成数据，结论适用于当前字段定义和样本结构。
            </p>
            <p>
              <strong>阈值边界</strong>混淆矩阵对应既定分类阈值；页面没有推演其他阈值。
            </p>
            <p>
              <strong>使用边界</strong
              >结果用于比较分类方法和解释风险信号，不代表已经接入实际客户系统。
            </p>
          </div>
        </section>

        <footer class="case-footer" data-reveal>
          <div>
            <p class="case-kicker">CONTINUE READING</p>
            <h2>继续查看其他分析项目</h2>
          </div>
          <ul>
            {
              relatedProjects.map((project) => (
                <li>
                  <a href={getLocalizedPath(`/projects/${project.data.slug}/`, "zh")}>
                    <>
                      <span>{project.data.topic}</span>
                      <strong>{project.data.title}</strong>
                      <i aria-hidden="true">↗</i>
                    </>
                  </a>
                </li>
              ))
            }
          </ul>
          <ContextBack
            locale="zh"
            fallbackPath="/projects/"
            label={{ en: "Back to projects", zh: "返回项目列表" }}
          />
        </footer>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .churn-case {
    width: 100%;
    min-width: 0;
    overflow: clip;
  }

  .churn-case > article {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: none;
    margin: 0;
  }

  .case-shell {
    width: min(calc(100% - clamp(1.25rem, 5vw, 5rem)), 82rem);
    margin-inline: auto;
  }

  .case-hero {
    min-width: 0;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(2.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--colour-border-strong);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--colour-primary) 7%, transparent),
        transparent 52%
      ),
      var(--colour-page);
  }

  .case-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(28rem, 0.95fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: end;
    min-height: min(38rem, calc(100svh - var(--header-height) - 8rem));
    padding-top: clamp(3rem, 8vw, 7rem);
  }

  .case-hero__copy {
    min-width: 0;
  }

  .case-kicker,
  .case-hero h1,
  .case-hero__summary,
  .case-hero__decision p,
  .section-intro p,
  .section-intro h2,
  .question-grid h3,
  .question-grid p,
  .bridge-copy,
  .recipe-contrast h3,
  .recipe-contrast p,
  .code-evidence h3,
  .code-evidence p,
  .decision-quote p,
  .code-narrative h3,
  .code-narrative p,
  .boundary-copy h2,
  .boundary-notes p,
  .case-footer h2 {
    margin: 0;
  }

  .case-kicker,
  .case-hero__copy > .case-kicker {
    color: var(--colour-accent);
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .case-hero h1 {
    max-width: 13ch;
    margin-top: 1.1rem;
    font-size: clamp(3rem, 6.2vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .case-hero__summary {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--colour-text-muted);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.75;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case-tags li {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--colour-border-strong);
    border-radius: 999px;
    color: var(--colour-text-muted);
    font-size: 0.78rem;
  }

  .case-hero__signal {
    position: relative;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-block: 1px solid var(--colour-border-strong);
  }

  .signal-route svg {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .signal-route path {
    fill: none;
    stroke-linecap: round;
  }

  .signal-route__base {
    stroke: var(--colour-border);
    stroke-width: 2;
  }

  .signal-route__active {
    stroke: var(--colour-primary);
    stroke-width: 3;
  }

  .signal-route circle {
    fill: var(--colour-page);
    stroke: var(--colour-accent);
    stroke-width: 3;
  }

  .case-hero__signal ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: -1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case-hero__signal li {
    display: grid;
    gap: 0.3rem;
  }

  .case-hero__signal li span {
    color: var(--colour-accent);
    font: 700 0.7rem/1 var(--font-mono);
  }

  .case-hero__signal li strong {
    font: 750 clamp(1.2rem, 2.8vw, 1.8rem)/1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }

  .case-hero__signal li small {
    color: var(--colour-text-muted);
  }

  .case-hero__decision {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--colour-border);
  }

  .case-hero__decision span {
    color: var(--colour-text-muted);
    font-size: 0.78rem;
  }

  .case-hero__decision strong {
    color: var(--colour-primary-strong);
    font: 750 1.05rem/1 var(--font-display);
  }

  .case-hero__decision p {
    color: var(--colour-text-muted);
  }

  .case-toc {
    position: sticky;
    top: var(--header-height);
    z-index: var(--z-raised);
    border-bottom: 1px solid var(--colour-border);
    background: color-mix(in srgb, var(--colour-page) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .case-toc .case-shell {
