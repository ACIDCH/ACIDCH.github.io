---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
import CodeShowcase from "./CodeShowcase.astro";
import ContextBack from "./ContextBack.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  alternatePath: string | null;
}

const { entry, alternatePath } = Astro.props;
const relatedProjects = (await getCollection("projects"))
  .filter(
    (project) =>
      project.data.locale === "zh" &&
      project.data.translationKey !== entry.data.translationKey,
  )
  .sort(
    (left, right) =>
      Number(right.data.featured) - Number(left.data.featured) ||
      left.data.title.localeCompare(right.data.title, "zh-CN"),
  )
  .slice(0, 2);
const structuredData = {
  "@type": "CreativeWork",
  name: entry.data.title,
  description: entry.data.summary,
  inLanguage: "zh-CN",
  keywords: [...entry.data.tools, ...entry.data.tags],
  isAccessibleForFree: true,
  dateModified: entry.data.updatedAt?.toISOString(),
};
const snippets = [
  {
    title: "01 · 统一歌曲与艺人文本",
    code: `def normalise_text(value):
    value = unicodedata.normalize("NFKD", str(value))
    value = "".join(char for char in value if not unicodedata.combining(char))
    value = re.sub(r"[^a-z0-9 ]", " ", value.lower())
    return re.sub(r"\\s+", " ", value).strip()`,
  },
  {
    title: "02 · 删除两套 Grammy 数据的重叠记录",
    code: `overlap_keys = set(
    grammy_json[["year", "title_norm", "artist_norm"]]
    .itertuples(index=False, name=None)
)
csv_unique = grammy_csv[
    ~grammy_csv[["year", "title_norm", "artist_norm"]]
    .apply(tuple, axis=1)
    .isin(overlap_keys)
]`,
  },
  {
    title: "03 · 先执行歌曲名与艺人名精确匹配",
    code: `exact_matches = spotify.merge(
    grammy_winners[["title_norm", "artist_norm"]].drop_duplicates(),
    on=["title_norm", "artist_norm"],
    how="inner",
)
spotify["grammy_winner"] = spotify.index.isin(exact_matches.index)`,
  },
  {
    title: "04 · 对未匹配记录执行模糊匹配",
    code: `def best_match(row, candidates, threshold=88):
    query = f"{row.title_norm} {row.artist_norm}"
    match = process.extractOne(query, candidates, scorer=fuzz.token_set_ratio)
    return match if match and match[1] >= threshold else None`,
  },
  {
    title: "05 · 比较两组流行度分布",
    code: `winner_popularity = analysis.loc[analysis.grammy_winner, "popularity"]
other_popularity = analysis.loc[~analysis.grammy_winner, "popularity"]
u_stat, p_value = stats.mannwhitneyu(
    winner_popularity,
    other_popularity,
    alternative="two-sided",
)`,
  },
  {
    title: "06 · 将浏览量转换为相对日期",
    code: `pageviews["relative_day"] = (
    pageviews["date"] - pageviews["ceremony_date"]
).dt.days
event_window = pageviews.loc[pageviews["relative_day"].between(-42, 42)]`,
  },
];
const charts = [
  {
    src: "popularity-distribution.webp",
    width: 694,
    height: 584,
    title: "流行度分布",
    caption: "获奖歌曲的流行度中位数为 72，其他歌曲为 66；两组分布仍有明显重叠。",
  },
  {
    src: "audio-profile.webp",
    width: 666,
    height: 588,
    title: "平均音频特征",
    caption: "八项标准化音频特征的组间轮廓接近，没有形成清晰的单一特征优势。",
  },
  {
    src: "audio-feature-distributions.webp",
    width: 1584,
    height: 810,
    title: "音频特征分布",
    caption: "逐项分布检验均未达到 0.05 显著性水平，最大效应量仍属可忽略范围。",
  },
  {
    src: "popularity-trend.webp",
    width: 1184,
    height: 583,
    title: "年度流行度走势",
    caption: "2015 年前的年度平均差距为 4.27，2015 年后的可比年份差距为 2.08。",
  },
  {
    src: "pageviews-event-window.webp",
    width: 793,
    height: 473,
    title: "典礼日前后页面浏览量",
    caption:
      "三首歌曲各保留 85 天观察窗口，用于检视事件日前后的关注变化；该部分仅作补充探索。",
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  locale="zh"
  alternatePath={alternatePath}
  pageType="article"
  structuredData={structuredData}
>
  <article class="project-detail python-project">
    <ContextBack
      locale="zh"
      fallbackPath="/zh/projects/"
      label={{ en: "Back to Projects", zh: "返回项目列表" }}
    />

    <header class="python-hero" data-reveal>
      <p class="status">Python 数据分析</p>
      <h1>{entry.data.title}</h1>
      <p class="python-hero__lede">
        连接提名记录、歌曲属性与事件窗口数据，回答获奖歌曲是否具有不同的流行度和音频特征。
      </p>
      <ul class="tag-list" aria-label="项目工具">
        {entry.data.tools.map((tool) => <li class="tag">{tool}</li>)}
      </ul>
      <dl class="hero-metrics">
        <div><dt>最终分析样本</dt><dd>1,687 首</dd></div>
        <div><dt>识别获奖歌曲</dt><dd>71 首</dd></div>
        <div><dt>分析年份</dt><dd>2000–2018</dd></div>
        <div><dt>音频特征</dt><dd>8 项</dd></div>
      </dl>
    </header>

    <nav class="project-toc" aria-label="页面目录" data-reveal>
      <a href="#overview">30 秒速览</a>
      <a href="#data">数据与核查</a>
      <a href="#workflow">处理流程</a>
      <a href="#code">关键代码</a>
      <a href="#results">结果</a>
      <a href="#interaction">阈值检视</a>
    </nav>

    <section id="overview" class="project-section" data-reveal>
      <p class="eyebrow">30 秒速览</p>
      <h2>从多源记录到可检验样本</h2>
      <div class="overview-grid">
        <div class="card">
          <h3>问题</h3>
          <p>获奖歌曲的 Spotify 流行度是否更高，音频特征是否存在稳定差异？</p>
        </div>
        <div class="card">
          <h3>方法</h3>
          <p>
            清洗两套提名记录，先精确匹配，再以 88
            分阈值补充模糊匹配，最后进行非参数检验。
          </p>
        </div>
        <div class="card">
          <h3>结论</h3>
          <p>流行度差异达到统计显著，但效应量较小；八项音频特征均未发现显著差异。</p>
        </div>
      </div>
    </section>

    <section id="data" class="project-section" data-reveal>
      <p class="eyebrow">数据与核查</p>
      <h2>三类数据承担不同角色</h2>
      <div class="table-scroll" tabindex="0" aria-label="数据来源和处理结果">
        <table>
          <thead
            ><tr><th>数据</th><th>初始规模</th><th>主要核查</th><th>进入分析</th></tr
            ></thead
          >
          <tbody>
            <tr
              ><td>提名记录 A</td><td>4,305 × 5</td><td>删除 43 条重复记录</td><td
                rowspan="2">合并清洗后 4,380 条</td
              ></tr
            >
            <tr
              ><td>提名记录 B</td><td>4,810 × 10</td><td
                >删除缺失歌曲名，并排除结构异常的 2019 年</td
              ></tr
            >
            <tr
              ><td>Spotify 歌曲</td><td>2,000 × 18</td><td
                >去重、限定年份、删除流行度为 0 的记录</td
              ><td>1,687 首</td></tr
            >
            <tr
              ><td>页面浏览量</td><td>3 × 85 天</td><td>围绕典礼日建立 ±42 天窗口</td
              ><td>255 条</td></tr
            >
          </tbody>
        </table>
      </div>
      <p class="note">
        2019 年在其中一套提名记录中出现 433 行，平均每个类别 5.2 行；前一年对应值为
        1.0。为避免字段含义变化影响匹配，该年份未进入主分析。
      </p>
    </section>

    <section id="workflow" class="project-section" data-reveal>
      <p class="eyebrow">处理流程</p>
      <h2>每一步都保留可核查的数量变化</h2>
      <ol class="process-flow">
        <li>
          <strong>审计</strong><span>检查字段、缺失、重复、年份和异常结构。</span>
        </li>
        <li><strong>标准化</strong><span>统一大小写、重音、标点和空格。</span></li>
        <li>
          <strong>合并</strong><span>去除两套提名数据之间的 4,253 条重叠记录。</span>
        </li>
        <li>
          <strong>匹配</strong><span>得到 64 个精确匹配和 7 个阈值内模糊匹配。</span>
        </li>
        <li>
          <strong>检验</strong><span>比较流行度与八项音频特征，并报告效应量。</span>
        </li>
        <li>
          <strong>探索</strong><span>以三首歌曲检查事件窗口内的页面关注变化。</span>
        </li>
      </ol>
    </section>

    <section id="code" class="project-section" data-reveal>
      <p class="eyebrow">关键代码</p>
      <h2>六段代码对应六个分析动作</h2>
      <div class="code-grid">
        {
          snippets.map((snippet, index) => (
            <CodeShowcase {...snippet} open={index === 0} />
          ))
        }
      </div>
    </section>

    <section id="results" class="project-section" data-reveal>
      <p class="eyebrow">真实结果</p>
      <h2>统计差异不等同于强预测信号</h2>
      <div class="result-strip">
        <div><strong>65.25</strong><span>获奖歌曲平均流行度</span></div>
        <div><strong>63.65</strong><span>其他歌曲平均流行度</span></div>
        <div><strong>p &lt; 0.001</strong><span>Mann–Whitney 检验</span></div>
        <div><strong>|r| = 0.272</strong><span>小效应量</span></div>
      </div>
      <div class="chart-grid">
        {
          charts.map((chart) => (
            <figure class="analysis-chart card" data-reveal>
              <img
                src={withBase(`/projects/grammy-spotify/${chart.src}`)}
                width={chart.width}
                height={chart.height}
                alt={chart.title}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <>
                  <strong>{chart.title}</strong>
                  <span>{chart.caption}</span>
                </>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section
      id="interaction"
      class="project-section threshold-lab"
      data-threshold-lab
      data-reveal
    >
      <p class="eyebrow">轻量互动</p>
      <h2>查看匹配阈值如何影响标记数量</h2>
      <p>
        下方重放七个真实模糊匹配分数的阈值判断，不在浏览器中重新运行完整分析。基准阈值为
        88，精确匹配数量固定为 64。
      </p>
      <div class="threshold-controls">
        <label for="match-threshold"
          >最低匹配分数：<output for="match-threshold">88</output></label
        >
        <input
          id="match-threshold"
          type="range"
          min="85"
          max="100"
          step="1"
          value="88"
        />
        <button class="button button--secondary" type="button" data-reset-threshold
          >恢复基准值</button
        >
      </div>
      <div class="threshold-results" aria-live="polite">
        <div><strong data-fuzzy-count>7</strong><span>保留的模糊匹配</span></div>
        <div><strong data-total-count>71</strong><span>识别的获奖歌曲</span></div>
        <div><strong data-share>4.2%</strong><span>占最终样本比例</span></div>
      </div>
      <div class="score-track" aria-label="七个模糊匹配分数">
        {
          [95.24, 93.94, 93.55, 92.31, 91.23, 90.2, 89.74].map((score) => (
            <span style={`--score:${score}%`} data-score={score}>
              {score.toFixed(2)}
            </span>
          ))
        }
      </div>
      <noscript
        ><p class="note">
          基准阈值 88：保留 7 个模糊匹配，总计识别 71 首获奖歌曲。
        </p></noscript
      >
    </section>

    <section class="project-section" data-reveal>
      <p class="eyebrow">主要观察</p>
      <h2>结果应放在样本边界内解释</h2>
      <div class="finding-grid">
        <div class="card">
          <h3>流行度</h3><p>
            两组差异具有统计证据，但小效应量和高度重叠的分布不支持强分类结论。
          </p>
        </div>
        <div class="card">
          <h3>音频特征</h3><p>
            八项特征均未达到显著性水平；最大绝对效应量来自 speechiness，仍仅为 0.100。
          </p>
        </div>
        <div class="card">
          <h3>时间变化</h3><p>
            年度差距并不稳定，2003 年为 +20.89，2011 年为 −43.10；2018
            年没有匹配到获奖歌曲。
          </p>
        </div>
      </div>
    </section>

    <section class="project-section" data-reveal>
      <p class="eyebrow">技术细节与边界</p>
      <h2>复现依赖明确的清洗和匹配规则</h2>
      <ul class="boundary-list">
        <li>最终表含 1,687 行、31 列；71 行标记为获奖歌曲，1,616 行为其他歌曲。</li>
        <li>模糊匹配采用 token-set 相似度和 88 分阈值；阈值变化会改变标记数量。</li>
        <li>流行度是平台指标快照，不代表长期商业表现或因果影响。</li>
        <li>页面浏览量仅覆盖三首歌曲，用于展示事件窗口方法，不外推到全部样本。</li>
        <li>
          公开内容为脱敏后的分析结构、代码节选和输出图，不包含原始数据文件与完整分析文件。
        </li>
      </ul>
    </section>

    {
      relatedProjects.length > 0 && (
        <section class="project-section related-projects" data-reveal>
          <p class="eyebrow">相关项目</p>
          <h2>继续查看</h2>
          <div class="project-grid">
            {relatedProjects.map((project) => (
              <ProjectCard entry={project} locale="zh" />
            ))}
          </div>
        </section>
      )
    }

    <ContextBack
      locale="zh"
      fallbackPath="/zh/projects/"
      label={{ en: "Back to Projects", zh: "返回项目列表" }}
    />
  </article>
</BaseLayout>

<script>
  const initialiseThresholdLab = () => {
    document.querySelectorAll<HTMLElement>("[data-threshold-lab]").forEach((lab) => {
      if (lab.dataset.ready === "true") return;
      lab.dataset.ready = "true";
      const input = lab.querySelector<HTMLInputElement>("#match-threshold");
      const output = lab.querySelector<HTMLOutputElement>("output");
      const reset = lab.querySelector<HTMLButtonElement>("[data-reset-threshold]");
      const fuzzyCount = lab.querySelector<HTMLElement>("[data-fuzzy-count]");
      const totalCount = lab.querySelector<HTMLElement>("[data-total-count]");
      const share = lab.querySelector<HTMLElement>("[data-share]");
      const scoreItems = [...lab.querySelectorAll<HTMLElement>("[data-score]")];
      if (!input || !output || !reset || !fuzzyCount || !totalCount || !share) return;

      const update = () => {
        const threshold = Number(input.value);
        const count = scoreItems.filter(
          (item) => Number(item.dataset.score) >= threshold,
        ).length;
        output.value = String(threshold);
        output.textContent = String(threshold);
        fuzzyCount.textContent = String(count);
        totalCount.textContent = String(64 + count);
        share.textContent = `${(((64 + count) / 1687) * 100).toFixed(1)}%`;
        scoreItems.forEach((item) => {
          item.dataset.included = String(Number(item.dataset.score) >= threshold);
        });
      };

      input.addEventListener("input", update);
      reset.addEventListener("click", () => {
        input.value = "88";
        update();
        input.focus();
      });
      update();
    });
  };

  initialiseThresholdLab();
  document.addEventListener("astro:page-load", initialiseThresholdLab);
</script>

<style>
  .python-project {
    width: min(100%, var(--container-project));
    min-width: 0;
    margin-inline: auto;
  }

  .python-project > * {
    min-width: 0;
  }

  .python-project :is(.project-section, .code-grid, .code-showcase, .table-scroll) {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .python-hero,
  .project-section {
    margin-block: var(--space-16);
  }

  .python-hero {
    padding: clamp(1.5rem, 4vw, 4rem);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--colour-primary) 15%, transparent),
        transparent 55%
      ),
      var(--colour-surface);
  }

  .python-hero h1 {
    max-width: 17ch;
    margin-block: var(--space-3);
  }

  .python-hero__lede {
    max-width: 64ch;
    font-size: var(--font-size-xl);
  }

  .hero-metrics,
  .result-strip,
  .threshold-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-metrics div,
  .result-strip div,
  .threshold-results div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--colour-surface) 88%, transparent);
  }

  dt,
  .result-strip span,
  .threshold-results span {
    color: var(--colour-text-muted);
    font-size: var(--font-size-sm);
  }

  dd,
  .result-strip strong,
  .threshold-results strong {
    margin: 0;
    font-size: var(--font-size-xl);
  }

  .project-toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    background: var(--colour-surface);
  }

  .project-toc a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--colour-text-muted);
    text-decoration: none;
  }

  .project-toc a:hover {
    color: var(--colour-primary-strong);
    background: var(--colour-surface-subtle);
  }

  .project-section {
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
  }

  .project-section > h2 {
    max-width: 24ch;
  }

  .eyebrow {
    color: var(--colour-primary-strong);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .overview-grid,
  .finding-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .card {
    padding: var(--space-5);
  }

  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
    contain: inline-size;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
  }

  table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    background: var(--colour-surface);
  }

  th,
  td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--colour-border);
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--colour-text-muted);
    font-size: var(--font-size-sm);
  }

  .note {
    padding: var(--space-4);
    border-left: 3px solid var(--colour-primary);
    background: var(--colour-surface-subtle);
  }

  .process-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    counter-reset: flow;
  }

  .process-flow li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border-top: 2px solid var(--colour-primary);
    background: var(--colour-surface);
    counter-increment: flow;
  }

  .process-flow strong::before {
    content: "0" counter(flow) " · ";
    color: var(--colour-primary);
  }

  .code-grid {
    display: grid;
    gap: var(--space-4);
  }

  .result-strip {
    margin-bottom: var(--space-6);
  }

  .chart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .analysis-chart {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    margin: 0;
    overflow: hidden;
  }

  .analysis-chart:nth-child(3),
  .analysis-chart:nth-child(4) {
    grid-column: 1 / -1;
  }

  .analysis-chart img {
    width: 100%;
    height: auto;
