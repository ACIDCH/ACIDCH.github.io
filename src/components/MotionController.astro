<div class="page-progress" aria-hidden="true" data-page-progress>
  <span></span>
</div>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  let activeMotionCleanup: (() => void) | undefined;

  function initMotion() {
    activeMotionCleanup?.();
    const controller = new AbortController();
    const observers: IntersectionObserver[] = [];
    const frameIds: number[] = [];
    const { signal } = controller;
    const revealElements = Array.from(
      document.querySelectorAll<HTMLElement>("[data-reveal]"),
    );

    document.documentElement.dataset.motionReady = "true";

    if (reduceMotion.matches || !("IntersectionObserver" in window)) {
      revealElements.forEach((element) => {
        element.dataset.revealReady = "true";
        element.dataset.revealed = "true";
      });
    } else {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).dataset.revealed = "true";
            revealObserver.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -6% 0px", threshold: 0.06 },
      );
      observers.push(revealObserver);
      revealElements.forEach((element) => {
        element.dataset.revealReady = "true";
      });

      const firstFrame = requestAnimationFrame(() => {
        const secondFrame = requestAnimationFrame(() => {
          revealElements.forEach((element) => revealObserver.observe(element));
        });
        frameIds.push(secondFrame);
      });
      frameIds.push(firstFrame);
    }

    document
      .querySelectorAll<HTMLElement>("[data-counter-target]")
      .forEach((counter) => {
        const target = Number(counter.dataset.counterTarget ?? 0);
        if (reduceMotion.matches || target <= 0) {
          counter.textContent = String(target);
          return;
        }

        const counterObserver = new IntersectionObserver(([entry]) => {
          if (!entry?.isIntersecting) return;
          counterObserver.disconnect();
          const startedAt = performance.now();
          const duration = 520;

          function tick(now: number) {
            const progress = Math.min(1, (now - startedAt) / duration);
            const eased = 1 - (1 - progress) ** 3;
            counter.textContent = String(Math.round(target * eased));
            if (progress < 1) frameIds.push(requestAnimationFrame(tick));
          }

          frameIds.push(requestAnimationFrame(tick));
        });
        observers.push(counterObserver);
        counterObserver.observe(counter);
      });

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      if (reduceMotion.matches || !finePointer.matches) return;
      card.addEventListener(
        "pointermove",
        (event) => {
          const bounds = card.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width - 0.5;
          const y = (event.clientY - bounds.top) / bounds.height - 0.5;
          card.style.setProperty("--tilt-x", `${(-y * 2.4).toFixed(2)}deg`);
          card.style.setProperty("--tilt-y", `${(x * 2.4).toFixed(2)}deg`);
        },
        { signal },
      );
      card.addEventListener(
        "pointerleave",
        () => {
          card.style.removeProperty("--tilt-x");
          card.style.removeProperty("--tilt-y");
        },
        { signal },
      );
    });

    activeMotionCleanup = () => {
      controller.abort();
      observers.forEach((observer) => observer.disconnect());
      frameIds.forEach((frameId) => cancelAnimationFrame(frameId));
    };
  }

  function setProgress(state: "loading" | "complete") {
    const progress = document.querySelector<HTMLElement>("[data-page-progress]");
    if (!progress) return;
    progress.dataset.state = state;
    if (state === "complete") {
      window.setTimeout(() => {
        progress.removeAttribute("data-state");
      }, 260);
    }
  }

  document.addEventListener("astro:before-preparation", () => setProgress("loading"));
  document.addEventListener("astro:before-swap", () => activeMotionCleanup?.());
  document.addEventListener("astro:after-swap", () => setProgress("complete"));
  document.addEventListener("astro:page-load", initMotion);
  reduceMotion.addEventListener("change", initMotion);
  initMotion();
</script>
