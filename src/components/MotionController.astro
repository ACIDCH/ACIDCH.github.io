<div class="page-progress" aria-hidden="true" data-page-progress>
  <span></span>
</div>

<script>
  import { initContentMotion } from "../scripts/content-motion";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  let activeMotionCleanup: (() => void) | undefined;

  function initMotion() {
    activeMotionCleanup?.();
    const controller = new AbortController();
    const observers: IntersectionObserver[] = [];
    const frameIds = new Set<number>();
    const schedule = (callback: FrameRequestCallback) => {
      const id = requestAnimationFrame((time) => {
        frameIds.delete(id);
        callback(time);
      });
      frameIds.add(id);
      return id;
    };
    const { signal } = controller;
    const cleanupContentMotion = initContentMotion(document, reduceMotion.matches);
    document.documentElement.dataset.motionReady = "true";

    document
      .querySelectorAll<HTMLElement>("[data-counter-target]")
      .forEach((counter) => {
        const target = Number(counter.dataset.counterTarget ?? 0);
        if (
          reduceMotion.matches ||
          target <= 0 ||
          !("IntersectionObserver" in window)
        ) {
          counter.textContent = String(target);
          return;
        }

        const counterObserver = new IntersectionObserver(([entry]) => {
          if (!entry?.isIntersecting) return;
          counterObserver.disconnect();
          const startedAt = performance.now();
          const duration = 520;

          function tick(now: number) {
            const progress = Math.min(1, (now - startedAt) / duration);
            const eased = 1 - (1 - progress) ** 3;
            counter.textContent = String(Math.round(target * eased));
            if (progress < 1) schedule(tick);
          }

          schedule(tick);
        });
        observers.push(counterObserver);
        counterObserver.observe(counter);
      });

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
      card.style.removeProperty("--tilt-x");
      card.style.removeProperty("--tilt-y");
      if (reduceMotion.matches || !finePointer.matches) return;
      let pendingFrame: number | undefined;
      let pointerX = 0;
      let pointerY = 0;
      card.addEventListener(
        "pointermove",
        (event) => {
          pointerX = event.clientX;
          pointerY = event.clientY;
          if (pendingFrame !== undefined) return;
          pendingFrame = schedule(() => {
            pendingFrame = undefined;
            const bounds = card.getBoundingClientRect();
            if (!bounds.width || !bounds.height) return;
            const x = (pointerX - bounds.left) / bounds.width - 0.5;
            const y = (pointerY - bounds.top) / bounds.height - 0.5;
            card.style.setProperty("--tilt-x", `${(-y * 2.4).toFixed(2)}deg`);
            card.style.setProperty("--tilt-y", `${(x * 2.4).toFixed(2)}deg`);
          });
        },
        { signal },
      );
      card.addEventListener(
        "pointerleave",
        () => {
          if (pendingFrame !== undefined) {
            cancelAnimationFrame(pendingFrame);
            frameIds.delete(pendingFrame);
            pendingFrame = undefined;
          }
          card.style.removeProperty("--tilt-x");
          card.style.removeProperty("--tilt-y");
        },
        { signal },
      );
    });

    activeMotionCleanup = () => {
      cleanupContentMotion();
      controller.abort();
      observers.forEach((observer) => observer.disconnect());
      frameIds.forEach((frameId) => cancelAnimationFrame(frameId));
    };
  }

  let progressTimer: number | undefined;
  function setProgress(state: "loading" | "complete") {
    window.clearTimeout(progressTimer);
    const progress = document.querySelector<HTMLElement>("[data-page-progress]");
    if (!progress) return;
    progress.dataset.state = state;
    if (state === "complete") {
      progressTimer = window.setTimeout(() => {
        progress.removeAttribute("data-state");
      }, 260);
    }
  }

  document.addEventListener("astro:before-preparation", () => setProgress("loading"));
  document.addEventListener("astro:before-swap", () => activeMotionCleanup?.());
  document.addEventListener("astro:after-swap", () => setProgress("complete"));
  document.addEventListener("astro:page-load", initMotion);
  reduceMotion.addEventListener("change", initMotion);
  initMotion();
</script>
