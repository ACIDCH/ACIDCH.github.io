---
import type { Locale } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = locale === "en" ? "Toggle light or dark theme" : "切换浅色或深色主题";
---

<button
  class="icon-button theme-toggle"
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <span data-theme-icon="light"><Icon name="sun" /></span>
  <span data-theme-icon="dark"><Icon name="moon" /></span>
</button>

<script>
  const root = document.documentElement;
  const storageKey = root.dataset.themeStorageKey ?? "theme";
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  type ThemePreference = "light" | "dark" | "system";

  function isThemePreference(
    value: string | null | undefined,
  ): value is ThemePreference {
    return value === "light" || value === "dark" || value === "system";
  }

  function applyTheme(preference: ThemePreference, persist = true) {
    const resolved =
      preference === "system" ? (systemTheme.matches ? "dark" : "light") : preference;

    root.dataset.theme = resolved;
    root.dataset.themePreference = preference;
    root.style.colorScheme = resolved;

    if (persist) {
      try {
        localStorage.setItem(storageKey, preference);
      } catch {
        // Theme selection still applies for the current page.
      }
    }

    document.querySelectorAll<HTMLElement>("[data-theme-icon]").forEach((icon) => {
      icon.hidden = icon.dataset.themeIcon !== resolved;
    });
  }

  function initThemeSwitch() {
    const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
    toggles.forEach((toggle) => {
      if (toggle.dataset.themeControlReady === "true") return;
      toggle.dataset.themeControlReady = "true";
      toggle.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
      });
    });

    let storedPreference: string | null = null;
    try {
      storedPreference = localStorage.getItem(storageKey);
    } catch {
      storedPreference = null;
    }
    const initialPreference = isThemePreference(storedPreference ?? undefined)
      ? storedPreference
      : root.dataset.themePreference;
    applyTheme(
      isThemePreference(initialPreference) ? initialPreference : "system",
      false,
    );
  }

  systemTheme.addEventListener("change", () => {
    if (root.dataset.themePreference === "system") {
      applyTheme("system", false);
    }
  });

  document.addEventListener("astro:before-swap", (event) => {
    const incomingDocument = (event as Event & { newDocument: Document }).newDocument;
    const incomingRoot = incomingDocument?.documentElement;
    if (!incomingRoot) return;

    incomingRoot.dataset.theme = root.dataset.theme ?? "light";
    incomingRoot.dataset.themePreference = root.dataset.themePreference ?? "system";
    incomingRoot.style.colorScheme = root.style.colorScheme;
  });

  document.addEventListener("astro:page-load", initThemeSwitch);
  initThemeSwitch();
</script>
