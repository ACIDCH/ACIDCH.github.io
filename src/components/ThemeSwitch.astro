---
import type { Locale } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels =
  locale === "en"
    ? { group: "Colour theme", light: "Light", dark: "Dark", system: "System" }
    : { group: "颜色主题", light: "浅色", dark: "深色", system: "跟随系统" };
---

<div class="theme-switch" role="group" aria-label={labels.group}>
  <button
    type="button"
    data-theme-option="light"
    aria-label={labels.light}
    aria-pressed="false"
  >
    <Icon name="sun" />
    <span>{labels.light}</span>
  </button>
  <button
    type="button"
    data-theme-option="dark"
    aria-label={labels.dark}
    aria-pressed="false"
  >
    <Icon name="moon" />
    <span>{labels.dark}</span>
  </button>
  <button
    type="button"
    data-theme-option="system"
    aria-label={labels.system}
    aria-pressed="false"
  >
    <Icon name="system" />
    <span>{labels.system}</span>
  </button>
</div>

<script>
  const root = document.documentElement;
  const storageKey = root.dataset.themeStorageKey ?? "theme";
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  type ThemePreference = "light" | "dark" | "system";

  function isThemePreference(
    value: string | null | undefined,
  ): value is ThemePreference {
    return value === "light" || value === "dark" || value === "system";
  }

  function applyTheme(preference: ThemePreference, persist = true) {
    const resolved =
      preference === "system" ? (systemTheme.matches ? "dark" : "light") : preference;

    root.dataset.theme = resolved;
    root.dataset.themePreference = preference;
    root.style.colorScheme = resolved;

    if (persist) {
      try {
        localStorage.setItem(storageKey, preference);
      } catch {
        // Theme selection still applies for the current page.
      }
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-option]")
      .forEach((option) => {
        option.setAttribute(
          "aria-pressed",
          String(option.dataset.themeOption === preference),
        );
      });
  }

  function initThemeSwitch() {
    const options = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-theme-option]"),
    );

    options.forEach((option, index) => {
      if (option.dataset.themeControlReady === "true") {
        return;
      }

      option.dataset.themeControlReady = "true";
      option.addEventListener("click", () => {
        const preference = option.dataset.themeOption;
        if (isThemePreference(preference)) {
          applyTheme(preference);
        }
      });

      option.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
          return;
        }

        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? options.length - 1
              : (index + (event.key === "ArrowRight" ? 1 : -1) + options.length) %
                options.length;

        options[nextIndex]?.focus();
        options[nextIndex]?.click();
      });
    });

    let storedPreference: string | null = null;
    try {
      storedPreference = localStorage.getItem(storageKey);
    } catch {
      storedPreference = null;
    }
    const initialPreference = isThemePreference(storedPreference ?? undefined)
      ? storedPreference
      : root.dataset.themePreference;
    applyTheme(
      isThemePreference(initialPreference) ? initialPreference : "system",
      false,
    );
  }

  systemTheme.addEventListener("change", () => {
    if (root.dataset.themePreference === "system") {
      applyTheme("system", false);
    }
  });

  document.addEventListener("astro:before-swap", (event) => {
    const incomingDocument = (event as Event & { newDocument: Document }).newDocument;
    const incomingRoot = incomingDocument?.documentElement;
    if (!incomingRoot) return;

    incomingRoot.dataset.theme = root.dataset.theme ?? "light";
    incomingRoot.dataset.themePreference = root.dataset.themePreference ?? "system";
    incomingRoot.style.colorScheme = root.style.colorScheme;
  });

  document.addEventListener("astro:page-load", initThemeSwitch);
  initThemeSwitch();
</script>
