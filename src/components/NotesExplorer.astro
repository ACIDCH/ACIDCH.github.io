---
import type { CollectionEntry } from "astro:content";
import { portfolioConfig } from "../config/portfolio";
import type { Locale } from "../config/site";
import { getTotalPages } from "../utils/pagination";
import NoteList from "./NoteList.astro";
import Pagination from "./Pagination.astro";
import SocialIconButton from "./SocialIconButton.astro";

interface Props {
  entries: CollectionEntry<"notes">[];
  locale: Locale;
  currentPage?: number;
  pageSize?: number;
  basePath?: string;
}

const {
  entries,
  locale,
  currentPage = 1,
  pageSize = 9,
  basePath = locale === "en" ? "/notes/" : "/zh/notes/",
} = Astro.props;
const totalPages = getTotalPages(entries.length, pageSize);
const tagCounts = new Map<string, number>();
entries
  .flatMap((entry) => entry.data.tags)
  .forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
const maxCount = Math.max(1, ...tagCounts.values());
const tags = [...tagCounts.entries()].sort(([left], [right]) =>
  left.localeCompare(right, locale === "zh" ? "zh-CN" : "en"),
);
const copy =
  locale === "en"
    ? {
        title: "Browse by tag",
        description:
          "Choose a topic from the knowledge map. The URL updates so this view can be shared.",
        all: "All notes",
        result: "notes shown",
        empty: "No notes match this tag.",
        latest: "Learning Notes",
        external: "External Notebook / Cloud Notes",
      }
    : {
        title: "按标签浏览",
        description: "从知识地图中选择主题。网址会同步更新，便于分享当前视图。",
        all: "全部笔记",
        result: "篇笔记",
        empty: "没有符合该标签的笔记。",
        latest: "学习笔记",
        external: "外部笔记本 / 云笔记",
      };
const notebook = portfolioConfig.externalNotebook;
---

<section
  class="notes-explorer"
  data-notes-explorer
  data-result-label={copy.result}
  data-current-page={currentPage}
  data-page-size={pageSize}
  data-base-path={basePath}
  data-page-label={locale === "en" ? "Page" : "第"}
  data-page-separator={locale === "en" ? "of" : "页，共"}
  data-page-suffix={locale === "en" ? "" : "页"}
>
  <section class="tag-cloud-panel" aria-labelledby="tag-cloud-title">
    <div>
      <p class="status">{locale === "en" ? "Knowledge map" : "知识地图"}</p>
      <h2 id="tag-cloud-title">{copy.title}</h2>
      <p>{copy.description}</p>
    </div>
    <div class="tag-cloud" role="group" aria-label={copy.title}>
      <button type="button" data-note-tag="" aria-pressed="true">{copy.all}</button>
      {
        tags.map(([tag, count]) => (
          <button
            type="button"
            data-note-tag={tag.toLocaleLowerCase()}
            aria-pressed="false"
            style={`--tag-weight: ${0.82 + (count / maxCount) * 0.6}rem`}
          >
            {tag}
            <span aria-label={`${count} ${copy.result}`}>{count}</span>
          </button>
        ))
      }
    </div>
  </section>

  <div class="notes-results-heading">
    <h2>{copy.latest}</h2>
    <p aria-live="polite" data-notes-result>
      {entries.length}
      {copy.result}
    </p>
  </div>
  <NoteList entries={entries} locale={locale} />
  <p class="empty-state" data-notes-empty hidden>{copy.empty}</p>
  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={basePath}
    locale={locale}
  />

  {
    notebook.enabled && notebook.url && (
      <aside class="external-notebook">
        <div>
          <p class="status">{copy.external}</p>
          <h2>{notebook.label[locale]}</h2>
        </div>
        <SocialIconButton
          href={notebook.url}
          label={notebook.label[locale]}
          icon="external"
          external
        />
      </aside>
    )
  }
</section>

<script>
  let activeNotesCleanup: (() => void) | undefined;

  function initNotesExplorer() {
    activeNotesCleanup?.();
    const explorer = document.querySelector<HTMLElement>("[data-notes-explorer]");
    if (!explorer) return;
    const buttons = Array.from(
      explorer.querySelectorAll<HTMLButtonElement>("[data-note-tag]"),
    );
    const cards = Array.from(
      explorer.querySelectorAll<HTMLElement>("[data-note-card]"),
    );
    const result = explorer.querySelector<HTMLElement>("[data-notes-result]");
    const empty = explorer.querySelector<HTMLElement>("[data-notes-empty]");
    const pagination = explorer.querySelector<HTMLElement>("[data-pagination]");
    const pageSize = Number(explorer.dataset.pageSize ?? 9);
    const currentPage = Number(explorer.dataset.currentPage ?? 1);
    const basePath = explorer.dataset.basePath ?? "/notes/";
    const controller = new AbortController();

    function applyTag(tag: string, updateUrl = true) {
      const matches = cards.filter(
        (card) => !tag || (card.dataset.tags ?? "").split("|").includes(tag),
      );
      const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
      const start = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matches.slice(start, start + pageSize));

      cards.forEach((card) => {
        card.hidden = !visibleCards.has(card);
      });
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.noteTag === tag));
      });
      if (result) {
        result.textContent = `${matches.length} ${explorer!.dataset.resultLabel ?? ""}`;
      }
      if (empty) empty.hidden = visibleCards.size !== 0;

      if (pagination) {
        pagination.hidden = totalPages <= 1;
        pagination
          .querySelectorAll<HTMLElement>("[data-pagination-page]")
          .forEach((link) => {
            const page = Number(link.dataset.paginationPage);
            link.closest("li")!.hidden = page > totalPages;
            const path = page === 1 ? basePath : `${basePath}page/${String(page)}/`;
            const params = new URLSearchParams();
            if (tag) params.set("tag", tag);
            link.setAttribute("href", params.size ? `${path}?${params}` : path);
          });
        const status = pagination.querySelector<HTMLElement>(
          "[data-pagination-status]",
        );
        if (status) {
          status.textContent =
            explorer!.dataset.pageLabel === "Page"
              ? `Page ${currentPage} of ${totalPages}`
              : `第 ${currentPage} 页，共 ${totalPages} 页`;
        }
        pagination
          .querySelector<HTMLAnchorElement>("[data-pagination-previous]")
          ?.toggleAttribute("hidden", currentPage <= 1);
        pagination
          .querySelector<HTMLAnchorElement>("[data-pagination-next]")
          ?.toggleAttribute("hidden", currentPage >= totalPages);
        pagination.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
          const url = new URL(link.href);
          if (tag) url.searchParams.set("tag", tag);
          else url.searchParams.delete("tag");
          link.href = `${url.pathname}${url.search}`;
        });
      }

      if (updateUrl) {
        const params = new URLSearchParams();
        if (tag) params.set("tag", tag);
        const target = params.size ? `${basePath}?${params}` : basePath;
        if (currentPage === 1) {
          history.replaceState(history.state, "", target);
        } else {
          location.assign(target);
        }
      }
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => applyTag(button.dataset.noteTag ?? ""), {
        signal: controller.signal,
      });
    });
    applyTag(
      new URLSearchParams(location.search).get("tag")?.toLocaleLowerCase() ?? "",
      false,
    );
    activeNotesCleanup = () => controller.abort();
  }

  document.addEventListener("astro:before-swap", () => activeNotesCleanup?.());
  document.addEventListener("astro:page-load", initNotesExplorer);
  initNotesExplorer();
</script>
