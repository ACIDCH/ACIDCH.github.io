---
import { portfolioConfig } from "../config/portfolio";
import type { Locale } from "../config/site";
import { sharedUi } from "../i18n/shared-ui";
import { withBase } from "../utils/paths";
import Icon from "./Icon.astro";
import SocialIconButton from "./SocialIconButton.astro";
import WechatQrDialog from "./WechatQrDialog.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sharedUi[locale].social;
const { contact } = portfolioConfig;
const resumePath = contact.resume.paths[locale];
const resumeAvailable =
  contact.resume.enabled && contact.resume.available[locale] && resumePath;
---

<div class="social-links" aria-label={copy.contactLinks}>
  {
    contact.github.enabled && contact.github.url && (
      <SocialIconButton
        href={contact.github.url}
        label="GitHub"
        icon="github"
        external
      />
    )
  }
  {
    contact.linkedin.enabled &&
      (contact.linkedin.url ? (
        <SocialIconButton
          href={contact.linkedin.url}
          label="LinkedIn"
          icon="linkedin"
          external
        />
      ) : (
        <span
          class="social-icon-button"
          aria-disabled="true"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <Icon name="linkedin" size={22} />
          <span>LinkedIn</span>
        </span>
      ))
  }
  {
    contact.email.enabled && contact.email.address && (
      <SocialIconButton
        href={`mailto:${contact.email.address}`}
        label={copy.email}
        icon="email"
      />
    )
  }
  <WechatQrDialog locale={locale} />
  {
    resumeAvailable && (
      <SocialIconButton
        href={withBase(resumePath)}
        label={copy.resume}
        icon="resume"
        external
      />
    )
  }
</div>
