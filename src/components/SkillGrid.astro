---
import { skillGroups } from "../config/skills";
import type { Locale } from "../config/site";
import { sharedUi } from "../i18n/shared-ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = sharedUi[locale].skillGrid;
---

<div class="capability-grid">
  {
    skillGroups.map((group, index) => (
      <article class="ui-card capability-card" data-reveal data-tilt>
        <span class="capability-card__index" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3>{group.title[locale]}</h3>
        <p>{group.description[locale]}</p>
        <ul class="tag-list" aria-label={copy.relatedTools}>
          {group.tools.map((tool) => (
            <li class="tag">{tool}</li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
