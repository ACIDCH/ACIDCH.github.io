---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../config/site";
import { sharedUi } from "../i18n/shared-ui";
import { getLocalizedPath } from "../utils/paths";
import ProjectCover from "./ProjectCover.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const copy = sharedUi[locale].projectCard;
const coverTitles: Record<string, string> = {
  "european-property-market-dashboard": "Power BI",
  "grammy-spotify-analysis": "Python",
  "sales-profitability-warehouse": "SQL",
  "customer-churn-machine-learning": "R",
  "retirement-monte-carlo": "Excel",
};
const coverTitle =
  coverTitles[entry.data.translationKey] ??
  entry.data.tools[0] ??
  sharedUi.en.projectCard.topics[entry.data.topic];
const coverBadges = entry.data.tools
  .filter((tool) => tool.trim().toLowerCase() !== coverTitle.trim().toLowerCase())
  .slice(0, 3);
---

<article class="project-card" data-tilt>
  <ProjectCover entry={entry} compact showCode code={coverTitle} badges={coverBadges} />
  <div class="cluster cluster--compact project-card__meta">
    <p class="status">{copy.statuses[entry.data.status]}</p>
    <span class="tag">{copy.topics[entry.data.topic]}</span>
    {entry.data.isPlaceholder && <span class="tag">{copy.placeholder}</span>}
  </div>
  <h2>
    <a href={getLocalizedPath(`/projects/${entry.data.slug}/`, locale)}>
      {entry.data.title}
    </a>
  </h2>
  <p class="project-card__summary">{entry.data.summary}</p>
  <ul class="tag-list project-card__tools" aria-label={copy.tools}>
    {entry.data.tools.map((tool) => <li class="tag">{tool}</li>)}
  </ul>
  <a
    class="project-card__link"
    href={getLocalizedPath(`/projects/${entry.data.slug}/`, locale)}
    aria-label={`${copy.viewProject}: ${entry.data.title}`}
  >
    {copy.viewCaseStudy}
    <span class="project-card__arrow" aria-hidden="true">→</span>
  </a>
</article>
