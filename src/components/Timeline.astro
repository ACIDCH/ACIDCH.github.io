---
import { timelineEntries } from "../config/experience";
import type { Locale } from "../config/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ol class="timeline">
  {
    timelineEntries.map((entry) => (
      <li class="timeline__item" data-reveal>
        <p class="status">{entry.kind}</p>
        <details>
          <summary>
            <span class="timeline__title">{entry.title[locale]}</span>
            <span class="timeline__organisation">{entry.organisation[locale]}</span>
          </summary>
          <p>{entry.detail[locale]}</p>
          <p class="timeline__period">{entry.period[locale]}</p>
        </details>
      </li>
    ))
  }
</ol>
