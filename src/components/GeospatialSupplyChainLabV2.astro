---
interface Props {
  locale?: "en" | "zh";
}

const { locale = "zh" } = Astro.props;
const zh = locale === "zh";
const c = zh
  ? {
      title: "基于地理空间的供应链优化",
      subtitle: "Auckland / Geospatial Supply Chain Decision Sandbox",
      intro: "以真实奥克兰地理位置和道路网络为底层，把设施覆盖、路网扰动、车队容量与库存策略放进同一个可交互情景沙盘。",
      scenario: "情景与目标",
      network: "路网不确定性",
      facility: "设施与覆盖",
      fleet: "车队与运输",
      inventory: "库存策略",
      address: "自然语言地址",
      run: "运行优化",
      routes: "加载最优道路路径",
      reset: "恢复基线",
      baseline: "基线",
      congestion: "交通拥堵",
      closure: "道路临时封闭",
      newRoad: "新增道路 / 通行改善",
      mixed: "混合不确定性",
      minHubs: "最少设施",
      minCost: "固定成本 + 网络成本",
      threshold: "最大服务距离",
      redundancy: "最低覆盖次数",
      maxOpen: "最多开启设施",
      facilityCapacity: "单设施容量",
      fleetSize: "车队数量",
      vehicleCapacity: "单车容量",
      trips: "每车每日趟数",
      transportCost: "运输成本 / km",
      demandMultiplier: "需求情景倍率",
      meanDemand: "日均库存需求",
      demandSd: "需求标准差",
      leadTime: "提前期（天）",
      serviceLevel: "服务水平",
      holdingCost: "安全库存持有成本 / 单位",
      role: "地点类型",
      factory: "工厂候选点",
      warehouse: "仓库候选点",
      demand: "需求点",
      add: "解析地址并加入网络",
      custom: "自定义网络实体",
      empty: "尚未添加自定义地点。",
      results: "结果",
      hubs: "开启设施",
      coverage: "覆盖率",
      avgDistance: "加权平均距离",
      fleetCapacity: "车队运力覆盖",
      safetyStock: "安全库存",
      rop: "再订货点",
      totalCost: "情景成本指标",
      statusReady: "基线道路距离矩阵已加载。可直接调整参数并运行情景。",
      statusRunning: "正在计算当前情景…",
      noSolution: "当前约束下没有可行的设施覆盖方案。",
      geocoding: "正在解析地址并转换为真实地理坐标…",
      geocodeFail: "地址解析失败，请补充 Auckland / New Zealand 等位置信息后重试。",
      added: "地点已加入网络，并已计算与现有节点的道路距离。",
      routing: "正在加载当前最优分配对应的真实道路几何…",
      routed: "最优道路路径已加载。",
      routeFail: "部分道路路径未返回，已保留分配虚线作为降级显示。",
      note: "V2 的拥堵、封路和新增道路情景先作用于 OD 路网成本矩阵；它会真实改变优化输入与设施选择，但尚未直接修改 OSM 的单条道路 edge。后续接入可编辑路由图后再升级为 edge-level disruption。",
      clientGeocode: "当前网站为静态部署，地址转换暂由浏览器调用公开地理编码服务完成；上线前会评估迁移到受控代理/Worker，避免把它误称为现有后端。",
    }
  : {
      title: "Geospatial Supply Chain Optimisation",
      subtitle: "Auckland / Geospatial Supply Chain Decision Sandbox",
      intro: "A real-Auckland decision sandbox combining facility coverage, road-network uncertainty, fleet capacity and inventory policy on one interactive map.",
      scenario: "Scenario & objective",
      network: "Road uncertainty",
      facility: "Facilities & coverage",
      fleet: "Fleet & transport",
      inventory: "Inventory policy",
      address: "Natural-language address",
      run: "Run optimisation",
      routes: "Load optimised road routes",
      reset: "Reset baseline",
      baseline: "Baseline",
      congestion: "Traffic congestion",
      closure: "Temporary road closure",
      newRoad: "New road / access improvement",
      mixed: "Mixed uncertainty",
      minHubs: "Minimum facilities",
      minCost: "Fixed + network cost",
      threshold: "Maximum service distance",
      redundancy: "Minimum coverage count",
      maxOpen: "Maximum open facilities",
      facilityCapacity: "Capacity per facility",
      fleetSize: "Fleet size",
      vehicleCapacity: "Vehicle capacity",
      trips: "Trips per vehicle / day",
      transportCost: "Transport cost / km",
      demandMultiplier: "Demand multiplier",
      meanDemand: "Mean daily inventory demand",
      demandSd: "Demand standard deviation",
      leadTime: "Lead time (days)",
      serviceLevel: "Service level",
      holdingCost: "Safety-stock holding cost / unit",
      role: "Location type",
      factory: "Factory candidate",
      warehouse: "Warehouse candidate",
      demand: "Demand node",
      add: "Geocode and add to network",
      custom: "Custom network entities",
      empty: "No custom locations yet.",
      results: "Results",
      hubs: "Open facilities",
      coverage: "Coverage",
      avgDistance: "Weighted average distance",
      fleetCapacity: "Fleet capacity coverage",
      safetyStock: "Safety stock",
      rop: "Reorder point",
      totalCost: "Scenario cost index",
      statusReady: "Verified baseline road-distance matrix loaded. Adjust parameters and run a scenario.",
      statusRunning: "Calculating the current scenario…",
      noSolution: "No feasible facility-coverage solution under the current constraints.",
      geocoding: "Resolving the address into real geographic coordinates…",
      geocodeFail: "Address geocoding failed. Add Auckland / New Zealand context and try again.",
      added: "Location added and road distances to the current network have been calculated.",
      routing: "Loading road geometry for the current optimised allocation…",
      routed: "Optimised road routes loaded.",
      routeFail: "Some routes were unavailable; dashed allocation links remain as fallback.",
      note: "V2 applies congestion, closure and new-road uncertainty to the OD network-cost matrix. This changes the optimisation input and solution, but does not yet mutate individual OSM road edges. Edge-level disruption comes with the editable routing-graph stage.",
      clientGeocode: "The site is currently static, so address conversion is performed in-browser through a public geocoder. Before production, this can move behind a controlled proxy/Worker rather than being presented as an existing backend.",
    };
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<section id="geo-v2" class="geo2" data-locale={locale}>
  <div class="geo2__map-shell">
    <div id="geo2-map" aria-label="Auckland geospatial supply chain map"></div>

    <div class="geo2__identity">
      <span>{c.subtitle}</span>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
    </div>

    <div class="geo2__legend">
      <span><i class="facility"></i> Facility</span>
      <span><i class="demand"></i> Demand</span>
      <span><i class="allocation"></i> Allocation</span>
      <span><i class="route"></i> Road route</span>
    </div>

    <aside class="geo2__console" aria-label="Scenario console">
      <div class="geo2__console-scroll">
        <section class="geo2__block">
          <div class="geo2__block-title"><span>01</span><strong>{c.scenario}</strong></div>
          <label class="geo2__field">
            <span>Objective</span>
            <select id="geo2-objective">
              <option value="minHubs">{c.minHubs}</option>
              <option value="minCost">{c.minCost}</option>
            </select>
          </label>
          <label class="geo2__field">
            <span>Scenario</span>
            <select id="geo2-road-mode">
              <option value="baseline">{c.baseline}</option>
              <option value="congestion">{c.congestion}</option>
              <option value="closure">{c.closure}</option>
              <option value="newroad">{c.newRoad}</option>
              <option value="mixed">{c.mixed}</option>
            </select>
          </label>
        </section>

        <section class="geo2__block" id="geo2-network-block">
          <div class="geo2__block-title"><span>02</span><strong>{c.network}</strong></div>
          <label class="geo2__range">
            <span>{c.congestion}</span><output id="geo2-congestion-out">35%</output>
            <input id="geo2-congestion" type="range" min="0" max="100" step="5" value="35" />
          </label>
          <label class="geo2__range">
            <span>{c.closure}</span><output id="geo2-closure-out">10%</output>
            <input id="geo2-closure" type="range" min="0" max="35" step="5" value="10" />
          </label>
          <label class="geo2__range">
            <span>{c.newRoad}</span><output id="geo2-improvement-out">20%</output>
            <input id="geo2-improvement" type="range" min="0" max="50" step="5" value="20" />
          </label>
          <label class="geo2__field geo2__field--inline">
            <span>Random seed</span><input id="geo2-seed" type="number" value="708709" />
          </label>
        </section>

        <section class="geo2__block">
          <div class="geo2__block-title"><span>03</span><strong>{c.facility}</strong></div>
          <label class="geo2__range">
            <span>{c.threshold}</span><output id="geo2-threshold-out">6.0 km</output>
            <input id="geo2-threshold" type="range" min="3" max="15" step="0.5" value="6" />
          </label>
          <label class="geo2__field">
            <span>{c.redundancy}</span>
            <select id="geo2-redundancy"><option value="1">1×</option><option value="2">2×</option></select>
          </label>
          <div class="geo2__stepper-row">
            <span>{c.maxOpen}</span>
            <div class="geo2__stepper"><button type="button" data-step="maxOpen" data-delta="-1">−</button><output id="geo2-max-open-out">4</output><button type="button" data-step="maxOpen" data-delta="1">+</button></div>
          </div>
          <label class="geo2__field geo2__field--inline">
            <span>{c.facilityCapacity}</span><input id="geo2-facility-capacity" type="number" min="100" step="100" value="5000" />
          </label>
          <label class="geo2__field geo2__field--inline">
            <span>Fixed cost / facility</span><input id="geo2-fixed-cost" type="number" min="0" step="10000" value="350000" />
          </label>
        </section>

        <section class="geo2__block">
          <div class="geo2__block-title"><span>04</span><strong>{c.fleet}</strong></div>
          <div class="geo2__stepper-row">
            <span>{c.fleetSize}</span>
            <div class="geo2__stepper"><button type="button" data-step="fleet" data-delta="-1">−</button><output id="geo2-fleet-out">10</output><button type="button" data-step="fleet" data-delta="1">+</button></div>
          </div>
          <label class="geo2__field geo2__field--inline"><span>{c.vehicleCapacity}</span><input id="geo2-vehicle-capacity" type="number" min="1" value="120" /></label>
          <label class="geo2__field geo2__field--inline"><span>{c.trips}</span><input id="geo2-trips" type="number" min="1" value="5" /></label>
          <label class="geo2__field geo2__field--inline"><span>{c.transportCost}</span><input id="geo2-transport-cost" type="number" min="0" step="0.01" value="0.72" /></label>
          <label class="geo2__range"><span>{c.demandMultiplier}</span><output id="geo2-demand-multiplier-out">1.00×</output><input id="geo2-demand-multiplier" type="range" min="0.5" max="1.8" step="0.05" value="1" /></label>
        </section>

        <section class="geo2__block">
          <div class="geo2__block-title"><span>05</span><strong>{c.inventory}</strong></div>
          <label class="geo2__field geo2__field--inline"><span>{c.meanDemand}</span><input id="geo2-inv-mean" type="number" min="0" value="120" /></label>
          <label class="geo2__field geo2__field--inline"><span>{c.demandSd}</span><input id="geo2-inv-sd" type="number" min="0" value="25" /></label>
          <label class="geo2__field geo2__field--inline"><span>{c.leadTime}</span><input id="geo2-lead-time" type="number" min="0.1" step="0.1" value="2" /></label>
          <label class="geo2__field"><span>{c.serviceLevel}</span><select id="geo2-service"><option value="1.282">90%</option><option value="1.645" selected>95%</option><option value="1.960">97.5%</option><option value="2.326">99%</option></select></label>
          <label class="geo2__field geo2__field--inline"><span>{c.holdingCost}</span><input id="geo2-holding-cost" type="number" min="0" step="0.1" value="1" /></label>
        </section>

        <section class="geo2__block">
          <div class="geo2__block-title"><span>06</span><strong>{c.address}</strong></div>
          <label class="geo2__field"><span>{c.role}</span><select id="geo2-address-role"><option value="warehouse">{c.warehouse}</option><option value="factory">{c.factory}</option><option value="demand">{c.demand}</option></select></label>
          <label class="geo2__field"><span>Address</span><input id="geo2-address" type="text" placeholder="e.g. 20 Symonds Street, Auckland" /></label>
          <button id="geo2-add-address" class="geo2__secondary" type="button">{c.add}</button>
          <p class="geo2__hint">{c.clientGeocode}</p>
          <div class="geo2__custom-head"><span>{c.custom}</span><strong id="geo2-custom-count">0</strong></div>
          <div id="geo2-custom-list" class="geo2__custom-list"><p>{c.empty}</p></div>
        </section>

        <section class="geo2__block geo2__block--note"><p>{c.note}</p></section>
      </div>

      <div class="geo2__console-actions">
        <button id="geo2-run" type="button">{c.run}</button>
        <button id="geo2-routes" type="button" disabled>{c.routes}</button>
        <button id="geo2-reset" type="button" class="geo2__ghost">{c.reset}</button>
      </div>
    </aside>

    <aside class="geo2__results">
      <div class="geo2__results-head"><span>RESULT</span><strong>{c.results}</strong></div>
      <div class="geo2__kpis">
        <div><span>{c.hubs}</span><strong id="geo2-kpi-hubs">2</strong></div>
        <div><span>{c.coverage}</span><strong id="geo2-kpi-coverage">100%</strong></div>
        <div><span>{c.avgDistance}</span><strong id="geo2-kpi-distance">—</strong></div>
        <div><span>{c.fleetCapacity}</span><strong id="geo2-kpi-fleet">—</strong></div>
        <div><span>{c.safetyStock}</span><strong id="geo2-kpi-ss">—</strong></div>
        <div><span>{c.rop}</span><strong id="geo2-kpi-rop">—</strong></div>
      </div>
      <div class="geo2__cost"><span>{c.totalCost}</span><strong id="geo2-kpi-cost">—</strong></div>
      <p id="geo2-status">{c.statusReady}</p>
      <div id="geo2-open-list" class="geo2__open-list"></div>
    </aside>
  </div>
</section>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline>
  (() => {
    const root = document.getElementById("geo-v2");
    if (!root || !window.L) return;
    const locale = root.dataset.locale || "zh";
    const zh = locale === "zh";
    const tx = zh
      ? { running: "正在计算当前情景…", noSolution: "当前约束下没有可行方案。", geocoding: "正在解析地址并计算真实道路距离…", geocodeFail: "地址解析失败。", added: "地点已加入网络。", routing: "正在加载最优道路路径…", routed: "道路路径已加载。", routeFail: "部分路径不可用，已保留分配虚线。", remove: "删除", covers: "覆盖" }
      : { running: "Calculating scenario…", noSolution: "No feasible solution.", geocoding: "Geocoding address and calculating road distances…", geocodeFail: "Address geocoding failed.", added: "Location added to the network.", routing: "Loading optimised road routes…", routed: "Road routes loaded.", routeFail: "Some routes were unavailable; dashed allocations remain.", remove: "Remove", covers: "covers" };

    const baseHubNames = ["328 Ponsonby Road", "322 Great North Road", "214 Green Lane West", "151 Beach Road", "76 Coates Avenue", "151 Neilson Street"];
    const baseHubQueries = ["328 Ponsonby Road, Ponsonby, Auckland, New Zealand", "322 Great North Road, Grey Lynn, Auckland, New Zealand", "214 Green Lane West, Epsom, Auckland, New Zealand", "151 Beach Road, Auckland CBD, Auckland, New Zealand", "76 Coates Avenue, Orakei, Auckland, New Zealand", "151 Neilson Street, Onehunga, Auckland, New Zealand"];
    const baseDemandNames = ["Auckland CBD", "Epsom", "Grey Lynn", "Mount Eden", "Newmarket", "Onehunga", "Orakei", "Ponsonby", "Remuera", "Three Kings"];
    const baseDemandQueries = baseDemandNames.map((name) => `${name}, Auckland, New Zealand`);
    const baseDemands = [4000, 600, 700, 800, 500, 600, 400, 700, 900, 400];
    const baseDistances = [
      [2.07,5.80,2.04,4.66,4.12,10.66,7.50,0.31,7.70,7.89],
      [4.20,5.62,1.29,4.26,4.94,10.03,9.50,3.22,8.51,6.91],
      [6.45,1.92,6.76,2.79,3.44,4.19,7.26,7.27,4.42,3.23],
      [1.45,4.95,4.85,4.11,2.47,9.25,4.48,3.52,4.89,7.33],
      [5.56,6.79,8.98,7.29,5.05,9.13,0.00,7.63,2.87,9.60],
      [10.70,6.17,10.99,7.03,7.69,1.04,9.48,11.52,6.62,4.27],
    ];

    let hubNames = [...baseHubNames];
    let hubQueries = [...baseHubQueries];
    let demandNames = [...baseDemandNames];
    let demandQueries = [...baseDemandQueries];
    let demands = [...baseDemands];
    let matrix = baseDistances.map((row) => [...row]);
    let hubTypes = baseHubNames.map(() => "warehouse");
    let custom = [];
    let hubCoords = [];
    let demandCoords = [];
    let solution = null;
    let scenarioMatrix = matrix.map((row) => [...row]);
    let maxOpen = 4;
    let fleet = 10;

    const $ = (id) => document.getElementById(id);
    const status = $("geo2-status");
    const map = window.L.map("geo2-map", { zoomControl: true }).setView([-36.873, 174.766], 12);
    window.L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", { maxZoom: 20, subdomains: "abcd", attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; CARTO' }).addTo(map);
    const facilityLayer = window.L.layerGroup().addTo(map);
    const demandLayer = window.L.layerGroup().addTo(map);
    const allocationLayer = window.L.layerGroup().addTo(map);
    const routeLayer = window.L.layerGroup().addTo(map);

    const sleep = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
    const geocodeOne = async (query) => {
      const url = new URL("https://nominatim.openstreetmap.org/search");
      url.searchParams.set("q", query);
      url.searchParams.set("format", "jsonv2");
      url.searchParams.set("limit", "1");
      url.searchParams.set("countrycodes", "nz");
      const r = await fetch(url.toString(), { headers: { "Accept-Language": zh ? "zh,en;q=0.8" : "en" } });
      if (!r.ok) throw new Error(`Nominatim ${r.status}`);
      const data = await r.json();
      if (!data.length) throw new Error("No geocode result");
      return { lat: Number(data[0].lat), lon: Number(data[0].lon), label: data[0].display_name || query };
    };
    const routeDistance = async (a, b) => {
      const url = `https://router.project-osrm.org/route/v1/driving/${a.lon},${a.lat};${b.lon},${b.lat}?overview=false&steps=false`;
      const r = await fetch(url);
      if (!r.ok) throw new Error(`OSRM ${r.status}`);
      const data = await r.json();
      const meters = data.routes?.[0]?.distance;
      if (!Number.isFinite(meters)) throw new Error("No route distance");
      return meters / 1000;
    };

    const ensureBaseCoords = async () => {
      const key = "acidch-geo-v2-base-coords";
      try {
        const cached = JSON.parse(localStorage.getItem(key) || "null");
        if (cached?.hubs?.length === baseHubNames.length && cached?.demands?.length === baseDemandNames.length) {
          hubCoords = [...cached.hubs, ...hubCoords.slice(baseHubNames.length)];
          demandCoords = [...cached.demands, ...demandCoords.slice(baseDemandNames.length)];
          return;
        }
      } catch {}
      const h = [];
      const d = [];
      for (const q of baseHubQueries) { h.push(await geocodeOne(q)); await sleep(1050); }
      for (const q of baseDemandQueries) { d.push(await geocodeOne(q)); await sleep(1050); }
      hubCoords = [...h, ...hubCoords.slice(baseHubNames.length)];
      demandCoords = [...d, ...demandCoords.slice(baseDemandNames.length)];
      localStorage.setItem(key, JSON.stringify({ hubs: h, demands: d }));
    };

    const combinations = (items, choose) => {
      const out = [];
      const walk = (start, picked) => {
        if (picked.length === choose) { out.push([...picked]); return; }
        for (let i = start; i < items.length; i += 1) { picked.push(items[i]); walk(i + 1, picked); picked.pop(); }
      };
      walk(0, []);
      return out;
    };

    const seeded = (seed) => {
      let x = Math.abs(Number(seed) || 1) % 2147483647;
      if (x === 0) x = 1;
      return () => ((x = (x * 48271) % 2147483647) - 1) / 2147483646;
    };

    const buildScenarioMatrix = () => {
      const mode = $("geo2-road-mode").value;
      const congestion = Number($("geo2-congestion").value) / 100;
      const closure = Number($("geo2-closure").value) / 100;
      const improvement = Number($("geo2-improvement").value) / 100;
      const rnd = seeded($("geo2-seed").value);
      return matrix.map((row) => row.map((value) => {
        if (!Number.isFinite(value)) return Infinity;
        let d = value;
        if (mode === "congestion" || mode === "mixed") d *= 1 + congestion * (0.45 + 0.55 * rnd());
        if ((mode === "closure" || mode === "mixed") && rnd() < closure) return Infinity;
        if ((mode === "newroad" || mode === "mixed") && rnd() < 0.3) d *= 1 - improvement * (0.55 + 0.45 * rnd());
        return d;
      }));
    };

    const solve = () => {
      scenarioMatrix = buildScenarioMatrix();
      const threshold = Number($("geo2-threshold").value);
      const redundancy = Number($("geo2-redundancy").value);
      const demandMultiplier = Number($("geo2-demand-multiplier").value);
      const facilityCapacity = Number($("geo2-facility-capacity").value);
      const objective = $("geo2-objective").value;
      const fixedCost = Number($("geo2-fixed-cost").value);
      const transportCost = Number($("geo2-transport-cost").value);
      const totalDemand = demands.reduce((a, b) => a + b, 0) * demandMultiplier;
      const ids = hubNames.map((_, i) => i);
      let best = null;
      for (let k = 1; k <= Math.min(maxOpen, ids.length); k += 1) {
        for (const selected of combinations(ids, k)) {
          if (k * facilityCapacity < totalDemand) continue;
          const coverCounts = demandNames.map((_, j) => selected.reduce((sum, i) => sum + (scenarioMatrix[i]?.[j] <= threshold ? 1 : 0), 0));
          if (!coverCounts.every((n) => n >= redundancy)) continue;
          const nearest = demandNames.map((_, j) => selected.map((i) => ({ hub: i, d: scenarioMatrix[i]?.[j] ?? Infinity })).filter((x) => x.d <= threshold).sort((a, b) => a.d - b.d)[0]);
          if (nearest.some((x) => !x)) continue;
          const weightedDistance = nearest.reduce((sum, x, j) => sum + x.d * demands[j] * demandMultiplier, 0);
          const score = fixedCost * k + transportCost * weightedDistance;
          const candidate = { selected, coverCounts, nearest, weightedDistance, score };
          if (!best || (objective === "minHubs" ? selected.length < best.selected.length || (selected.length === best.selected.length && score < best.score) : score < best.score)) best = candidate;
        }
        if (best && objective === "minHubs") break;
      }
      solution = best;
      return best;
    };

    const inventoryMetrics = () => {
      const mean = Number($("geo2-inv-mean").value);
      const sd = Number($("geo2-inv-sd").value);
      const lead = Number($("geo2-lead-time").value);
      const z = Number($("geo2-service").value);
      const ss = z * sd * Math.sqrt(lead);
      return { ss, rop: mean * lead + ss };
    };

    const renderMap = () => {
      allocationLayer.clearLayers();
      facilityLayer.clearLayers();
      demandLayer.clearLayers();
      if (hubCoords.length) {
        hubCoords.forEach((p, i) => {
          if (!p) return;
          const active = solution?.selected?.includes(i);
          const color = hubTypes[i] === "factory" ? "#ffcc66" : "#67e8f9";
          window.L.circleMarker([p.lat, p.lon], { radius: active ? 9 : 6, weight: active ? 3 : 1.5, color: active ? "#d8ff6b" : color, fillColor: active ? "#d8ff6b" : color, fillOpacity: active ? 0.95 : 0.55 })
            .bindTooltip(`<strong>${hubNames[i]}</strong><br>${hubTypes[i]}`)
            .addTo(facilityLayer);
        });
      }
      if (demandCoords.length) {
        demandCoords.forEach((p, i) => {
          if (!p) return;
          window.L.circleMarker([p.lat, p.lon], { radius: Math.max(4, Math.min(10, 4 + (demands[i] || 0) / 900)), color: "#ff759a", weight: 1.2, fillColor: "#ff3d78", fillOpacity: 0.62 })
            .bindTooltip(`<strong>${demandNames[i]}</strong><br>Demand: ${(demands[i] || 0).toLocaleString()}`)
            .addTo(demandLayer);
        });
      }
      if (solution && hubCoords.length && demandCoords.length) {
        solution.nearest.forEach((x, j) => {
          const a = hubCoords[x.hub]; const b = demandCoords[j]; if (!a || !b) return;
          window.L.polyline([[a.lat, a.lon], [b.lat, b.lon]], { color: "#62ecff", weight: 1.4, opacity: 0.5, dashArray: "4 8" }).addTo(allocationLayer);
        });
      }
    };

    const renderResults = () => {
      const inv = inventoryMetrics();
      const totalDemand = demands.reduce((a, b) => a + b, 0) * Number($("geo2-demand-multiplier").value);
      const fleetCap = fleet * Number($("geo2-vehicle-capacity").value) * Number($("geo2-trips").value);
      $("geo2-kpi-ss").textContent = inv.ss.toFixed(0);
      $("geo2-kpi-rop").textContent = inv.rop.toFixed(0);
      $("geo2-kpi-fleet").textContent = `${Math.min(999, (fleetCap / Math.max(1, totalDemand)) * 100).toFixed(0)}%`;
      if (!solution) {
        $("geo2-kpi-hubs").textContent = "—";
        $("geo2-kpi-coverage").textContent = "0%";
        $("geo2-kpi-distance").textContent = "—";
        $("geo2-kpi-cost").textContent = "—";
        $("geo2-open-list").innerHTML = "";
        status.textContent = tx.noSolution;
        return;
      }
      const avg = solution.weightedDistance / Math.max(1, totalDemand);
      const inventoryCost = inv.ss * Number($("geo2-holding-cost").value) * solution.selected.length;
      $("geo2-kpi-hubs").textContent = String(solution.selected.length);
      $("geo2-kpi-coverage").textContent = "100%";
      $("geo2-kpi-distance").textContent = `${avg.toFixed(2)} km`;
      $("geo2-kpi-cost").textContent = `NZ$${(solution.score + inventoryCost).toLocaleString(undefined, { maximumFractionDigits: 0 })}`;
      $("geo2-open-list").innerHTML = solution.selected.map((i) => `<div><span>${String(i + 1).padStart(2, "0")}</span><strong>${hubNames[i]}</strong></div>`).join("");
      status.textContent = zh ? "当前情景已重新优化。" : "Scenario re-optimised.";
    };

    const runScenario = () => {
      status.textContent = tx.running;
      routeLayer.clearLayers();
      solve();
      renderResults();
      renderMap();
      $("geo2-routes").disabled = !solution;
    };

    const updateLabels = () => {
      $("geo2-congestion-out").textContent = `${$("geo2-congestion").value}%`;
      $("geo2-closure-out").textContent = `${$("geo2-closure").value}%`;
      $("geo2-improvement-out").textContent = `${$("geo2-improvement").value}%`;
      $("geo2-threshold-out").textContent = `${Number($("geo2-threshold").value).toFixed(1)} km`;
      $("geo2-demand-multiplier-out").textContent = `${Number($("geo2-demand-multiplier").value).toFixed(2)}×`;
      $("geo2-max-open-out").textContent = String(maxOpen);
      $("geo2-fleet-out").textContent = String(fleet);
    };

    ["geo2-congestion","geo2-closure","geo2-improvement","geo2-threshold","geo2-demand-multiplier"].forEach((id) => $(id).addEventListener("input", updateLabels));
    document.querySelectorAll("[data-step]").forEach((button) => button.addEventListener("click", () => {
      const d = Number(button.dataset.delta || 0);
      if (button.dataset.step === "maxOpen") maxOpen = Math.max(1, Math.min(hubNames.length, maxOpen + d));
      if (button.dataset.step === "fleet") fleet = Math.max(0, fleet + d);
      updateLabels();
    }));

    const renderCustom = () => {
      $("geo2-custom-count").textContent = String(custom.length);
      $("geo2-custom-list").innerHTML = custom.length ? custom.map((x) => `<div class="geo2__custom-row"><div><strong>${x.name}</strong><small>${x.type} · ${x.lat.toFixed(5)}, ${x.lon.toFixed(5)}</small></div><button type="button" data-remove-custom="${x.id}">${tx.remove}</button></div>`).join("") : `<p>${zh ? "尚未添加自定义地点。" : "No custom locations yet."}</p>`;
      document.querySelectorAll("[data-remove-custom]").forEach((button) => button.addEventListener("click", () => removeCustom(button.dataset.removeCustom)));
    };

    const removeCustom = (id) => {
      const item = custom.find((x) => x.id === id); if (!item) return;
      if (item.type === "demand") {
        const idx = demandNames.indexOf(item.name);
        if (idx >= baseDemandNames.length) { demandNames.splice(idx,1); demandQueries.splice(idx,1); demands.splice(idx,1); demandCoords.splice(idx,1); matrix.forEach((row) => row.splice(idx,1)); }
      } else {
        const idx = hubNames.indexOf(item.name);
        if (idx >= baseHubNames.length) { hubNames.splice(idx,1); hubQueries.splice(idx,1); hubTypes.splice(idx,1); hubCoords.splice(idx,1); matrix.splice(idx,1); maxOpen = Math.min(maxOpen, hubNames.length); }
      }
      custom = custom.filter((x) => x.id !== id);
      renderCustom(); updateLabels(); runScenario();
    };

    $("geo2-add-address").addEventListener("click", async () => {
      const input = $("geo2-address");
      const query = input.value.trim();
      if (!query) return;
      status.textContent = tx.geocoding;
      $("geo2-add-address").disabled = true;
      try {
        await ensureBaseCoords();
        const p = await geocodeOne(query.includes("New Zealand") ? query : `${query}, Auckland, New Zealand`);
        const type = $("geo2-address-role").value;
        const id = `custom-${Date.now()}`;
        const name = query;
        if (type === "demand") {
          const col = [];
          for (let i = 0; i < hubCoords.length; i += 1) { col.push(await routeDistance(hubCoords[i], p)); await sleep(120); }
          matrix.forEach((row, i) => row.push(col[i]));
          demandNames.push(name); demandQueries.push(query); demands.push(500); demandCoords.push(p);
        } else {
          const row = [];
          for (let j = 0; j < demandCoords.length; j += 1) { row.push(await routeDistance(p, demandCoords[j])); await sleep(120); }
          hubNames.push(name); hubQueries.push(query); hubTypes.push(type); hubCoords.push(p); matrix.push(row); maxOpen = Math.min(Math.max(maxOpen, 1), hubNames.length);
        }
        custom.push({ id, name, type, lat: p.lat, lon: p.lon });
        input.value = "";
        renderCustom(); updateLabels(); runScenario();
        status.textContent = tx.added;
      } catch (error) {
        console.warn("[Geo V2] address add failed", error);
        status.textContent = tx.geocodeFail;
      } finally { $("geo2-add-address").disabled = false; }
    });

    $("geo2-routes").addEventListener("click", async () => {
      if (!solution) return;
      status.textContent = tx.routing;
      $("geo2-routes").disabled = true;
      routeLayer.clearLayers();
      try {
        await ensureBaseCoords();
        let failures = 0;
        for (let j = 0; j < solution.nearest.length; j += 1) {
          const x = solution.nearest[j]; const a = hubCoords[x.hub]; const b = demandCoords[j];
          if (!a || !b) { failures += 1; continue; }
          const url = `https://router.project-osrm.org/route/v1/driving/${a.lon},${a.lat};${b.lon},${b.lat}?overview=simplified&geometries=geojson&steps=false`;
          try {
            const r = await fetch(url); const data = await r.json(); const coords = data.routes?.[0]?.geometry?.coordinates;
            if (!coords?.length) throw new Error("No geometry");
            window.L.polyline(coords.map(([lon,lat]) => [lat,lon]), { color: "#d8ff6b", weight: 2.8, opacity: 0.85 }).addTo(routeLayer);
          } catch { failures += 1; }
          await sleep(120);
        }
        status.textContent = failures ? tx.routeFail : tx.routed;
      } catch { status.textContent = tx.routeFail; }
      $("geo2-routes").disabled = false;
    });

    $("geo2-run").addEventListener("click", runScenario);
    $("geo2-reset").addEventListener("click", () => {
      hubNames = [...baseHubNames]; hubQueries = [...baseHubQueries]; demandNames = [...baseDemandNames]; demandQueries = [...baseDemandQueries]; demands = [...baseDemands]; matrix = baseDistances.map((row) => [...row]); hubTypes = baseHubNames.map(() => "warehouse"); custom = []; hubCoords = hubCoords.slice(0, baseHubNames.length); demandCoords = demandCoords.slice(0, baseDemandNames.length); maxOpen = 4; fleet = 10;
      $("geo2-road-mode").value = "baseline"; $("geo2-objective").value = "minHubs"; $("geo2-threshold").value = "6"; $("geo2-redundancy").value = "1"; $("geo2-congestion").value = "35"; $("geo2-closure").value = "10"; $("geo2-improvement").value = "20"; $("geo2-seed").value = "708709"; $("geo2-demand-multiplier").value = "1";
      routeLayer.clearLayers(); renderCustom(); updateLabels(); runScenario();
    });

    const cached = (() => { try { return JSON.parse(localStorage.getItem("acidch-geo-v2-base-coords") || "null"); } catch { return null; } })();
    if (cached?.hubs?.length === baseHubNames.length && cached?.demands?.length === baseDemandNames.length) { hubCoords = cached.hubs; demandCoords = cached.demands; }
    updateLabels(); renderCustom(); runScenario(); renderMap();
  })();
</script>

