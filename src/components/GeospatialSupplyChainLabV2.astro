te-columns:minmax(0,1fr) auto}.geo2__range input{grid-column:1/-1;width:100%;accent-color:var(--cyan)}.geo2__range output{color:#eefcff;font-family:monospace}.geo2__stepper-row{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:.58rem 0;color:var(--muted);font-size:.7rem}.geo2__stepper{display:flex;align-items:center;border:1px solid var(--line)}.geo2__stepper button,.geo2__stepper output{width:34px;height:30px;display:grid;place-items:center;border:0;background:#0b202c;color:#eafaff}.geo2__stepper button{cursor:pointer;color:var(--cyan)}.geo2__secondary,.geo2__console-actions button{width:100%;border:1px solid rgba(98,236,255,.35);background:rgba(35,105,125,.3);color:#effcff;padding:.62rem .7rem;cursor:pointer}.geo2__hint,.geo2__block--note p{margin:.55rem 0 0;color:#658793;font-size:.64rem;line-height:1.45}.geo2__custom-head{display:flex;justify-content:space-between;margin-top:.75rem;color:#8aa8b4;font-size:.68rem}.geo2__custom-list{display:grid;gap:.4rem;margin-top:.45rem}.geo2__custom-list>p{color:#668692;font-size:.66rem}.geo2__custom-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.5rem;padding:.5rem;border:1px solid rgba(98,236,255,.13);background:rgba(11,42,55,.48)}.geo2__custom-row strong,.geo2__custom-row small{display:block}.geo2__custom-row strong{font-size:.68rem}.geo2__custom-row small{margin-top:.2rem;color:#6f909c;font-size:.58rem}.geo2__custom-row button{border:0;background:transparent;color:var(--pink);font-size:.62rem;cursor:pointer}.geo2__console-actions{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;padding:.7rem;border-top:1px solid var(--line);background:#071a25}.geo2__console-actions .geo2__ghost{grid-column:1/-1;background:transparent;color:#7896a1}.geo2__console-actions button:disabled{opacity:.4;cursor:not-allowed}.geo2__results{position:absolute;z-index:650;right:390px;bottom:1rem;width:330px;padding:.8rem;border:1px solid var(--line);background:rgba(7,24,34,.91);backdrop-filter:blur(13px)}.geo2__results-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.6rem}.geo2__results-head strong{font-size:.75rem}.geo2__kpis{display:grid;grid-template-columns:1fr 1fr;gap:.4rem}.geo2__kpis>div,.geo2__cost{padding:.55rem;border:1px solid rgba(116,190,213,.16);background:rgba(11,39,51,.52)}.geo2__kpis span,.geo2__cost span{display:block;color:#7896a2;font-size:.6rem}.geo2__kpis strong,.geo2__cost strong{display:block;margin-top:.3rem;color:#f1fcff;font:700 1rem monospace}.geo2__cost{margin-top:.4rem}.geo2__cost strong{color:var(--acid)}#geo2-status{margin:.6rem 0 0;color:#7898a4;font-size:.64rem;line-height:1.45}.geo2__open-list{display:grid;gap:.25rem;margin-top:.55rem}.geo2__open-list div{display:grid;grid-template-columns:25px 1fr;gap:.4rem;color:#92aeb8;font-size:.62rem}.geo2__open-list span{color:var(--acid);font-family:monospace}.geo2__legend{position:absolute;z-index:620;left:1rem;bottom:1rem;display:flex;gap:.65rem;flex-wrap:wrap;padding:.45rem .55rem;border:1px solid var(--line);background:rgba(6,20,29,.86);color:#87a3ae;font-size:.62rem}.geo2__legend span{display:flex;align-items:center;gap:.3rem}.geo2__legend i{width:12px;height:5px;border-radius:99px;display:inline-block}.geo2__legend .facility{height:8px;background:var(--acid)}.geo2__legend .demand{height:8px;background:var(--pink)}.geo2__legend .allocation{border-top:1px dashed var(--cyan)}.geo2__legend .route{background:var(--cyan)}:global(.geo2 .leaflet-control-zoom a){background:rgba(7,24,34,.92);color:#eafaff;border-color:var(--line)}:global(.geo2 .leaflet-control-attribution){background:rgba(7,24,34,.7);color:#74919c}:global(.geo2 .leaflet-tooltip){border:1px solid rgba(98,236,255,.25);background:rgba(6,21,30,.95);color:#eafaff;box-shadow:none;font-size:.68rem}
  @media(max-width:980px){.geo2__map-shell{min-height:1100px}.geo2__identity{width:calc(100% - 2rem)}.geo2__console{top:auto;right:.6rem;bottom:.6rem;left:.6rem;width:auto;height:470px}.geo2__results{right:.6rem;bottom:484px;width:300px}.geo2__legend{bottom:484px;max-width:calc(100% - 340px)}}
  @media(max-width:640px){.geo2{width:calc(100vw - .5rem)}.geo2__map-shell{min-height:1240px}.geo2__identity p{display:none}.geo2__console{height:540px}.geo2__results{right:.5rem;left:.5rem;bottom:554px;width:auto}.geo2__legend{right:.5rem;left:.5rem;bottom:780px;max-width:none}.geo2__kpis{grid-template-columns:1fr 1fr}}
</style>
